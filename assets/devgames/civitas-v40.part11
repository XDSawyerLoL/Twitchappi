';

function v33CityAmbience(g,state,ts){
 const sec=ts/1000;
 // Warm coastal light follows the game clock without modifying gameplay values.
 g.save();g.globalCompositeOperation='screen';
 const halo=g.createRadialGradient(980,100,30,850,190,680);
 halo.addColorStop(0,'rgba(255,232,170,.09)');halo.addColorStop(1,'rgba(255,242,200,0)');
 g.fillStyle=halo;g.fillRect(0,0,W,H);g.restore();
 // Scene-owned animation: flags and moving shadows exist only for built civic structures.
 if(state.sites.some(b=>b?.type==='hotelville')){
  const hall=state.sites.findIndex(b=>b?.type==='hotelville');
  if(Math.floor(hall/8)===(state.district||0)){
   const [x,y]=v18ScenicSitePoint(hall,state),wave=Math.sin(sec*1.6)*3;
   g.save();g.globalAlpha=.55;g.strokeStyle='#916028';g.lineWidth=1.4;g.beginPath();g.moveTo(x-53,y-74);g.lineTo(x-53,y-122);g.stroke();
   g.fillStyle='#9b2218';g.beginPath();g.moveTo(x-52,y-118);g.quadraticCurveTo(x-40,y-116+wave,x-28,y-113);g.lineTo(x-50,y-100);g.closePath();g.fill();g.restore();
  }
 }
}



// CIVITAS XL — V35-native terrain contact model.
// Painted construction illustrations already include courtyards; don't put another solid
// oval or opaque plaza underneath them. Distress the ground along the footprint instead.
const v40Perf={foundations:0,footsteps:0,soilStones:0,environment:0};
function v40Hash(n){let x=Math.sin(n*127.18+19.37)*43758.5453;return x-Math.floor(x)}
function v40SoilIntegration(g,x,y,type,width,level,ts,index){
 v40Perf.foundations++;
 const isPort=type==='port',industry=['scierie','carriere','marbre','cave'].includes(type);
 const civic=['hotelville','senatbat','academie','temple','forum'].includes(type);
 if(isPort)return;
 const radius=(civic?93:industry?78:73)*Math.min(1.15,1+Math.max(0,level-1)*.025);
 g.save();
 // Multiple softly feathered soil stains follow the ground plane. No solid fill shape.
 const soil=g.createRadialGradient(x-10,y+11,3,x+1,y+14,radius*1.11);
 soil.addColorStop(0,industry?'rgba(75,64,35,.34)':'rgba(101,79,44,.24)');
 soil.addColorStop(.48,industry?'rgba(106,87,45,.21)':'rgba(123,100,56,.13)');
 soil.addColorStop(.79,'rgba(111,100,53,.055)');soil.addColorStop(1,'rgba(111,100,53,0)');
 g.fillStyle=soil;g.beginPath();g.ellipse(x,y+13,radius,radius*.38,-.04,0,Math.PI*2);g.fill();
 // Painterly scuffed earth and sparse stone at perimeter; consistent deterministic placement.
 for(let i=0;i<29;i++){
  const seed=index*113+i*5.7,angle=v40Hash(seed)*Math.PI*2,ring=.68+.27*v40Hash(seed+3);
  const px=x+Math.cos(angle)*radius*ring,py=y+14+Math.sin(angle)*radius*.31*ring;
  const r=.8+v40Hash(seed+7)*2.15;
  g.fillStyle= i%7===0?'rgba(226,208,160,.33)':i%3===0?'rgba(78,105,51,.31)':'rgba(101,81,49,.19)';
  g.beginPath();g.ellipse(px,py,r,r*.43,angle*.18,0,Math.PI*2);g.fill();
 }
 // A short entrance threshold joins the painted sprite to the underlying road texture.
 // It must not read as a separate large polygon or stage.
 const walkWidth=civic?26:industry?19:21;
 const entryY=y+22;
 const endY=y+(civic?47:42);
 const pave=g.createLinearGradient(0,entryY,0,endY);
 pave.addColorStop(0,'rgba(170,141,90,.26)');pave.addColorStop(.6,'rgba(176,155,104,.17)');pave.addColorStop(1,'rgba(169,145,93,0)');
 g.fillStyle=pave;g.beginPath();g.moveTo(x-walkWidth*.64,entryY);g.lineTo(x+walkWidth*.64,entryY);
 g.quadraticCurveTo(x+walkWidth*.86,endY-5,x+walkWidth*1.2,endY);
 g.lineTo(x-walkWidth*1.18,endY);
 g.quadraticCurveTo(x-walkWidth*.84,endY-5,x-walkWidth*.64,entryY);g.fill();
 if(civic){
  g.strokeStyle='rgba(241,215,165,.32)';g.lineWidth=1.4;
  for(let j=0;j<3;j++){const yy=y+25+j*4;g.beginPath();g.moveTo(x-13-j*2,yy);g.lineTo(x+13+j*2,yy);g.stroke()}
 }
 // Work yards keep scattered material with the correct industry's colour, never oversized tiles.
 if(industry){for(let j=0;j<5;j++){
  const seed=index*20+j*2.4,px=x+radius*.67+(v40Hash(seed)-.5)*26,py=y+18+(v40Hash(seed+1)-.5)*14;
  const stone=type==='carriere'||type==='marbre';g.fillStyle=stone?'rgba(190,186,164,.68)':'rgba(117,80,39,.56)';
  g.fillRect(px,py,stone?6:9,stone?3.5:2.8)
 }}
 g.restore();
}
function v40ForegroundContact(g,x,y,type,width,level,index){
 // Small foreground occluders hide the sprite's cut-out feet without burying architecture.
 if(type==='port')return;
 g.save();
 const w=Math.min(89,width*.41);
 const line=g.createLinearGradient(x,y+12,x,y+29);
 line.addColorStop(0,'rgba(43,37,22,0)');line.addColorStop(.42,'rgba(42,33,18,.13)');line.addColorStop(1,'rgba(42,33,18,0)');
 g.fillStyle=line;g.fillRect(x-w*.73,y+12,w*1.46,16);
 for(let i=0;i<17;i++){
  const seed=48.9*index+i*1.28,f=v40Hash(seed),gx=x+(f-.5)*w*1.83;
  const gy=y+19+v40Hash(seed+33)*14;
  if(Math.abs(gx-x)<(type==='hotelville'?29:18)&&gy<y+26)continue;
  const grass=v40Hash(seed+9)>.40;
  g.strokeStyle=grass?'rgba(74,103,43,.51)':'rgba(184,165,121,.55)';g.lineWidth=grass?.8:1.4;
  g.beginPath();g.moveTo(gx,gy);g.lineTo(gx+(f-.5)*2.5,gy-(grass?2.4:1.1));g.stroke();v40Perf.soilStones++;
 }
 g.restore();
}
function v40CitizenFootfall(g,actor,pose,sec,scale){
 if(!pose.walking)return;
 const beat=Math.sin(sec*(9.4+(actor.uid%3))+actor.uid);
 if(beat<.68)return;
 const dustAlpha=Math.max(0,(beat-.68)/.32)*.11;
 g.save();g.fillStyle=`rgba(197,167,113,${dustAlpha})`;
 const dir=pose.dx<0?1:-1;
 g.beginPath();g.ellipse(dir*5*scale,1.1,4.6*scale,1.6*scale,-.14,0,Math.PI*2);g.fill();g.restore();v40Perf.footsteps++;
}
function v40Microclimate(g,state,ts){
 // The same warm Mediterranean light reaches the scenery and new sprites.
 // Subtle enough to preserve contrast, rather than covering the city in fog.
 g.save();g.globalCompositeOperation='soft-light';
 const sunlight=g.createLinearGradient(0,0,W,H);
 sunlight.addColorStop(0,'rgba(244,209,138,.075)');sunlight.addColorStop(.57,'rgba(226,206,152,.025)');
 sunlight.addColorStop(1,'rgba(54,103,116,.08)');g.fillStyle=sunlight;g.fillRect(0,0,W,H);g.restore();
 v40Perf.environment++;
}
window.CIVITAS_V40_VISUAL_DIAGNOSTIC=()=>({
 ...(window.CIVITAS_V39_VISUAL_DIAGNOSTIC?.()||{}),revision:40,
 foundations:v40Perf.foundations,footsteps:v40Perf.footsteps,
 vegetationDetails:v40Perf.soilStones,environmentFrames:v40Perf.environment,
 terrainSystem:'feathered-ground-contact',spriteGrade:'single-city-light',
 savePreserved:true
});

// CIVITAS XXXIX — single-depth scenic compositor: sprite feet, building foundations,
// roads and foreground population live in one projected world, never separate flat layers.
const v39Perf={layers:0,buildingDraws:0,peopleDraws:0,entrances:0};
function v39GroundContact(g,x,y,type,sz,level,ts){
 g.save();
 const size=(type==='hotelville'?112:type==='senatbat'?94:82)*(1+Math.min(3,level-1)*.035);
 const rough=type==='scierie'||type==='carriere'||type==='marbre'||type==='cave';
 // Contact soil: irregular polygon with feathered opacity and hand-painted grain.
 const grd=g.createRadialGradient(x-8,y+4,5,x+5,y+14,size*1.08);
 grd.addColorStop(0,rough?'rgba(91,83,48,.38)':'rgba(139,112,71,.31)');
 grd.addColorStop(.45,rough?'rgba(118,101,66,.29)':'rgba(169,141,98,.25)');
 grd.addColorStop(1,'rgba(106,87,58,0)');
 g.fillStyle=grd;g.beginPath();g.moveTo(x-size*.94,y+4);
 for(let j=0;j<=22;j++){const a=Math.PI*2*j/22,phase=Math.sin(j*2.4+x*.017)*.07+Math.cos(j*1.7)*.04;
  const r=1+phase,px=x+Math.cos(a)*size*r,py=y+13+Math.sin(a)*size*.32*r;
  if(j===0)g.moveTo(px,py);else g.lineTo(px,py)}g.closePath();g.fill();
 // Irregular low masonry and leaf litter at the front, with the same scene light.
 for(let k=0;k<15;k++){
  const f=(k+.3)/15,xx=x-size*.79+f*size*1.58;
  const yy=y+23+Math.sin(f*21+x*.07)*3+Math.abs(f-.5)*7;
  const v=.8+(k%4)*.45;
  g.fillStyle=k%4===0?'rgba(78,99,47,.55)':k%3===0?'rgba(203,183,132,.64)':'rgba(110,100,70,.34)';
  g.beginPath();g.ellipse(xx,yy,v*2.0,v*.9,Math.sin(k*2.2)*.45,0,Math.PI*2);g.fill();
 }
 // Strongest contact directly below the façade. This is NOT a detached oval platform.
 const foot=g.createLinearGradient(x,y+7,x,y+26);
 foot.addColorStop(0,'rgba(41,35,25,.20)');foot.addColorStop(1,'rgba(41,35,25,0)');
 g.fillStyle=foot;g.fillRect(x-sz*.34,y+9,sz*.68,19);
 g.restore();
}
function v39PaintRouteGuides(g){
 if(!showRoutes)return;
 const marked=new Set();g.save();g.setLineDash([6,7]);g.lineWidth=2.2;
 for(const a of actors){
  const path=scenicPathForActor(a),key=path.map(p=>p.join(',')).join('/');if(marked.has(key))continue;marked.add(key);
  g.strokeStyle=a.role==='builder'?'rgba(255,214,141,.92)':a.role==='carrier'?'rgba(224,226,166,.82)':'rgba(247,228,178,.68)';
  g.beginPath();path.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.stroke();
 }g.restore();
}
function v39PaintScenicDepth(g,state,ts){
 const sec=ts/1000,district=state.district||0,items=[];
 v39PaintRouteGuides(g);
 for(let i=district*8;i<district*8+8;i++){
  const exists=state.sites[i]||state.construction?.site===i;
  if(!exists&&state.selected!==i)continue;
  const [x,y]=v18ScenicSitePoint(i,state);
  // At the façade line, not the roof peak: pedestrians behind disappear naturally.
  items.push({kind:'architecture',idx:i,depth:y+21,x});
 }
 for(const a of actors){
  if(a.targetIndex>=0&&Math.floor(a.targetIndex/8)!==district)continue;
  const pose=v17ActorPose(a,scenicPathForActor(a),sec);
  items.push({kind:'person',actor:a,pose,depth:pose.y+1,x:pose.x});
 }
 items.sort((a,b)=>a.depth-b.depth||(a.kind==='architecture'?-1:1));
 v39Perf.layers=items.length;v39Perf.buildingDraws=0;v39Perf.peopleDraws=0;
 for(const entry of items){
  if(entry.kind==='architecture'){
   paintLandscapeBuildings(g,state,ts,entry.idx);v39Perf.buildingDraws++;
  }else{
   v17DrawCitizen(g,entry.actor,entry.pose,sec);v39Perf.peopleDraws++;
  }
 }
}
window.CIVITAS_V39_VISUAL_DIAGNOSTIC=()=>{
 const st=api.snapshot();const citizens=actors.map(a=>({role:a.role,site:a.targetIndex,
   routeLength:Math.round(v17RouteLength(scenicPathForActor(a))),
   finalPoint:scenicPathForActor(a).at(-1),depth:v17ActorPose(a,scenicPathForActor(a),performance.now()/1000).y}));
 return {source:'CIVITAS_ROMA_V35.html',revision:39,saveKey:'civitas-roman-v35',
  district:st.district,architecture:st.sites.filter(Boolean).length,
  layers:v39Perf.layers,buildingDraws:v39Perf.buildingDraws,peopleDraws:v39Perf.peopleDraws,
  actors:citizens,renderMode};
};

function drawLandscape(g,state,ts){
 const districtScene=(state.district===1?scenicDistrict2:scenicBase);if(districtScene.complete&&districtScene.naturalWidth){g.drawImage(districtScene,0,0,W,H)}else{g.fillStyle='#648a5d';g.fillRect(0,0,W,H)}
 // Make the top and bottom of the reference art transition naturally into the in-game UI bars.
 let shade=g.createLinearGradient(0,0,0,55);shade.addColorStop(0,'#3d2b1e72');shade.addColorStop(1,'#3d2b1e00');g.fillStyle=shade;g.fillRect(0,0,W,55);
 v16Breeze(g,ts);v16Water(g,ts,true);paintWater(g,ts);paintTownAtmosphere(g,state,ts);v16SeaTraffic(g,ts,state);
 v39PaintScenicDepth(g,state,ts);v40Microclimate(g,state,ts);v33CityAmbience(g,state,ts);v16BuildingsSpecial(g,state,ts,true);v18RoadsideLife(g,state,ts,true);v16Flags(g,ts,state,true);
 if(state.activeCity&&state.activeCity!=='player'){g.fillStyle='rgba(59,44,17,.035)';g.fillRect(0,0,W,H)}
}

function drawBuildings(g,state,ts){
 const list=sites.map(([x,y],i)=>({i,x,y,b:state.sites[i]})).sort((a,b)=>(a.x+a.y)-(b.x+b.y));
 if(state.sites[4]?.type==='hotelville'){
  const [px,py]=tilePoint(...sites[4]);g.save();g.fillStyle='#baa87f9c';g.beginPath();g.ellipse(px,py+12,94,35,0,0,Math.PI*2);g.fill();g.strokeStyle='#e3d2aa';g.lineWidth=2;g.stroke();
  if((state.sites[4]?.level||0)>=3&&modularProps.statue?.complete&&modularProps.statue.naturalWidth)g.drawImage(modularProps.statue,px-96,py-75,55,83);g.restore();
 }
 for(const a of list){
  const [x,y]=tilePoint(a.x,a.y),sel=a.i===state.selected,job=state.construction?.site===a.i,queued=(state.queue||[]).some(q=>q.site===a.i),b=a.b;
  g.save();g.translate(x,y);
  const path=()=>{g.beginPath();g.ellipse(0,11,66,27,0,0,Math.PI*2)};
  if(b||job){
   g.fillStyle='#33261b48';g.beginPath();g.ellipse(5,13,52,18,0,0,Math.PI*2);g.fill();
   g.fillStyle='#cdb58a4d';g.beginPath();g.ellipse(0,12,45,13,0,0,Math.PI*2);g.fill();
   const type=b?.type||state.construction?.type,img=spriteFor(type),level=b?.level||state.construction?.level||1;
   const size=(type==='hotelville'?202:type==='senatbat'?190:type==='port'?194:type==='carriere'?161:type==='scierie'?164:173)*.96*(1+Math.min(.27,Math.max(0,level-1)*.07));
   const workers=v23SiteWorkers(state,a.i);
   g.fillStyle='#291f164d';g.beginPath();g.ellipse(10,13,size*.38,22,0,0,Math.PI*2);g.fill();
   if(b&&!job)v24Architecture(g,0,0,size,type,level,ts);
   if(img?.complete&&img.naturalWidth){const ratio=img.naturalWidth/img.naturalHeight,dh=size/ratio,baseY=19;
    if(job&&!b){const p=Math.max(0,Math.min(1,(Date.now()-state.construction.start)/(state.construction.end-state.construction.start)));v18DrawStructure(g,img,0,0,size,dh,p,ts/1000)}else g.drawImage(img,-size/2,-dh+baseY,size,dh);
   }else{g.fillStyle='#b7a17c';g.fillRect(-30,-70,60,58);poly(g,[[-35,-70],[0,-92],[35,-70]],'#a44b34')}
   if(!job){if(workers>0&&['scierie','carriere','cave','marbre'].includes(type))paintWorkshopActivity(g,size*.17,-size*.61,ts,workers,type);v18BuildingMotion(g,0,0,size,type,level,workers,ts);v19WorkshopShift(g,0,0,size,type,workers,ts);v24LongActivity(g,0,0,size,type,level,workers,ts);v23DrawBuildingScene(g,0,0,size,type,level,workers,ts,state,a.i,false)}
   if(level>=2&&b){g.strokeStyle='#dfc48e';g.lineWidth=3;g.beginPath();g.moveTo(-47,18);g.lineTo(47,18);g.stroke()}
   if(level>=3&&b){g.strokeStyle='#d5b87c';g.lineWidth=2;g.beginPath();g.moveTo(-size*.26,17);g.lineTo(size*.26,17);g.stroke()}
   if(job){g.fillStyle='#22150ec9';g.fillRect(-42,40,84,8);g.fillStyle='#7a532c';g.fillRect(-41,41,82,6);g.fillStyle='#f4dc9e';const p=Math.max(0,Math.min(1,(Date.now()-state.construction.start)/(state.construction.end-state.construction.start)));g.fillRect(-41,41,82*p,6)}
  }else if(sel){g.save();g.strokeStyle='#ffe3a9';g.lineWidth=2.4;g.setLineDash([7,5]);path();g.stroke();g.restore()}
  if(sel){g.strokeStyle='#ffda82';g.lineWidth=2.3;path();g.stroke()}
  if(queued){g.fillStyle='#26180fcc';g.fillRect(34,-66,18,12);g.fillStyle='#f8dfa1';g.font='bold 10px Georgia';g.fillText('Q',39,-56)}
  g.restore();
 }
}



let v30QuickLast='',v30QuickCollapsed=false;
const v30QuickPanel=holder.querySelector('#v30QuickPanel'),v30QuickToggle=holder.querySelector('#v30QuickToggle');
const v30Safe=(value)=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const v30Human=(n)=>new Intl.NumberFormat('fr-FR',{maximumFractionDigits:0}).format(n||0);
function v30CostRow(cost){const glyph={wood:'🪵',stone:'▤',marble:'⬜',wine:'🍇',gold:'◉'};const names={wood:'Bois',stone:'Pierre',marble:'Marbre',wine:'Vin',gold:'Or'};
 return Object.entries(cost||{}).filter(([,n])=>n>0).map(([k,n])=>`<span class="v30-quick-cost" title="${names[k]||k}">${glyph[k]||'•'} ${v30Human(n)}</span>`).join('');}
function v30QuickContent(state){
 const current=state.sites[state.selected],idx=state.selected+1,profile=state.resources||{},free=state.freeWorkers||0,queued=(state.queue||[]).some(j=>j.site===state.selected);
 const bag=`<div class="v30-quick-stocks">${Object.entries({wood:'Bois',stone:'Pierre',marble:'Marbre',gold:'Or'}).map(([k,label])=>`<span title="${label}">${v30Human(profile[k])} <small>${label}</small></span>`).join('')}</div>`;
 let body='';
 if(state.construction?.site===state.selected){
  const job=state.construction,t0=job.start||Date.now(),t1=job.end||Date.now()+1000,pct=Math.min(100,Math.max(0,(Date.now()-t0)/(t1-t0)*100));
  body=`<div class="v30-quick-tag">CHANTIER EN COURS</div><h3>${v30Safe(api.label(job.type))}</h3><p>Les bâtisseurs travaillent sur la parcelle ${idx}. Le bâtiment apparaîtra après la fin du chantier.</p><div class="v30-quick-progress"><i style="width:${pct}%"></i></div><p class="v30-quick-meta">${Math.floor(pct)} % achevé</p><button data-nav="chantiers" class="v30-quick-main">Suivre les travaux</button>`;
 }else if(current){
  const item=(api.catalog?.()||[]).find(x=>x.type===current.type);
  body=`<div class="v30-quick-tag">ÉDIFICE · PARCELLE ${idx}</div><h3>${v30Safe(api.label(current.type))}</h3><p>${v30Safe(item?.description||'Bâtiment de votre colonie.')}</p><div class="v30-quick-metrics"><span>Niveau <b>${current.level}</b></span><span>Ouvriers <b>${state.workers?.[state.selected]||0}</b></span></div>${item?`<div class="v30-quick-sub">Amélioration au niveau ${current.level+1}</div><div class="v30-quick-costs">${v30CostRow(item.cost)}</div><button class="v30-quick-main" data-build="${current.type}" ${!item.possible?'disabled':''}>${item.possible?'Lancer l’amélioration':'Matériaux insuffisants'}</button>`:''}${state.workers?.[state.selected]!==undefined||['scierie','carriere','marbre','cave','academie'].includes(current.type)?'<div class="v30-quick-sub">Gestion des ouvriers</div><div class="v30-quick-workers"><button data-worker="-5">−5</button><button data-worker="-1">−1</button><span>'+v30Human(free)+' libres</span><button data-worker="1">+1</button><button data-worker="5">+5</button></div>':''}`;
 }else{
   const entries=(api.catalog?.()||[]).filter(x=>state.selected===4?x.type==='hotelville':x.type!=='hotelville').sort((a,b)=>Number(b.possible)-Number(a.possible));
   body=`<div class="v30-quick-tag">TERRAIN LIBRE · PARCELLE ${idx}</div><h3>Développer la cité</h3><p>Sélectionne un édifice. Son aperçu s’affiche sur la parcelle avant le chantier.</p><div class="v30-quick-list">${entries.map(x=>`<div class="v30-build-option" data-v30-type="${v30Safe(x.type)}"><div class="v30-build-name">${v30Safe(x.name)}</div><div class="v30-quick-costs">${v30CostRow(x.cost)}</div><button data-build="${x.type}" ${!x.possible?'disabled':''} title="${x.possible?'Construire':(x.missing?.length?'Ressources insuffisantes':'Bâtiment verrouillé')}">${x.possible?'Construire':'Verrouillé'}</button></div>`).join('')}</div>`;
 }
 return `<div class="v30-quick-title"><span>ADMINISTRATION DE LA CITÉ</span><button type="button" id="v30QuickClose" title="Masquer les outils">×</button></div>${bag}<div class="v30-quick-body">${body}</div>`;
}
function v30UpdateQuickPanel(state){
 if(!v30QuickPanel||!document.body.classList.contains('v30-immersive')||v30QuickCollapsed)return;
 const sig=JSON.stringify([state.district,state.selected,state.sites[state.selected],state.construction?.type,state.construction?.site,
 Math.floor((Date.now()-(state.construction?.start||Date.now()))/3000),Object.values(state.resources||{}).map(x=>Math.floor(x)),state.workers?.[state.selected],state.freeWorkers]);
 if(sig===v30QuickLast)return;
 const oldScroll=v30QuickPanel.querySelector('.v30-quick-body')?.scrollTop||0;
 v30QuickPanel.innerHTML=v30QuickContent(state);
 if(v30QuickPanel.querySelector('.v30-quick-body'))v30QuickPanel.querySelector('.v30-quick-body').scrollTop=oldScroll;
 v30QuickLast=sig;
}
v30QuickToggle.addEventListener('click',()=>{v30QuickCollapsed=!v30QuickCollapsed;v30QuickPanel.classList.toggle('collapsed',v30QuickCollapsed);v30QuickToggle.textContent=v30QuickCollapsed?'⚒ Gérer la cité':'✓ Outils affichés';v30QuickLast='';v30UpdateQuickPanel(api.snapshot());});
v30QuickPanel.addEventListener('click',e=>{if(e.target.closest('#v30QuickClose')){v30QuickToggle.click();return;}if(e.target.closest('[data-nav]')){document.body.classList.remove('v30-immersive');v30ImmersionBtn.textContent='◈';v30ImmersionBtn.setAttribute('aria-pressed','false');}});
v30QuickPanel.addEventListener('pointerover',e=>{const row=e.target.closest('.v30-build-option');if(row)window.CIVITAS_V30_PREVIEW=row.dataset.v30Type||null});
v30QuickPanel.addEventListener('pointerout',e=>{const row=e.target.closest('.v30-build-option');if(row&&!row.contains(e.relatedTarget))window.CIVITAS_V30_PREVIEW=null;});

function drawStatus(state,ts){
 const name=state.city||'Colonia Julia';holder.querySelectorAll('[data-district]').forEach(b=>{b.classList.toggle('selected',+b.dataset.district===(state.district||0));});
 holder.querySelector('#isoCityName').textContent=name+' · '+(state.district===1?'Quartier des Collines':'Forum central');
 const total=state.totalBuildings??0,slots=16,people=state.citizens??state.pop??0,free=state.freeWorkers??0;
 holder.querySelector('#isoDetails').textContent=`${total}/${slots} édifices · ${Math.round(people)} habitants · ${Math.round(free)} travailleurs libres · ${state.construction?'Chantier actif':'Ville en activité'}`;
 v30UpdateQuickPanel(state);
}

function v30DrawLivePreview(g,state,ts){
 const previewType=window.CIVITAS_V30_PREVIEW;
 if(renderMode!=='scenic'||!previewType||state.nav!=='ville')return;
 const i=state.selected;
 if(Math.floor(i/8)!==(state.district||0)||state.sites[i]||state.construction?.site===i)return;
 const xy=v18ScenicSitePoint(i,state),x=xy[0],y=xy[1],im=spriteFor(previewType);
 const hall=previewType==='hotelville',size=(hall?275:previewType==='senatbat'?232:184);
 g.save();g.globalAlpha=.63;g.fillStyle='rgba(246,221,159,.19)';g.strokeStyle='#ffe8a2';g.lineWidth=2.1;g.setLineDash([7,5]);g.beginPath();g.ellipse(x,y+15,91,34,0,0,Math.PI*2);g.fill();g.stroke();g.setLineDash([]);
 if(im?.complete&&im.naturalWidth){const h=size*im.naturalHeight/im.naturalWidth;g.drawImage(im,x-size/2,y-h+19,size,h)}
 g.globalAlpha=1;g.fillStyle='rgba(39,23,16,.93)';g.strokeStyle='#d7aa66';g.lineWidth=1.3;
 const label=window.CIVITAS_BRIDGE?.label(previewType)||previewType;
 g.font='bold 16px Georgia';const bw=Math.max(114,Math.min(200,g.measureText(label).width+28));g.beginPath();g.roundRect(x-bw/2,y+35,bw,30,7);g.fill();g.stroke();g.fillStyle='#fff0c9';g.textAlign='center';g.fillText(label,x,y+56);g.textAlign='left';g.restore();
}


function v30DrawWeather(g,state,ts){
 const sec=ts/1000;
 if(v30Weather==='clear'){
   g.save();g.globalCompositeOperation='screen';
   for(let k=0;k<6;k++){const x=82+k*194+(sec*1.45)%50,y=50+(k%3)*71;
     const light=g.createRadialGradient(x,y,3,x,y,105);light.addColorStop(0,'rgba(255,238,176,.055)');light.addColorStop(1,'rgba(255,228,179,0)');g.fillStyle=light;g.beginPath();g.ellipse(x,y,124,40,-.2,0,Math.PI*2);g.fill()}
   g.restore();return;
 }
 if(v30Weather==='breeze'){
   g.save();g.strokeStyle='rgba(238,208,133,.28)';g.lineWidth=1.2;
   for(let k=0;k<25;k++){
    const progress=((k*.379+sec*.043)%1),x=(k*271+sec*(16+k%5*3))%W,y=82+(k*77)%520;
    if(progress<.09)continue;
    const s=3+(k%5);g.save();g.translate(x,y);g.rotate((k%7-3)*.15+Math.sin(sec*.7+k)*.14);g.beginPath();g.moveTo(-s/2,0);g.quadraticCurveTo(0,-s*.55,s,0);g.stroke();g.restore();
   }g.restore();return;
 }
 if(v30Weather==='rain'){
   g.save();g.fillStyle='rgba(40,58,69,.16)';g.fillRect(0,0,W,H);
   g.lineWidth=1.1;g.strokeStyle='rgba(235,239,236,.30)';
   for(let k=0;k<95;k++){
     const y=((k*71+sec*(195+k%11*4))%(H+50))-25;
     const x=((k*127+sec*(54+k%5*2))%(W+44))-22;
     g.beginPath();g.moveTo(x,y);g.lineTo(x-4,y+11+k%4);g.stroke();
   }
   g.strokeStyle='rgba(224,239,235,.25)';
   for(let k=0;k<16;k++){
     const x=113+(k*81)%990,y=300+(k*57)%320;
     const pulse=(sec*.69+k*.13)%1;
     g.beginPath();g.ellipse(x,y,3+pulse*8,1+pulse*2,0,0,Math.PI*2);g.stroke();
   }
   g.restore();
 }
}

let V21_MOTION_PAUSE=false;let V21_PAUSE_TIME=0;
const v21PauseButton=document.createElement('button');v21PauseButton.id='v21PauseMotion';v21PauseButton.textContent='⏸';v21PauseButton.title='Mettre les animations en pause';holder.querySelector('.iso-tools').appendChild(v21PauseButton);v21PauseButton.addEventListener('click',()=>{V21_MOTION_PAUSE=!V21_MOTION_PAUSE;if(V21_MOTION_PAUSE)V21_PAUSE_TIME=performance.now();v21PauseButton.textContent=V21_MOTION_PAUSE?'▶':'⏸';v21PauseButton.title=V21_MOTION_PAUSE?'Relancer les animations':'Mettre les animations en pause'});
const V21_MOTION_OK=!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;let lastFrame=0,lastStatusTime=-Infinity;function redraw(ts){requestAnimationFrame(redraw);if(document.hidden||ts-lastFrame<29||!isOpen||!api)return;lastFrame=ts;const state=getState(ts);if(state.nav!=='ville'){holder.classList.remove('visible');document.body.classList.remove('iso-live');toggle.style.display='none';return}holder.classList.add('visible');document.body.classList.add('iso-live');toggle.style.display='';if(!V21_MOTION_PAUSE)updateActors(state);
 if(!ctx)return;const visualTs=V21_MOTION_PAUSE?V21_PAUSE_TIME:ts;
 ctx.setTransform(V30_PIXEL_SCALE,0,0,V30_PIXEL_SCALE,0,0);ctx.clearRect(0,0,W,H);v29ClampCamera();
 const backdrop=(state.district===1?scenicDistrict2:scenicBase);
 if(backdrop.complete&&backdrop.naturalWidth){ctx.drawImage(backdrop,0,0,W,H)}else{ctx.fillStyle='#557c58';ctx.fillRect(0,0,W,H)}
 ctx.save();ctx.translate(W/2+panX,H/2+panY);ctx.scale(zoom,zoom);ctx.translate(-W/2,-H/2);if(renderMode==='scenic'){drawLandscape(ctx,state,visualTs)}else{ctx.drawImage(terrain,0,0);v21Atmosphere(ctx,V21_MOTION_OK?visualTs:0,'under');v20Water(ctx,visualTs);v16Breeze(ctx,visualTs);v20DrawVegetation(ctx,visualTs,'back',state);v21GroundDetail(ctx,state,visualTs);drawBuildings(ctx,state,visualTs);v20DrawVegetation(ctx,visualTs,'front',state);v21RoadTraffic(ctx,state,V21_MOTION_OK?visualTs:0);v21CoastLife(ctx,state,V21_MOTION_OK?visualTs:0);v16BuildingsSpecial(ctx,state,visualTs,false);v18RoadsideLife(ctx,state,visualTs,false);if(state.sites.some(b=>b?.type==='hotelville'))v16Flags(ctx,visualTs,state,false);drawActors(ctx,visualTs);v25LocalSparks(ctx,state,visualTs);v21Atmosphere(ctx,ts,'top')}v32AtmosphericLayer(ctx,state,visualTs);v30DrawWeather(ctx,state,visualTs);v25Lighting(ctx,state,visualTs,renderMode==='scenic');v30DrawLivePreview(ctx,state,visualTs);ctx.restore();
 if(ts-lastStatusTime>1100){drawStatus(state,ts);lastStatusTime=ts;}
}
function refreshVisibility(){const active=api.snapshot().nav==='ville';holder.classList.toggle('visible',isOpen&&active);document.body.classList.toggle('iso-live',isOpen&&active);toggle.style.display=active?'':'none';toggle.textContent='◈ VILLE ILLUSTRÉE';toggle.setAttribute('aria-pressed',String(isOpen));const old=document.getElementById('npcLayer');if(old)old.style.visibility=isOpen?'hidden':'';const plots=document.getElementById('plots');if(plots){plots.style.pointerEvents=isOpen?'none':'';plots.style.visibility=isOpen?'hidden':'';}}
renderMode='scenic';canvas.setAttribute('aria-label','Cité romaine illustrée interactive, bâtiments construits et habitants animés');
const v25TimeBtn=holder.querySelector('#isoTimeMode');
const v25TimeLabels={day:'☀ Jour',dusk:'◐ Soir',night:'☾ Nuit',auto:'◷ Cycle'};
v25TimeBtn.addEventListener('click',()=>{const opts=['day','dusk','night','auto'];v25TimePreset=opts[(opts.indexOf(v25TimePreset)+1)%opts.length];v25TimeBtn.textContent=v25TimeLabels[v25TimePreset];v25TimeBtn.setAttribute('aria-pressed',String(v25TimePreset!=='day'));});
const v30FullBtn=holder.querySelector('#v30Fullscreen');
if(v30FullBtn)v30FullBtn.addEventListener('click',()=>{const viewport=document.getElementById('viewport');if(document.fullscreenElement)document.exitFullscreen?.();else viewport?.requestFullscreen?.().catch(()=>{});});
let v30Weather='clear';try{v30Weather=localStorage.getItem('civitas-v30-ambience')||'clear'}catch(e){}
const v30WeatherBtn=holder.querySelector('#v30Weather');
const v30WeatherNames={clear:'☀ Clair',breeze:'♧ Vent',rain:'☂ Pluie'};
function v30SyncWeather(){v30WeatherBtn.textContent=v30WeatherNames[v30Weather]||v30WeatherNames.clear;v30WeatherBtn.setAttribute('aria-label','Ambiance : '+(v30Weather==='rain'?'pluie':v30Weather==='breeze'?'vent':'ciel clair'));}
v30SyncWeather();v30WeatherBtn.addEventListener('click',()=>{const modes=['clear','breeze','rain'];v30Weather=modes[(modes.indexOf(v30Weather)+1)%modes.length];try{localStorage.setItem('civitas-v30-ambience',v30Weather)}catch(e){}v30SyncWeather()});
const v30ImmersionBtn=holder.querySelector('#v30Immersion');
function v30ToggleImmersion(){const next=!document.body.classList.contains('v30-immersive');document.body.classList.toggle('v30-immersive',next);v30ImmersionBtn.setAttribute('aria-pressed',String(next));v30ImmersionBtn.textContent=next?'✕':'◈';v30ImmersionBtn.title=next?'Retrouver les panneaux de gestion':'Agrandir la ville';if(next){v30QuickLast='';v30QuickCollapsed=false;v30QuickPanel.classList.remove('collapsed');v30QuickToggle.textContent='✓ Outils affichés';v30UpdateQuickPanel(api.snapshot());}}
v30ImmersionBtn.addEventListener('click',v30ToggleImmersion);
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.body.classList.contains('v30-immersive')){e.stopPropagation();v30ToggleImmersion();}});
function setOpen(value){isOpen=true;refreshVisibility()}
function v29ClampCamera(){const maxX=(zoom-1)*W*.5,maxY=(zoom-1)*H*.5;panX=Math.max(-maxX,Math.min(maxX,panX));panY=Math.max(-maxY,Math.min(maxY,panY))}
function setZoom(v){zoom=Math.max(1,Math.min(1.65,v));v29ClampCamera()}
holder.querySelectorAll('[data-district]').forEach(b=>b.addEventListener('click',()=>{api.switchDistrict(+b.dataset.district);lastStateAt=0;zoom=1;panX=0;panY=0;}));
const v34Focus=document.createElement('button');v34Focus.type='button';v34Focus.id='v34FocusSite';v34Focus.textContent='Cadrer';v34Focus.title='Cadrer la parcelle sélectionnée';v34Focus.setAttribute('aria-label','Cadrer la parcelle sélectionnée dans la ville');
 holder.appendChild(v34Focus);
 let v34CameraToken=0;
 window.CIVITAS_V34_CAMERA_STATE=()=>({zoom,panX,panY,renderMode});
 v34Focus.addEventListener('click',()=>{
  const state=api.snapshot(),idx=Number(state.selected);if(!Number.isInteger(idx))return;
  const district=state.district||0;if(Math.floor(idx/8)!==district){api.switchDistrict(Math.floor(idx/8));lastStateAt=0}
  const xy=v18ScenicSitePoint(idx,api.snapshot()),newZoom=1.52;
  const tx=-(xy[0]-W/2)*newZoom,ty=-(xy[1]-H/2)*newZoom;
  const beforeZoom=zoom,beforeX=panX,beforeY=panY,start=performance.now(),token=++v34CameraToken;
  const tick=now=>{if(token!==v34CameraToken)return;const t=Math.min(1,(now-start)/560),ease=1-Math.pow(1-t,3);
    zoom=beforeZoom+(newZoom-beforeZoom)*ease;panX=beforeX+(tx-beforeX)*ease;panY=beforeY+(ty-beforeY)*ease;v29ClampCamera();if(t<1)requestAnimationFrame(tick)};
  requestAnimationFrame(tick);
 });
 holder.querySelector('#isoZoomIn').addEventListener('click',()=>setZoom(zoom+.12));holder.querySelector('#isoZoomOut').addEventListener('click',()=>setZoom(zoom-.12));holder.querySelector('#isoZoomReset').addEventListener('click',()=>{zoom=1;panX=0;panY=0});holder.querySelector('#isoRoads').addEventListener('click',e=>{showRoutes=!showRoutes;e.currentTarget.classList.toggle('active',showRoutes);e.currentTarget.textContent='Trajets des habitants '+(showRoutes?'✓':'×')});
canvas.addEventListener('wheel',e=>{e.preventDefault();setZoom(zoom+(e.deltaY>0?-.1:.1))},{passive:false});
function v30Pointer(e){const r=canvas.getBoundingClientRect();return {x:(e.clientX-r.left)*W/r.width,y:(e.clientY-r.top)*H/r.height}}
canvas.addEventListener('pointerdown',e=>{const p=v30Pointer(e);drag={x:p.x,y:p.y,lastX:p.x,lastY:p.y,moved:false};canvas.setPointerCapture(e.pointerId)});
canvas.addEventListener('pointermove',e=>{if(!drag)return;const p=v30Pointer(e),dx=p.x-drag.lastX,dy=p.y-drag.lastY;if(Math.abs(p.x-drag.x)+Math.abs(p.y-drag.y)>6)drag.moved=true;if(drag.moved){panX+=dx;panY+=dy;v29ClampCamera()}drag.lastX=p.x;drag.lastY=p.y});
canvas.addEventListener('pointerup',e=>{if(!drag)return;const moved=drag.moved;drag=null;if(moved)return;const pt=v30Pointer(e),[mx,my]=[pt.x,pt.y];let best=-1,dist=Infinity;sites.forEach(([x,y],i)=>{const [px,py]=fxy(x,y);const r=Math.hypot(mx-px,my-py);if(r<dist){dist=r;best=i}});if(best>=0&&dist<Math.max(40,zoom*58)){api.selectSite(best+(api.snapshot().district||0)*8);lastStateAt=0;drawStatus(api.snapshot(),performance.now())}});
canvas.addEventListener('pointercancel',()=>drag=null);
const hover=holder.querySelector('#isoHover');
canvas.addEventListener('pointermove',e=>{if(drag){hover.classList.remove('visible');return}const rect=canvas.getBoundingClientRect(),mx=(e.clientX-rect.left)*W/rect.width,my=(e.clientY-rect.top)*H/rect.height;
let best=-1,dist=Infinity;sites.forEach(([x,y],i)=>{const [px,py]=fxy(x,y),r=Math.hypot(mx-px,my-py);if(r<dist){dist=r;best=i}});const active=dist<Math.max(39,zoom*53);canvas.style.cursor=active?'pointer':'grab';if(!active){hover.classList.remove('visible');return}const st=getState(performance.now()),building=st.sites[best],job=st.construction?.site===best;hover.textContent=building?`${api.label(building.type)} · Niveau ${building.level}`:job?`Chantier : ${api.label(st.construction.type)}`:best===4?'Terrain de l’Hôtel de ville':`Terrain à bâtir n° ${best+1}`;hover.style.left=Math.min(920,Math.max(15,e.offsetX+16))+'px';hover.style.top=Math.max(57,Math.min(615,e.offsetY-12))+'px';hover.classList.add('visible')});canvas.addEventListener('pointerleave',()=>hover.classList.remove('visible'));

document.addEventListener('keydown',e=>{if((e.key==='v'||e.key==='V')&&!e.target.closest('input,textarea'))setOpen(!isOpen);if(!isOpen)return;if(e.key==='+')setZoom(zoom+.12);if(e.key==='-')setZoom(zoom-.12)});
window.CIVITAS_ISO_DEBUG=()=>({open:isOpen,zoom,panX,panY,actors:actors.map(a=>({name:a.name,role:a.role,pathLength:a.path.length})),canvasReady:!!ctx,tiles:tiles.length,sitePosition:index=>{const [x,y]=sites[index];return fxy(x,y)}});
refreshVisibility();requestAnimationFrame(redraw);
})();

</script>
<script>
(()=>{
 const position=()=>{
  for(const node of document.querySelectorAll('[data-v25-mission]')){
   const a=Number(node.dataset.start),b=Number(node.dataset.end),duration=Math.max(1,b-a);
   const p=Math.max(0,Math.min(1,(Date.now()-a)/duration));
   const x0=Number(node.dataset.x0),x1=Number(node.dataset.x1),y0=Number(node.dataset.y0),y1=Number(node.dataset.y1),cy=Number(node.dataset.curve);
   const x=(1-p)*(1-p)*x0+2*(1-p)*p*(x0+x1)*.5+p*p*x1;
   const y=(1-p)*(1-p)*y0+2*(1-p)*p*cy+p*p*y1;
   node.setAttribute('transform',`translate(${x.toFixed(3)},${y.toFixed(3)})`);
   node.style.opacity=String(.75+.25*Math.sin(performance.now()*.004));
  }
 };
 setInterval(position,100);position();
})();
</script>
<script>
(()=>{
 'use strict';
 const b=document.getElementById('v28ProfileControl'),d=document.getElementById('v28ProfileDialog'),f=document.getElementById('v28ProfileForm'),input=document.getElementById('v28ProfileInput');
 const key='civitas-persona-name';
 const story=document.getElementById('storyOverlay');if(story)document.body.appendChild(story);document.body.appendChild(d);
 function name(){try{return localStorage.getItem(key)||'Lucius Varron'}catch{return 'Lucius Varron'}}
 function show(){d.classList.add('visible');input.value=name();input.focus();input.select()}
 function hide(){d.classList.remove('visible')}
 function refresh(){b.querySelector('.v28-profile-name').textContent=name()}
 b.addEventListener('click',show);document.getElementById('v28ProfileCancel').addEventListener('click',hide);
 d.addEventListener('click',e=>{if(e.target===d)hide()});
 f.addEventListener('submit',e=>{e.preventDefault();const s=input.value.trim().replace(/[<>]/g,'');if(s.length<3||s.length>24){input.setCustomValidity('Choisis entre 3 et 24 caractères.');input.reportValidity();return}input.setCustomValidity('');try{localStorage.setItem(key,s)}catch{}refresh();hide()});
 input.addEventListener('input',()=>input.setCustomValidity(''));
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&d.classList.contains('visible')){e.stopPropagation();hide()}});
 refresh();
})();
</script><script>
(()=>{
'use strict';
const panel=document.getElementById('rightPanel');
const memory={query:'',onlyAffordable:false};
let lastSelectedType=null;
function filterCards(){
 if(!panel)return;
 const input=panel.querySelector('#v30CatalogSearch'),btn=panel.querySelector('#v30Affordable'),rows=[...panel.querySelectorAll('.v4-card[data-v30-type]')];
 if(!input||!rows.length)return;
 if(document.activeElement!==input)input.value=memory.query;
 if(btn)btn.setAttribute('aria-pressed',String(memory.onlyAffordable));
 const q=memory.query.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
 let visible=0,buildable=0;
 for(const r of rows){
   const name=(r.dataset.v30Name||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
   const allowed=!r.querySelector('button[data-build]')?.disabled;
   const match=(!q||name.includes(q))&&(!memory.onlyAffordable||allowed);
   r.hidden=!match;if(match)visible++;if(allowed)buildable++;
 }
 const stat=panel.querySelector('#v30CatalogCount');if(stat)stat.textContent=visible+' bâtiment(s) affiché(s) · '+buildable+' réalisable(s) sur cette parcelle';
}
if(panel){new MutationObserver(()=>filterCards()).observe(panel,{childList:true});filterCards()}
document.addEventListener('input',e=>{if(e.target.id==='v30CatalogSearch'){memory.query=e.target.value;filterCards()}});
document.addEventListener('click',e=>{const b=e.target.closest('#v30Affordable');if(b){memory.onlyAffordable=!memory.onlyAffordable;filterCards()}});
// When the user browses the building catalogue, the actual in-game renderer previews that asset on the selected vacant lot.
// This is a visual hint; construction and resource use still go through the original game mechanics.
document.addEventListener('pointerover',e=>{
 const row=e.target.closest('.v4-card[data-v30-type]');if(row){window.CIVITAS_V30_PREVIEW=row.dataset.v30Type||null}
});
document.addEventListener('pointerout',e=>{
 const row=e.target.closest('.v4-card[data-v30-type]');if(row&&!row.contains(e.relatedTarget))window.CIVITAS_V30_PREVIEW=null;
});
// Visual effects in the main renderer read this public preview value.
})();
</script>
<script>
(()=>{'use strict';
 const game=window.CIVITAS_BRIDGE,root=document.getElementById('isoDistrict'),stage=document.getElementById('stage');
 if(!game||!root)return;
 const toggle=document.createElement('button');toggle.id='v31CouncilToggle';toggle.type='button';toggle.textContent='⚖ Conseil de la cité';toggle.setAttribute('aria-expanded','false');
 const panel=document.createElement('aside');panel.id='v31Council';panel.setAttribute('aria-label','Conseil du gouverneur et main-d’œuvre');
 root.append(toggle);stage.append(panel);
 const fmt=(n)=>new Intl.NumberFormat('fr-FR',{maximumFractionDigits:0}).format(n||0),esc=s=>String(s??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
 const glyph={wood:'🪵',stone:'▤',marble:'⬜',wine:'🍇',gold:'◉'};
 const nice={wood:'Bois',stone:'Pierre',marble:'Marbre',wine:'Vin',gold:'Or'};
 let open=false,last='';
 function render(){
  if(!open)return;
  if(game.snapshot().nav!=='ville'){show(false);return;}
  const c=game.cityReport();if(!c)return;
  const sig=JSON.stringify([c.city,c.stocks,c.rates,c.workers,c.assigned,c.suggested,c.happiness,c.construction,c.buildings]);
  if(sig===last)return;last=sig;
  const percent=Math.min(100,Math.round(c.pop/Math.max(1,c.popLimit)*100));
  const rates=Object.entries(c.stocks).map(([key,value])=>`<div class="v31-resource"><span>${glyph[key]||'•'} ${nice[key]||esc(key)}</span><span><b>${fmt(value)}</b> <span class="${c.rates[key]>=0?'v31-positive':'v31-negative'}">${c.rates[key]>=0?'+':''}${fmt(c.rates[key])}/h</span></span></div>`).join('');
  const rec=c.suggested,missing=Object.entries(rec.missing).map(([k,v])=>`${fmt(v)} ${nice[k]||k}`).join(', ');
  const estimate=Object.keys(rec.missing).length?rec.waitHours===null?'Production manquante : bâtiment producteur nécessaire':`Ressources disponibles dans environ ${Math.ceil(rec.waitHours)} h de jeu`:'Matériaux disponibles';
  const warnings=c.outstanding.map(x=>`<div class="v31-warn">${esc(x.message)}</div>`).join('')||'<div class="v31-ok">Toutes les filières actives sont suivies.</div>';
  const originalScroll=panel.scrollTop;
  panel.innerHTML=`<div class="v31-head"><span>Conseil du gouverneur</span><button id="v31CouncilClose" aria-label="Fermer le conseil">×</button></div>
   <div class="v31-section"><h3>Prochaine priorité</h3><b>${esc(rec.name)}</b><p>${esc(estimate)}${missing?` · Manque : ${esc(missing)}`:''}</p><button id="v31Recommend" data-v31-focus="${esc(rec.type)}">Sélectionner un terrain pour ${esc(rec.name)}</button></div>
   <div class="v31-section"><h3>${esc(c.city)}</h3><div class="v31-numbers"><div class="v31-stat"><b>${c.buildings}/${c.sites}</b><small>Édifices / parcelles</small></div><div class="v31-stat"><b>${fmt(c.pop)}/${fmt(c.popLimit)}</b><small>Habitants · ${percent} % de capacité</small></div><div class="v31-stat"><b>${c.free}</b><small>Travailleurs libres</small></div><div class="v31-stat"><b>${Math.round(c.happiness)} %</b><small>Satisfaction</small></div></div></div>
   <div class="v31-section"><h3>Réserves et rendements réels</h3>${rates}<small>Stockage : ${fmt(c.maxStock)} par ressource</small></div>
   <div class="v31-section"><h3>Organiser la main-d’œuvre</h3><p>${c.assigned}/${c.workers} citoyens mobilisés dans la ville et les exploitations communes. La nouvelle répartition concerne les ateliers de la ville.</p><div class="v31-actions"><button data-v31-staff="balanced">Équilibrer</button><button data-v31-staff="wood">Priorité bois</button><button data-v31-staff="stone">Priorité pierre</button><button data-v31-staff="clear">Libérer les ateliers</button></div></div>
   <div class="v31-section"><h3>Points de vigilance</h3>${warnings}</div>`;
  panel.scrollTop=originalScroll;
 }
 function show(next){open=next;document.body.classList.toggle('v31-council-open',open);panel.classList.toggle('open',open);toggle.setAttribute('aria-expanded',String(open));toggle.textContent=open?'✕ Fermer le conseil':'⚖ Conseil de la cité';last='';render()}
 toggle.addEventListener('click',()=>show(!open));
 panel.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.id==='v31CouncilClose'){show(false);return}if(b.dataset.v31Staff){game.distributeWorkers(b.dataset.v31Staff);last='';render();return}if(b.dataset.v31Focus){game.focusBuilding(b.dataset.v31Focus);show(false)}});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&open)show(false)});
 window.CIVITAS_V31_DIAGNOSTIC=()=>({open,city:game.cityReport(),sceneVisible:root.classList.contains('visible')});
 setInterval(()=>{if(open&&!document.hidden)render()},1600);
})();
</script>


<script>
(()=>{'use strict';
 const bridge=window.CIVITAS_BRIDGE,root=document.getElementById('isoDistrict');if(!bridge||!root||!bridge.campaign)return;
 const button=document.createElement('button');button.id='c33CampaignToggle';button.type='button';button.textContent='⚜ Campagne';button.title='Six chapitres, récompenses et victoire de la campagne solo';
 const dialog=document.createElement('section');dialog.id='c33CampaignOverlay';dialog.setAttribute('role','dialog');dialog.setAttribute('aria-modal','true');dialog.setAttribute('aria-label','Campagne CIVITAS');
 root.append(button,dialog);let isOpen=false,lastSignature='';
 const esc=s=>String(s??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
 function paint(){if(!isOpen)return;
  const st=bridge.campaign();const sig=JSON.stringify(st);if(sig===lastSignature)return;lastSignature=sig;
  let content='';
  if(st.victory)content=`<section class="c33-victory"><h3>SPQR · Ton Imperium est reconnu</h3><p>Les familles du Latium ont désormais une cité, des institutions, des routes commerciales et des colonies alliées.</p><strong>Victoire de la campagne solo</strong><p>Tu peux poursuivre la partie librement, construire et conquérir d’autres provinces.</p></section>`;
  content+=`<div class="c33-grid">${st.chapters.map(ch=>{
    const lock=ch.index>0&&!st.chapters[ch.index-1].completed&&!ch.completed;
    return `<article class="c33-chapter ${ch.completed?'completed':''} ${lock?'locked':''}"><h3>${esc(ch.title)}</h3><p>${esc(ch.subtitle)}</p><ul>${ch.steps.map(x=>`<li class="${x.done?'done':''}"><span>${x.done?'✓':'○'}</span><span>${esc(x.text)}</span></li>`).join('')}</ul>${ch.completed?'<footer>✓ Chapitre achevé · récompense attribuée</footer>':`<button data-c33-route="${esc(ch.steps.find(x=>!x.done)?.target||'ville')}">Voir l’objectif dans le jeu</button><footer>Récompense : ${Object.entries(ch.reward).map(([k,v])=>`${esc(({wood:'bois',stone:'pierre',marble:'marbre',wine:'vin',gold:'or'})[k]||k)} +${v}`).join(' · ')}</footer>`}</article>`}).join('')}</div>`;
  const focus=document.activeElement===dialog?true:false;
  dialog.innerHTML=`<div class="c33-paper"><div class="c33-top"><div><h2>Les six livres de Rome</h2><p>Campagne solo · ${esc(st.city)} · les objectifs utilisent les véritables données de ta partie</p></div><button type="button" id="c33Close">✕ Retour au jeu</button></div><div class="c33-progress"><i style="width:${st.progress}%"></i></div><p class="c33-state"><b>${st.complete}/${st.total} chapitres</b> achevés · ${st.victory?'Campagne terminée, partie libre accessible':'Construis, cherche, commerce et défends tes colonies pour progresser.'}</p>${content}</div>`;
 }
 function show(next){isOpen=!!next;dialog.classList.toggle('open',isOpen);button.setAttribute('aria-expanded',String(isOpen));lastSignature='';if(isOpen)paint()}
 button.addEventListener('click',()=>show(!isOpen));
 dialog.addEventListener('click',e=>{
  if(e.target.closest('#c33Close')){show(false);return}
  const target=e.target.closest('[data-c33-route]');if(!target)return;
  const x=target.dataset.c33Route;show(false);
  const buildings=['hotelville','scierie','logement','entrepot','marche','senatbat','academie','caserne'];
  if(buildings.includes(x)){bridge.navigate('ville');bridge.focusBuilding?.(x)}
  else bridge.navigate(x==='carte'?'carte':x);
 });
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&isOpen)show(false)});
 const observer=new MutationObserver(()=>{if(isOpen&&bridge.snapshot().nav!=='ville')show(false)});
 observer.observe(root,{attributes:true,attributeFilter:['class']});
 setInterval(()=>{if(isOpen)paint()},1800);
 window.CIVITAS_CAMPAIGN_UI={open:()=>show(true),close:()=>show(false)};
})();
</script>


<script>
(()=>{
 'use strict';
 const plate=document.createElement('section');plate.id='v34GovernorPlate';plate.setAttribute('aria-label','Portrait du gouverneur');
 plate.innerHTML='<img id="v34GovernorPortrait" alt="Portrait du gouverneur"><span class="v34-caption">GOUVERNEUR DE ROME</span><span class="v34-laurel" aria-hidden="true">❧</span>';
 const stage=document.querySelector('#stage'),profile=stage?.querySelector('#v28ProfileControl');
 if(stage&&profile){stage.insertBefore(plate,profile)}
 const oldQuestCover=document.createElement('div');oldQuestCover.id='v34LeftFooter';oldQuestCover.setAttribute('aria-hidden','true');
 oldQuestCover.innerHTML='<span>✧</span><strong>SPQR</strong><span class="v34-divider"></span><span>ROMA<br>ETERNA</span>';
 stage.appendChild(oldQuestCover);
 const avatar=plate.querySelector('img');const defaultAvatar='data:image/jpeg;base64,';
 const storageKey='civitas-v34-portrait';
 const getAvatar=()=>{try{return localStorage.getItem(storageKey)||defaultAvatar}catch{return defaultAvatar}};
 const setAvatar=src=>{avatar.src=src;const preview=document.getElementById('v34GovernorPreview');if(preview)preview.src=src};
 setAvatar(getAvatar());
 const dialog=document.getElementById('v28ProfileDialog'),form=document.getElementById('v28ProfileForm');
 if(!dialog||!form)return;
 const block=document.createElement('div');block.className='v34-portrait-settings';
 block.innerHTML='<img id="v34GovernorPreview" alt="Aperçu du portrait"><div><label for="v34PortraitFile">Portrait du gouverneur</label><input id="v34PortraitFile" type="file" accept="image/png,image/jpeg,image/webp"><small>Image personnelle enregistrée sur cet appareil, sans envoi sur un serveur. JPG, PNG ou WebP, 3 Mo maximum.</small><button type="button" id="v34RestorePortrait" class="secondary">Portrait romain par défaut</button></div>';
 const actions=form.querySelector('.v28-profile-actions');if(actions)form.insertBefore(block,actions);else form.append(block);
 block.querySelector('#v34GovernorPreview').src=avatar.src;
 block.querySelector('#v34RestorePortrait').addEventListener('click',()=>{try{localStorage.removeItem(storageKey)}catch{}setAvatar(defaultAvatar)});
 block.querySelector('#v34PortraitFile').addEventListener('change',async e=>{
  const file=e.currentTarget.files?.[0];if(!file)return;
  if(!/^image\/(png|jpeg|webp)$/.test(file.type)||file.size>3_000_000){alert('Choisis une image PNG, JPG ou WebP de moins de 3 Mo.');e.currentTarget.value='';return}
  try{
   const url=URL.createObjectURL(file);
   const img=new Image();await new Promise((resolve,reject)=>{img.onload=resolve;img.onerror=reject;img.src=url});
   const canvas=document.createElement('canvas');canvas.width=256;canvas.height=256;
   const ctx=canvas.getContext('2d');const size=Math.min(img.width,img.height);
   ctx.drawImage(img,(img.width-size)/2,(img.height-size)/2,size,size,0,0,256,256);
   const data=canvas.toDataURL('image/jpeg',.84);
   URL.revokeObjectURL(url);localStorage.setItem(storageKey,data);setAvatar(data);
  }catch(err){alert('Impossible d’utiliser ce portrait sur cet appareil.');}
 });
 // Expose safe read-only visual diagnostics for in-game testing.
 window.CIVITAS_V34_VISUAL=()=>({portraitLoaded:!!avatar.complete&&avatar.naturalWidth>0,profileVisible:!!profile&&getComputedStyle(profile).display!=='none',clockVisible:!!document.getElementById('clockLabel')&&getComputedStyle(document.getElementById('clockLabel')).display!=='none',customPortrait:avatar.src!==defaultAvatar});
})();
</script>

<script id="v35-hud-native">
(()=>{
 'use strict';
 const stage=document.getElementById('stage');
 const avatar=document.getElementById('v34GovernorPortrait');
 if(stage&&avatar){stage.appendChild(avatar)}
 const plate=document.getElementById('v34GovernorPlate');if(plate)plate.remove();
 document.getElementById('v34LeftFooter')?.remove();
 const button=document.getElementById('v28ProfileControl');
 if(button){button.setAttribute('title','Modifier le nom et le portrait du gouverneur');}
 // Native-frame diagnostics: no second painted rectangle survives above the skin.
 window.CIVITAS_V35_HUD=()=>({avatarParent:avatar?.parentElement?.id,legacyPlate:!!document.getElementById('v34GovernorPlate'),legacyFooter:!!document.getElementById('v34LeftFooter'),clockStyle:getComputedStyle(document.getElementById('clockLabel')).backgroundColor,sceneBorder:getComputedStyle(document.getElementById('isoDistrict')).borderTopWidth});
})();
</script>
<script>
(()=>{const iso=document.getElementById('isoDistrict');if(!iso)return;
 const btn=document.createElement('button');btn.id='v40QuestButton';btn.type='button';
 btn.textContent='⚜ Quêtes';btn.setAttribute('aria-expanded','false');btn.setAttribute('aria-controls','v40QuestPanel');
 const panel=document.createElement('section');panel.id='v40QuestPanel';panel.setAttribute('aria-label','Quêtes de la cité');
 const refresh=()=>{const old=document.getElementById('questList');const source=old?.querySelectorAll('button[data-quest]')||[];
  panel.innerHTML='<h3>Quêtes de la cité</h3>'+(source.length?Array.from(source).map(el=>
   '<button type="button" data-quest="'+el.dataset.quest+'">'+el.textContent.replaceAll('<','&lt;')+'</button>').join('')
   :'<p>Les objectifs de la colonie apparaîtront ici.</p>');};
 btn.addEventListener('click',()=>{const open=!panel.classList.contains('open');
   if(open)refresh();panel.classList.toggle('open',open);btn.setAttribute('aria-expanded',String(open));});
 panel.addEventListener('click',e=>{const a=e.target.closest('button[data-quest]');if(!a)return;
   const old=[...document.querySelectorAll('#questList button[data-quest]')].find(b=>b.dataset.quest===a.dataset.quest);
   if(old){old.click();refresh();}});
 iso.append(btn,panel);
})();
</script></body></html>
