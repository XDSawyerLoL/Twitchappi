<script>
(()=>{'use strict';
const BUILD={
 hotelville:{name:'Hôtel de ville',desc:'Premier édifice de la colonie. Centre civique, impôts, habitants et progression urbaine.',icon:'🏛',sprite:'forum',cost:{wood:80,stone:45,gold:15},seconds:12,rate:{gold:24},influence:2},
