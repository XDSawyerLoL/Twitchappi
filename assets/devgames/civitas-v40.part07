<script>
// V18 migration copies the previous save; never modifies V17 content.
try{const next='civitas-roman-v24',prev='civitas-roman-v22';if(!localStorage.getItem(next)&&localStorage.getItem(prev))localStorage.setItem(next,localStorage.getItem(prev));}catch(e){}
