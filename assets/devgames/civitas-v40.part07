const money=n=>Math.floor(n).toLocaleString('fr-FR');const formatSec=n=>{n=Math.max(0,Math.ceil(n));return `${Math.floor(n/3600)?`${Math.floor(n/3600)} h `:''}${Math.floor(n%3600/60)?`${Math.floor(n%3600/60)} min `:''}${n%60}s`};const now=()=>Date.now();
const $=id=>document.getElementById(id);
const fresh=()=>({v:8,city:'Colonia Julia',coords:'425:317',res:{wood:160,stone:110,marble:0,wine:0,gold:35},pop:36,happiness:62,influence:2,legions:0,nav:'ville',selected:HALL_SITE,district:0,selectedBuild:null,sites:Array(16).fill(null),construction:null,recruit:null,expedition:null,provinces:['latium'],cooldown:{},log:[{t:now(),txt:'Quelques tentes sur une côte du Latium. La première mission : fonder un Hôtel de ville.'}],quests:[],stats:{woodMade:0,trades:0,recruited:0,voyages:0},speed:10,last:now(),start:now(),tech:0,workers:{},science:0,researches:{},pendingEvent:null,eventAt:now()+240000,queue:[],voyage:null,panelFilter:'tous',panelMode:'catalog',provinceMode:'province',sharedWorkers:{wood:0,stone:0},localSelected:'player',localStates:{},localMission:null,tutorialVisitedLocale:false,tutorialInspectedNeighbor:false,tutorialVisitedWorld:false});
const SAVE_KEY='civitas-roman-v35';
try{if(!localStorage.getItem(SAVE_KEY)){const previous=localStorage.getItem('civitas-roman-v34')||localStorage.getItem('civitas-roman-v33')||localStorage.getItem('civitas-roman-v32')||localStorage.getItem('civitas-roman-v31')||localStorage.getItem('civitas-roman-v30')||localStorage.getItem('civitas-roman-v29')||localStorage.getItem('civitas-roman-v28')||localStorage.getItem('civitas-roman-v27')||localStorage.getItem('civitas-roman-v26')||localStorage.getItem('civitas-roman-v25')||localStorage.getItem('civitas-roman-v24');if(previous)localStorage.setItem(SAVE_KEY,previous)}}catch(e){}
function migrateV7(st){
 if(!st||!Array.isArray(st.sites)||![8,16].includes(st.sites.length)||!st.res)return fresh();if(st.sites.length===8)st.sites=st.sites.concat(Array(8).fill(null));
 if([7,8,9,10,11,12].includes(st.v))return st;
 st.v=7; st.localSelected='player';st.localMission=null;st.localStates={};st.tutorialVisitedLocale=false;st.tutorialInspectedNeighbor=false;st.tutorialVisitedWorld=false;
 const moveWorkers=(from,to)=>{if(st.workers?.[from]!=null){st.workers[to]=st.workers[from];delete st.workers[from];}};
 // A former decorative civic icon is never considered a constructed building.
 delete st.core;delete st.selectedCivic;
 const legacyHall=st.sites.findIndex(b=>b?.type==='forum'||b?.type==='hotelville');
 if(legacyHall>=0){
  const old=st.sites[HALL_SITE];const main=st.sites[legacyHall];
  if(legacyHall!==HALL_SITE&&old){const vacant=st.sites.findIndex((b,i)=>i!==HALL_SITE&&i!==legacyHall&&!b);if(vacant>=0){st.sites[vacant]=old;moveWorkers(HALL_SITE,vacant)}else{st.sites[legacyHall]=old;moveWorkers(HALL_SITE,legacyHall)}}
  else if(legacyHall!==HALL_SITE)st.sites[legacyHall]=null;
  st.sites[HALL_SITE]={type:'hotelville',level:Math.max(1,main.level||1)};
  st.quests=Array.from(new Set([...(st.quests||[]),'hall']));
 }else if(st.sites[HALL_SITE]){
  const vacant=st.sites.findIndex((b,i)=>i!==HALL_SITE&&!b);
  if(vacant>=0){st.sites[vacant]=st.sites[HALL_SITE];st.sites[HALL_SITE]=null;moveWorkers(HALL_SITE,vacant);}
  // If all old slots are occupied, retain the legacy building and ask for a free slot.
 }
 // If construction overlaps the new central slot, reassign to a vacant slot when possible.
 if(st.construction?.site===HALL_SITE&&st.construction.type!=='hotelville'){
  const vacant=st.sites.findIndex((b,i)=>i!==HALL_SITE&&!b&&!st.queue?.some(q=>q.site===i));
  if(vacant>=0)st.construction.site=vacant;
 }
 return st;
}
let needsRedraw=false;let game;
try{const existing=localStorage.getItem(SAVE_KEY);const fromPrevious=localStorage.getItem('civitas-roman-v32')||localStorage.getItem('civitas-roman-v31')||localStorage.getItem('civitas-roman-v30')||localStorage.getItem('civitas-roman-v29')||localStorage.getItem('civitas-roman-v28')||localStorage.getItem('civitas-roman-v27')||localStorage.getItem('civitas-roman-v24')||localStorage.getItem('civitas-roman-v22')||localStorage.getItem('civitas-roman-v20')||localStorage.getItem('civitas-roman-v19')||localStorage.getItem('civitas-roman-v18')||localStorage.getItem('civitas-roman-v17')||localStorage.getItem('civitas-roman-v16')||localStorage.getItem('civitas-roman-v15')||localStorage.getItem('civitas-roman-v14')||localStorage.getItem('civitas-roman-v25')||localStorage.getItem('civitas-roman-v24')||localStorage.getItem('civitas-roman-v14')||localStorage.getItem('civitas-roman-v13')||localStorage.getItem('civitas-roman-v12')||localStorage.getItem('civitas-roman-v11')||localStorage.getItem('civitas-roman-v10')||localStorage.getItem('civitas-roman-v9')||localStorage.getItem('civitas-roman-v8')||localStorage.getItem('civitas-roman-v7')||localStorage.getItem('civitas-roman-v6')||localStorage.getItem('civitas-roman-v5');game=migrateV7(JSON.parse(existing||fromPrevious||'null'));if(!existing&&fromPrevious)localStorage.setItem(SAVE_KEY,JSON.stringify(game));}catch{game=fresh()}
game.workers=game.workers||{};game.units=game.units||{velites:0,equites:0};game.formation=game.formation||'acies';game.battleReports=game.battleReports||[];game.incomingRaid=game.incomingRaid||null;game.sharedWorkers=game.sharedWorkers||{wood:0,stone:0};game.localStates=game.localStates||{};game.battleReports=game.battleReports||[];game.incomingRaid=game.incomingRaid||null;game.science=game.science||0;game.researches=game.researches||{};game.pendingEvent=game.pendingEvent||null;game.eventAt=game.eventAt||now()+240000;game.queue=Array.isArray(game.queue)?game.queue.slice(0,2):[];game.voyage=game.voyage||null;game.panelFilter=game.panelFilter||'tous';game.panelMode=game.panelMode||'catalog';game.provinceMode=game.provinceMode||'province';game.stats=game.stats||{woodMade:0,trades:0,recruited:0};game.stats.voyages=game.stats.voyages||0;game.localSelected=game.localSelected||'player';game.localStates=game.localStates||{};game.localMission=game.localMission||null;game.reliefAt=game.reliefAt||0;game.reliefCount=game.reliefCount||0;game.district=Number(game.district)||0;game.sites=Array.isArray(game.sites)?game.sites.concat(Array(Math.max(0,16-game.sites.length)).fill(null)):Array(16).fill(null);

const CITY_FIELDS=['units','formation','sharedWorkers','city','coords','res','pop','happiness','legions','selected','selectedBuild','district','sites','construction','recruit','expedition','queue','voyage','workers','science','last','start','log','quests','stats','pendingEvent','eventAt','cooldown','panelMode','panelFilter','provinceMode','reliefAt','reliefCount','tech'];
const cloneCity=o=>JSON.parse(JSON.stringify(o===undefined?null:o));
function snapshotCity(){const c={};for(const key of CITY_FIELDS)c[key]=cloneCity(game[key]);return c}
function initCities(){game.v=12;game.activeCity=game.activeCity||'player';game.cities=game.cities||{};game.cities[game.activeCity]=snapshotCity();game.colonizing=game.colonizing||null;game.convoy=game.convoy||null}
function syncCity(){if(game.cities)game.cities[game.activeCity]=snapshotCity()}
function cityInfo(id){return id===game.activeCity?snapshotCity():game.cities?.[id]||null}
function cityName(id){return cityInfo(id)?.city||id}
function switchCity(id){if(!game.cities[id])return notify('Cette colonie n’est pas fondée.');update();syncCity();const c=cloneCity(game.cities[id]);for(const k of CITY_FIELDS)game[k]=cloneCity(c[k]);game.units=game.units||{velites:0,equites:0};game.formation=game.formation||'acies';game.sharedWorkers=game.sharedWorkers||{wood:0,stone:0};game.activeCity=id;game.localSelected=id;game.nav='ville';game.sites=Array.isArray(game.sites)?game.sites.concat(Array(Math.max(0,16-game.sites.length)).fill(null)):Array(16).fill(null);game.district=Number(game.district)||0;game.nav='ville';game.selected=Number.isInteger(game.selected)?game.selected:HALL_SITE;game.panelMode=game.sites[game.selected]?'details':'catalog';update();save();render();notify('Ville administrée : '+game.city)}
const COLONIZE_COST={wood:260,stone:190,wine:25,gold:180};
function canColonize(id){return (id==='vacant1'||id==='vacant2')&&!game.cities[id]&&!game.colonizing&&hallLevel()>=2&&hasBuilding('port')&&game.pop>=55&&affordable(COLONIZE_COST)}
function colonize(id){if(id!=='vacant1'&&id!=='vacant2')return;if(game.cities[id])return notify('Ce terrain est occupé.');if(game.colonizing)return notify('Une expédition est déjà partie.');if(hallLevel()<2)return notify('Hôtel de ville niveau 2 requis.');if(!hasBuilding('port'))return notify('Port requis.');if(game.pop<55)return notify('Il faut au moins 55 habitants.');update();if(!pay(COLONIZE_COST))return notify('Ressources insuffisantes.');game.pop-=10;game.colonizing={target:id,origin:game.activeCity,start:now(),end:now()+90000};log('Un navire quitte la cité pour fonder une colonie.');save();render();notify('Colons partis · 90 secondes')}
function finishColonization(t){const m=game.colonizing;if(!m||t<m.end)return false;if(!game.cities[m.target]){const c=snapshotCity();c.city=m.target==='vacant1'?'Nova Sabina':'Portus Tiberis';c.coords=m.target==='vacant1'?'423:313':'428:322';c.res={wood:160,stone:110,marble:0,wine:0,gold:35};c.pop=26;c.happiness=67;c.legions=0;c.units={velites:0,equites:0};c.formation='acies';c.selected=HALL_SITE;c.selectedBuild=null;c.sites=Array(16).fill(null);c.construction=null;c.queue=[];c.recruit=null;c.expedition=null;c.voyage=null;c.workers={};c.sharedWorkers={wood:0,stone:0};c.science=0;c.last=t;c.start=t;c.log=[{t,txt:'Les colons débarquent. Construis un Hôtel de ville.'}];c.quests=[];c.stats={woodMade:0,trades:0,recruited:0,voyages:0};c.pendingEvent=null;c.eventAt=t+240000;c.cooldown={};c.panelMode='catalog';c.reliefAt=0;c.reliefCount=0;game.cities[m.target]=c;game.influence+=8;log('Nouvelle colonie fondée : '+c.city);notify('Nouvelle colonie : '+c.city)}game.colonizing=null;return true}
function sendConvoy(id,resource,amount){if(!game.cities[id]||id===game.activeCity)return notify('Choisis une autre colonie.');if(!['wood','stone','marble','wine','gold'].includes(resource)||![50,100].includes(amount))return;if(!hasBuilding('port'))return notify('Port requis pour expédier.');if(game.convoy)return notify('Un convoi est déjà en mer.');update();const fee=12;if(game.res[resource]<amount||game.res.gold<fee+(resource==='gold'?amount:0))return notify('Réserves insuffisantes.');game.res[resource]-=amount;game.res.gold-=fee;game.convoy={from:game.activeCity,to:id,resource,amount,start:now(),end:now()+45000};log(`Convoi vers ${cityName(id)} : ${amount} ${META[resource].name}.`);save();render();notify('Convoi parti · 45 secondes')}
function finishConvoy(t){const m=game.convoy;if(!m||t<m.end)return false;const dest=m.to===game.activeCity?game:game.cities[m.to];if(dest){const capacityDest=500+(dest.sites||[]).filter(b=>b?.type==='entrepot').reduce((n,b)=>n+600*b.level,0);const n=Math.min(m.amount,Math.max(0,capacityDest-(dest.res[m.resource]||0)));dest.res[m.resource]=(dest.res[m.resource]||0)+n;const msg=`${dest.city} reçoit ${n} ${META[m.resource].name}.`;dest.log=dest.log||[];dest.log.unshift({t,txt:msg});log(msg);notify(msg)}game.convoy=null;return true}
function coloniesMenu(){const box=$('cityNav');if(!box)return;box.innerHTML=`<button data-nav="locale">⌂ Province</button><button data-nav="empire">⚜ Cités (${Object.keys(game.cities||{}).length})</button><span>${esc(game.city)}</span>`}
initCities();
try{localStorage.setItem(SAVE_KEY,JSON.stringify(game))}catch{}

let toastTimeout=null,tickCount=0,provinceSelected='corsica';
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function save(){try{syncCity();localStorage.setItem(SAVE_KEY,JSON.stringify(game))}catch(e){console.warn('Sauvegarde indisponible',e)}}
function log(message){game.log.unshift({t:now(),txt:message});game.log=game.log.slice(0,80);if(game.nav==='messages')showOverlay('messages')}
function notify(message){const el=$('toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>el.classList.remove('show'),3400)}
function hasHall(){return game.sites[HALL_SITE]?.type==='hotelville'&&game.sites[HALL_SITE].level>=1}
function hallLevel(){return hasHall()?game.sites[HALL_SITE].level:0}
function hasSenate(){return hasBuilding('senatbat')}
function buildings(type){return game.sites.filter(b=>b&&b.level>0&&(!type||b.type===type))}
function hasBuilding(type){return buildings(type).length>0}
function capacity(){return 500+buildings('entrepot').reduce((sum,b)=>sum+b.level*600,0)}
function popCap(){return 40+Math.max(0,hallLevel()-1)*10+buildings('logement').reduce((sum,b)=>sum+b.level*35,0)}
const WORK_TYPES={scierie:['wood',22],carriere:['stone',19],marbre:['marble',12],cave:['wine',16]};
function jobsCapacity(site){const b=game.sites[site];return b&&WORK_TYPES[b.type]?4+b.level*4:0}
function workforce(){return Math.max(0,Math.floor(game.pop*.58))}
function occupied(){return Object.values(game.workers||{}).reduce((sum,v)=>sum+(+v||0),0)+Object.values(game.sharedWorkers||{}).reduce((sum,v)=>sum+(+v||0),0)}
const COMMON_SITES={wood:{name:'Forêt du Latium',description:'Les citoyens coupent le bois des forêts communes. Chaque ouvrier reçoit une part de la production.',icon:'🌲',perWorker:16,x:43,y:70},stone:{name:'Carrière des collines',description:'L’exploitation collective extrait de la pierre pour tous les colons participants.',icon:'⛏',perWorker:13,x:13,y:51}};
const COMMON_MAX=12;
function commonTotal(type){return Object.values(game.cities||{}).reduce((sum,c)=>sum+(c?.sharedWorkers?.[type]||0),0)+(game.cities?.[game.activeCity]?0:game.sharedWorkers?.[type]||0)}
function setCommonWorkers(type,delta){if(!COMMON_SITES[type]||!hasHall())return notify('Fonde l’Hôtel de ville pour exploiter les terres communes.');
 update();let old=Math.max(0,game.sharedWorkers?.[type]||0);const used=Object.entries(game.cities||{}).reduce((sum,[id,c])=>sum+(id===game.activeCity?0:c?.sharedWorkers?.[type]||0),0);const next=Math.max(0,Math.min(COMMON_MAX-used,old+delta));if(next>old&&availableWorkers()<next-old)return notify('Tous les travailleurs sont déjà affectés.');game.sharedWorkers[type]=next;log(`Exploitation commune : ${next} ouvriers à ${COMMON_SITES[type].name}.`);save();render();}
const REGION_BONUS={player:{wood:1,stone:1,gold:1,description:'Côte fondatrice du Latium · territoire équilibré'},vacant1:{wood:1.18,stone:1,gold:1,description:'Nova Sabina · collines forestières · bois +18 %'},vacant2:{wood:1,stone:1.12,gold:1.12,description:'Portus Tiberis · estuaire marchand · pierre et or +12 %'}};
function regionBonus(){return REGION_BONUS[game.activeCity]||REGION_BONUS.player;}

function availableWorkers(){return Math.max(0,workforce()-occupied())}
function production(){
 const r={wood:0,stone:0,marble:0,wine:0,gold:(hasHall()?Math.max(4,(Math.floor(game.pop)-occupied())*.43):0)};
 game.sites.forEach((b,i)=>{if(!b||b.level<1)return;
  if(WORK_TYPES[b.type]){const [res,perWorker]=WORK_TYPES[b.type];const n=Math.min(jobsCapacity(i),Math.max(0,+game.workers[i]||0));r[res]+=n*perWorker*(1+.15*(b.level-1));}
  if(b.type==='forum')r.gold+=23*b.level;if(b.type==='hotelville')r.gold+=14*b.level;
 });
 if(hasHall()){r.wood+=(game.sharedWorkers?.wood||0)*COMMON_SITES.wood.perWorker;r.stone+=(game.sharedWorkers?.stone||0)*COMMON_SITES.stone.perWorker;}
 for(const p of PLACES){if(!game.provinces.includes(p.id))continue;for(const [key,val]of Object.entries(p.bonus))r[key]+=val}
 const effect=(.58+Math.max(0,game.happiness)*.0042)*(game.researches?.economy?1.14:1);
 for(const k of RES)r[k]*=effect*(regionBonus()[k]||1);
 r.gold-=game.legions*.55+(game.units?.velites||0)*.27+(game.units?.equites||0)*1.1; // maintenance of the active standing army
 return r;
}
function setWorkers(site,delta){const cap=jobsCapacity(site);if(!cap)return notify('Ce bâtiment ne nécessite pas d’ouvriers.');const old=Math.max(0,+(game.workers[site]||0));const next=Math.max(0,Math.min(cap,old+delta));if(next>old&&availableWorkers()<next-old)return notify('Pas assez de citoyens disponibles.');update();game.workers[site]=next;log(`Main-d’œuvre : ${next}/${cap} ouvriers affectés à ${BUILD[game.sites[site].type].name}.`);const wq=QUESTS.find(q=>q.id==='workers');if(wq&&!game.quests.includes('workers')&&wq.check(game)>=wq.goal){game.quests.push('workers');grant(wq.reward);log('Le Sénat récompense la mobilisation des premiers ouvriers.');}save();render();}

function affordable(cost){return Object.entries(cost).every(([k,v])=>game.res[k]>=v)}
function pay(cost){if(!affordable(cost))return false;for(const [k,v] of Object.entries(cost))game.res[k]-=v;return true}
function grant(rewards){for(const[k,v]of Object.entries(rewards||{}))game.res[k]=Math.min(capacity(),game.res[k]+v)}
function costFor(type,level){const c=BUILD[type].cost;return Object.fromEntries(Object.entries(c).map(([k,v])=>[k,Math.ceil(v*Math.pow(1.65,level-1))]))}
function timeFor(type,level){return Math.max(8,Math.round(BUILD[type].seconds*(1+level*0.6)*(game.researches?.construction ? 0.82 : 1)))}
const TECHS=[{id:'economy',name:'Arpentage',desc:'Rendement de toutes les productions +14 %.',cost:35,icon:'⚒'},{id:'construction',name:'Génie romain',desc:'Chantiers 18 % plus rapides.',cost:55,icon:'🏗'},{id:'civic',name:'Droit civil',desc:'Satisfaction +8 % et influence +3.',cost:70,icon:'⚖'},{id:'naval',name:'Navigation avancée',desc:'Expéditions navales 20 % plus rapides.',cost:95,icon:'⛵'}];
const EVENTS=[
 {id:'merchant',title:'Une caravane marchande',text:'Une caravane arrive à la colonie. Ses négociants demandent l’autorisation d’établir un comptoir temporaire.',choices:[['Acheter les denrées',{gold:-20,stone:60,happiness:2}],['Prélever une taxe',{gold:50,happiness:-4}]]},
 {id:'rain',title:'Pluies sur les chemins',text:'De fortes pluies menacent les routes de la colonie. Faut-il déployer les ouvriers ou laisser la nature faire ?',choices:[['Réparer les routes',{wood:-35,happiness:5}],['Attendre la décrue',{happiness:-5}]]},
 {id:'veterans',title:'Les vétérans du Latium',text:'Des vétérans demandent à s’installer et à transmettre leur savoir aux jeunes de la cité.',choices:[['Les accueillir',{pop:5,gold:-25,influence:2}],['Leur verser une prime',{gold:-15,happiness:4}]]}
];
function research(id){const t=TECHS.find(t=>t.id===id);if(!t||game.researches[id])return;if(!hasBuilding('academie'))return notify('Construisez une académie pour étudier.');if(game.science<t.cost)return notify('Points de savoir insuffisants.');update();game.science-=t.cost;game.researches[id]=true;if(id==='civic'){game.happiness=Math.min(100,game.happiness+8);game.influence+=3;}log(`Recherche achevée : ${t.name}.`);save();render();notify(`Progrès débloqué : ${t.name}`)}
function decideEvent(index){const e=EVENTS.find(e=>e.id===game.pendingEvent);if(!e)return;const choice=e.choices[index];if(!choice)return;for(const [key,val]of Object.entries(choice[1]))if(RES.includes(key)&&val<0&&game.res[key]<-val)return notify('Tes réserves ne suffisent pas pour cette décision.');for(const [key,val]of Object.entries(choice[1])){if(RES.includes(key))game.res[key]=Math.max(0,Math.min(capacity(),game.res[key]+val));else if(key==='happiness')game.happiness=Math.max(5,Math.min(100,game.happiness+val));else if(key==='pop')game.pop=Math.min(popCap(),game.pop+val);else game[key]=(game[key]||0)+val;}game.pendingEvent=null;game.nav='ville';game.eventAt=now()+180000+Math.random()*140000;log(`${e.title} — ${choice[0]}.`);notify('La décision a été appliquée.');save();render()}
function startNextJob(time){
 if(game.construction||!game.queue.length)return;
 const j=game.queue.shift();const start=Math.max(j.queuedAt||time,time);
 game.construction={site:j.site,type:j.type,level:j.level,start,end:start+(j.seconds||timeFor(j.type,j.level))*1000};
 log(`Les bâtisseurs commencent ${BUILD[j.type].name} niveau ${j.level}, parcelle ${j.site+1}.`);
 needsRedraw=true;
}
function finishEvents(at=now()){
 let loops=0;while(++loops<9){let changed=false;
 if(game.construction&&at>=game.construction.end){
  const job=game.construction; game.sites[job.site]={type:job.type,level:job.level}; game.construction=null;
  log(`${BUILD[job.type].name} niveau ${job.level} achevé, parcelle ${job.site+1}.`); notify(`${BUILD[job.type].name} terminé !`);
  const questId={hotelville:'hall',scierie:'sawmill',logement:'house',entrepot:'warehouse',senatbat:'senate'}[job.type];
  const q=QUESTS.find(x=>x.id===questId);
  if(q&&!game.quests.includes(questId)){game.quests.push(questId);grant(q.reward);log(`Ravitaillement de Rome : objectif « ${q.title} » accompli.`)}
  startNextJob(job.end);changed=true;
 }
 if(game.recruit&&at>=game.recruit.end){const type=game.recruit.type||'legion';const number=game.recruit.count;if(type==='legion')game.legions+=number;else game.units[type]=(game.units[type]||0)+number;game.stats.recruited+=number;log(`${number} ${UNIT_TYPES[type]?.name||'légionnaires'} rejoignent la garnison.`);game.recruit=null;changed=true}
 if(game.voyage&&at>=game.voyage.end){
  const voyage=game.voyage;const p=PLACES.find(x=>x.id===voyage.target);const resource=voyage.resource;
  const gain=Math.min(capacity()-game.res[resource],voyage.amount);
  game.res[resource]+=Math.max(0,gain);game.stats.voyages=(game.stats.voyages||0)+1;
  log(`Navire marchand revenu de ${p?.name||'la Méditerranée'} : +${Math.floor(Math.max(0,gain))} ${META[resource].name}.`);
  notify(`Navire marchand revenu : +${Math.floor(Math.max(0,gain))} ${META[resource].name}`);game.voyage=null;changed=true;
 }
 if(game.expedition&&at>=game.expedition.end){
  const mission=game.expedition,p=PLACES.find(x=>x.id===mission.target);
  if(p){
   const starting=mission.army||{legion:mission.soldiers||0,velites:0,equites:0};
   const battle=simulateBattle(starting,p.power,mission.formation||'acies',p.kind?.includes('fortifi')||false);
   game.legions+=battle.army.legion;game.units.velites+=battle.army.velites;game.units.equites+=battle.army.equites;
   if(battle.victory){if(!game.provinces.includes(p.id))game.provinces.push(p.id);game.influence+=8;log(`Victoire navale en ${p.name} : ${armyCount(battle.losses)} soldats perdus en ${battle.rounds} tours.`);notify(`Victoire : ${p.name} rejoint Rome`)}
   else{game.happiness=Math.max(10,game.happiness-3);log(`Échec de la campagne en ${p.name} : ${armyCount(battle.losses)} pertes.`);notify(`Retraite devant ${p.name}`)}
   addBattleReport({target:p.name,defense:false,victory:battle.victory,rounds:battle.rounds,formation:mission.formation||'acies',chronicle:battle.chronicle,losses:battle.losses,survivors:battle.army,loot:0,city:game.activeCity});
  }
  game.expedition=null;changed=true;
 }
 if(game.localMission&&at>=game.localMission.end){resolveLocalMission(at);changed=true}
 if(game.incomingRaid&&at>=game.incomingRaid.end){resolveRetaliation(at);changed=true}
 if(game.colonizing&&at>=game.colonizing.end){finishColonization(at);changed=true}
 if(game.convoy&&at>=game.convoy.end){finishConvoy(at);changed=true}
 if(changed)needsRedraw=true;if(!changed)break;
 }
}
function update(){
 const t=now();advanceNeighbors(t);let cursor=Math.max(t-86400*3,Math.min(t,game.last||t));let loops=0;
 // Split offline time at the exact completion of buildings/recruitment/travel.
 while(cursor<t&&loops++<24){
  const endEvents=[game.construction?.end,game.recruit?.end,game.voyage?.end,game.expedition?.end,game.localMission?.end,game.colonizing?.end,game.convoy?.end,game.incomingRaid?.end].filter(x=>typeof x==='number'&&x>cursor);
  const stop=Math.min(t,...endEvents);const hours=(stop-cursor)*game.speed/3600000;
  if(hours>0){const rates=production();for(const k of RES){const previous=game.res[k];game.res[k]=Math.min(capacity(),Math.max(0,game.res[k]+rates[k]*hours));if(k==='wood')game.stats.woodMade+=Math.max(0,game.res[k]-previous)}
   game.pop=Math.min(popCap(),game.pop+(game.happiness/100)*hours*3.4);
   if(hasBuilding('academie'))game.science+=hours*14*buildings('academie').reduce((n,b)=>n+b.level,0);
   let drift=(hasBuilding('temple')?.35:0)+(hasBuilding('forum')?.1:0);
   if(game.pop>=popCap()*.96)drift-=.72;
   if(game.pop>50){if(game.res.wine>1){const usage=Math.min(game.res.wine,game.pop*.015*hours);game.res.wine-=usage;drift+=.17}else drift-=.28}
   if(game.res.gold<1 && game.legions>0)drift-=.65;
   game.happiness=Math.max(15,Math.min(100,game.happiness+hours*drift));
  }
  cursor=stop;game.last=stop;finishEvents(stop);
  if(stop===t)break;
 }
 game.last=t; finishEvents(t);
 if(game.eventAt<t&&!game.pendingEvent&&buildings().length>=3){game.pendingEvent=EVENTS[Math.floor(Math.random()*EVENTS.length)].id;log('Un événement demande votre décision : '+EVENTS.find(e=>e.id===game.pendingEvent).title);needsRedraw=true}
}
function claimQuest(id){const q=QUESTS.find(q=>q.id===id);if(!q||game.quests.includes(id)||q.check(game)<q.goal)return;game.quests.push(id);grant(q.reward);game.influence+=2;log('Objectif accompli : '+q.title);notify('Récompense récupérée : '+q.title);save();render()}
function needsFoundingAid(){
 const target=hasHall()?'scierie':'hotelville';
 const existing=game.sites.some(b=>b?.type===target)||game.construction?.type===target||game.queue.some(j=>j.type===target);
 const cost=costFor(target,1);
 return !existing&&['wood','stone','gold'].some(k=>game.res[k]<cost[k]);
}
function claimFoundingAid(){
 update();const target=hasHall()?'scierie':'hotelville';
 if(!needsFoundingAid())return notify('La colonie dispose déjà des ressources nécessaires.');
 const elapsed=now()-(game.reliefAt||0);
 if(game.reliefAt&&elapsed<60000)return notify('Le courrier du Sénat est encore en route.');
 const cost=costFor(target,1),pack={};
 for(const key of ['wood','stone','gold'])pack[key]=Math.max(0,Math.ceil(cost[key]-game.res[key]));
 for(const [k,v] of Object.entries(pack))game.res[k]=Math.min(capacity(),game.res[k]+v);
 game.reliefAt=now();game.reliefCount=(game.reliefCount||0)+1;
 game.influence=Math.max(0,game.influence-(game.reliefCount>1?2:0));
 const name=BUILD[target].name;
 log(`Ravitaillement limité du Sénat : matériaux manquants pour ${name}.`);
 notify(`Ravitaillement reçu : construis ${name}.`);save();render();
}
function startBuild(type,site=game.selected){
 const def=BUILD[type],current=game.sites[site];if(!def||site<0||site>=SITES.length)return;
 if(site===HALL_SITE&&type!=='hotelville')return notify('La parcelle centrale est réservée à l’Hôtel de ville.');
 if(type==='hotelville'&&site!==HALL_SITE)return notify('L’Hôtel de ville se construit sur la parcelle centrale.');
 if(type!=='hotelville'&&!hasHall()&&game.construction?.type!=='hotelville'&&!game.queue.some(q=>q.type==='hotelville'))return notify('Construis d’abord l’Hôtel de ville au centre de la cité.');
 if(type==='senatbat'&&hallLevel()<2)return notify('Le Sénat exige un Hôtel de ville de niveau 2.');
 if(type==='senatbat'&&hasBuilding('senatbat')&&!current)return notify('Une Curie du Sénat existe déjà dans la cité.');
 if(current&&current.type!==type)return notify('Ce terrain est occupé. Sélectionnez une autre parcelle.');
 if(game.construction?.site===site||game.queue.some(j=>j.site===site))return notify('Un chantier est déjà prévu sur ce terrain.');
 if(game.construction&&game.queue.length>=2)return notify('La file de chantiers est pleine (3 travaux maximum).');
 const level=(current?.level||0)+1,cost=costFor(type,level);
 if(!affordable(cost))return notify('Matériaux insuffisants : consultez les besoins indiqués en rouge.');
 update();if(!pay(cost))return notify('Matériaux insuffisants.');
 const seconds=timeFor(type,level),job={site,type,level,seconds,queuedAt:now()};
 if(game.construction){game.queue.push(job);log(`Chantier programmé : ${def.name} niv. ${level} (position ${game.queue.length+1}).`);notify(`${def.name} ajouté à la file des chantiers.`)}
 else{game.construction={...job,start:now(),end:now()+seconds*1000};log(`Chantier commencé : ${def.name} niveau ${level}.`);notify(`Construction lancée : ${def.name}`)}
 game.selected=site;game.panelMode='details';save();render();
}
function cancelJob(index){
 const active=index===-1;const j=active?game.construction:game.queue[index];if(!j)return;
 const cost=costFor(j.type,j.level),refRate=active?.65:1;
 if(!confirm(`Annuler ${BUILD[j.type].name} niveau ${j.level} ? ${active?'65 %':'100 %'} des matériaux seront restitués.`))return;
 const reserve=Object.fromEntries(Object.entries(cost).map(([key,val])=>[key,Math.floor(val*refRate)]));
 if(active){game.construction=null;startNextJob(now())}else game.queue.splice(index,1);
 grant(reserve);log(`Chantier de ${BUILD[j.type].name} annulé. Matériaux restitués.`);save();render();notify('Chantier annulé.');
}
function demolishBuilding(site){const b=game.sites[site];if(b?.type==='hotelville')return notify('L’Hôtel de ville fonde la colonie et ne peut être démoli.');if(!b||game.construction?.site===site||game.queue.some(j=>j.site===site))return notify('Impossible de démolir un chantier actif ou programmé.');
 if(!confirm(`Démolir ${BUILD[b.type].name} niveau ${b.level} ? Cette action est définitive. Une partie du bois sera récupérée.`))return;
 const refund=Math.floor(BUILD[b.type].cost.wood*.25); game.sites[site]=null;delete game.workers[site];game.res.wood=Math.min(capacity(),game.res.wood+refund);
 log(`${BUILD[b.type].name} démoli. ${refund} bois récupérés.`);game.panelMode='catalog';save();render();notify('Terrain libéré.');
}
function voyageCost(p){return {gold:Math.round(35+p.power*.45)}}
function startVoyage(id){const p=PLACES.find(p=>p.id===id);if(!p||p.id==='latium')return;
 if(!hasBuilding('port'))return notify('Bâtissez un port pour équiper un navire marchand.');
 if(game.voyage)return notify('Un navire marchand est déjà en voyage.');
 if(!pay(voyageCost(p)))return notify('Deniers insuffisants pour payer la traversée.');
 const res=Object.keys(p.bonus)[0]||'stone';const secs=Math.max(20,Math.round(travelTime(p)*.8));
 game.voyage={target:id,resource:res,amount:Math.round(55+p.power*2.5),start:now(),end:now()+secs*1000};
 log(`Un navire marchand part pour ${p.name}. Cargaison attendue : ${META[res].name}.`);
 save();render();notify(`Navire marchand envoyé vers ${p.name}`);
}
function recruit(type='legion'){
 const u=UNIT_TYPES[type];if(!u)return;
 if(!hasBuilding('caserne'))return notify('Construis une caserne pour recruter.');
 if(!unitAvailability(type))return notify('Améliore la caserne au niveau 2 pour la cavalerie.');
 if(game.recruit)return notify('Une formation est déjà en cours.');
 update();if(!pay(u.cost))return notify('Provisions insuffisantes pour cette cohorte.');
 game.recruit={type,count:5,start:now(),end:now()+u.seconds*1000};
 log(`Cohorte en entraînement : 5 ${u.name.toLowerCase()}.`);save();render();notify('Entraînement commencé');
}
function travelTime(p){const d=Math.hypot((p.x-49)*1.2,(p.y-32));return Math.round((32+d*1.15)*(game.researches?.naval?.8:1))}
function expeditionCost(p){return {gold:60+Math.round(p.power*2),wine:35+Math.round(p.power*1.4)}}
function expeditionOdds(p){
 const army=takeMarchingArmy(),attack=armyPower(army)*(FORMATIONS[game.formation]?.attack||1);
 const ratio=attack/Math.max(1,p.power*1.40+8);
 return Math.round(100*Math.min(.92,Math.max(.08,.51+(ratio-1)*.34)));
}
function sendExpedition(id){const p=PLACES.find(p=>p.id===id);if(!p||game.provinces.includes(id))return;
 if(!hasBuilding('port'))return notify('Un port est nécessaire pour une campagne maritime.');
 if(!hasBuilding('caserne'))return notify('Construis une caserne pour armer la flotte.');
 if(game.expedition)return notify('Une expédition est déjà en cours.');
 const army=takeMarchingArmy(),strength=armyPower(army)*(FORMATIONS[game.formation]?.attack||1);
 if(armyCount(army)<5||strength<p.power*.85)return notify(`Force insuffisante. Prépare une armée plus importante (${Math.round(strength)} de force / ${p.power} requis).`);
 update();if(!pay(expeditionCost(p)))return notify('Provisions et deniers insuffisants.');
 game.legions-=army.legion;game.units.velites-=army.velites;game.units.equites-=army.equites;
 const secs=travelTime(p),soldiers=armyCount(army);
 game.expedition={target:id,soldiers,army,formation:game.formation,start:now(),end:now()+secs*1000};
 log(`Campagne vers ${p.name} : ${soldiers} soldats en mer, sous la formation ${FORMATIONS[game.formation]?.name||'Acies'}.`);
 save();render();notify(`${soldiers} soldats embarquent vers ${p.name}`);
}
function edict(type){if(!hasSenate())return notify('Érige la Curie du Sénat avant de promulguer des décrets.');const cd=game.cooldown[type]||0;if(now()<cd)return notify('Le Sénat ne peut pas encore renouveler ce décret.');let cost={},fx=()=>{};if(type==='tax'){game.happiness=Math.max(10,game.happiness-12);game.res.gold=Math.min(capacity(),game.res.gold+200);log('Impôt extraordinaire : +200 or, mécontentement populaire.')}else if(type==='wine'){cost={wine:80,gold:35};fx=()=>{game.happiness=Math.min(100,game.happiness+14);game.influence+=3;log('Fête populaire : la foule acclame vos magistrats.')}}else if(type==='grain'){cost={gold:80};fx=()=>{game.happiness=Math.min(100,game.happiness+10);game.pop=Math.min(popCap(),game.pop+4);log('Distribution de vivres : des familles rejoignent votre cité.')}}else if(type==='trade'){cost={stone:100};fx=()=>{game.res.wood=Math.min(capacity(),game.res.wood+165);game.stats.trades++;log('Le Sénat obtient un échange de pierre contre bois.')}}else return;if(!pay(cost))return notify('Le trésor ou les ressources sont insuffisants.');fx();game.cooldown[type]=now()+45000;game.influence+=1;save();render();notify('Décret adopté par le Sénat')}
function trade(type){if(!hasBuilding('marche'))return notify('Un marché est nécessaire pour commercer.');const opts={wood:['wood',100,'stone',75],stone:['stone',100,'wood',80],marble:['marble',70,'gold',110],wine:['wine',100,'gold',90],gold:['gold',150,'marble',80]};const a=opts[type];if(!a||!pay({[a[0]]:a[1]}))return notify('Ressources insuffisantes.');game.res[a[2]]=Math.min(capacity(),game.res[a[2]]+a[3]);game.stats.trades++;log(`Échange commercial : ${a[1]} ${META[a[0]].name} contre ${a[3]} ${META[a[2]].name}.`);save();render();notify('Échange effectué')}
function resHTML(cost){return Object.entries(cost).map(([k,v])=>`<span class="${game.res[k]<v?'missing':''}">${META[k].icon} ${money(v)}</span>`).join(' ')}
const V27_RESOURCE_ICONS={"wood": "data:image/png;base64,", "stone": "data:image/png;base64,", "marble": "data:image/png;base64,", "wine": "data:image/png;base64,", "gold": "data:image/png;base64,", "population": "data:image/png;base64,"};
function bar(){
 const rate=production();
 const labels={wood:'Bois',stone:'Pierre',marble:'Marbre',wine:'Vin',gold:'Or'};
 let str='';
 for(const k of RES){
  const v=rate[k],delta=(v>=0?'+':'−')+money(Math.abs(v));
  const count=money(game.res[k]);
  str+=`<div class="v27-resource" role="group" aria-label="${labels[k]} : ${count}, production ${delta} par heure" title="${labels[k]} : ${count} / ${money(capacity())} · ${delta}/h"><img loading="eager" draggable="false" alt="" src="${V27_RESOURCE_ICONS[k]}"><div class="v27-counts"><span class="v27-quantity">${count}</span><span class="v27-rate ${v<0?'negative':''}">${delta}/h</span></div></div>`;
 }
 const happy=game.happiness<35?'negative':'';
 str+=`<div class="v27-resource v27-population" role="group" aria-label="Population ${Math.floor(game.pop)} sur ${popCap()}, satisfaction ${Math.round(game.happiness)} pour cent" title="Habitants ${Math.floor(game.pop)} / ${popCap()} · Satisfaction ${Math.round(game.happiness)} %"><img loading="eager" draggable="false" alt="" src="${V27_RESOURCE_ICONS.population}"><div class="v27-counts"><span class="v27-quantity">${Math.floor(game.pop)} / ${popCap()}</span><span class="v27-rate ${happy}">✦ ${Math.round(game.happiness)}%</span></div></div>`;
 $('resources').innerHTML=str;$('clockLabel').textContent=new Date().toLocaleTimeString('fr-FR',{hour12:false});
 $('speedLabel').textContent=`CIVITAS XL · ×${game.speed} · ${availableWorkers()} travailleurs disponibles`;$('cityNameLabel').textContent=game.city;$('cityCoords').textContent='('+game.coords+')';
 const hud=$('v4BuildHud');if(hud){const j=game.construction;hud.innerHTML=j?`<div class="v4-hud-icon">⚒</div><div class="v4-hud-main"><strong>${esc(BUILD[j.type].name)} <span>niv. ${j.level}</span></strong><div class="v4-hud-progress"><i style="width:${Math.max(0,Math.min(100,100*(now()-j.start)/(j.end-j.start)))}%"></i></div><small>${formatSec((j.end-now())/1000)} restant · ${game.queue.length} en attente</small></div><button data-nav="chantiers" title="Ouvrir les chantiers">Gérer ❯</button>`:`<div class="v4-hud-icon">⚒</div><div class="v4-hud-main"><strong>Aucun chantier en cours</strong><small>Sélectionne un terrain pour bâtir ou améliorer.</small></div><button data-nav="chantiers">Chantiers ❯</button>`}
}
function createNav(){let h='';for(const[id,label,x1,x2]of NAV)h+=`<button class="hot ${game.nav===id?'active':''}" data-nav="${id==='carte'?'locale':id}" title="${label}" aria-label="${label}" style="left:${x1}px;top:1px;width:${x2-x1}px;height:90px"></button>`;h+=`<button class="hot" data-nav="ville" title="Retour à la ville" style="left:84px;top:113px;width:229px;height:59px"></button>`;const left=[['empire',217,296],['messages',304,370],['caserne',375,444],['marche',453,526],['classement',532,603],['locale',605,679]];for(const [id,y1,y2] of left)h+=`<button class="hot" data-nav="${id}" title="${id}" style="left:4px;top:${y1}px;width:78px;height:${y2-y1}px"></button>`;h+=`<div class="v7-views"><button data-nav="ville" class="${game.nav==='ville'?'active':''}">Ville</button><button data-nav="locale" class="${game.nav==='locale'?'active':''}">Province</button><button data-nav="carte" class="${game.nav==='carte'?'active':''}">Monde</button></div>`;$('nav-hotspots').innerHTML=h}
const SPRITES={scierie:'data:image/png;base64,',carriere:'data:image/png;base64,',cave:'data:image/png;base64,',entrepot:'data:image/png;base64,',logement:'data:image/png;base64,',forum:'data:image/svg+xml;base64,',caserne:'data:image/svg+xml;base64,',port:'data:image/svg+xml;base64,'};const CIVIC_ART={hotelville:'data:image/png;base64,',senatbat:'data:image/png;base64,'};
function sprite(type){if(window.CIVITAS_V13_ART?.[type])return window.CIVITAS_V13_ART[type];if(CIVIC_ART[type])return CIVIC_ART[type];const name=BUILD[type]?.sprite||'logement';return SPRITES[name]||SPRITES.logement}
function plots(){let h='';SITES.forEach((p,i)=>{if(Math.floor(i/8)!==(game.district||0))return;const b=game.sites[i],work=game.construction?.site===i,queued=game.queue.some(j=>j.site===i),empty=!b;let spriteHtml=b?`<img class="sprite ${b.type==='hotelville'?'hall-sprite':''}" alt="${esc(BUILD[b.type].name)}" src="${sprite(b.type)}"><span class="bname">${esc(BUILD[b.type].name)} <span class="lvl">niv. ${b.level}</span></span>`:'';
if(work){const progress=Math.max(0,Math.min(1,(now()-game.construction.start)/(game.construction.end-game.construction.start)));if(!b)spriteHtml+=`<img class="sprite rising-building" src="${sprite(game.construction.type)}" alt="Bâtiment en construction" style="opacity:${.15+.8*progress};clip-path:inset(${Math.round((1-progress)*75)}% 0 0 0)">`;spriteHtml+=`<div class="constructing v3-site-construction"><div class="scaffold">▥</div><span class="work-symbol">⚒</span></div><span class="bname">${esc(BUILD[game.construction.type].name)} · <span class="buildremain">${formatSec((game.construction.end-now())/1000)}</span></span>`;}
if(queued)spriteHtml+=`<div class="queued-label">⌛ En attente</div>`;
if(i===HALL_SITE&&!b&&!work&&!queued)spriteHtml=`<span class="foundation-mark"><strong>✦</strong><span>Hôtel de ville</span><small>Premier chantier</small></span>`;
if(!hasHall()&&i!==HALL_SITE&&empty)spriteHtml=`<span class="plot-wait">▣<small>Après la fondation</small></span>`;
h+=`<button data-site="${i}" class="hit-plot ${empty?'empty':''} ${i===HALL_SITE?'central-plot':''} ${game.selected===i?'selected':''}" aria-label="Parcelle ${i+1}${b?' '+BUILD[b.type].name:''}" style="left:${p.x}px;top:${p.y}px" title="${b?BUILD[b.type].name+' niveau '+b.level:i===HALL_SITE?'Parcelle centrale — Hôtel de ville':'Parcelle libre '+(i+1)}">${spriteHtml||'<span class="plotHint">Construire ici</span>'}</button>`});$('plots').innerHTML=h}
function quests(){const visible=QUESTS.filter(q=>!game.quests.includes(q.id)).slice(0,3);$('questHeader').textContent=`⚜ Quêtes (${visible.length})`;$('questList').innerHTML=visible.length?visible.map(q=>{const done=q.check(game)>=q.goal;return `<button data-quest="${q.id}" class="${done?'completed':''}" title="${done?'Cliquez pour récupérer la récompense':'Objectif en cours'}"><span class="tick">${done?'✓':'□'}</span>${esc(q.title)} (${Math.min(q.goal,Math.floor(q.check(game)))}/${q.goal}) ${done?'🎁':''}</button>`}).join(''):'<p style="margin:8px">Toutes les quêtes de cette alpha sont terminées.</p>'}
function panelTitle(t){$('panelTitle').textContent=t}
function missingCost(cost){return Object.entries(cost).filter(([k,v])=>game.res[k]<v).map(([k,v])=>`${Math.ceil(v-game.res[k])} ${META[k].name.toLowerCase()}`)}
function etaFor(cost){const r=production(),st=Object.entries(cost).filter(([k,v])=>v>game.res[k]);if(!st.length)return 'Disponible';
 const delays=st.map(([k,v])=>r[k]>0?(v-game.res[k])*3600/(r[k]*game.speed):Infinity);if(delays.some(x=>!isFinite(x)))return 'Production ou commerce nécessaire';
 return `Attente estimée : ${formatSec(Math.max(...delays))}`;
}
const GROUPS={tous:'Tous',production:'Production',civique:'Vie civile',imperial:'Empire'};
const GROUP_OF={hotelville:'civique',senatbat:'civique',scierie:'production',carriere:'production',marbre:'production',cave:'production',entrepot:'civique',logement:'civique',forum:'civique',temple:'civique',marche:'imperial',port:'imperial',caserne:'imperial',academie:'imperial'};
function requirementsHtml(cost){const miss=missingCost(cost);return `<div class="v4-costline">${Object.entries(cost).map(([k,n])=>`<span class="v4-cost ${game.res[k]<n?'short':'okay'}" title="${META[k].name}: ${money(game.res[k])} / ${money(n)}">${META[k].icon} ${money(n)}</span>`).join('')}</div>${miss.length?`<div class="v4-shortage">Il manque ${esc(miss.join(' · '))}. <small>${etaFor(cost)}</small></div>`:''}`}

const NEIGHBORS=[
 {id:'player',name:'Colonia Julia',x:48,y:43,type:'Votre cité',faction:'Roma',garrison:0,resource:'wood'},
 {id:'aurelia',name:'Tibur',x:21,y:12,type:'Cité agricole',faction:'Cités libres',garrison:10,resource:'wine'},
 {id:'ostia',name:'Antium',x:75,y:16,type:'Port marchand',faction:'Cités libres',garrison:16,resource:'stone'},
 {id:'velia',name:'Villa Sabina',x:82,y:49,type:'Cité fortifiée',faction:'Milice locale',garrison:28,resource:'gold'},
 {id:'sabina',name:'Satricum',x:29,y:86,type:'Village forestier',faction:'Cités libres',garrison:8,resource:'wood'},
 {id:'tiberis',name:'Aricia',x:79,y:80,type:'Bourg fluvial',faction:'Cités libres',garrison:12,resource:'stone'},
 {id:'castra',name:'Castra Alba',x:56,y:64,type:'Poste militaire',faction:'Milice locale',garrison:22,resource:'marble'},
 {id:'falcina',name:'Falcina',x:14,y:62,type:'Colonie viticole',faction:'Cités libres',garrison:13,resource:'wine'},
 {id:'vacant1',name:'Terre libre',x:59,y:17,type:'Emplacement libre',faction:'—',garrison:0,resource:'wood'},
 {id:'vacant2',name:'Terre libre',x:61,y:76,type:'Emplacement libre',faction:'—',garrison:0,resource:'wood'}
];
function neighbor(id){return NEIGHBORS.find(n=>n.id===id)}

/* CIVITAS XXXIX — COHORTES, CAMPAGNES ET DIPLOMATIE ACTIVES */
const UNIT_TYPES={
 legion:{name:'Légionnaires',role:'Infanterie lourde',icon:'🛡',power:1.6,upkeep:.55,seconds:25,cost:{wood:55,wine:70,gold:90},description:'Tiennent le centre et combattent dans toutes les formations.'},
 velites:{name:'Vélites',role:'Éclaireurs et tirailleurs',icon:'🏹',power:.88,upkeep:.27,seconds:18,cost:{wood:38,wine:35,gold:55},description:'Peu coûteux et très efficaces pour harceler.'},
 equites:{name:'Équites',role:'Cavalerie romaine',icon:'🐎',power:2.35,upkeep:1.1,seconds:38,cost:{wood:95,wine:95,gold:170},description:'Percée rapide, nécessite une caserne niveau 2.'}
};
const FORMATIONS={
 acies:{name:'Acies — ligne de bataille',attack:1,defense:1,description:'Formation équilibrée pour les engagements classiques.'},
 testudo:{name:'Testudo — tortue',attack:.80,defense:.69,description:'Moins de dégâts infligés mais beaucoup moins de pertes.'},
 cuneus:{name:'Cuneus — coin',attack:1.27,defense:1.25,description:'Percée brutale, mais lourdes pertes possibles.'}
};
const unitCount=(city,type)=>type==='legion'?(+city.legions||0):Math.max(0,+(city.units?.[type]||0));
const armyCount=a=>(a?.legion||0)+(a?.velites||0)+(a?.equites||0);
const cityArmy=city=>({legion:unitCount(city,'legion'),velites:unitCount(city,'velites'),equites:unitCount(city,'equites')});
const armyPower=a=>(a.legion||0)*1.6+(a.velites||0)*.88+(a.equites||0)*2.35;
const unitAvailability=(type)=>type!=='equites'||buildings('caserne').some(b=>b.level>=2);
function setFormation(type){if(!FORMATIONS[type])return;game.formation=type;save();render();notify('Formation adoptée : '+FORMATIONS[type].name)}
function takeMarchingArmy(st){const available=cityArmy(game);const army={legion:Math.max(0,Math.floor(available.legion*.84)),velites:Math.max(0,Math.floor(available.velites*.80)),equites:Math.max(0,Math.floor(available.equites*.80))};
 if(armyCount(army)<5&&available.legion>=5)army.legion=Math.min(available.legion,5);
 return army;
}
function previewBattle(id){const st=localState(id),n=neighbor(id),army=takeMarchingArmy(st),formation=FORMATIONS[game.formation]||FORMATIONS.acies;
 const defender=st.guards*(n.type.includes('fortifi')||n.type.includes('militaire')?1.52:1.21)+8;
 const power=armyPower(army)*formation.attack;const ratio=power/Math.max(1,defender);
 const chance=Math.max(.08,Math.min(.92,.51+(ratio-1)*.34));return {army,chance,defender,attacker:power};
}
function removeCasualties(a,needed){let remaining=needed;const killed={legion:0,velites:0,equites:0};
 for(let z=0;z<Math.max(0,needed);z++){
  const keys=['velites','legion','equites'].filter(k=>a[k]>0);if(!keys.length)break;
  const key=keys[Math.floor(Math.random()*keys.length)];a[key]--;killed[key]++;remaining--;
 }
 return killed;
}
function simulateBattle(armyOriginal,guardOriginal,formationName,fortified){
 const starting={...armyOriginal},army={...armyOriginal},formations=FORMATIONS[formationName]||FORMATIONS.acies;
 let guards=Math.max(1,Math.round(guardOriginal));const defending=guards;
 const chronicle=[];let rounds=0;
 while(rounds<6&&guards>0&&armyCount(army)>0){
  rounds++;
  const attack=armyPower(army)*formations.attack*(.82+Math.random()*.34);
  const defenseDamage=(guards*(fortified?1.36:1)*(0.045+Math.random()*.04))/(formations.defense);
  const defendersLost=Math.min(guards,Math.max(1,Math.round(attack/(fortified?6.2:5.6))));
  const ourLost=Math.min(armyCount(army),Math.max(0,Math.round(defenseDamage)));
  guards=Math.max(0,guards-defendersLost);removeCasualties(army,ourLost);
  chronicle.push(`Tour ${rounds} · ${defendersLost} défenseurs neutralisés · ${ourLost} pertes romaines`);
 }
 const victory=guards===0&&armyCount(army)>0;
 const retreat= !victory && armyCount(army)>0;
 const losses={legion:starting.legion-army.legion,velites:starting.velites-army.velites,equites:starting.equites-army.equites};
 return {victory,retreat,rounds,chronicle,army,losses,remainingGuards:Math.max(2,guards),defending};
}
function addBattleReport(report){game.battleReports=game.battleReports||[];game.battleReports.unshift({id:Date.now(),time:Date.now(),...report});game.battleReports=game.battleReports.slice(0,24)}
function resolveRetaliation(at){const raid=game.incomingRaid;if(!raid||raid.end>at)return;
 const city=raid.city===game.activeCity?game:game.cities?.[raid.city];if(!city){game.incomingRaid=null;return;}
 const defense=cityArmy(city);const support=Math.floor(city.pop/13)+2*(city.sites?.[4]?.type==='hotelville'?city.sites[4].level:1)+3*(city.sites||[]).filter(b=>b?.type==='caserne').reduce((v,b)=>v+b.level,0);
 const power=armyPower(defense)+support;const attacker=Math.max(3,raid.strength);
 const defended=power>=attacker*(.86+Math.random()*.30);
 const goldLoss=defended?0:Math.min(Math.floor(city.res.gold),Math.round(20+attacker*2.1));
 if(!defended){city.res.gold-=goldLoss;city.happiness=Math.max(12,city.happiness-7);}
 const losses=Math.min(city.legions,Math.max(0,Math.round(attacker*(defended?.08:.21))));city.legions=Math.max(0,city.legions-losses);
 addBattleReport({target:raid.from,defense:true,victory:defended,rounds:1,formation:'acies',chronicle:[defended?'La milice et la garnison ont repoussé les assaillants.':`Le raid a emporté ${goldLoss} deniers et semé le désordre.`],losses:{legion:losses,velites:0,equites:0},survivors:cityArmy(city),loot:0,city:raid.city});
 log(`${defended?'Raid repoussé':'Raid subi'} : ${raid.from} · ${losses} légionnaires perdus${goldLoss?' · '+goldLoss+' or saisis':''}.`);
 game.incomingRaid=null;needsRedraw=true;save();
}
function warOfficeHTML(){const running=game.recruit;const formation=FORMATIONS[game.formation]||FORMATIONS.acies;
 const cards=Object.entries(UNIT_TYPES).map(([key,u])=>`<article class="v22-unit-card"><div class="v22-unit-icon">${u.icon}</div><div><h3>${u.name}</h3><small>${u.role}</small><p>${u.description}</p><div class="v22-unit-count">En garnison <strong>${unitCount(game,key)}</strong> · Force ${u.power}</div><div class="v22-unit-cost">${Object.entries(u.cost).map(([r,v])=>`${META[r].icon} ${v}`).join(' · ')}</div><button class="btn-red" data-train-type="${key}" ${!hasBuilding('caserne')||!unitAvailability(key)||!!running||!affordable(u.cost)?'disabled':''}>Recruter 5 · ${u.seconds}s</button>${!unitAvailability(key)?'<small>Caserne niveau 2 requise</small>':''}</div></article>`).join('');
 const formButtons=Object.entries(FORMATIONS).map(([k,v])=>`<button class="v22-formation ${game.formation===k?'active':''}" data-formation="${k}" title="${v.description}"><strong>${v.name}</strong><small>${v.description}</small></button>`).join('');
 const r=game.incomingRaid;const army=cityArmy(game);
 return `<div class="v22-war-board"><div class="v22-war-head"><div><small>⚜ CASTRUM · COMMANDEMENT</small><h2>Les légions de ${esc(game.city)}</h2><p>Recrute plusieurs corps d'armée, choisis une formation et examine les rapports avant d'engager un voisin.</p></div><div class="v22-war-total">${armyCount(army)}<small>soldats prêts</small></div></div>
 ${r?`<div class="v22-raid-alert"><strong>⚠ Raid en approche : ${esc(r.from)}</strong><span>Vers ${esc(cityName(r.city))} · arrivée dans ${formatSec((r.end-now())/1000)} · puissance estimée ${r.strength}</span></div>`:''}
 <div class="v22-war-layout"><section><h3>Recrutement</h3><div class="v22-units">${cards}</div>${running?`<p class="v22-progress">Formation de ${UNIT_TYPES[running.type||'legion']?.name||'légionnaires'} · ${formatSec((running.end-now())/1000)} restantes</p>`:''}</section><section><h3>Doctrine militaire</h3><p>Formation en cours : <strong>${formation.name}</strong></p><div class="v22-formations">${formButtons}</div><h3>Campagne du Latium</h3><div class="v22-campaign">${warCampaignHTML()}</div><button class="btn-parch" data-nav="locale">Inspecter les colonies voisines</button><h3>Rapports récents</h3>${battleReportsHTML(3)}</section></div></div>`;
}
function warCampaignHTML(){const reports=game.battleReports||[];const missions=[
 {label:'Former au moins 5 légionnaires',done:game.legions>=5||game.stats.recruited>=5},
 {label:'Éclairer une cité indépendante',done:Object.values(game.localStates||{}).some(st=>st.intelUntil>0)},
 {label:'Remporter une bataille locale',done:reports.some(r=>r.victory&&!r.defense)},
 {label:'Établir un traité commercial',done:Object.values(game.localStates||{}).some(st=>st.pactUntil>0)}];
 return missions.map((m,i)=>`<div class="v22-campaign-row"><span>${m.done?'✓':'○'}</span><strong>Acte ${i+1}</strong><div>${m.label}</div></div>`).join('');}
function battleReportsHTML(max=24){const reports=(game.battleReports||[]).slice(0,max);return reports.length?reports.map(r=>`<details class="v22-report"><summary><strong>${r.victory?'Victoire':'Défaite'} · ${esc(r.target||'Latium')}</strong><small>${new Date(r.time).toLocaleString('fr-FR')} · ${r.defense?'Défense':'Campagne'} · ${r.rounds} tour(s)</small></summary><p>${r.defense?'Raid sur la colonie':'Formation : '+esc(FORMATIONS[r.formation]?.name||'Acies')}${r.loot?' · Butin : '+Math.floor(r.loot)+' or':''}</p><p>Pertes : ${r.losses?.legion||0} légionnaires · ${r.losses?.velites||0} vélites · ${r.losses?.equites||0} équites</p><ol>${(r.chronicle||[]).map(line=>`<li>${esc(line)}</li>`).join('')}</ol></details>`).join(''):'<p>Aucun combat enregistré. Explore les cités voisines pour lancer une expédition.</p>'}

function localState(id){const n=neighbor(id);if(!game.localStates[id])game.localStates[id]={relation:0,guards:n?.garrison||0,raids:0,trades:0,intelUntil:0,peaceUntil:0,stock:155,treasury:130,population:42+(n?.garrison||0),pactUntil:0,lastGrowth:now()};const st=game.localStates[id];st.stock=Number.isFinite(st.stock)?st.stock:155;st.treasury=Number.isFinite(st.treasury)?st.treasury:130;st.population=Number.isFinite(st.population)?st.population:42+(n?.garrison||0);st.pactUntil=st.pactUntil||0;st.lastGrowth=st.lastGrowth||now();return st;}
function advanceNeighbors(at=now()){
 for(const n of NEIGHBORS){if(n.id==='player'||n.id.startsWith('vacant'))continue;const st=localState(n.id);const elapsed=Math.max(0,Math.min(86400000,at-st.lastGrowth));if(elapsed<1000)continue;
  const hours=elapsed/3600000;st.stock=Math.min(340,st.stock+24*hours);st.treasury=Math.min(320,st.treasury+19*hours);st.guards=Math.min(n.garrison+Math.ceil(st.population/9),st.guards+hours*1.5);st.population=Math.min(135,st.population+hours*.6);if(st.relation>0)st.relation=Math.max(0,st.relation-hours*.25);if(st.relation<0)st.relation=Math.min(0,st.relation+hours*.25);st.lastGrowth=at;
 }
}
function negotiatePact(id){const n=neighbor(id),st=n&&localState(id);if(!n||!st)return;if(!hasBuilding('marche'))return notify('Un Marché est requis pour négocier.');if(st.relation<12)return notify('Établis d’abord de bonnes relations par le commerce.');if(st.pactUntil>now())return notify('Un accord commercial est déjà en vigueur.');update();if(!pay({gold:50}))return notify('Il faut 50 deniers pour négocier ce traité.');st.pactUntil=now()+3600000;st.relation=Math.min(90,st.relation+5);log('Traité commercial signé avec '+n.name+' pour une heure réelle.');save();render();notify('Traité actif : caravanes +25 % pendant une heure');}

function localSelect(id){const n=neighbor(id);if(!n)return;advanceNeighbors();game.localSelected=id;if(id!=='player'&&!id.startsWith('vacant'))game.tutorialInspectedNeighbor=true;save();render()}
function localMissionCost(kind){return kind==='trade'?{wood:25,gold:25}:kind==='spy'?{gold:35}:kind==='attack'?{wine:12,gold:30}:{};}
function localAction(kind,id){
 const n=neighbor(id),st=n&&localState(id);if(!n||id==='player'||id.startsWith('vacant'))return notify('Sélectionne une cité voisine occupée.');
 if(!hasHall())return notify('Fonde d’abord l’Hôtel de ville.');
 if(game.localMission)return notify('Une mission locale est déjà en cours.');
 if(kind==='trade'&&!hasBuilding('marche'))return notify('Construis un Marché pour commercer avec tes voisins.');
 if(kind==='spy'&&!hasBuilding('academie'))return notify('Construis une Académie pour former des éclaireurs.');
 if(kind==='attack'&&!hasBuilding('caserne'))return notify('Construis une Caserne avant d’attaquer.');
 if(kind==='attack'&&armyCount(takeMarchingArmy(st))<5)return notify('Entraîne au moins cinq soldats pour lancer une campagne.');
 if(kind==='attack'&&st.peaceUntil>now())return notify('La garnison voisine reste en état d’alerte après la dernière bataille.');
 const cost=localMissionCost(kind);if(!affordable(cost))return notify('Ressources insuffisantes pour cette mission.');
 update();if(!pay(cost))return notify('Ressources insuffisantes.');
 const army=kind==='attack'?takeMarchingArmy(st):null;const soldiers=kind==='attack'?armyCount(army):0;
 if(kind==='attack'){game.legions-=army.legion;game.units.velites-=army.velites;game.units.equites-=army.equites;}
 const duration=kind==='trade'?22:kind==='spy'?20:34;
 game.localMission={kind,target:id,origin:game.activeCity,soldiers,army,formation:game.formation,start:now(),end:now()+duration*1000};
 log(`${kind==='trade'?'Caravane marchande':kind==='spy'?'Éclaireur':'Légion'} envoyé${kind==='attack'?'e':''} vers ${n.name}.`);
 notify(`Mission vers ${n.name} lancée · ${duration} s`);save();render();
}
function resolveLocalMission(at){const m=game.localMission;if(!m||at<m.end)return;const n=neighbor(m.target),st=localState(m.target);if(!n){game.localMission=null;return}const missionCity=m.origin&&m.origin!==game.activeCity?game.cities[m.origin]:game;const missionCapacity=500+(missionCity.sites||[]).filter(b=>b?.type==='entrepot').reduce((v,b)=>v+b.level*600,0);
 if(m.kind==='trade'){
  const goods=n.resource;const offer=Math.floor((65+Math.max(0,st.relation))*(st.pactUntil>at?1.25:1));const qty=Math.max(0,Math.floor(Math.min(Math.max(0,missionCapacity-missionCity.res[goods]),st.stock,offer)));missionCity.res[goods]+=qty;st.stock-=qty;st.relation=Math.min(80,st.relation+7);st.trades++;
  missionCity.stats.trades++;log(`Caravane revenue de ${n.name} : ${Math.floor(qty)} ${META[goods]?.name||goods} importés.`);notify(`Commerce réussi : +${Math.floor(qty)} ${META[goods]?.name||goods}`);
 } else if(m.kind==='spy'){
  st.intelUntil=at+300000;st.relation=Math.max(-80,st.relation-3);log(`Rapport d’éclaireur à ${n.name} : ${st.guards} défenseurs, relations ${st.relation}.`);notify(`Espionnage terminé : ${st.guards} défenseurs identifiés`);
 } else if(m.kind==='attack'){
  const initial=m.army||{legion:m.soldiers||0,velites:0,equites:0};
  const fortified=n.type.includes('fortifi')||n.type.includes('militaire');
  const battle=simulateBattle(initial,st.guards,m.formation||'acies',fortified);
  if(!m.origin||m.origin===game.activeCity){game.legions+=battle.army.legion;game.units.velites+=battle.army.velites;game.units.equites+=battle.army.equites;}
  else if(game.cities[m.origin]){const origin=game.cities[m.origin];origin.units=origin.units||{velites:0,equites:0};origin.legions+=battle.army.legion;origin.units.velites+=battle.army.velites;origin.units.equites+=battle.army.equites;}
  st.guards=battle.remainingGuards;st.relation=Math.max(-100,st.relation-(battle.victory?35:22));st.raids++;st.peaceUntil=at+75000;
  const casualties=armyCount(battle.losses);let loot=0;
  if(battle.victory){loot=Math.max(0,Math.floor(Math.min(missionCapacity-missionCity.res.gold,st.treasury,45+st.guards*3)));missionCity.res.gold+=loot;st.treasury-=loot;game.influence+=3;log(`Victoire sur ${n.name} : ${battle.rounds} tours, ${casualties} pertes, ${loot} deniers saisis.`);notify(`Victoire ! ${loot} or · ${casualties} pertes`)}
  else {missionCity.happiness=Math.max(12,missionCity.happiness-3);log(`Retraite devant ${n.name} : ${battle.rounds} tours, ${casualties} pertes.`);notify(`Combat terminé : ${casualties} soldats perdus`)}
  addBattleReport({target:n.name,defense:false,victory:battle.victory,rounds:battle.rounds,formation:m.formation||'acies',chronicle:battle.chronicle,losses:battle.losses,survivors:battle.army,loot,city:m.origin});
  if(st.relation<=-30&&!game.incomingRaid&&!(st.retaliatedAt>at-500000)){
   st.retaliatedAt=at;game.incomingRaid={from:n.name,city:m.origin||game.activeCity,strength:Math.max(6,Math.floor(n.garrison*.72)),start:at,end:at+115000};
   log(`Alerte des éclaireurs : ${n.name} prépare une riposte contre ${cityName(m.origin||game.activeCity)}.`);
  }

 }
 game.localMission=null;needsRedraw=true;save();
}

// CIVITAS XL · Painted 2.5D geography built from separate land, terrain, road, water and foliage shapes.
const V24_SHORE='M0 0 H1060 V136 C1017 150 969 174 920 200 C867 217 827 250 790 289 C754 324 702 341 672 365 C630 389 594 409 562 430 C521 458 480 496 425 535 H0 Z';
function v24ProvinceArt(){
 const land='url(#v24Land)';
 let hills='';
 for(let k=0;k<33;k++){
  const cx=22+(k*89)%1014,cy=20+(k*53)%340;
  const rx=18+(k%6)*8,ry=6+(k%4)*4;
  hills+=`<path d="M${cx-rx} ${cy+ry} Q${cx-rx*.66} ${cy-ry*.45} ${cx} ${cy-ry*1.2} Q${cx+rx*.68} ${cy-ry*.16} ${cx+rx} ${cy+ry}" fill="none" stroke="${k%2?'#e5d7a0':'#62754d'}" stroke-width="${2+(k%3)}" stroke-opacity=".25"/>`;
 }
 let trees='';
 for(let k=0;k<125;k++){
  const x=18+(k*83+Math.floor(k/9)*17)%1015,y=15+(k*61+Math.floor(k/13)*37)%345;
  if(y>400-x*.18||y>366+(850-x)*.30&&x>650)continue;
  const r=3.6+(k%4)*1.5;
  trees+=`<g opacity="${.4+(k%5)*.09}" transform="translate(${x} ${y})"><ellipse cy="${r*.7}" rx="${r*.9}" ry="${r*.36}" fill="#203a27" opacity=".35"/><path d="M0 0v-${r*1.9}" stroke="#684c2a" stroke-width="1.4"/><path d="M-${r*.78} -${r*1.05} Q0 -${r*3.05} ${r*.7} -${r*.9}Q0 -${r*.4} -${r*.78} -${r*1.05}Z" fill="${k%3===0?'#335e3c':k%3===1?'#577143':'#688250'}" stroke="#294c32" stroke-width=".7"/></g>`;
 }
 let rocky='';
 for(let k=0;k<23;k++){
  const x=25+(k*137)%1030,y=28+(k*113)%315;
  rocky+=`<path d="M${x-16} ${y+9}l${8+(k%4)*3} -${12+(k%6)*3} ${8+(k%3)*3} -9 ${12+(k%3)*2} 21Z" fill="${k%3===0?'#cbc0a1':k%3===1?'#a7a68b':'#d8caa6'}" stroke="#7c806f" stroke-width="1" opacity=".68"/>`;
 }
 return `<svg class="local-svg v24-map-svg" viewBox="0 0 1060 535" preserveAspectRatio="none" aria-hidden="true"><defs>
 <linearGradient id="v24Sea" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#14536c"/><stop offset=".54" stop-color="#287e8b"/><stop offset="1" stop-color="#15566a"/></linearGradient>
 <linearGradient id="v24Land" x1="0" y1="0" x2=".85" y2="1"><stop stop-color="#74865e"/><stop offset=".24" stop-color="#c8bc83"/><stop offset=".48" stop-color="#9bac6e"/><stop offset=".75" stop-color="#c7b98b"/><stop offset="1" stop-color="#727d4e"/></linearGradient>
 <linearGradient id="v24Shore" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#efe3bd"/><stop offset="1" stop-color="#a88a5b"/></linearGradient>
 <pattern id="v24Tide" width="51" height="37" patternUnits="userSpaceOnUse"><path d="M4 22 Q14 17 24 22 T44 22" stroke="#def5e9" stroke-opacity=".16" stroke-width="1.1" fill="none"/></pattern>
 <pattern id="v24Grain" width="66" height="62" patternUnits="userSpaceOnUse"><path d="M8 8l7 -3m20 21l9 -3m-28 24l3 -6" stroke="#e3e2ad" opacity=".13" stroke-width="2"/><circle cx="56" cy="12" r="1.6" fill="#f6e8b5" opacity=".19"/></pattern>
 <filter id="v24Blur"><feGaussianBlur stdDeviation="2.2"/></filter>
 </defs><rect width="1060" height="535" fill="url(#v24Sea)"/><rect width="1060" height="535" fill="url(#v24Tide)"/>
 <path d="${V24_SHORE}" fill="#083f4f" stroke="#0b4c5b" stroke-width="23" filter="url(#v24Blur)" opacity=".67"/>
 <path d="${V24_SHORE}" fill="url(#v24Land)" stroke="url(#v24Shore)" stroke-width="13"/>
 <path d="${V24_SHORE}" fill="url(#v24Grain)" opacity=".88"/>
 <path d="M-50 95 C180 55 330 93 545 72 S840 45 1100 -1" stroke="#e4d2a2" opacity=".23" stroke-width="31" fill="none"/>
 <path d="M-50 95 C180 55 330 93 545 72 S840 45 1100 -1" stroke="#8b8c61" opacity=".33" stroke-width="5" fill="none"/>
 ${hills}${rocky}${trees}
 <g fill="none" stroke-linecap="round" stroke-linejoin="round">
 <path d="M45 285 Q159 212 304 251 Q436 270 528 183 Q624 117 770 145 Q894 173 1030 89" stroke="#665e42" stroke-opacity=".38" stroke-width="25"/>
 <path d="M45 285 Q159 212 304 251 Q436 270 528 183 Q624 117 770 145 Q894 173 1030 89" stroke="#efe0b7" stroke-width="13"/>
 <path d="M45 285 Q159 212 304 251 Q436 270 528 183 Q624 117 770 145 Q894 173 1030 89" stroke="#bc9e66" stroke-width="1.5" stroke-dasharray="3 10"/>
 <path d="M245 248 Q307 316 418 349 Q545 385 658 325 Q747 290 793 236" stroke="#705a3b" stroke-opacity=".45" stroke-width="20"/>
 <path d="M245 248 Q307 316 418 349 Q545 385 658 325 Q747 290 793 236" stroke="#f3dfb3" stroke-width="10"/>
 <path d="M418 349 Q480 430 540 445 Q590 463 650 430" stroke="#705a3b" stroke-opacity=".40" stroke-width="16"/>
 <path d="M418 349 Q480 430 540 445 Q590 463 650 430" stroke="#dfc998" stroke-width="8"/>
 </g>
 <g fill="#fff9dd" opacity=".45"><circle cx="245" cy="248" r="5"/><circle cx="418" cy="349" r="5"/><circle cx="658" cy="325" r="5"/></g>
 <g stroke="#d7f8e9" opacity=".48" fill="none" stroke-width="2"><path d="M760 409q28-9 61 0m-12 15q20-8 42 1m-25-52q36-9 58 4M931 330q32-10 58-1M671 499q27-8 52 1"/></g>
 <g fill="#f8efd2" font-family="Georgia" font-style="italic" letter-spacing="3" opacity=".64"><text x="26" y="43" font-size="18">AGER LATINUS</text><text x="791" y="492" font-size="18" opacity=".55">MARE TYRRHENUM</text></g>
 </svg>`;
}

function v25ProvinceMissionMap(){
 const nodes=NEIGHBORS.filter(n=>n.id!=='player');const home=NEIGHBORS[0],m=game.localMission;
 const selected=neighbor(game.localSelected)||home;
 let lines=nodes.map(n=>{
  if(n.id.startsWith('vacant'))return '';
  const active=m?.target===n.id,sel=selected.id===n.id;
  const ctrlX=(home.x+n.x)*.5,ctrlY=(home.y+n.y)*.5-(Math.abs(home.x-n.x)*.11+5);
  return `<path d="M${home.x} ${home.y}Q${ctrlX.toFixed(2)} ${ctrlY.toFixed(2)} ${n.x} ${n.y}" fill="none" stroke="${active?'#ffda85':sel?'#f8dcb2':'#f8e3b2'}" stroke-opacity="${active?'.96':sel?'.75':'.20'}" stroke-width="${active?'.48':sel?'.33':'.19'}" stroke-dasharray="1.4 1.5" />`;
 }).join('');
 const target= m&&neighbor(m.target);
 const marker=target?`<g data-v25-mission="province" data-start="${m.start}" data-end="${m.end}" data-x0="${home.x}" data-y0="${home.y}" data-x1="${target.x}" data-y1="${target.y}" data-curve="${(home.y+target.y)*.5-(Math.abs(home.x-target.x)*.11+5)}"><circle data-v25-marker r="1.65" fill="${m.kind==='attack'?'#a92b1b':'#ffdfa1'}" stroke="#fffcdf" stroke-width=".6"/><circle data-v25-glow r="3.1" fill="none" stroke="#ffde91" stroke-opacity=".6" stroke-width=".4"/></g>`:'';
 return `<svg class="v25-mission-map v25-province-map" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">${lines}${marker}</svg>`;
}
function v25WorldMissionMap(){
 const m=game.expedition||game.voyage;const target=m&&PLACES.find(p=>p.id===(m.target||m.place||m.to));
 const home=PLACES[0],sel=PLACES.find(p=>p.id===provinceSelected)||PLACES[0];
 const ctrlX=(home.x+sel.x)/2,ctrlY=Math.min(home.y,sel.y)-7;
 const trace=sel.id!==home.id?`<path d="M${home.x} ${home.y}Q${ctrlX} ${ctrlY} ${sel.x} ${sel.y}" fill="none" stroke="#ffe0a7" stroke-opacity=".73" stroke-width=".35" stroke-dasharray="1.2 1.4"/>`:'';
 const mov=target?`<g data-v25-mission="world" data-start="${m.start||Date.now()}" data-end="${m.end||Date.now()}" data-x0="${home.x}" data-y0="${home.y}" data-x1="${target.x}" data-y1="${target.y}" data-curve="${Math.min(home.y,target.y)-7}"><circle data-v25-marker r="1.2" fill="#fff4bd" stroke="#8e3419" stroke-width=".5"/><circle data-v25-glow r="2.2" fill="none" stroke="#fff4bd" stroke-width=".45"/></g>`:'';
 return `<svg class="v25-mission-map v25-world-map" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">${trace}${mov}</svg>`;
}

function v24ProvinceTraffic(){
 const trade=!!game.localMission||!!game.voyage||!!game.convoy;
 return `<div class="v24-province-ambience" aria-hidden="true"><div class="v24-haze"></div><div class="v24-water-ripples"></div><div class="v24-coast-bird b1"></div><div class="v24-coast-bird b2"></div>${trade?'<div class="v24-sailing-ship">⛵</div>':''}</div>`;
}
function v24WorldArt(){
 const art=window.CIVITAS_V13_ART||{};
 const landmarks=[
 ['rocks',21,19,74],['olive',30,24,55],['cypress',37,18,61],['rocks',51,16,59],
 ['olive',62,22,46],['rocks',73,24,59],['cypress',81,18,48],['olive',18,58,53],
 ['rocks',41,59,67],['olive',53,68,61],['cypress',66,62,53],['rocks',77,75,64]
 ];
 return `<div class="v24-world-art" aria-hidden="true"><div class="v24-world-haze"></div>${landmarks.map(([key,x,y,size],i)=>`<img class="v24-landmark v24-landmark-${i%4}" src="${art[key]||''}" alt="" style="left:${x}%;top:${y}%;width:${size}px"/>`).join('')}<div class="v24-world-vessel vessel-a">⛵</div><div class="v24-world-vessel vessel-b">⛵</div></div>`;
}
function localOverlay(){const sel=neighbor(game.localSelected)||NEIGHBORS[0],st=localState(sel.id);
 const routes=[[30,47,19,25],[30,47,44,66],[44,66,72,67],[30,47,51,42],[51,42,57,27],[51,42,73,38],[44,66,14,65]];
 return `<div class="viewbox local-view"><div class="view-header"><span>⚜ Latium — Province locale</span><button class="view-close" data-nav="ville" aria-label="Revenir à la ville">×</button></div><div class="local-body"><div class="local-map">
 ${v24ProvinceArt()}<img class="v28-province-landscape" aria-hidden="true" alt="" src="data:image/jpeg;base64,