{id:'sardinia',name:'Sardinia',x:42,y:41.7,power:14,bonus:{stone:18},desc:'Carrières de pierre et longues voies maritimes.',kind:'Île minière',land:'Italia'},
{id:'sicilia',name:'Sicilia',x:52,y:55,power:19,bonus:{wine:22},desc:'Des domaines viticoles et un détroit très disputé.',kind:'Île fertile',land:'Italia'},
