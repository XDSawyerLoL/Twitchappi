") center/cover no-repeat;filter:brightness(.7)}#storyOverlay .story-panel{position:absolute;inset:40px;display:flex;align-items:center;justify-content:center;padding:20px}#storyOverlay .story-card{max-width:960px;width:min(92vw,960px);background:linear-gradient(180deg,#f8ebcd,#ecd4a2 60%,#ddbb7e);border:4px solid #8d5e2d;border-radius:18px;box-shadow:0 30px 70px #000b;overflow:hidden;color:#2e1a0d}#storyOverlay .story-card .hero{padding:28px 34px 18px;background:linear-gradient(90deg,#6e120b,#9a2314,#640f08);color:#ffe9bc}#storyOverlay .story-card .hero h1{margin:0;font-size:54px;letter-spacing:1px}#storyOverlay .story-card .hero p{margin:8px 0 0;font-size:19px;color:#f9ddb0}#storyOverlay .story-body{padding:28px 34px 32px}#storyOverlay .story-body h2{margin:0 0 10px;font-size:34px}#storyOverlay .story-body p{font-size:20px;line-height:1.45;margin:12px 0}#storyOverlay .story-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:22px}#storyOverlay .story-small{font-size:15px;color:#7a5630}.start-blazon{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;background:#f1dfba;border:1px solid #bb9460;border-radius:999px;font-weight:bold;color:#6f110b}.intro-columns{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.intro-box{background:#f8e8c5;border:1px solid #bf975e;border-radius:10px;padding:16px}.tutorial-badge{display:inline-block;background:#7a140d;color:#ffe1b1;border-radius:999px;padding:4px 10px;font-size:12px;font-weight:bold;letter-spacing:.4px}.map-routes{position:absolute;inset:0;pointer-events:none}.map-routes svg{width:100%;height:100%}.map-panel{background:#ecd6ab;border:1px solid #b88b49;padding:12px;border-radius:8px}.sea-note{position:absolute;bottom:18px;left:18px;color:#e5f5f5;text-shadow:0 2px 4px #12465d;font-style:italic}.route-text{fill:#dfeec5;font-size:11px;font-style:italic}.route-path{stroke:#f8e7a2;stroke-width:2.8;fill:none;stroke-dasharray:7 7;opacity:.8;animation:dash 15s linear infinite}.route-path.alt{stroke:#b3ebff;opacity:.5}.port-dot{fill:#7d1c14;stroke:#f7dfa3;stroke-width:2}.compassRose{position:absolute;right:16px;bottom:16px;width:76px;height:76px;border-radius:50%;border:2px solid #f2e3a5;background:#1c5f7c66;color:#f3edcd;display:grid;place-items:center;font:700 24px Georgia;text-shadow:0 2px 4px #0d3b52}#globalIntroTag{position:absolute;z-index:6;left:169px;top:144px;background:#381d12d9;color:#fbe6b5;border:1px solid #d0aa62;border-radius:18px;padding:8px 14px;font-size:14px;font-weight:700}body.story-mode #advisorBox, body.story-mode #toast{display:none !important}body.story-mode #stage{filter:blur(1px)}@keyframes dash{to{stroke-dashoffset:-140}}.advisor-done{background:#2e7a45;color:#fff0c9;padding:6px 10px;border-radius:999px;font-weight:700;font-size:12px}.credits-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.credits-list .intro-box{font-size:16px}
/* CIVITAS 2.1 — animated Roman sprites; characters are not colored dots */
.citizen.sprite-npc {position:absolute;z-index:5;width:34px;height:70px;filter:drop-shadow(0 3px 2px #1a160d99);pointer-events:none;will-change:transform,left,top;}
.citizen.sprite-npc::before,.citizen.sprite-npc::after {display:none !important;content:none !important;}
.citizen.sprite-npc .spritewalk {width:100%;height:100%;object-fit:contain;display:block;user-select:none;pointer-events:none;}
.citizen.sprite-npc .crate {display:none !important;}
.citizen.sprite-npc.soldier {width:40px;height:82px;z-index:6;}
.citizen.sprite-npc.alt .spritewalk {filter:hue-rotate(24deg) saturate(.82)}
.citizen.sprite-npc.soldier .spritewalk {filter:saturate(1.32) contrast(1.06)}
#advisorBox .ad-portrait{width:82px;height:82px;flex:0 0 82px;overflow:hidden;position:relative;border:2px solid #ebc07d;border-radius:14px;background:#291910 !important;box-shadow:0 3px 9px #0005;}
#advisorBox .ad-portrait img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 23%;border:0;}
#advisorBox .ad-portrait::after,#advisorBox .ad-portrait::before{display:none !important;content:none !important;}
#advisorBox .ad-head{min-height:102px;}
#advisorBox .ad-title{font-size:23px;}
#advisorBox{width:405px;}
@media(prefers-reduced-motion:reduce){.citizen.sprite-npc {will-change:auto}}

.citizen.sprite-npc .spritewalk{background-repeat:no-repeat;display:block;width:100%;height:100%;background-position:0 0;object-fit:unset}
#advisorBox .ad-portrait .portraitAnim{width:82px;height:82px;background-repeat:no-repeat;background-position:0 0;background-size:656px 82px;display:block}

/* CIVITAS III : finition de l'interface, main d'oeuvre, map géographique */
:root{--v3-gold:#edce85}
#globalIntroTag{left:855px!important;top:156px!important;font-size:13px;opacity:.9}
#advisorBox{width:354px;left:17px;bottom:16px;max-height:306px;overflow:hidden}
#advisorBox .ad-body{padding:9px 13px 11px}
#advisorBox .ad-title{font-size:21px}
#advisorBox h3{font-size:20px;margin:4px 0}
#advisorBox p{font-size:15px;line-height:1.28}
#advisorBox .tip{font-size:12px}
#advisorBox .ad-actions{margin-top:5px}
.quest-content.tutorial-active{visibility:visible}
.viewbox.map-expanded{height:620px;top:170px;width:1130px;left:128px}
.viewbox.map-expanded .view-body{height:540px;padding:12px 17px}
.roman-map{position:relative;width:100%;height:440px;overflow:hidden;border:7px ridge #a57b3d;border-radius:10px;background:linear-gradient(#2c7688,#17465a);box-shadow:inset 0 4px 20px #042e3c,0 4px 10px #774b2673}
.roman-map-art{position:absolute;inset:0;pointer-events:none}
.roman-map-art svg{width:100%;height:100%}
.roman-map .g-label{font:italic 15px Georgia,serif;fill:#4b4c2c;stroke:#e5e3a8;stroke-width:.45px;paint-order:stroke;letter-spacing:2px;opacity:.82;text-anchor:middle}
.roman-map .sea-script{font:italic 32px Georgia,serif;fill:#d5e3bb;opacity:.3;letter-spacing:8px;text-anchor:middle}
.roman-map .sea-route{animation:seaRoute 24s linear infinite}@keyframes seaRoute{to{stroke-dashoffset:-140}}
.roman-map .geo-pin{position:absolute;z-index:3;transform:translate(-50%,-50%);border:none;border-radius:9px;background:linear-gradient(160deg,#f7e3b6,#d8b378);box-shadow:0 3px 5px #133c43aa,0 0 0 1px #90622d;color:#4a2412;padding:2px 6px 3px;display:flex;gap:4px;align-items:center;font:700 12px Georgia;white-space:nowrap;min-height:30px;transition:transform .12s;}
.roman-map .geo-pin.owned{background:linear-gradient(#9f2b17,#65160e);color:#ffecc9;box-shadow:0 0 0 2px #e9c783,0 3px 5px #153e43aa}
.roman-map .geo-pin.active{z-index:10;transform:translate(-50%,-50%) scale(1.18);outline:3px solid #ffdb72;box-shadow:0 0 20px #ffdd858e}
.roman-map .geo-pin:hover{z-index:10;transform:translate(-50%,-50%) scale(1.15)}
.roman-map .pin-icon{display:inline-grid;place-items:center;width:21px;height:21px;border-radius:50%;background:#7e2715;color:#ffe5a4;font-size:17px}
.roman-map .geo-pin.owned .pin-icon{background:#f2ce82;color:#771f16}
.map-kicker{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:14px;color:#674426;font-weight:bold;margin-bottom:8px;padding:1px 3px}
.map-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14px;margin-top:10px;color:#654222}
.map-legend{position:absolute;left:13px;bottom:10px;display:flex;gap:12px;align-items:center;background:#e9d7acdd;padding:6px 12px;border:1px solid #bd9b61;border-radius:6px;color:#4c311b;font:12px Georgia}
.map-legend span{display:inline-flex;align-items:center;gap:4px}.map-legend i{width:9px;height:9px;border-radius:50%;border:1px solid #d6b46c}.legend-owned{background:#a72f20}.legend-free{background:#f4e0b1}
.province-card .province-crest{font-size:32px;color:#96271b}.province-category{font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#8c612b;font-weight:700}
.province-card .owned-note{font:700 15px Georgia;color:#287344;background:#e8e3ba;border:1px solid #a8b178;padding:9px;border-radius:7px}
.province-card .chips{gap:6px}.province-card .chips .chip{font-size:13px}
.labor-box{background:linear-gradient(#fff0d0,#dec297);border:1px solid #a87c40;padding:10px;border-radius:8px;margin:13px 0;box-shadow:0 2px 2px #bc9659}.labor-box b{font-size:17px}.labor-box .labor-stats{margin:8px 0;font-size:14px}.worker-controls{display:flex;gap:6px;align-items:center}.worker-controls button{padding:6px 10px;font-size:15px}
.economy-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:13px 0 19px}.economy-summary>div{background:#f6e5c2;border:1px solid #cba673;border-radius:8px;padding:14px;display:flex;flex-direction:column;gap:5px}.economy-summary span{font-size:14px;color:#886035}.economy-summary b{font-size:24px;color:#522512}
.empire-actions{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}.research-card{display:flex;flex-direction:column}.research-card button{margin-top:auto;align-self:flex-start}
.event-stage{max-width:850px;margin:30px auto;padding:20px 38px;background:#f4e2c1;border:3px double #b99455;border-radius:13px;text-align:center}.event-stage h2{font-size:30px}.event-stage p{font-size:19px}.event-illust{font-size:68px;color:#842013}.event-choices{display:flex;gap:15px;justify-content:center;margin-top:20px}
#worldAlerts{position:absolute;z-index:22;right:52px;bottom:70px}.v3-event-badge{background:linear-gradient(#a12817,#641008);color:#f9e8bb;border:2px solid #e1bf73;border-radius:7px;padding:9px 16px;font:700 16px Georgia;box-shadow:0 5px 18px #0009;animation:eventPulse 2s ease-in-out infinite}@keyframes eventPulse{50%{filter:brightness(1.2)}}
.v3-extra-nav{position:absolute;z-index:11;background:linear-gradient(#6d1a11,#4a120b);color:#ffe9bb;border:1px solid #c89e5d;border-radius:5px;font:700 15px Georgia;box-shadow:0 2px 5px #1117;padding:6px 8px;min-width:150px;height:31px}
.v3-extra-nav:hover{background:#91301a}
.v3-site-construction{background:linear-gradient(#b985426e,#4a2b17a8)!important;display:flex!important;flex-direction:column;gap:0!important}.v3-site-construction .scaffold{font-size:51px;color:#c7903e;text-shadow:0 0 2px #000}.v3-site-construction .work-symbol{font-size:21px}
.v3-site-construction:after{content:' ';display:block;position:absolute;inset:6px;border:3px dashed #e2c38e;animation:sitePulse 1s ease-in-out infinite alternate}@keyframes sitePulse{to{opacity:.4}}
#stage #rightPanel{scrollbar-width:thin}
#advisorBox .ad-title{display:flex;align-items:center}
@media(max-height:680px){#advisorBox{transform:scale(.89);transform-origin:left bottom}}
#advisorBox.hidden-in-modal{display:none!important}
#advisorBox .ad-actions .btn-parch{padding:4px 8px;font-size:13px}
#questHeader{position:absolute;z-index:8;left:12px;top:757px;width:162px;height:39px;border:2px solid #ba8b3e;border-radius:22px 22px 12px 12px;background:linear-gradient(120deg,#714013,#e6ca83 30%,#f5e1b0 70%,#aa742c);box-shadow:0 2px 4px #2e190b;text-align:center;display:grid;place-items:center;font:bold 20px Georgia;color:#563110;text-shadow:0 1px #ffeac1}
#questList{left:16px;top:790px;width:351px;height:120px;padding:7px 9px;z-index:8;background:linear-gradient(120deg,#e5cb99,#f6e4bf,#e8ce9c);box-shadow:inset 0 0 0 2px #c3a06b;border-radius:4px 4px 9px 9px}
#questList button{font-size:14px;line-height:1.35}
#advisorBox.visible:not(.hidden-in-modal)~#questHeader{opacity:0}
#stage .rising-building{filter:drop-shadow(0 5px 4px #241208bb) sepia(.25)}
#stage .v3-site-construction{animation:scaffoldBreath 2s ease-in-out infinite alternate;pointer-events:none}@keyframes scaffoldBreath{to{background-color:#b5895b64}}
#storyOverlay .story-card .hero h1{text-shadow:0 3px 1px #4b0a06,0 0 18px #d3b368}
#stage .hit-plot.empty:hover{border-color:#e9ca7e;box-shadow:0 0 0 2px #f4d17a80,0 0 22px #ffd99388}
/* CIVITAS IV — compact game panels and interactive state */
:root{--iv-ink:#412514;--iv-carmine:#7b1b0d;--iv-gold:#cca363;--iv-paper:#f6e5be}
#rightPanel.card-zone{padding:0!important;overflow:hidden!important;height:511px;top:231px;left:1277px;width:357px;border-left:2px solid #b1834f;border-right:2px solid #96602c;background:linear-gradient(93deg,#d2ad75 0%,#f3e0b8 5%,#f5e6c7 53%,#e1bc81 100%);scrollbar-color:#ad7443 #e9cda2}
#rightPanel.card-zone:after{content:none!important;display:none}
#panelTitle.panel-top{background:linear-gradient(120deg,#651208,#942718,#651008);height:41px;top:184px;border:1px solid #b97e37;box-shadow:0 1px 0 #fee6b6 inset,0 3px 5px #30180a88;font-size:22px;line-height:32px;padding:0;z-index:10}
#rightPanel .v4-inspector,#rightPanel .v4-catalog{height:100%;overflow-y:auto;scrollbar-color:#bd9158 #ead2a7;padding:15px 19px 16px 17px;color:var(--iv-ink);font-size:16px;line-height:1.28}
.v4-eyebrow{color:#815d36;font-size:11px;letter-spacing:1.2px;font-weight:700;margin:0 0 10px}
.v4-building{display:grid;grid-template-columns:100px 1fr;align-items:center;gap:11px;padding-bottom:11px;margin-bottom:12px;border-bottom:1px solid #bd965f}
.v4-building img{width:98px;height:91px;object-fit:contain;filter:drop-shadow(1px 6px 3px #634a2f69)}
.v4-building h3{font-size:25px;margin:0;color:#4a2512;line-height:1.05}
.v4-building p{font-size:14px;margin:6px 0 0;line-height:1.25;color:#6c4e2f}
.v4-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0 14px}
.v4-stats>div{background:#f8eccfa6;border:1px solid #ceb084;box-shadow:0 1px 1px #fff8df inset;border-radius:8px;padding:9px 10px}
.v4-stats small{display:block;color:#6f573d;font-size:12px;margin-bottom:3px}
.v4-stats strong{font-size:19px;color:#642417}
.v4-section-title{display:flex;justify-content:space-between;align-items:baseline;gap:5px;font:bold 19px Georgia;color:#452311;margin:14px 0 8px}
.v4-section-title span{font:bold 12px Georgia;color:#785337;text-align:right}
.v4-workshop{padding:9px 12px;background:#ead0a2b5;border:1px solid #c8a370;border-radius:9px;margin-bottom:10px}
.v4-workshop .v4-section-title{margin:0 0 9px;font-size:17px}
.v4-workshop>small{display:block;color:#6b4a2c;font-size:12px;margin-top:6px;line-height:1.3}
.v4-labor-track{height:10px;border-radius:9px;overflow:hidden;background:#a78354;box-shadow:inset 0 1px 3px #5f371c8c;margin:8px 0}
.v4-labor-track>i{display:block;height:100%;background:linear-gradient(90deg,#297a4b,#89ae68,#d8bb64);border-radius:9px;transition:width .2s}
.v4-labor-buttons{display:flex;gap:5px}
.v4-labor-buttons button{border:1px solid #b1884d;background:linear-gradient(#fff0c8,#dbb784);color:#512712;padding:5px 0;border-radius:5px;flex:1;font:bold 14px Georgia}
.v4-labor-buttons button:hover{filter:brightness(1.07)}
.v4-costline{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0 6px}
.v4-cost{display:inline-flex;gap:3px;align-items:center;background:#fdf0d4;border-radius:6px;padding:5px 7px;border:1px solid #ccaf7d;font:bold 14px Georgia;color:#5f4327}
.v4-cost.short{border-color:#d58b72;background:#f6d8c2;color:#9b2616}
.v4-cost.okay{color:#3f613c}
.v4-shortage{color:#a22d19;font:bold 13px/1.3 Georgia;background:#fff0de;border-left:3px solid #bf462b;padding:6px 9px;margin:8px 0;border-radius:2px}
.v4-shortage small{display:block;color:#67452b;font-weight:normal;margin-top:2px}
.v4-duration{font-size:13px;color:#67492a;margin:9px 0}
.v4-cta.btn-red{width:100%;padding:10px 7px;margin:3px 0 13px;min-height:43px;font-size:16px}
.v4-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:space-between;border-top:1px solid #c9a774;padding-top:11px}
.v4-actions button{font-size:13px;min-height:31px;flex:1}
.v4-actions .v4-danger,.v4-job-card .v4-danger{color:#992e20;border-color:#be7858}
.v4-explainer{margin:15px 0;padding:11px;background:#f4e6c8;border:1px solid #cfb182;border-radius:8px;color:#69472a;line-height:1.35;font-size:15px}
.v4-inspector .v4-row{display:flex;justify-content:space-between;align-items:center;gap:4px;border-bottom:1px solid #d1b27f;padding:9px 0}
.v4-inspector .v4-progress,.v4-job-card .v4-progress{height:14px;background:#946d3e;box-shadow:inset 0 2px 3px #562a0e;border-radius:15px;overflow:hidden;margin:12px 0}
.v4-progress i{display:block;height:100%;background:linear-gradient(90deg,#ac692b,#eac46f,#fff0ac);border-radius:15px}
.v4-mini-stat{color:#745139;font-size:13px;margin-bottom:10px}
.v4-tabs{position:sticky;top:-15px;z-index:2;display:grid;grid-template-columns:repeat(4,1fr);gap:3px;background:#e8cc99;box-shadow:0 3px 10px #855b3222;padding:6px 1px 8px;margin:0 -4px 7px;border-bottom:1px solid #c6a56f}
.v4-tabs button{background:#eed7aa;color:#61452d;border:1px solid #c9a778;border-radius:5px;padding:8px 3px;font:700 12px Georgia}
.v4-tabs button.active{background:#84241a;color:#fff0ce;box-shadow:inset 0 1px #c46c3c}
.v4-catalog-list{display:flex;flex-direction:column;gap:4px}
.v4-card{display:grid;grid-template-columns:67px 1fr 29px;align-items:center;gap:7px;min-height:81px;border-bottom:1px solid #c1a272;padding:5px 0 7px}
.v4-card img{width:67px;height:65px;object-fit:contain;filter:drop-shadow(0 3px 2px #5c371b55)}
.v4-card-info strong{display:block;font-size:17px;line-height:1.1;color:#4e2814}
.v4-card-info>small{font-size:12px;line-height:1.13;color:#755238;display:block;margin:3px 0 5px}
.v4-card-cost{display:flex;gap:5px;flex-wrap:wrap;font-size:11px;color:#5e422a}
.v4-card-cost .missing{color:#a22c21;font-weight:bold}
.v4-card>button{border:1px solid #b68e55;background:linear-gradient(#f8e4bb,#d5aa6b);color:#733b16;border-radius:6px;height:31px;width:29px;font:bold 21px Arial;box-shadow:inset 0 1px #fff6d9}
.v4-card>button:disabled{opacity:.48}
.v4-card>button:hover:not(:disabled){filter:brightness(1.14)}
.v4-catalog-help{font-size:12px;color:#704b2e;margin:9px 2px;text-align:center}
.v4-switch-banner{border:1px solid #c09a63;background:#f7e6c4;border-radius:8px;padding:8px;display:flex;align-items:center;flex-wrap:wrap;font-size:12px;gap:4px;margin-bottom:8px}
.v4-switch-banner button{border:0;border-bottom:1px dotted #8d4f29;background:transparent;color:#7e291a;font-weight:bold;padding:3px}
.v4-hud-icon{font-size:25px;color:#f8c36d;text-shadow:0 2px 2px #42291a}
#v4BuildHud{position:absolute;z-index:15;left:425px;bottom:29px;width:445px;min-height:66px;display:flex;align-items:center;gap:10px;background:linear-gradient(95deg,#24180de5,#513018e8);border:2px solid #b88c4f;border-radius:12px;box-shadow:0 5px 20px #0009;color:#f5e6bd;padding:9px 12px}
#v4BuildHud .v4-hud-main{flex:1;min-width:0}
#v4BuildHud strong{display:block;font-size:14px;letter-spacing:.1px}
#v4BuildHud strong span{font-size:12px;color:#d0b285}
#v4BuildHud small{display:block;font-size:12px;color:#e1c18a}
#v4BuildHud button{color:#fff0c4;border:1px solid #bb8753;background:#71311c;border-radius:5px;padding:8px;font:bold 13px Georgia;white-space:nowrap}
#v4BuildHud button:hover{background:#9e4922}
.v4-hud-progress{height:6px;background:#84502d;overflow:hidden;border-radius:5px;margin:5px 0 4px}
.v4-hud-progress i{display:block;height:100%;background:#ecc76e}
.queued-label{position:absolute;top:25px;left:12px;background:#644026e3;color:#ffe2a3;padding:3px 6px;border-radius:7px;font:bold 13px Georgia}
.v4-job-grid{display:grid;gap:12px;margin:18px 0}
.v4-job-card{display:grid;grid-template-columns:90px 1fr auto;align-items:center;gap:17px;background:linear-gradient(110deg,#f6e8c8,#e9cc98);border:2px solid #c7a371;border-radius:10px;padding:12px}
.v4-job-icon img{width:80px;height:70px;object-fit:contain}
.v4-job-card strong{display:block;font-size:22px}
.v4-job-card small{display:block;color:#7d5739;font-size:14px;margin:3px 0}
.v4-empty-jobs{padding:25px;text-align:center;font-size:21px;color:#6e4b2c;background:#f7e5c0;border:1px solid #c5a36c;border-radius:10px}
.v4-footer-actions{display:flex;justify-content:flex-end}
.v4-voyage{border-top:1px solid #c8a577;padding-top:10px;margin-top:15px}
.v4-voyage>p{font-size:14px;line-height:1.3}
.v4-voyage .btn-parch{width:100%}
.v4-odds{margin:9px 0;padding:9px 10px;background:#efe0ba;border:1px solid #c6a26d;color:#573c27;font-size:13px;border-radius:8px}
.v4-odds strong{color:#792c1a}
.roman-map .geo-pin.active{filter:drop-shadow(0 0 8px #f6e09e)}
.roman-map-art{filter:saturate(1.08)}
.viewbox{border:6px solid #9c6a37;box-shadow:0 14px 50px #000a, inset 0 0 0 2px #e5c98b;border-radius:12px}
.view-header{box-shadow:inset 0 1px #db9a53;background:linear-gradient(90deg,#611109,#922617,#5a110a)}
.view-body{background:linear-gradient(120deg,#f6e6c5,#ead0a1)}
#advisorBox{border:2px solid #a27436;box-shadow:0 12px 30px #0008}
#advisorBox .ad-head{background:linear-gradient(90deg,#651008,#922519,#68140a)}
#storyOverlay .story-panel .story-card{border:3px solid #bc8d50;box-shadow:0 30px 80px #000e,0 0 0 7px #271609ad;border-radius:14px;max-width:1030px}
#storyOverlay .story-card .hero{background:linear-gradient(115deg,#55120c,#a12917 55%,#491008);border-bottom:4px solid #ce9f5c}
#storyOverlay .story-card .hero h1{font-size:51px;letter-spacing:2px;text-shadow:0 2px 4px #260b07}
#storyOverlay .story-card .hero p{font-size:17px;color:#f7dcae}
#storyOverlay .story-body{background:linear-gradient(130deg,#f9ebce,#edd7ad 68%,#d6b47b);padding:27px 34px}
#storyOverlay .story-body h2{font-size:30px;margin:12px 0}
#storyOverlay .story-body>p{font-size:17px}
#storyOverlay .intro-box{border:1px solid #c9a36d;background:#f9e9c9;box-shadow:inset 0 1px #fff7df}
#storyOverlay .intro-box p{font-size:17px}
#storyOverlay .story-small{font-size:14px}
#storyOverlay .story-actions .btn-red{padding:12px 16px;box-shadow:inset 0 1px #ffcc8d,0 3px #653516}
#storyOverlay .story-actions .btn-parch{padding:11px 14px}

.v4-route-overlay{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none;overflow:visible}
.v4-route-glow{fill:none;stroke:#f9d86b;stroke-width:10;opacity:.22;filter:blur(5px)}
.v4-route-path{fill:none;stroke:#ffe5a2;stroke-width:3;stroke-dasharray:10 8;filter:drop-shadow(0 1px 2px #6b3f1e);animation:v4route 17s linear infinite}
@keyframes v4route{to{stroke-dashoffset:-200}}
.roman-map .geo-pin{z-index:4}

/* Province context navigation, avoids deeply hidden actions */
.v4-province{padding:13px 14px 15px;line-height:1.25;color:#4c2b18}
.v4-prov-head{display:flex;align-items:center;gap:11px;margin-bottom:8px}
.v4-prov-head .v4-prov-seal{width:45px;height:45px;display:grid;place-items:center;background:#7b2518;color:#f7d899;border:2px solid #b7854c;border-radius:12px;font-size:26px}
.v4-prov-head small{font-size:11px;font-weight:700;letter-spacing:1.4px;color:#845d38}
.v4-prov-head h3{margin:2px 0 0;font-size:29px;color:#432412}
.v4-prov-desc{font-size:14px;line-height:1.3;margin:8px 0 13px;color:#725039}
.v4-prov-tabs{display:flex;border-bottom:1px solid #bd965d;gap:3px;margin:0 0 14px}
.v4-prov-tabs button{flex:1;background:#e4c492;border:1px solid #b68d5a;color:#684129;padding:8px 2px;font:bold 13px Georgia;border-radius:6px 6px 0 0}
.v4-prov-tabs button.active{background:#84251b;color:#fce5b6;box-shadow:inset 0 1px #e2b371}
.v4-prov-row{display:flex;justify-content:space-between;gap:5px;align-items:center;padding:9px 2px;border-bottom:1px solid #cfb080;font-size:14px}
.v4-prov-row strong{text-align:right;font-size:16px}
.v4-province .v4-section-title{margin-top:14px;margin-bottom:6px;font-size:17px}
.v4-province .chips{margin:10px 0}
.v4-p-tip{font-size:13px;line-height:1.28;color:#745236;margin-top:11px}
.v4-prov-action{width:100%;margin-top:10px;padding:12px 8px!important}
.v4-province .v4-odds{margin:11px 0;padding:10px}

/* CIVITAS V: rebuilt panel shell; obscures old static painted UI layer. */
#v5PanelBackdrop{position:absolute;z-index:8;left:1244px;top:176px;width:414px;height:608px;pointer-events:none;border:8px solid #6d3419;border-radius:18px 18px 15px 15px;background:linear-gradient(100deg,#4a2313,#a6733a 2%,#f6e9c6 6%,#f5dfb1 92%,#9b5c2d 97%,#432313);box-shadow:0 18px 38px #201006bb,inset 0 0 0 3px #d9b273,inset 0 0 33px #aa75466a}
#v5PanelBackdrop:before{content:'';position:absolute;inset:7px;pointer-events:none;border:1px solid #ae7c43;border-radius:7px;background:linear-gradient(180deg,#e4c995,#f7e9cb 18%,#f0dcaf 73%,#dcb77b)}
#panelTitle{z-index:14!important;left:1274px!important;top:192px!important;width:356px!important;height:45px!important;line-height:41px!important;border:2px solid #c79a59!important;border-radius:7px!important;box-shadow:0 0 0 5px #5c2b16,0 5px 10px #0007!important;color:#ffe9b5!important;text-shadow:0 2px 2px #3e0d05!important}
#rightPanel{z-index:12!important;left:1265px!important;top:248px!important;width:371px!important;height:512px!important;border:1px solid #c69b61!important;border-radius:7px!important;background:linear-gradient(105deg,#eed3a5,#fff0d0 10%,#f6e3b9 88%,#ddb783)!important;box-shadow:0 8px 20px #2a15065e!important}
#rightPanel .v4-catalog,#rightPanel .v4-inspector{padding:13px 15px 14px 15px!important}
#rightPanel .v4-eyebrow{letter-spacing:1.2px;color:#80542d;font-size:11px;font-weight:700}
#rightPanel .v4-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:3px;margin-bottom:8px}
#rightPanel .v4-tabs button{font-size:11px;padding:7px 1px;white-space:nowrap}
#rightPanel .v4-card{min-height:77px;padding:5px 3px;gap:8px}
#rightPanel .v4-card img{width:70px;height:62px}
#rightPanel .v4-card-info strong{font-size:15px}
#rightPanel .v4-card-info small{font-size:12px}
#rightPanel .v4-building{background:#faedcf;border:1px solid #c9a271;border-radius:8px;padding:11px 8px}
#rightPanel .v4-building h3{font-size:24px;color:#5a2a16;margin:0 0 4px}
#rightPanel .v4-building img{width:99px;height:86px;object-fit:contain}
#rightPanel .v4-stats{display:grid;grid-template-columns:1fr 1fr;gap:7px}
#rightPanel .v4-stats>div{background:#fff3d8;border:1px solid #c9aa77;border-radius:7px;text-align:center;padding:9px 4px}
#rightPanel .v4-stats strong{font-size:22px}
#rightPanel .v4-workshop{background:linear-gradient(100deg,#f8e9c9,#efdab0);border:1px solid #ceaa73;border-radius:8px;padding:9px;margin-top:9px}
#rightPanel .v4-cta{width:100%;padding:12px 8px;margin-top:10px}
#rightPanel button:disabled{cursor:not-allowed;opacity:.55}
.v5-labor-warning{border:1px solid #be7a41;background:#fff1d4;border-radius:8px;padding:10px;margin:8px 0;display:grid;gap:7px;color:#5d331d;font-size:13px}
.v5-labor-warning strong{font-size:15px;color:#8a301a}
.v5-assign,.v5-catalog-relief{border:1px solid #a97435;border-radius:7px;padding:7px 10px;background:linear-gradient(#fbe7af,#cf9e50);color:#4c2714;font:bold 13px Georgia;cursor:pointer;box-shadow:0 2px 0 #a97843}
.v5-assign:hover:not(:disabled),.v5-catalog-relief:hover{filter:brightness(1.06)}
.v5-assign:disabled{opacity:.5;cursor:not-allowed}
.v5-catalog-relief{display:block;width:100%;margin-top:8px}
#advisorBox{z-index:95!important;left:100px!important;bottom:20px!important;width:387px!important;max-height:none!important;transform:none!important;border:2px solid #d2a661!important;border-radius:12px!important;background:linear-gradient(#f2dfb6,#e4c089)!important;box-shadow:0 10px 30px #0008!important;overflow:hidden!important}
#advisorBox .ad-head{min-height:72px!important;padding:7px 10px!important;gap:10px!important;background:linear-gradient(105deg,#63100a,#912315)!important}
#advisorBox .ad-title{font-size:20px!important}
#advisorBox .ad-sub{font-size:12px}
#advisorBox .ad-portrait{width:78px!important;height:66px!important;flex:0 0 78px!important;border:1px solid #c99453!important;border-radius:8px!important;background:#3a2010!important;overflow:hidden!important}
#advisorBox .portraitAnim{display:block!important;width:96px!important;height:96px!important;background-repeat:no-repeat!important;background-size:768px 96px!important;transform:translate(-9px,-1px) scale(.82)!important;transform-origin:top left!important}
#advisorBox .ad-body{padding:9px 12px 10px!important}
#advisorBox h3{font-size:20px!important;margin:0 0 5px!important}
#advisorBox p{font-size:14px!important;line-height:1.25!important;margin:4px 0!important}
#advisorBox p.tip{display:none!important}
#advisorBox .ad-actions{gap:8px!important;margin-top:7px!important}
#advisorBox .ad-actions .skip{font-size:12px}
#advisorBox .step{font-size:12px}
#advisorBox .tutorial-badge{font-size:10px;padding:3px 8px}
.v5-advisor-aid{font-size:12px;color:#85401d;background:#fef2d6;border:1px solid #d5ac66;padding:7px;border-radius:5px;margin:5px 0}
.v5-advisor-aid button{display:block;margin-top:5px;width:100%}
.v5-choose-free{margin:4px 0;font-size:13px!important}
#v5VersionMark{position:absolute;right:48px;bottom:17px;z-index:4;font:700 11px Georgia;background:#351a0d;color:#cdae6f;padding:4px 10px;border-radius:22px;letter-spacing:2px;opacity:.8}
#v4BuildHud{left:514px!important;bottom:20px!important;width:420px!important;min-height:58px!important;padding:7px 11px!important}
#v4BuildHud .v4-hud-main strong{font-size:13px}
#v4BuildHud .v4-hud-main small{font-size:11px}
#viewOverlay .viewbox{box-shadow:0 18px 50px #0009!important}
/* Ensure plot controls remain clickable and visible outside UI regions. */
#plots{position:absolute;inset:0;pointer-events:none}
#plots .hit-plot{pointer-events:auto}

/* CIVITAS XII — coherent foundation, 3 views, uncropped UI */
#stage{isolation:isolate}
#stage .timerbox{right:36px;bottom:23px;width:146px;height:35px;font:700 18px Georgia;white-space:nowrap;display:flex;align-items:center;justify-content:center;padding:0 8px;background:#24170df4;border:1px solid #a6773d;box-shadow:0 3px 12px #0007}
#stage .resourceGroup{box-sizing:border-box;width:94px;overflow:visible;text-align:center;padding:4px 2px 0;white-space:nowrap}
#stage .resourceGroup .number{font-size:22px;line-height:1.2}
#stage .resourceGroup .rate{font-size:15px;line-height:1.3}
#stage #rightPanel{left:1259px;top:234px;width:362px;height:505px;padding:0;overflow:hidden;border-radius:0 0 7px 7px;box-sizing:border-box}
#stage .panel-top{left:1271px;top:188px;width:339px;font-size:21px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#stage #rightPanel .v4-catalog,#stage #rightPanel .v4-inspector{max-height:100%;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;padding:14px 16px 20px!important;box-sizing:border-box}
#stage #rightPanel .v4-card{min-height:70px;box-sizing:border-box}
#stage #rightPanel .v4-card img{object-fit:contain;flex:0 0 70px}
#stage #rightPanel .v4-card-info{min-width:0}
#stage #rightPanel .v4-card-info small{white-space:normal;line-height:1.2}
#stage #rightPanel .v4-building{overflow:hidden;box-sizing:border-box}
#stage #rightPanel .v4-building img{object-fit:contain;flex-shrink:0}
#stage .hit-plot.central-plot{width:180px;height:140px;z-index:12;border-radius:42%;overflow:visible}
#stage .hit-plot.central-plot.selected{box-shadow:0 0 0 3px #f4ca76aa,0 4px 25px #0005}
#stage .hit-plot .sprite.hall-sprite{width:175px;height:143px;left:2px;top:-39px;object-fit:contain}
#stage .foundation-mark{position:absolute;left:50%;top:47%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:8px 12px;background:#3a2116e5;border:2px solid #e6c583;border-radius:12px;box-shadow:0 0 21px #f5ce6b66;white-space:nowrap;color:#ffe4ab;text-shadow:none}
#stage .foundation-mark strong{font-size:24px;line-height:1;color:#f5cf86}
#stage .foundation-mark span{font-size:16px;font-weight:700}
#stage .foundation-mark small{font-size:11px;color:#ecd2a1}
#stage .plot-wait{position:absolute;top:42px;left:38px;font-size:21px;color:#ead5a5;text-shadow:0 2px 3px black}
#stage .plot-wait small{display:block;font-size:10px;white-space:nowrap}
#stage .v7-views{position:absolute;z-index:18;left:724px;top:168px;display:flex;gap:4px;background:#2d1b0fe8;border:1px solid #c6a16b;border-radius:22px;padding:5px;box-shadow:0 5px 17px #0b0a08a0}
#stage .v7-views button{border:0;background:transparent;color:#f2dfb5;font:700 14px Georgia;border-radius:15px;padding:7px 13px;cursor:pointer}
#stage .v7-views button:hover,#stage .v7-views button.active{background:linear-gradient(#a34425,#722319);color:#ffe8b3}
#stage #advisorBox{width:360px;left:92px;bottom:28px;max-height:300px;overflow:auto;z-index:30}
#stage #advisorBox.hidden-in-modal{display:none!important}
#stage .quest-header{z-index:5}
#stage .quest-content.tutorial-active,.quest-header:has(+ .quest-content.tutorial-active){visibility:hidden!important}
#stage .viewbox.local-view{left:115px;top:175px;width:1105px;height:640px;border-width:8px;overflow:hidden}
#stage .viewbox.local-view .view-header{min-height:56px;font-size:24px;display:flex;align-items:center;justify-content:center}
#stage .local-body{height:calc(100% - 56px);background:#ead2aa;padding:0;display:flex;flex-direction:column;overflow:hidden}
#stage .local-map{position:relative;flex:1;min-height:0;background:#2b7182;overflow:hidden}
#stage .local-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#stage .local-node{position:absolute;transform:translate(-50%,-50%);z-index:3;border:0;background:transparent;display:flex;flex-direction:column;align-items:center;gap:1px;color:#fff6d9;cursor:pointer;min-width:114px;max-width:150px;text-shadow:0 2px 4px #241409,0 0 9px #141c16;transition:transform .15s}
#stage .local-node .node-building{width:50px;height:43px;display:flex;justify-content:center;align-items:center;border:2px solid #f1d6a0;border-radius:8px;background:linear-gradient(160deg,#884e30,#432b20);box-shadow:0 7px 13px #0008;font-size:29px;color:#ffe29b}
#stage .local-node .node-name{background:#271c13dd;border:1px solid #d3b275;border-radius:15px;padding:3px 7px;white-space:nowrap;font-weight:700;font-size:14px}
#stage .local-node small{background:#161512a9;color:#f4e0bd;padding:2px 5px;border-radius:6px;font-size:10px;white-space:nowrap}
#stage .local-node.my-city .node-building{background:linear-gradient(#9b2916,#5b130d);color:#fff0ad;border-color:#ffdc85}
#stage .local-node.vacant .node-building{background:#b8a7839e;color:#4f4936;border-style:dashed}
#stage .local-node.active{z-index:5;transform:translate(-50%,-50%) scale(1.12)}
#stage .local-node.active .node-building{box-shadow:0 0 0 4px #ffdda6,0 0 28px #ffdc74,0 9px 10px #0009}
#stage .local-node:hover{transform:translate(-50%,-50%) scale(1.1)}
#stage .local-legend{position:absolute;left:14px;bottom:13px;display:flex;gap:12px;background:#201c16dc;color:#f1e4c0;border:1px solid #c2a377;border-radius:8px;padding:8px 12px;font-size:12px}
#stage .local-bottom{min-height:57px;background:linear-gradient(#f1ddaf,#d1a972);border-top:2px solid #986d40;display:flex;justify-content:space-between;align-items:center;padding:8px 16px;gap:14px}
#stage .local-bottom div:first-child{display:flex;flex-direction:column;gap:4px}
#stage .local-bottom strong{font-size:17px}
#stage .local-bottom span{font-size:12px;color:#6b4a2e}
#stage .local-bottom div:last-child{display:flex;gap:8px}
#stage #rightPanel .local-inspector{height:100%;overflow-y:auto;padding:18px 17px 20px;box-sizing:border-box;color:#392217;scrollbar-width:thin}
#stage .local-inspector .local-eyebrow{font-size:11px;color:#825327;font-weight:bold;letter-spacing:1.5px}
#stage .local-inspector .local-inspect-art{height:80px;display:grid;place-items:center;color:#85422a;font-size:52px;background:radial-gradient(ellipse,#f9e6b8,#d9b57e);border:1px solid #b48e55;border-radius:9px;margin:10px 0}
#stage .local-inspector h2{font-size:25px;margin:6px 0}
#stage .local-inspector p{line-height:1.35;margin:4px 0 10px}
#stage .local-stat{display:flex;justify-content:space-between;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid #b99462;font-size:14px}
#stage .local-stat strong{font-size:14px;text-align:right}
#stage .local-controls{display:flex;flex-direction:column;gap:8px;margin-top:17px}
#stage .local-controls button{text-align:center;min-height:44px}
#stage .local-controls button small{font-size:11px;display:block;font-weight:400}
#stage .local-inspector .local-explain{font-size:12px;color:#75552c;line-height:1.4;margin-top:13px}
#stage .mission-ticket{background:#533321;color:#ffeac2;border:1px solid #dcb374;border-radius:7px;padding:12px;margin:10px 0;display:flex;gap:4px;flex-direction:column}
#stage .mission-ticket span{font-size:13px}
#stage .senate-locked{text-align:center;max-width:700px;margin:auto;padding:30px 22px}
#stage .senate-icon{font-size:60px}
#stage .senate-locked p{font-size:18px;line-height:1.45}

#questBackgroundMask{display:none;position:absolute;left:0;bottom:0;width:379px;height:194px;z-index:7;pointer-events:none;background:linear-gradient(100deg,#1c150ebf,#22170db7);box-shadow:inset 0 25px 30px #2a21196b}
#stage:has(#advisorBox.visible) #questBackgroundMask,#stage:has(.viewbox) #questBackgroundMask{display:block}
#stage:has(#advisorBox.visible) #questHeader,#stage:has(#advisorBox.visible) #questList,#stage:has(.viewbox) #questHeader,#stage:has(.viewbox) #questList{visibility:hidden!important}

#cityNav{position:absolute;left:96px;top:188px;z-index:10;display:flex;gap:6px;align-items:center;max-width:460px;padding:7px 9px;background:linear-gradient(90deg,#35170df0,#532914eb);color:#ffefd0;border:1px solid #c49b5a;border-radius:9px;box-shadow:0 7px 20px #0007;font:700 13px Georgia}#cityNav button{border:1px solid #b08c55;border-radius:5px;background:linear-gradient(#f6e5bf,#d8b478);padding:6px 9px;color:#54260d;font:700 13px Georgia;cursor:pointer;white-space:nowrap}#cityNav button:hover{filter:brightness(1.1)}#cityNav span{white-space:nowrap;max-width:112px;overflow:hidden;text-overflow:ellipsis}
.city-manager{border:2px solid #c09b69;background:#f5e1babb;border-radius:10px;padding:14px;margin-bottom:20px}.manager-heading{display:flex;justify-content:space-between;align-items:center;gap:9px}.manager-heading h2{margin:5px 0}.city-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.city-card{background:linear-gradient(#fff0ce,#e7c79a);border:1px solid #b88c58;border-radius:9px;padding:14px}.city-card h3{margin:4px 0;font-size:23px}.city-card p{font-size:15px}.city-stock{border-top:1px solid #b98f56;border-bottom:1px solid #b98f56;padding:7px 0;margin:9px 0}.city-convoy{margin-top:9px;font-size:13px;line-height:1.5}.city-convoy div{display:flex;gap:6px;flex-wrap:wrap;margin-top:5px}
#stage .local-node.my-city .node-building{background:linear-gradient(#ad481a,#6b1a0d);border-color:#ffdb92;box-shadow:0 0 0 3px #ffdd8770,0 7px 13px #0008}
#stage .timerbox{right:27px;bottom:11px;width:208px;height:54px;white-space:nowrap;border:3px ridge #cf9e4b;background:radial-gradient(ellipse at center,#462318,#21110e);box-shadow:inset 0 2px 7px #0009,0 4px 9px #0007;border-radius:32px;padding:10px 12px;font-size:18px;z-index:9}
#stage .resourceGroup .number{font-size:20px;white-space:nowrap}#stage .resourceGroup.population .number{font-size:17px}

#stage[data-region="vacant1"] #art{filter:hue-rotate(-14deg) saturate(1.11) brightness(.99)}
#stage[data-region="vacant2"] #art{filter:hue-rotate(8deg) saturate(1.16) brightness(1.035)}
#regionNote{position:absolute;z-index:7;left:340px;top:189px;max-width:360px;pointer-events:none;border:1px solid #e3bd72;border-radius:0 0 13px 13px;background:linear-gradient(90deg,#3d2316ed,#5f3b22ec);color:#fff1cd;font:700 15px Georgia;padding:6px 17px;box-shadow:0 5px 12px #0005;text-shadow:0 2px 3px #0007}
#regionDecor{position:absolute;inset:0;pointer-events:none;z-index:2}
.common-node{position:absolute;z-index:5;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;width:156px;min-height:83px;border:2px solid #dbba78;border-radius:13px;background:linear-gradient(155deg,#f6e7b9,#b99255);box-shadow:0 5px 0 #55492cb8,0 10px 20px #082e406a;color:#3c2917;text-shadow:none;cursor:pointer;padding:6px}
.common-node>span{font-size:23px}.common-node strong{font:bold 15px Georgia}.common-node small{font:12px Georgia}.common-node.active{outline:4px solid #f9e2a2}.common-node:hover{filter:brightness(1.10)}
.common-icon{font-size:52px;margin:12px auto;text-align:center}.common-controls{display:flex;gap:8px;flex-wrap:wrap;padding:12px 0}.common-controls button{flex:1}.local-inspector .local-stat strong{overflow-wrap:anywhere}

/* CIVITAS XII — independent city renderer. The original illustrated scene remains available. */
#isoToggle{position:absolute;z-index:19;left:1024px;top:154px;background:linear-gradient(180deg,#8b2417,#5c120b);border:2px solid #e2bb70;border-radius:8px;color:#ffeac1;font:700 17px Georgia;padding:9px 16px;box-shadow:0 5px 17px #17100b88;cursor:pointer;min-width:200px;white-space:nowrap}
#isoToggle:hover{filter:brightness(1.15)}
#isoDistrict{position:absolute;left:85px;top:179px;width:1168px;height:743px;z-index:14;background:#1a3c4e;border:5px ridge #a37b40;border-radius:12px;box-shadow:0 14px 30px #07080b99;display:none;overflow:hidden;color:#fff0c8}
#isoDistrict.visible{display:block}
#isoDistrict .iso-heading{height:43px;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(90deg,#55160e,#873021 55%,#542014);padding:5px 12px;border-bottom:2px solid #d2aa67}
#isoDistrict .iso-heading strong{display:block;letter-spacing:.12em;font:700 17px Georgia}
#isoDistrict .iso-heading small{color:#e1c28b;font:13px Georgia}
#isoDistrict .iso-tools{position:absolute;right:12px;top:54px;z-index:2;display:flex;gap:6px}
#isoDistrict .iso-tools button{border:1px solid #e1bd7d;border-radius:5px;background:#46211d;color:#fff4cb;font:bold 23px/1 Georgia;width:38px;height:31px;cursor:pointer}
#isoDistrict .iso-tools #isoClose{width:44px;background:#782216}
#isoDistrict canvas{display:block;width:1158px;height:662px;touch-action:none;cursor:grab;background:#2d7c98}
#isoDistrict canvas:active{cursor:grabbing}
#isoDistrict .iso-info{height:30px;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:5px 12px;background:#2c1d15;font:13px Georgia;white-space:nowrap}
#isoDistrict #isoDetails{font-weight:bold;color:#f9d69e}
#isoDistrict .iso-city-menu{position:absolute;right:16px;bottom:52px;background:#3d221cde;border:1px solid #d5ae77;border-radius:7px;padding:8px 13px;color:#ffedc1;font:700 13px Georgia;cursor:pointer}
#isoDistrict .iso-city-menu.active{background:#6e2916}
body.iso-live #v4BuildHud{display:none !important}

/* CIVITAS XII — detail pass and interactive tooltip */
#isoDistrict{background:#143b4b;border:5px ridge #bd965b;box-shadow:0 16px 42px #090b0cc9}
#isoDistrict .iso-heading{background:linear-gradient(90deg,#512015,#7c2b20 52%,#361610);height:44px}
#isoDistrict canvas{image-rendering:auto;background:#226e81}
#isoHover{position:absolute;z-index:4;display:none;background:linear-gradient(180deg,#5d2416ed,#351c11f4);border:1px solid #e2c183;color:#ffe4b0;font:700 14px Georgia;box-shadow:0 4px 15px #140d0a87;border-radius:7px;padding:7px 10px;pointer-events:none;white-space:nowrap}
#isoHover.visible{display:block}
#isoDistrict .iso-info{font-size:12px;background:#251c17}
#isoDistrict #isoDetails{color:#fce2af}
#stage .v7-views{z-index:60 !important;top:160px !important}
/* V12: controls and improved legibility */
#isoDistrict{background:#2a3b3c;border-color:#b88e52;box-shadow:0 20px 60px #180c08be;}
#isoDistrict .iso-heading{background:linear-gradient(90deg,#471b11,#754029 48%,#432116);}
#isoDistrict .iso-heading strong{letter-spacing:1.8px}
#isoDistrict .iso-tools{display:flex;align-items:center;gap:5px}
#isoDistrict .iso-tools .v12-scene-btn{width:auto;min-width:74px;padding:7px 12px;line-height:1;font-size:13px;border:1px solid #9d733d;border-radius:6px;color:#f3dfb6;background:#4d291a}
#isoDistrict .iso-tools .v12-scene-btn.active{color:#492310;background:linear-gradient(#f5dea7,#dfb56f);border-color:#ffe3a1;box-shadow:inset 0 1px #fff6d5}
#isoDistrict #isoCanvas{background:#236a7d;}
#isoDistrict .iso-info{background:linear-gradient(90deg,#3b271b,#44261c);color:#f2dfba}
#isoDistrict .iso-city-menu{background:linear-gradient(#5b321e,#351c14);color:#f7e4bb;border:1px solid #bc9259}
@media (prefers-reduced-motion:reduce){#isoDistrict *{transition:none!important;animation:none!important}}

#isoDistrict{box-shadow:0 12px 35px #0c100fe0;outline:1px solid #d9b777!important}
#isoDistrict .iso-heading{background:linear-gradient(120deg,#3d2617,#674329 58%,#402319)!important;box-shadow:0 5px 18px #14100888;color:#f7e7c1}
#isoDistrict #isoCanvas{background:#195f73;image-rendering:auto}
#isoDistrict .iso-info{background:linear-gradient(90deg,#342219ee,#523d2aee)!important;border-top:1px solid #c7a56b!important;color:#f2dbac!important;font-size:13px}
#isoDistrict .iso-heading strong{letter-spacing:1.25px}
#isoDistrict .iso-tools button{border-radius:6px!important}
#isoDistrict .iso-city-menu{border-radius:7px!important;background:#60331fe9!important;color:#ffebc2!important}

/* CIVITAS XXXIX — Direction artistique romaine unifiée, appliquée aux VRAIES vues de jeu */
#stage .local-view{border:8px ridge #b3884e;box-shadow:0 17px 55px #0e1b1aee}
#stage .local-map{background:radial-gradient(ellipse at 25% 17%,#739a7b 0,#426b5f 36%,#176d80 72%,#0b4e69 100%)}
#stage .local-svg{filter:saturate(1.22) contrast(1.1)}
#stage .v15-region-decor{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
#stage .v15-region-decor .region-detail{position:absolute;transform:translate(-50%,-76%);filter:drop-shadow(0 6px 5px #22372675);object-fit:contain;opacity:.94}
#stage .v15-wave-mark{position:absolute;width:190px;height:27px;border-top:3px solid #d4eddb5c;border-radius:50%;top:72%;left:72%;animation:v15Bobbing 9s ease-in-out infinite}
#stage .v15-wave-two{left:81%;top:84%;width:100px;animation-delay:-4s}
@keyframes v15Bobbing{0%,100%{transform:translate(0,0);opacity:.37}50%{transform:translate(13px,-5px);opacity:.77}}
#stage .local-node{min-width:102px;max-width:144px;z-index:4;gap:0}
#stage .local-node .node-building{width:100px;height:81px;background:none!important;border:0!important;box-shadow:none!important;display:flex;align-items:end;justify-content:center;border-radius:0;filter:drop-shadow(0 6px 4px #1c2b2180)}
#stage .local-node .node-building img{max-width:100px;max-height:83px;object-fit:contain;display:block;pointer-events:none}
#stage .local-node .node-building .vacant-flag{color:#664722;background:linear-gradient(#f7e1ae,#cfaa72);border:2px dashed #987045;border-radius:13px;padding:8px 14px;font-size:24px}
#stage .local-node .node-name{background:linear-gradient(115deg,#321b11f5,#512917e8);border:1px solid #debe83;border-radius:7px;box-shadow:0 2px 4px #0006;color:#fff1cc;font-size:13px;line-height:1.05;padding:6px 9px;text-shadow:0 2px 2px #090504}
#stage .local-node small{background:#20120fdb;color:#f5ddad;border:1px solid #bea16b87;font:11px Georgia;padding:3px 7px;border-radius:0 0 6px 6px}
#stage .local-node:hover .node-building img,#stage .local-node.active .node-building img{filter:brightness(1.13) drop-shadow(0 0 9px #fff0a1)}
#stage .local-node.active .node-building{box-shadow:none!important}
#stage .common-node{background:linear-gradient(180deg,#f7e7c4,#d8b27c);border:2px solid #b1884b;box-shadow:0 7px 18px #172c2e9a;min-height:98px;max-height:135px;width:139px;padding:3px 7px 8px;border-radius:10px;gap:2px}
#stage .common-node .v15-common-art{height:59px;width:90px;object-fit:contain;filter:drop-shadow(0 5px 3px #6854328a)}
#stage .common-node strong{font-size:13px;color:#4e2b15}
#stage .common-node small{font:11px Georgia;color:#77542c}
#stage .local-legend{z-index:4;background:linear-gradient(95deg,#3a2116ed,#68472bc9);border:1px solid #d2b780;border-radius:7px;color:#f1e4bc;font-size:12px}
#stage .local-bottom{background:linear-gradient(#f6e5bd,#d5b486)}
#stage .view-header{background:linear-gradient(95deg,#57160d,#912418 52%,#52150c);text-shadow:0 2px 3px #2a0906}
#stage .roman-map{border:8px ridge #b58b4e;box-shadow:inset 0 0 0 2px #dfbb7b,inset 0 5px 33px #0b334a,0 8px 17px #4c2c165e}
#stage .roman-map-art{filter:saturate(1.19) contrast(1.1)}
#stage .v15-world-features{position:absolute;inset:0;pointer-events:none;z-index:2}
#stage .v15-world-features img{position:absolute;transform:translate(-50%,-54%);height:auto;filter:drop-shadow(0 4px 3px #0b30296e);opacity:.78}
#stage .roman-map .geo-pin{z-index:5;flex-direction:column;gap:0;min-height:0;padding:2px 5px 4px;border:1px solid #b3894d;border-radius:8px;background:linear-gradient(#fff1d4f5,#d5ae70ed);box-shadow:0 3px 7px #0c414994;min-width:67px}
#stage .roman-map .geo-pin .pin-icon{width:46px;height:37px;background:none!important;border-radius:0;box-shadow:none;display:block}
#stage .roman-map .geo-pin .pin-icon img{width:100%;height:100%;object-fit:contain;display:block}
#stage .roman-map .geo-pin .pin-name{font-size:12px;color:#3c2315;text-shadow:none}
#stage .roman-map .geo-pin.owned{background:linear-gradient(#9f3520,#672014);border-color:#e7c47c}
#stage .roman-map .geo-pin.owned .pin-name{color:#ffebbc}
#stage .roman-map .geo-pin:hover .pin-icon img{transform:scale(1.07)}
#stage .map-legend{z-index:6;background:#f4e3bded;border-radius:8px}
#isoDistrict{border-color:#b58d50!important;background:#321c13!important;box-shadow:0 20px 65px #130c09dd!important}
#isoDistrict .iso-heading{background:linear-gradient(105deg,#5a180d,#84251b,#542012)!important}
#isoDistrict .iso-info{background:linear-gradient(90deg,#372219,#5b3823)!important;color:#f8e4b8!important}
#isoDistrict .iso-tools button{color:#fae6bd;background:#4b2616!important;border-color:#d6b578!important}
#isoDistrict .iso-tools button.active{background:#992719!important}
#isoDistrict canvas{image-rendering:auto;}

#stage .local-map{background-image:url("data:image/webp;base64,")!important;background-size:100% 100%!important;background-position:center!important}
#stage .local-svg{opacity:.23!important;mix-blend-mode:soft-light;filter:none!important}
#stage .local-svg text{opacity:1}
#stage .v15-region-decor .region-detail{filter:drop-shadow(1px 7px 4px #2a2f2188)}

/* CIVITAS XXX: lightweight and restrained in-game motion for the three strategic views. */
#isoDistrict .iso-heading{background:linear-gradient(100deg,#4f190e,#782214 65%,#3d2118)}
#isoDistrict .iso-tools button{transition:filter .18s,box-shadow .18s,transform .18s}
#isoDistrict .iso-tools button:hover{transform:translateY(-1px);filter:brightness(1.15)}
#stage .local-map::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;mix-blend-mode:screen;opacity:.13;background:repeating-linear-gradient(125deg,transparent 0 45px,#bde7e6 47px,transparent 49px 110px);background-size:440px 420px;animation:v16SeaMove 22s linear infinite}
#stage .roman-map::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;opacity:.18;mix-blend-mode:screen;background:repeating-linear-gradient(108deg,transparent 0 58px,#c4e9df 60px,transparent 63px 145px);background-size:520px 420px;animation:v16SeaMove 28s linear infinite}
#stage .local-node img{filter:drop-shadow(0 4px 4px #1f2917a9);transition:filter .18s,transform .18s}
#stage .local-node:hover img{filter:drop-shadow(0 9px 8px #17281bbb);transform:translateY(-3px)}
#stage .local-node.active img{filter:drop-shadow(0 4px 7px #eed79888)}
@keyframes v16SeaMove{to{background-position:220px 90px}}
@media(prefers-reduced-motion:reduce){#stage .roman-map::after,#stage .local-map::after{animation:none}}


/* V17: only simulated inhabitants; remove the free-floating legacy DOM characters. */
#npcLayer .citizen,#npcLayer .boat-mini,#npcLayer .wake{display:none!important}
/* Cleaner scene HUD: leave the painted streets and buildings visible. */
#isoDistrict .iso-heading{backdrop-filter:blur(3px)}
/* No fallback to the frozen painted characters: the animated scene is the canonical city view. */
#isoClose,#isoToggle{display:none!important}

/* XXI: proportions, precision, shared art direction on all map levels */
#isoDistrict .iso-heading{background:linear-gradient(90deg,rgba(68,25,12,.96),rgba(101,32,18,.94) 55%,rgba(56,24,16,.96));box-shadow:inset 0 -1px 0 #e9be74b5}
#isoDistrict .iso-heading strong{letter-spacing:1.25px;text-shadow:0 1px 2px #210b06}
#isoDistrict .iso-tools button{border-color:#bb985e;background:linear-gradient(180deg,#75472f,#462b20);transition:filter .16s,transform .16s;min-height:25px}
#isoDistrict .iso-tools button:hover{filter:brightness(1.18);transform:translateY(-1px)}
#isoDistrict .iso-tools button.active{background:linear-gradient(180deg,#9e2e19,#6e1c12);box-shadow:inset 0 1px 0 #e4aa6b66}
#isoDistrict .iso-info{border-top:1px solid #d6a96277}
#isoHover{box-shadow:0 6px 22px #180f09aa;pointer-events:none}
.local-map .local-svg,.roman-map .roman-map-art{filter:saturate(1.08) contrast(1.035)}
.local-map .local-svg{box-shadow:inset 0 0 52px #261e0d27}
.local-map button:hover,.roman-map button:hover{filter:brightness(1.08) drop-shadow(0 2px 3px #331d1077)}
@media(prefers-reduced-motion:reduce){.v15-wave-mark,.v15-region-decor .region-detail{animation:none!important}}

/* XXI: keep the three map tabs readable instead of obscuring the overlay title. */
#stage .v7-views{top:143px;left:730px;transform:scale(.83);transform-origin:left top;z-index:45}
#stage .v7-views button{padding:6px 13px;min-height:28px}

/* CIVITAS XXXIX — Military strategy interface */
.v22-war-board,.v22-war-history{color:#3d2414;padding:10px 16px 24px;background:linear-gradient(140deg,#f6e5bb,#ead3a2);font-size:16px}
.v22-war-head{display:flex;align-items:center;justify-content:space-between;gap:14px;background:linear-gradient(115deg,#71200e,#a42b15 75%,#5b140d);border:2px solid #b98848;border-radius:10px;color:#fff0d0;padding:17px 22px;margin-bottom:15px;box-shadow:0 8px 15px #0002}
.v22-war-head h2{margin:5px 0;font-size:29px}.v22-war-head p{margin:5px 0;font-size:16px}.v22-war-head small{color:#f2d0a0;letter-spacing:1px}
.v22-war-total{text-align:center;font-size:42px;font-weight:900;line-height:1}.v22-war-total small{display:block;font-size:12px;font-weight:500;white-space:nowrap}
.v22-war-layout{display:grid;grid-template-columns:1.35fr 1fr;gap:18px}.v22-war-layout>section{min-width:0}.v22-war-board h3{font-size:23px;color:#733012;margin:10px 0}
.v22-units{display:grid;gap:10px}.v22-unit-card{display:flex;gap:12px;background:#fff2d5;border:1px solid #c9a46c;border-radius:9px;padding:12px;box-shadow:0 3px 12px #68431e18}.v22-unit-card h3{font-size:22px;margin:0 0 2px}.v22-unit-icon{width:57px;height:57px;border-radius:9px;background:#7d2e1a;color:#f6dfae;display:grid;place-items:center;flex-shrink:0;font-size:28px}.v22-unit-card p{font-size:14px;line-height:1.35;margin:6px 0}.v22-unit-card small{display:block;font-size:13px;color:#805a35}.v22-unit-card button{margin-top:9px}.v22-unit-count,.v22-unit-cost{font-size:14px;margin-top:6px}
.v22-formations{display:grid;gap:7px;margin-bottom:14px}.v22-formation{background:#fbefce;color:#573117;text-align:left;border:1px solid #bd9760;border-radius:6px;padding:9px 12px;cursor:pointer}.v22-formation.active{outline:2px solid #8d2215;background:#f4dba8}.v22-formation strong,.v22-formation small{display:block}.v22-formation small{font-size:13px;line-height:1.25;margin-top:4px}.v22-progress{background:#ecd29c;padding:9px;border-radius:6px}
.v22-campaign{border:1px solid #c7a36d;background:#f9e7c7;border-radius:9px;padding:7px;margin:10px 0}.v22-campaign-row{display:grid;grid-template-columns:24px 60px 1fr;align-items:center;gap:8px;padding:5px;border-bottom:1px solid #dec49b;font-size:14px}.v22-campaign-row:last-child{border:0}.v22-campaign-row span{font-weight:bold;color:#a22212}
.v22-report{background:#fff4da;border:1px solid #c69b64;border-radius:7px;margin-bottom:8px;padding:8px 12px;font-size:14px}.v22-report summary{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;cursor:pointer;gap:6px}.v22-report summary small{font-size:12px;color:#825934}.v22-report ol{padding-left:20px;margin:8px 0}.v22-report li{margin:5px 0}
.v22-enemy-forecast{padding:10px;background:linear-gradient(#fcf1d7,#ead4a9);border:1px solid #bb8e55;border-radius:8px;margin:10px 0;font-size:14px;line-height:1.4}.v22-enemy-forecast h3{margin:0 0 5px;font-size:18px}.v22-enemy-forecast small{color:#805430}
.v22-raid-alert{display:grid;background:#84251b;border:1px solid #e9b17a;color:#fff0cc;padding:11px;border-radius:8px;gap:6px;margin:10px 0}.v22-war-history{height:100%;overflow:auto}.v22-war-history h2{font-size:32px}
.v22-incoming-alert{background:#852119 !important;color:#fff3d3 !important;border:2px solid #e6b26f !important;animation:v22-urgent 2s ease-in-out infinite}@keyframes v22-urgent{0%,100%{filter:brightness(1)}50%{filter:brightness(1.24)}}
.v22-war-board .v22-unit-card .btn-red{font-size:15px;min-height:36px}.v22-war-board .v22-war-layout{align-items:start}

/* CIVITAS XXX: full game map art redesign, not static image replacement */
#stage .local-map{background:#286979;isolation:isolate}
#stage .v24-map-svg{filter:saturate(1.1) contrast(1.09)}
#stage .v15-region-decor{z-index:2}
#stage .v15-region-decor .region-detail{filter:drop-shadow(0 7px 5px #302d206a) saturate(.95);transform:translate(-50%,-76%) scale(.96);transition:transform .6s}
#stage .local-node{z-index:7;min-width:104px;filter:drop-shadow(0 9px 5px #1f271460)}
#stage .local-node .node-building{width:88px!important;height:68px!important;background:transparent!important;border:none!important;box-shadow:none!important;overflow:visible!important;transition:transform .2s ease,filter .2s ease!important}
#stage .local-node .node-building img{width:98px!important;height:72px!important;object-fit:contain!important;filter:drop-shadow(0 6px 5px #22291a88)!important}
#stage .local-node:hover .node-building,#stage .local-node.active .node-building{transform:translateY(-4px) scale(1.07)}
#stage .local-node .node-name{font-size:13px;padding:4px 10px;background:#332318ed;border-color:#dfbd83;box-shadow:0 2px 6px #0005}
#stage .local-node small{font-size:10px;color:#f8e7c5;background:#22201abb}
#stage .local-node.my-city .node-building{background:transparent!important}
#stage .common-node{z-index:7}
#stage .common-node .v15-common-art{width:102px!important;height:88px!important;object-fit:contain!important;filter:drop-shadow(0 6px 6px #2927138a)!important}
#stage .v24-province-ambience{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
#stage .v24-haze{position:absolute;left:-20%;top:0;width:120%;height:70%;background:radial-gradient(ellipse at 33% 20%,#f8e7b21e,transparent 63%);animation:v24Haze 18s ease-in-out infinite alternate}
#stage .v24-water-ripples{position:absolute;right:-30%;bottom:-25%;height:75%;width:85%;border-radius:50%;background:repeating-radial-gradient(ellipse at 65% 75%,transparent 0 31px,#d9f5e615 32px 33px,transparent 34px 65px);animation:v24Tides 13s linear infinite}
#stage .v24-coast-bird{position:absolute;left:75%;top:39%;width:13px;height:6px;border-top:2px solid #f3ebce;border-radius:100%;transform:rotate(-8deg);animation:v24Bird 14s linear infinite}
#stage .v24-coast-bird.b2{top:56%;left:65%;animation-delay:-7s;opacity:.8}
#stage .v24-sailing-ship{position:absolute;left:70%;top:77%;font-size:24px;filter:drop-shadow(0 3px 3px #193b4577);animation:v24Sail 17s ease-in-out infinite}
#stage .roman-map{height:454px;isolation:isolate;border:6px ridge #c19958;background:#25667c}
#stage .roman-map .geo-pin{border:0!important;box-shadow:none!important;background:transparent!important;padding:2px!important;min-width:78px;filter:drop-shadow(0 3px 3px #0c34407c);transition:transform .2s ease!important}
#stage .roman-map .geo-pin .pin-icon{width:66px!important;height:55px!important;filter:drop-shadow(0 5px 5px #0c293d96)}
#stage .roman-map .geo-pin .pin-icon img{height:100%!important;width:100%!important;object-fit:contain!important}
#stage .roman-map .geo-pin .pin-name{font-size:12px!important;padding:3px 7px!important;border:1px solid #b88b51;border-radius:12px;background:#f5e5bdeb;color:#4b2819;box-shadow:0 3px 4px #123b468e}
#stage .roman-map .geo-pin.owned .pin-name{background:#791e16;color:#fff0bf;border:1px solid #eccb91}
#stage .roman-map .geo-pin.active{outline:0!important;transform:translate(-50%,-50%) scale(1.13)!important}
#stage .roman-map .geo-pin.active .pin-name{box-shadow:0 0 0 2px #ffdc7d,0 6px 8px #123b468a}
#stage .v24-world-art{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
#stage .v24-world-art .v24-landmark{position:absolute;transform:translate(-50%,-63%) scale(.78);height:auto;object-fit:contain;filter:drop-shadow(0 5px 3px #173e3e4d);opacity:.54}
#stage .v24-world-haze{position:absolute;inset:0;background:radial-gradient(ellipse at 40% 28%,#fff1bc10,transparent 45%);animation:v24Haze 20s ease-in-out infinite alternate}
#stage .v24-world-vessel{position:absolute;font-size:19px;filter:drop-shadow(0 2px 3px #114e63);opacity:.85}
#stage .v24-world-vessel.vessel-a{left:48%;top:57%;animation:v24ShipWorld 30s ease-in-out infinite}
#stage .v24-world-vessel.vessel-b{left:64%;top:48%;animation:v24ShipWorldB 36s ease-in-out infinite}
@keyframes v24Tides{0%{transform:translate(0,0) scale(1)}100%{transform:translate(-16px,-8px) scale(1.11)}}
@keyframes v24Haze{from{transform:translate(-9px,0);opacity:.6}to{transform:translate(18px,5px);opacity:1}}
@keyframes v24Bird{0%{transform:translate(-35px,15px) rotate(-8deg)}50%{transform:translate(75px,-24px) rotate(3deg)}100%{transform:translate(195px,-49px) rotate(-6deg)}}
@keyframes v24Sail{0%,100%{transform:translate(-12px,6px) rotate(-2deg)}50%{transform:translate(75px,-17px) rotate(3deg)}}
@keyframes v24ShipWorld{0%,100%{transform:translate(-60px,45px)}50%{transform:translate(70px,-32px)}}
@keyframes v24ShipWorldB{0%,100%{transform:translate(42px,25px)}50%{transform:translate(-60px,-35px)}}
@media (prefers-reduced-motion: reduce){#stage .v24-world-art *,#stage .v24-province-ambience *{animation:none!important}}

/* CIVITAS XXXIX — map travel graphics and tuned living-city controls */
#stage .v25-mission-map{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2;filter:drop-shadow(0 1px 2px #3e2d1e)}
#stage .v25-province-map{opacity:.92}
#stage .v25-world-map{opacity:.92;z-index:4}
#stage .v25-mission-map path{stroke-linecap:round;animation:v25RouteFlow 18s linear infinite}
@keyframes v25RouteFlow{to{stroke-dashoffset:-18}}
#isoTimeMode{background:linear-gradient(180deg,#95672d,#50381e)!important;color:#f9e3b8!important;border:1px solid #e8c078!important;min-width:70px;white-space:nowrap;font-size:12px!important;padding:4px 7px!important}
#stage .v24-world-vessel{font-size:15px;opacity:.64}
#stage .local-node.active .node-building img{filter:drop-shadow(0 1px 2px #241406) drop-shadow(0 0 8px #ffd38baa)}
@media(max-width:1100px){#isoTimeMode{min-width:50px;font-size:11px!important}}

/* CIVITAS XXXIX — Unified illustrated city and rebuilt resource belt. */
#isoModeScenic,#isoModeTactical,#isoClose,#isoToggle{display:none!important}
#resources{
 position:absolute;left:355px;top:91px;z-index:23;
 width:978px;height:64px;box-sizing:border-box;display:flex;align-items:stretch;
 border:1px solid #ba965a;border-top:2px solid #d4b779;border-bottom:3px solid #a27b45;
 border-radius:2px 2px 7px 7px;overflow:hidden;
 background:linear-gradient(180deg,#f8e7c4 0%,#f1d6a6 58%,#dfbc87 100%);
 box-shadow:inset 0 2px 7px #fff6d688,0 2px 5px #3b210c55;
 pointer-events:auto;
}
#resources .v27-resource{height:100%;flex:1 1 0;min-width:0;display:flex;align-items:center;justify-content:center;gap:5px;box-sizing:border-box;padding:3px 6px;border-right:1px solid #ab815054;position:relative;overflow:visible;white-space:nowrap;}
#resources .v27-resource:last-child{border-right:0}
#resources .v27-resource img{width:51px;height:49px;object-fit:contain;flex:0 0 51px;display:block;mix-blend-mode:normal;}
#resources .v27-counts{display:flex;flex-direction:column;min-width:0;max-width:calc(100% - 56px);align-items:center;justify-content:center;gap:2px;}
#resources .v27-quantity{font:700 clamp(14px,1.25vw,22px)/1.1 Georgia,'Times New Roman',serif;color:#36200f;font-variant-numeric:tabular-nums;white-space:nowrap;letter-spacing:-.35px}
#resources .v27-rate{font:700 14px/1.1 Georgia,'Times New Roman',serif;color:#277347;white-space:nowrap}
#resources .v27-rate.negative{color:#9b3024}
#resources .v27-population .v27-quantity{font-size:19px}
#resources .v27-resource:hover{background:rgba(255,255,255,.27)}
#isoDistrict .iso-tools{top:54px;right:13px;gap:7px}
#isoDistrict .iso-tools #isoTimeMode{min-width:77px}
#isoDistrict .iso-heading strong{font-size:16px}
#isoDistrict #isoHover{max-width:260px;white-space:normal;overflow-wrap:anywhere;}
#stage .v7-views{top:160px;left:714px;transform:scale(.82);transform-origin:left top;}
#stage .header-speed{top:159px;left:405px;font-size:12px;max-width:285px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#stage #v5VersionMark{display:none!important}
#isoDistrict .iso-info{font-size:12px;white-space:normal;}


/* CIVITAS XXX: single panoramic mode, zero blue gutters, clean baked UI. */
#viewport{margin:0!important;padding:0!important;overflow:hidden!important;align-items:center!important;justify-content:center!important;background:#123a47!important}
#isoDistrict{background:transparent!important;border:2px solid #b88b4c!important;border-radius:9px!important;box-shadow:0 10px 24px #1d130a7a!important}
#isoDistrict canvas{background:transparent!important;image-rendering:auto;}
#isoDistrict .iso-heading{position:relative;overflow:visible;}
#isoDistrict .iso-heading strong{font-size:16px;letter-spacing:.055em}
#isoDistrict .iso-heading small{font-size:13px}
#isoDistrict .iso-info{overflow:hidden}
#isoDistrict .iso-heading .v28-wards{position:absolute;left:410px;top:6px;display:flex;gap:5px;z-index:12}
#isoDistrict .v28-wards button{font:700 14px Georgia;padding:5px 14px;cursor:pointer;color:#e9d5ad;background:#58351e;border:1px solid #a77e49;border-radius:5px;white-space:nowrap}
#isoDistrict .v28-wards button.selected{color:#fff0c6;background:#852b17;border-color:#e9c786;box-shadow:0 0 0 1px #d49b4e}
#v28ProfileControl{position:absolute;left:1412px;top:4px;z-index:85;width:141px;height:76px;background:linear-gradient(90deg,#39251ae5,#321c15f7);border:1px solid #b28b51;border-radius:4px;color:#f3dcae;text-align:left;padding:12px 7px 8px;cursor:pointer;box-shadow:inset 0 1px #dcb26c54;font-family:Georgia,serif}
#v28ProfileControl .v28-profile-name{display:block;font-size:17px;font-weight:bold;line-height:1.15;white-space:normal;overflow:hidden;text-overflow:ellipsis;max-height:40px}
#v28ProfileControl .v28-profile-edit{position:absolute;right:6px;bottom:3px;font:12px Georgia;color:#f2c878}
#v28ProfileDialog{position:absolute;inset:0;z-index:350;display:none;place-items:center;background:#130b08cf}
#v28ProfileDialog.visible{display:grid}
#v28ProfileDialog .v28-profile-card{width:550px;max-width:96%;background:#efdbb4;border:4px ridge #b1894e;border-radius:10px;padding:28px 30px;box-shadow:0 17px 60px #000c;color:#3a2514;font:17px Georgia}
#v28ProfileDialog h2{font-size:29px;color:#732115;margin:0 0 13px}
#v28ProfileDialog label{display:block;margin:16px 0 7px;font-weight:bold}
#v28ProfileDialog input{display:block;width:100%;font:19px Georgia;border:2px solid #ad8857;background:#fff8e8;color:#3b2211;padding:12px;border-radius:5px}
#v28ProfileDialog .v28-profile-actions{display:flex;justify-content:flex-end;gap:12px;margin-top:19px}
#v28ProfileDialog button{font:700 16px Georgia;padding:10px 16px;background:linear-gradient(#aa3623,#682014);color:#ffe6c0;border:1px solid #e9c47d;border-radius:5px;cursor:pointer}
#v28ProfileDialog button.secondary{background:#ecddbd;color:#432410;border-color:#a5855e}
#stage #clockLabel{position:absolute!important;left:1542px!important;top:879px!important;width:110px!important;height:46px!important;right:auto!important;bottom:auto!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;display:flex!important;justify-content:center!important;align-items:center!important;padding:0!important;font:700 18px Georgia!important;color:#f9e4b4!important;text-shadow:0 2px 2px #000!important;white-space:nowrap!important;z-index:75!important}
#nav-hotspots .v3-extra-nav{display:none!important}
.v28-nav-actions{display:flex;gap:12px;flex-wrap:wrap;padding:12px 0 18px;margin:0 0 14px;border-bottom:1px solid #c39960}
#storyOverlay .story-card{filter:none!important;backdrop-filter:none!important;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
#storyOverlay .story-body p{font-size:21px;line-height:1.55}
#isoDistrict .iso-tools{right:12px}

/* Province illustrated in the same Roman direction as Ville; interactions remain DOM-driven. */
#stage .local-map{background:#3a7585!important;isolation:isolate}
#stage .local-map .v24-map-svg{display:none!important}
#stage .local-map .v15-region-decor{display:none!important}
#stage .v28-province-landscape{position:absolute;inset:0;width:100%;height:100%;z-index:1;object-fit:cover;pointer-events:none;user-select:none;display:block}
#stage .local-map .v24-province-ambience{z-index:2;pointer-events:none;opacity:.42}
#stage .local-map .local-node{z-index:25}
#stage .local-map .common-node{z-index:26}
#stage .local-map .local-legend{z-index:30;position:absolute}
#stage .local-map .v25-province-mission{z-index:20;pointer-events:none}
#stage .local-map .local-node .node-building{border:1px solid #c59d57!important;background:#ead3a6bf!important;border-radius:11px!important;box-shadow:0 2px 7px #22180a7a!important}
#stage .local-map .local-node .node-name{font:700 15px Georgia!important;padding:5px 12px!important;border:1px solid #caa46a!important;border-radius:99px!important;background:#4d2b1be8!important;color:#fff1c8!important;box-shadow:0 3px 10px #1f1a0ab0!important;white-space:nowrap}
#stage .local-map .local-node.active .node-name{background:#8d2f17ed!important;border-color:#f5d58a!important}
#v28ProfileControl{left:1431px!important;width:124px!important;background:linear-gradient(90deg,#42291d,#2d1811)!important;opacity:1!important;box-shadow:inset 0 1px #caa36e62!important}
#v28ProfileControl .v28-profile-name{font-size:15.5px!important}

/* More legible Province: the settlements remain selectable but no longer cover the painting. */
#stage .local-map .local-node:not(.vacant) .node-building{display:none!important}
#stage .local-map .local-node{min-width:90px!important;max-width:148px!important;gap:3px!important}
#stage .local-map .local-node small{display:none!important}
#stage .local-map .local-node .node-name{font-size:16px!important;padding:7px 15px!important}
#stage .local-map .common-node{min-width:0!important;max-width:160px!important;max-height:65px!important;padding:6px 9px!important;box-shadow:0 2px 7px #2d1c14a8!important;z-index:28!important}
#stage .local-map .common-node .v15-common-art{display:none!important}
#stage .local-map .common-node strong{font-size:14px!important}
#stage .local-map .common-node small{font-size:11px!important}
#v28ProfileControl{left:1427px!important;width:146px!important}
/* Intro and profile overlays live outside the scaled stage, so the text remains sharp at any desktop resolution. */
body > #storyOverlay{position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;z-index:2000!important}
body > #storyOverlay .story-panel{inset:0!important;padding:20px!important}
body > #storyOverlay .story-card{width:min(960px,94vw)!important;max-height:94vh;overflow:auto;filter:none!important}
body > #v28ProfileDialog{position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;z-index:2100!important}

/* CIVITAS XXX: polish pass, preserving the one illustrated playable city */
#isoDistrict{border:2px solid #c8a56b;border-radius:9px;background:#2e2418;box-shadow:0 16px 35px #170e08c7,0 0 0 1px #321a12;}
#isoDistrict .iso-heading{height:43px;background:linear-gradient(90deg,#3a1c15,#67221a 45%,#321610);border-bottom:1px solid #cfaa72;padding:6px 13px;}
#isoDistrict .iso-heading strong{font-size:15px;letter-spacing:.07em;text-shadow:0 1px 2px #080403;}
#isoDistrict .iso-heading small{font-size:12px;}
#isoDistrict canvas{width:1164px;height:662px;background:#827b54;image-rendering:auto;}
#isoDistrict .iso-info{height:32px;font:13px/1.3 Georgia;background:linear-gradient(180deg,#432a1b,#291a12);border-top:1px solid #b4864f;padding:5px 14px;color:#e6ce9f;}
#isoDistrict #isoDetails{color:#fce3ba;font:700 13px Georgia;}
#isoDistrict #v30CityCompass{color:#dbba7b;letter-spacing:.065em;font-weight:bold;font-size:11px;}
#isoDistrict .iso-tools{top:52px;right:12px;gap:5px;z-index:20;background:linear-gradient(90deg,#372319c2,#27150fcf);padding:5px;border:1px solid #bd955f;border-radius:7px;box-shadow:0 5px 18px #1a130e60;}
#isoDistrict .iso-tools button{width:35px;height:30px;min-width:35px;font-size:18px;background:linear-gradient(#6c4229,#392115);border-color:#d0a973;border-radius:5px;text-shadow:0 1px 1px #170b09;}
#isoDistrict .iso-tools button:hover{background:linear-gradient(#966139,#61351c);}
#isoDistrict #v30Fullscreen{font-size:20px;}
#isoDistrict .v28-wards button{border-radius:17px;padding:6px 11px;font-size:13px;}
#isoDistrict .v29-scene-tabs{border-radius:6px;background:#422318dd;}
#isoDistrict .v29-scene-tabs button{font-size:12px;padding:4px 7px;}
#isoDistrict #isoRoads{bottom:41px;right:15px;border-radius:6px;background:#3f2818c9;color:#f5deb1;padding:7px 11px;font-size:12px;}
#advisorBox{box-shadow:0 12px 25px #1e120ba8;}
#stage .header-speed{opacity:.92;font-size:13px;}
#stage .v4-catalog{scrollbar-width:thin;}
#stage .v4-catalog-list{padding-bottom:8px;}
#stage .v4-card{transition:background .15s,border-color .15s,transform .15s;}
#stage .v4-card:hover{background:#fff2d9b5;transform:translateX(-2px)}
#stage .v4-card[data-v30-type]{cursor:default;}
#stage .v4-card[hidden]{display:none!important;}
#stage .v30-catalog-controls{position:sticky;top:23px;z-index:3;background:linear-gradient(#f9e7c4,#efd5a3);border:1px solid #c6a16a;box-shadow:0 3px 8px #5c3f1b2c;padding:8px;border-radius:7px;margin:8px 0 7px;}
#stage .v30-search-label{display:block;color:#76512c;font:700 11px Georgia;letter-spacing:.04em;margin-bottom:5px;}
#stage .v30-catalog-fields{display:flex;gap:5px;}
#stage #v30CatalogSearch{min-width:0;flex:1;max-width:100%;height:32px;background:#fff7e6;border:1px solid #b9955f;border-radius:5px;outline-offset:2px;padding:0 8px;font:13px Georgia;color:#462b19;box-shadow:inset 0 2px 3px #4d32121f;}
#stage #v30Affordable{padding:0 7px;min-width:98px;border-radius:5px;border:1px solid #b18a53;background:#edd3a7;color:#583619;font:700 11px Georgia;}
#stage #v30Affordable[aria-pressed="true"]{background:#436443;color:#fff6d8;border-color:#3b593b;}
#stage #v30CatalogCount{font:12px Georgia;color:#826343;margin-top:5px;}
#stage #rightPanel .v4-catalog{padding-top:10px;}
#stage .v4-tabs{border-radius:6px;}
#stage .v4-card-info strong{font-size:16px;}
#isoHover{box-shadow:0 8px 18px #160d0975;}
#stage .v4-catalog-help{font-size:13px;line-height:1.35;}

/* One playable illustrated scene; the enlarged view simply dismisses management chrome. */
#isoDistrict .iso-tools #v30Weather{width:68px;min-width:68px;font-size:12px;background:linear-gradient(#60462d,#39271e);letter-spacing:.01em;}
#isoDistrict .iso-tools #v30Immersion{width:35px;min-width:35px;font-size:18px;}
body.v30-immersive #isoDistrict{left:145px!important;top:95px!important;width:1385px!important;height:833px!important;z-index:185!important;border:3px solid #c8a36a!important;box-shadow:0 0 0 180px #0e0b09ac,0 18px 60px #130d08bd!important;}
body.v30-immersive #isoDistrict .iso-heading{height:50px!important;}
body.v30-immersive #isoDistrict canvas{width:1379px!important;height:781px!important;}
body.v30-immersive #isoDistrict .iso-info{display:none!important;}
body.v30-immersive #isoDistrict #isoRoads{display:none!important;}
body.v30-immersive #isoDistrict .v29-scene-tabs{display:none!important;}
body.v30-immersive #isoDistrict .iso-tools{top:52px;}
body.v30-immersive #advisorBox{visibility:hidden;}
@media(prefers-reduced-motion:reduce){#isoDistrict canvas{transition:none}}

/* CIVITAS XXXIX — playable administration in the same single illustrated view */
#isoDistrict #v30QuickPanel{display:none;position:absolute;right:14px;top:222px;width:287px;max-height:548px;z-index:12;overflow:hidden;border-radius:9px;border:2px solid #d8b476;background:linear-gradient(120deg,#fff1d0,#e8c994);box-shadow:0 16px 35px #21110b9c;color:#4a2a18;font:14px/1.36 Georgia;}
#isoDistrict #v30QuickPanel.collapsed{display:none!important;}
#isoDistrict #v30QuickToggle{display:none;position:absolute;bottom:19px;right:17px;z-index:14;padding:9px 14px;cursor:pointer;border-radius:6px;border:1px solid #d8b476;background:#57291be8;box-shadow:0 6px 15px #22130e8f;color:#ffe9bd;font:700 15px Georgia;}
body.v30-immersive #isoDistrict #v30QuickPanel{display:block;}
body.v30-immersive #isoDistrict #v30QuickToggle{display:block;}
#isoDistrict .v30-quick-title{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#7e2519,#4e170e);color:#fce4b3;padding:9px 11px;border-bottom:2px solid #b38b4e;font:700 12px Georgia;letter-spacing:.06em;}
#isoDistrict #v30QuickClose{font:700 21px/1 Georgia;border:1px solid #e6c082;background:#502015;color:#ffe9c2;border-radius:4px;width:25px;height:24px;}
#isoDistrict .v30-quick-stocks{display:flex;justify-content:space-evenly;align-items:center;gap:4px;padding:8px 7px;background:#f1dfb9;border-bottom:1px solid #c7a46a;}
#isoDistrict .v30-quick-stocks span{font:700 14px Georgia;text-align:center;color:#5c3419;}
#isoDistrict .v30-quick-stocks small{display:block;color:#88633c;font:11px Georgia;}
#isoDistrict .v30-quick-body{padding:10px 13px 12px;overflow-y:auto;max-height:469px;scrollbar-width:thin;scrollbar-color:#b48c5e #f4e4c4;}
#isoDistrict .v30-quick-tag{font:700 10px Georgia;color:#8d6241;letter-spacing:.08em;}
#isoDistrict .v30-quick-body h3{font:bold 22px Georgia;line-height:1.08;margin:8px 0;color:#572615;}
#isoDistrict .v30-quick-body p{font:13px/1.38 Georgia;margin:7px 0 11px;color:#735339;}
#isoDistrict .v30-quick-sub{font:bold 14px Georgia;border-top:1px solid #bc9762;margin:11px 0 7px;padding-top:9px;}
#isoDistrict .v30-quick-metrics{display:flex;gap:10px;}
#isoDistrict .v30-quick-metrics span{flex:1;background:#fff2d5;border:1px solid #c7a673;border-radius:6px;text-align:center;padding:7px;color:#684324;}
#isoDistrict .v30-quick-metrics b{display:block;color:#74271b;font-size:17px;}
#isoDistrict .v30-quick-costs{display:flex;flex-wrap:wrap;gap:4px;margin:5px 0;}
#isoDistrict .v30-quick-cost{background:#ffefd0;border:1px solid #d7b581;border-radius:4px;padding:3px 5px;font-size:12px;white-space:nowrap;}
#isoDistrict .v30-quick-main{width:100%;min-height:36px;border-radius:5px;border:1px solid #a37337;background:linear-gradient(#862e18,#55170e);color:#ffedcb;font:700 14px Georgia;padding:7px;cursor:pointer;margin:7px 0;}
#isoDistrict .v30-quick-main:disabled{background:#b8987b;opacity:.75;cursor:not-allowed;}
#isoDistrict .v30-quick-workers{display:flex;align-items:center;gap:3px;}
#isoDistrict .v30-quick-workers button{background:#efdab4;color:#693820;border:1px solid #b99563;border-radius:4px;font:bold 13px Georgia;padding:5px;min-width:30px;cursor:pointer;}
#isoDistrict .v30-quick-workers span{flex:1;text-align:center;color:#6d4b33;font-size:11px;}
#isoDistrict .v30-quick-list{display:flex;flex-direction:column;gap:7px;padding-top:5px;}
#isoDistrict .v30-build-option{display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;column-gap:6px;padding:8px;border:1px solid #c9ab7d;background:#f6e7c9;border-radius:6px;transition:background .12s;}
#isoDistrict .v30-build-option:hover{background:#fff1d5;}
#isoDistrict .v30-build-name{grid-column:1;font:bold 15px Georgia;color:#542819;}
#isoDistrict .v30-build-option .v30-quick-costs{grid-column:1;grid-row:2;margin:3px 0 0;}
#isoDistrict .v30-build-option button{grid-column:2;grid-row:1 / span 2;align-self:center;border-radius:4px;background:#7c2617;border:1px solid #a06d33;color:#fff2d4;font:700 12px Georgia;padding:9px 7px;cursor:pointer;}
#isoDistrict .v30-build-option button:disabled{background:#dac6a7;color:#866b50;border-color:#c2a57d;cursor:not-allowed;}
#isoDistrict .v30-quick-progress{height:12px;overflow:hidden;background:#ac9167;border:1px solid #c09e6d;border-radius:9px;}
#isoDistrict .v30-quick-progress>i{display:block;height:100%;background:linear-gradient(90deg,#b76e23,#e9c07b);}
#isoDistrict .v30-quick-meta{font-size:12px;text-align:right;margin:3px 0;}

/* CIVITAS XXXIX — the illustrated, playable city is part of the game screen, not a dark modal. */
#isoDistrict,#isoDistrict.visible{border:2px solid #d5b57a!important;border-radius:7px!important;box-shadow:0 4px 15px #1b140a66!important;background:#f0dec0!important;}
#isoDistrict .iso-heading{border-bottom:1px solid #d1aa6d!important;background:linear-gradient(90deg,#542015,#772a1e 57%,#4b2115)!important;}
#isoDistrict #isoCityName{font-size:13px;}
#isoDistrict .iso-tools{background:rgba(36,22,13,.67);padding:5px;border-radius:8px;border:1px solid rgba(229,188,122,.5);backdrop-filter:blur(3px);}
#isoDistrict .iso-tools button:hover,#isoDistrict .iso-tools button:focus-visible{background:#80412a;filter:brightness(1.15)}
#isoDistrict #isoRoads{bottom:46px!important;right:12px!important;}
#isoDistrict .iso-info{background:linear-gradient(90deg,#4d2b19,#301b12)!important;border-top:1px solid #c9a165;color:#fce0ad;}
#isoDistrict canvas{background:#8f9e74!important;}
body.v30-immersive #isoDistrict{left:85px!important;top:178px!important;width:1150px!important;height:731px!important;z-index:14!important;border:2px solid #d5b57a!important;box-shadow:0 4px 15px #1b140a66!important;}
body.v30-immersive #isoDistrict .iso-heading{height:44px!important;}
body.v30-immersive #isoDistrict canvas{width:1146px!important;height:647px!important;}
body.v30-immersive #isoDistrict .iso-info{display:flex!important;}
body.v30-immersive #isoDistrict #isoRoads{display:block!important;}
body.v30-immersive #isoDistrict .v29-scene-tabs{display:flex!important;}
body.v30-immersive #isoDistrict .iso-tools{top:52px!important;}
body.v30-immersive #advisorBox{visibility:visible!important;}
body.v30-immersive #isoDistrict #v30QuickPanel{display:none!important;}
body.v30-immersive #isoDistrict #v30QuickToggle{display:none!important;}
body.v31-council-open #v5PanelBackdrop,body.v31-council-open #panelTitle,body.v31-council-open #rightPanel{visibility:hidden!important;}
#isoDistrict #v31CouncilToggle{position:absolute;left:610px;top:5px;bottom:auto;z-index:30;border:1px solid #d4a85f;border-radius:6px;background:linear-gradient(#673323,#3c2016);color:#fff0c4;padding:9px 13px;font:bold 13px Georgia;box-shadow:0 4px 10px #100d0a77;cursor:pointer;}
#isoDistrict #v31CouncilToggle:hover{background:#874027;}
#stage #v31Council{position:absolute;top:176px;left:1239px;bottom:auto;height:592px;width:393px;z-index:32;display:none;overflow-y:auto;border:2px solid #b98d52;border-radius:8px;background:linear-gradient(130deg,#fff1d3,#dec292);box-shadow:0 12px 35px #0b0a0977;color:#472715;font:13px/1.4 Georgia;scrollbar-color:#a98555 #eedbb8;}
#stage #v31Council.open{display:block;}
#stage .v31-head{position:sticky;top:0;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#742b1d,#471a13);padding:12px;color:#ffe8bb;font:700 16px Georgia;z-index:1;}
#stage #v31CouncilClose{background:#5a2119;color:#ffe8bb;border:1px solid #c9a36c;border-radius:5px;padding:2px 9px;cursor:pointer;}
#stage .v31-section{padding:12px;border-bottom:1px solid #d3ad72;}
#stage .v31-section h3{font:700 16px Georgia;margin:0 0 8px;color:#63241b;}
#stage .v31-numbers{display:grid;grid-template-columns:1fr 1fr;gap:7px;}
#stage .v31-stat{padding:7px 8px;border-radius:6px;border:1px solid #d5af77;background:#fff5df;}
#stage .v31-stat b{display:block;font:700 19px Georgia;color:#4e2b1d;}
#stage .v31-stat small{color:#826345;font-size:11px;}
#stage .v31-resource{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px dashed #d7b98b;}
#stage .v31-resource:last-child{border-bottom:0;}
#stage .v31-resource b{font-variant-numeric:tabular-nums;}
#stage .v31-positive{color:#2d7045;}
#stage .v31-negative{color:#aa3425;}
#stage .v31-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:9px;}
#stage .v31-actions button,#stage #v31Recommend{border:1px solid #ac7c45;color:#49220f;border-radius:5px;padding:9px 8px;background:linear-gradient(#fff4d8,#dbb479);font:700 12px Georgia;cursor:pointer;}
#stage .v31-actions button:hover,#stage #v31Recommend:hover{background:#f7d995;}
#stage #v31Recommend{display:block;width:100%;text-align:left;margin-top:10px;}
#stage .v31-warn{padding:7px 8px;border-left:3px solid #a33a23;background:#fae3cb;margin:6px 0;}
#stage .v31-ok{padding:7px 8px;border-left:3px solid #4d8254;background:#ecf2dd;margin:6px 0;}
@media (prefers-reduced-motion:reduce){#isoDistrict .iso-tools{backdrop-filter:none}}


/* CIVITAS XXXIXI — artistically coherent UI, applied to the playable view. */
#isoDistrict{border:3px solid #bd8a49!important;border-radius:8px!important;box-shadow:0 19px 50px rgba(15,10,6,.49), inset 0 0 0 1px #f1d59e!important;background:#423627!important}
#isoDistrict .iso-heading{background:linear-gradient(110deg,#4b2118 0%,#702f21 47%,#3e1b16 100%)!important;box-shadow:inset 0 -2px #bc8a48!important}
#isoDistrict #isoCanvas{background:#887f62!important;image-rendering:auto;filter:saturate(1.04) contrast(1.015)}
#isoDistrict .iso-info{background:linear-gradient(90deg,#3d241a,#593524)!important;box-shadow:inset 0 2px #a57e45!important}
#isoDistrict .iso-tools button{border:1px solid #ca9f64!important;background:linear-gradient(180deg,rgba(90,51,31,.97),rgba(48,25,18,.97))!important;color:#f9e8bd!important;box-shadow:inset 0 1px #ffdca342!important}
#isoDistrict .iso-tools button:hover{background:#764026!important}
#isoDistrict .v28-wards button,#isoDistrict .v29-scene-tabs button{border-radius:4px!important;letter-spacing:.015em}
#isoDistrict .v28-wards button.selected{box-shadow:inset 0 -2px #f4c77b,0 0 0 1px #c79755!important}
#isoDistrict #v30QuickPanel{box-shadow:0 12px 40px #1d0d087c!important}


/* XXII visual system, province and world preserve live interaction layers. */
#stage .v28-province-landscape{filter:saturate(1.07) contrast(1.04);image-rendering:auto!important}
#stage .local-node .node-building{box-shadow:0 5px 13px #26190a7d, inset 0 1px rgba(255,244,215,.6)!important}
#stage .local-node:hover{filter:drop-shadow(0 0 5px #e7c67f)}
#stage .worldmap{box-shadow:inset 0 0 75px #16100c4d,0 10px 32px #1b100a99!important}
#stage .v15-world-art{filter:saturate(1.08) contrast(1.03)}

/* CIVITAS XXXIX — campaign UI and legibility pass */
#c33CampaignToggle{position:absolute;left:776px;top:5px;z-index:32;padding:8px 13px;
 background:linear-gradient(#714021,#3c2116);border:1px solid #e0bc74;border-radius:6px;
 color:#ffe9b0;font:700 13px Georgia;box-shadow:0 4px 10px #0005;cursor:pointer}
#c33CampaignToggle:hover,#c33CampaignToggle:focus-visible{background:#8d4b26;outline:1px solid #f6d18e}
#c33CampaignOverlay{position:absolute;inset:43px 0 30px;z-index:40;display:none;
 background:linear-gradient(130deg,#160e09ed,#28170fda 58%,#120c08f5);backdrop-filter:blur(5px);
 color:#352012;font-family:Georgia,'Times New Roman',serif;overflow:auto}
#c33CampaignOverlay.open{display:block}
#c33CampaignOverlay .c33-paper{margin:20px auto 22px;max-width:1010px;width:calc(100% - 52px);
 border:3px solid #b98e50;border-radius:12px;box-shadow:0 14px 30px #000b;
 background:linear-gradient(115deg,#f8eccd,#e7ce9e 75%,#d9b983);padding:22px 24px 28px}
.c33-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;border-bottom:2px solid #b88a4f;padding-bottom:13px}
.c33-top h2{margin:0;color:#6c170f;font-size:30px;letter-spacing:.04em}.c33-top p{margin:7px 0 0;color:#79563e;font-size:15px}
#c33Close{background:#781e15;color:#fff2cd;border:2px solid #d2ae67;border-radius:7px;font-size:15px;padding:9px 15px;cursor:pointer}
.c33-progress{height:12px;background:#b18a55a6;border:1px solid #a2783f;border-radius:10px;margin:17px 0 11px;overflow:hidden}
.c33-progress>i{height:100%;display:block;background:linear-gradient(90deg,#9a3f23,#d6a94b);transition:width .25s}
.c33-state{font-size:15px;color:#55361e;margin-bottom:15px}
.c33-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.c33-chapter{padding:14px 14px 13px;border:1px solid #c39b69;border-radius:8px;background:linear-gradient(145deg,#fff7ddc8,#eedbb9c7);box-shadow:inset 0 1px #fff9}
.c33-chapter.completed{border-color:#78935b;background:linear-gradient(145deg,#f2f0d5,#e3e3bc)}
.c33-chapter.locked{opacity:.76}.c33-chapter h3{font-size:18px;color:#6d2517;margin:0 0 4px}.c33-chapter p{font-size:12px;color:#745d48;margin:0 0 12px}
.c33-chapter ul{padding:0;margin:0 0 11px;list-style:none;display:grid;gap:6px}
.c33-chapter li{display:flex;gap:8px;align-items:flex-start;font-size:13px;line-height:1.35}
.c33-chapter li span:first-child{min-width:17px;font-weight:700;color:#8e432a}
.c33-chapter li.done span:first-child{color:#476d30}
.c33-chapter button{font:bold 12px Georgia;background:#efdab4;border:1px solid #b89057;color:#5d321b;padding:6px 10px;border-radius:5px;cursor:pointer}
.c33-chapter button:hover{background:#ffe7b3}
.c33-chapter footer{font-size:12px;color:#765637;border-top:1px solid #ccb083;padding-top:7px}
.c33-victory{margin:15px 0;padding:20px;text-align:center;border:2px solid #b99647;
 border-radius:10px;background:radial-gradient(ellipse at top,#fff3c4,#d8b681);color:#702114;box-shadow:0 8px 30px #0002}
.c33-victory h3{font-size:28px;margin:0 0 7px}.c33-victory p{font-size:15px;margin:0 0 8px}
.c33-victory strong{font-size:18px;color:#5a2416}
@media(max-width:950px){.c33-grid{grid-template-columns:1fr}}


#stage:has(#isoDistrict.visible) #questHeader,
#stage:has(#isoDistrict.visible) #questList{visibility:hidden!important;pointer-events:none!important}
#v40QuestButton{position:absolute;bottom:8px;left:12px;z-index:33;border:1px solid #d5b779;
 background:#542b1c;color:#f5e0b7;font:700 13px Georgia;padding:4px 11px;border-radius:6px;cursor:pointer}
#v40QuestButton:hover{background:#794022}#v40QuestButton:focus-visible{outline:2px solid #fff1bc}
#v40QuestPanel{position:absolute;left:11px;bottom:41px;z-index:34;width:min(335px,calc(100% - 22px));
 max-height:205px;overflow:auto;border:2px solid #cfa66c;border-radius:8px;padding:10px 12px;
 background:linear-gradient(140deg,#f7e5c1,#e7c698);box-shadow:0 9px 28px #1c160dba;color:#462715;
 font:700 14px Georgia;display:none}
#v40QuestPanel.open{display:block}#v40QuestPanel h3{margin:0 0 8px;font:700 19px Georgia}
#v40QuestPanel button{display:block;background:transparent;border:0;text-align:left;width:100%;padding:6px;
 border-bottom:1px solid #b99a69;color:#4e321c;font:700 14px Georgia;cursor:pointer}
#v40QuestPanel button:hover{background:#fff6d48a}
</style><!-- CIVITAS XXX : rendu modulaire, météo lumineuse, détail de parcelles, circulation, port, bouton pause. Sauvegarde V20 préservée. -->
<style id="civitas-v29-layout">
/* V29: no duplicate floating view selector over the city header */
body.iso-live #stage .v7-views{display:none!important}
#isoDistrict{background:#283e34!important;border:3px solid #bd9b63!important;border-radius:9px!important}
#isoDistrict #isoCanvas{background:#466e55!important;width:1162px;height:662px;image-rendering:auto;}
#isoDistrict .iso-heading{height:43px!important;padding:4px 11px!important;background:linear-gradient(180deg,#7a281b,#51200f)!important;}
#isoDistrict .iso-heading>div:first-child{width:330px;flex-shrink:0;}
#isoDistrict .iso-heading strong{font-size:15px!important;letter-spacing:.025em!important;white-space:nowrap;}
#isoDistrict .iso-heading small{display:block;font-size:12px!important;margin-top:0!important;}
#isoDistrict .iso-heading .v28-wards{left:342px!important;top:5px!important;}
#isoDistrict .v28-wards button{font-size:13px!important;padding:5px 9px!important;}
#isoDistrict .v29-scene-tabs{position:absolute;right:9px;top:5px;display:flex;gap:3px;z-index:16;background:#301c15;border:1px solid #ba8951;border-radius:20px;padding:3px;}
#isoDistrict .v29-scene-tabs button{padding:4px 9px;border:0;border-radius:15px;color:#f8e2b1;background:transparent;font:700 12px Georgia;cursor:pointer}
#isoDistrict .v29-scene-tabs button:first-child,#isoDistrict .v29-scene-tabs button:hover{background:#8e2f1c;color:#fff2cf}
#v28ProfileControl{left:1451px!important;top:13px!important;width:122px!important;height:66px!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:transparent!important;padding:8px 7px!important;}
#v28ProfileControl .v28-profile-name{font-size:16px!important;line-height:1.12!important;max-height:39px;overflow:hidden;word-break:break-word;color:#f5dba6;text-shadow:0 1px 2px #1c0f09}
#v28ProfileControl .v28-profile-edit{font-size:11px!important;right:8px!important;bottom:5px!important;color:#f9c77c!important}
#stage #clockLabel{left:1556px!important;top:875px!important;width:89px!important;height:39px!important;background:#2d1a12!important;border-radius:12px!important;color:#ffe4ab!important;font:700 16px Georgia!important;text-shadow:0 1px 2px #130d09!important;z-index:75!important;}
#stage .header-speed{max-width:310px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#stage #nav-hotspots .v7-views{box-shadow:none;}
@media(prefers-reduced-motion:reduce){#isoDistrict .v29-scene-tabs button{transition:none}}
</style><style>
/* CIVITAS XXXIX -- clean HUD, no duplicated raster portrait/clock artwork */
#v34GovernorPlate{position:absolute;z-index:95;left:1324px;top:0;width:256px;height:119px;
 background:linear-gradient(150deg,#6f482f 0%,#281810 28%,#382219 65%,#24150e 100%);
 border-left:3px solid #c7a168;border-right:3px solid #ad844b;border-bottom:4px ridge #dfb86c;
 box-shadow:inset 0 2px #edce8a,0 6px 13px #1b0e09ab;color:#f6dfa8}
#v34GovernorPlate:before{content:"";position:absolute;inset:8px 8px 12px 8px;border:1px solid #81634480;pointer-events:none}
#v34GovernorPortrait{position:absolute;left:11px;top:9px;width:92px;height:97px;object-fit:cover;object-position:center 35%;
 border:3px solid #bd985d;border-radius:46% 46% 8px 8px/20% 20% 8px 8px;
 box-shadow:0 1px 0 #fff0c0 inset,0 2px 5px #000b;filter:saturate(.96)}
#v34GovernorPlate .v34-laurel{position:absolute;left:95px;top:85px;color:#c4a05f;font-size:16px;text-shadow:0 1px #150d08}
#v34GovernorPlate .v34-caption{position:absolute;top:11px;left:116px;right:8px;color:#cba56f;font:italic 13px Georgia;letter-spacing:.3px}
#v28ProfileControl{left:1437px!important;top:36px!important;width:133px!important;height:60px!important;z-index:105!important;
 border:0!important;border-radius:0!important;background:transparent!important;padding:1px 4px!important;
 box-shadow:none!important;color:#fff0ca!important;text-align:left!important}
#v28ProfileControl:hover{background:#ecbb5f18!important;outline:1px solid #c6a06f!important}
#v28ProfileControl .v28-profile-name{font-size:17px!important;line-height:1.07!important;
 color:#fff1d5!important;max-height:37px!important;overflow:hidden!important;word-break:break-word}
#v28ProfileControl .v28-profile-edit{font:12px Georgia!important;color:#e1b86f!important;bottom:1px!important;right:4px!important}
#stage #clockLabel{position:absolute!important;left:1448px!important;top:849px!important;width:222px!important;height:79px!important;
 z-index:115!important;right:auto!important;bottom:auto!important;display:flex!important;align-items:center!important;justify-content:center!important;
 padding:20px 10px 13px 43px!important;box-sizing:border-box!important;
 border:3px ridge #bb8c4c!important;border-radius:15px!important;background:linear-gradient(180deg,#754a2e,#271610 40%,#382017 100%)!important;
 box-shadow:inset 0 2px 0 #e9c88b,0 7px 15px #110d08ac!important;
 font:700 18px/1 Georgia!important;letter-spacing:1px!important;color:#ffefc9!important;
 text-shadow:0 2px 3px #0009!important;white-space:nowrap!important;overflow:hidden!important}
#stage #clockLabel:before{content:"⌛";position:absolute;left:13px;top:17px;font-size:29px;line-height:36px;color:#dfbb72;
 text-shadow:0 1px 2px #0009;animation:v34-hourglass 8s ease-in-out infinite}
@keyframes v34-hourglass{0%,45%,100%{transform:rotate(0)}52%,65%{transform:rotate(180deg)}}
#v34GovernorPlate,#stage #clockLabel{user-select:none}
#isoDistrict #v34FocusSite{position:absolute!important;top:56px!important;left:15px!important;z-index:29!important;min-width:84px!important;opacity:.93;color:#f6deb2!important;border:1px solid #d1a367!important;background:linear-gradient(#674325,#362017)!important;padding:5px 9px!important;font:700 12px Georgia!important;border-radius:5px!important}
#isoDistrict #v34FocusSite:hover{background:#87572e!important}
/* Scene and controls share one framing system, with reduced clutter and uniform spacing. */
#isoDistrict{border:2px solid #b99964!important;border-radius:4px!important;box-shadow:0 12px 32px #120906bb!important}
#isoDistrict .iso-heading{border-bottom:2px solid #d6b979!important;box-shadow:0 3px 9px #210d0cb3!important}
#isoDistrict .iso-info{border-top:2px solid #c6a06c!important;line-height:1.2!important}
#isoDistrict #isoCanvas{background:#314e4d!important}
#viewport{background:radial-gradient(ellipse at center,#5b3922 0%,#342117 50%,#110e0a 100%)!important}
#v34LeftFooter{position:absolute;z-index:58;left:0;top:746px;width:87px;height:195px;
 background:linear-gradient(130deg,#2f2115 2%,#442c1d 44%,#1b120b 100%);
 border-top:4px ridge #bf9557;border-right:3px ridge #aa8248;
 box-shadow:inset 0 1px #e4c68f,8px 2px 16px #170d0a77;
 display:flex;flex-direction:column;justify-content:center;align-items:center;gap:9px;
 color:#dab772;font:700 13px Georgia;text-align:center;pointer-events:none}
#v34LeftFooter strong{font:700 19px Georgia;letter-spacing:1px;color:#f2d393}
#v34LeftFooter .v34-divider{width:52px;height:1px;background:#b18a4e}

#v30QuickPanel{scrollbar-color:#b88d55 #f2dbb5}
#v28ProfileDialog .v34-portrait-settings{display:flex;gap:20px;align-items:center;justify-content:flex-start;
 padding:14px;margin:13px 0;border:1px solid #baa074;background:#ffedcd;border-radius:6px}
#v28ProfileDialog .v34-portrait-settings img{width:85px;height:87px;border:2px solid #a77b4a;border-radius:11px;object-fit:cover}
#v28ProfileDialog .v34-portrait-settings input{max-width:260px;width:100%;font-size:13px}
#v28ProfileDialog .v34-portrait-settings small{display:block;color:#775434;margin-top:6px;line-height:1.25}
@media(prefers-reduced-motion:reduce){#stage #clockLabel:before{animation:none}}
</style><style>
/* CIVITAS XXXIX — native HUD restoration; legacy superimposed plates are deliberately retired. */
#v34GovernorPlate,#v34LeftFooter{display:none!important}
#stage #v34GovernorPortrait{
  position:absolute!important;left:1343px!important;top:12px!important;z-index:96!important;
  width:72px!important;height:66px!important;object-fit:cover!important;object-position:center 33%!important;
  border:0!important;border-radius:2px!important;box-shadow:none!important;
  clip-path:inset(0 round 2px);background:#2b1c16!important;filter:saturate(.93) contrast(1.035)!important;
}
#stage #v28ProfileControl{
 left:1426px!important;top:34px!important;width:139px!important;height:43px!important;z-index:97!important;
 display:block!important;background:transparent!important;border:0!important;border-radius:0!important;
 box-shadow:none!important;padding:0 2px!important;outline:0!important;text-align:left!important;
}
#stage #v28ProfileControl:hover{background:transparent!important;outline:0!important}
#v28ProfileControl .v28-profile-name{font:700 17px/1.13 Georgia!important;color:#fff0c5!important;white-space:normal!important;max-height:35px!important;text-shadow:0 1px 2px #140b07!important}
#v28ProfileControl .v28-profile-edit{position:absolute!important;right:4px!important;bottom:0!important;font:italic 11px Georgia!important;color:#e6c28d!important;}
#stage #clockLabel{
  left:1536px!important;top:878px!important;width:109px!important;height:29px!important;padding:0!important;
  border:0!important;background:transparent!important;border-radius:0!important;box-shadow:none!important;
  color:#fff0c8!important;font:700 16px/1 Georgia!important;letter-spacing:0!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
  text-shadow:0 1px 3px #080504!important;z-index:115!important;
}
#stage #clockLabel:before{content:none!important;display:none!important}
#isoDistrict{
 left:85px!important;top:177px!important;width:1168px!important;height:748px!important;
 border:0!important;border-radius:0!important;box-shadow:none!important;background:#3f543d!important;
}
#isoDistrict .iso-heading{border-top:2px solid #d8b676!important;border-bottom:2px solid #d6b574!important;box-shadow:none!important}
#isoDistrict .iso-info{border-top:1px solid #ad8553!important;box-shadow:none!important}
#isoDistrict #isoCanvas{width:1168px!important;height:662px!important;display:block!important;border:0!important}
#isoDistrict #v34FocusSite{border:1px solid #9e7848!important;background:linear-gradient(#694121,#342116)!important;box-shadow:none!important}
#isoDistrict .iso-info,#isoDistrict .iso-heading{border-radius:0!important}
/* Profile and screen overlays should never inherit the stage's image scaling for their text. */
#stage .v28-profile-name,#stage #clockLabel{text-rendering:optimizeLegibility}
</style><style id="v39SingleCityMode">#isoToggle{display:none!important}</style></head><body>
<div id="viewport"><div id="stage-holder"><main id="stage" aria-label="CIVITAS, jeu de stratégie romain">
<button type="button" id="v28ProfileControl" aria-label="Modifier mon pseudonyme" title="Modifier mon pseudonyme"><span class="v28-profile-name">Lucius Varron</span><span class="v28-profile-edit">✎ Modifier</span></button><div id="v28ProfileDialog" role="dialog" aria-modal="true" aria-labelledby="v28ProfileTitle"><form class="v28-profile-card" id="v28ProfileForm"><h2 id="v28ProfileTitle">Profil du gouverneur</h2><p>Choisis ton nom de gouverneur. Ce pseudonyme sera conservé sur cet appareil.</p><label for="v28ProfileInput">Pseudonyme</label><input id="v28ProfileInput" maxlength="24" minlength="3" required placeholder="Votre nom romain"><div class="v28-profile-actions"><button type="button" class="secondary" id="v28ProfileCancel">Annuler</button><button type="submit">Enregistrer</button></div></form></div><img id="art" src="data:image/png;base64,