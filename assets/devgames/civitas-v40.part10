  g.fillStyle='#8c1c15';g.strokeStyle='#d5ac5c';g.lineWidth=1;g.beginPath();g.moveTo(bx+2,by-25);g.bezierCurveTo(bx+17+sway,by-32,bx+24+sway,by-16,bx+29+sway,by-19);g.lineTo(bx+22+sway,by+2);g.lineTo(bx+2,by-2);g.closePath();g.fill();g.stroke();
  if(type==='hotelville'){
