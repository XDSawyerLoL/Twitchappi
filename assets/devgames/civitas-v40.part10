function paintWorkshopActivity(g,x,y,ts,workers,type){
 if(!workers)return;
 // A working workshop emits slight heat, dust and smoke; idle shops remain still.
 g.save();const sec=ts/1000;for(let k=0;k<4;k++){
  const t=(sec*.17+k*.27)%1,r=3+8*t;
  g.globalAlpha=(.11+.07*Math.sin(k+sec*.31))*(1-t);
  g.fillStyle='#f4e6ce';g.beginPath();g.ellipse(x+Math.sin(sec*.9+k)*8+t*13,y-t*48, r,r*.73,0,0,Math.PI*2);g.fill();
