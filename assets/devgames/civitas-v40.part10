function paintWater(g,ts){
 const seconds=ts/1000;g.save();g.beginPath();g.rect(1032,460,136,204);g.clip();
 for(let i=0;i<17;i++){const x=1047+(i*37)%128,y=489+(i*29)%164+Math.sin(seconds*.7+i*.8)*2;
 g.strokeStyle=`rgba(232,249,231,${.16+.09*Math.sin(seconds+i)})`;g.lineWidth=1;g.beginPath();g.moveTo(x-12,y);g.quadraticCurveTo(x+6,y-4,x+17,y);g.stroke()}
