for(const [role,srcs] of Object.entries(v18RoleSource))v18RoleVariants[role]=srcs.map(src=>{const img=new Image();img.src=src;return img});
function v18ImageForActor(actor){const role=({delegate:'resident',merchant:'resident',docker:'carrier',guard:'soldier'})[actor.role]||actor.role,list=v18RoleVariants[role]||[];return (actor.uid%5===0?list[0]:actor.uid%3===0?list[1]:null)||v16RoleFrames[role]||walkImg}
function v18DrawStructure(g,img,x,y,width,height,progress,t){
 // Three physically distinct phases: masonry, posts/scaffold, roof installation.
 const p=Math.min(1,Math.max(0,progress));g.save();
 g.fillStyle='#d9c49d';g.strokeStyle='#9e815b';g.lineWidth=1.8;
 g.beginPath();g.ellipse(x,y+14,width*.33,17,0,0,Math.PI*2);g.fill();g.stroke();
 const rows=1+Math.floor(Math.min(.32,p)*13);
 for(let row=0;row<rows;row++)for(let col=0;col<5;col++){
  const bx=x-width*.24+col*width*.12+(row%2)*width*.04,by=y+7-row*6;
  g.fillStyle=(row+col)%2?'#c7b492':'#e6d3b1';g.fillRect(bx,by,Math.max(10,width*.11),5.5);g.strokeRect(bx,by,Math.max(10,width*.11),5.5)
 }
 if(p>.24){const rise=Math.min(1,(p-.24)/.37);
  g.strokeStyle='#956536';g.lineWidth=3.5;const cols=[-.29,-.16,.16,.29];
  for(const cc of cols){g.beginPath();g.moveTo(x+width*cc,y+1);g.lineTo(x+width*cc,y-90*rise);g.stroke()}
  if(rise>.3){g.lineWidth=2;g.beginPath();g.moveTo(x-width*.28,y-85*rise);g.lineTo(x+width*.28,y-85*rise);g.moveTo(x-width*.29,y-80*rise);g.lineTo(x+width*.28,y-28*rise);g.stroke()}
  const hook=13+Math.sin(t*2.2)*4;g.strokeStyle='#81633a';g.lineWidth=1.4;g.beginPath();g.moveTo(x+width*.28,y-87*rise);g.lineTo(x+width*.28,y-30+hook);g.stroke();
  g.fillStyle='#c6b18b';g.fillRect(x+width*.28-6,y-35+hook,13,9)
 }
 if(p>.56&&img?.complete&&img.naturalWidth){
  const finish=Math.min(1,(p-.56)/.44);g.save();g.globalAlpha=.38+finish*.62;
  g.beginPath();g.rect(x-width/2,y-height*finish+16,width,height*finish);g.clip();g.drawImage(img,x-width/2,y-height+16,width,height);g.restore()
 }
 const sparks=1+Math.floor(p*4);
 for(let k=0;k<sparks;k++){const u=(t*.45+k/sparks)%1;g.fillStyle=`rgba(220,200,151,${(.27*(1-u)).toFixed(3)})`;g.beginPath();g.arc(x+Math.sin(k*2.4)*width*.19,y-12-28*u,2+5*u,0,Math.PI*2);g.fill()}
