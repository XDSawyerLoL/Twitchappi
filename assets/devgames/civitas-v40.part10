function v19WorkshopShift(g,x,y,width,type,workers,ts){
 if(workers<1||!['scierie','carriere','marbre','cave','entrepot','marche','port'].includes(type))return;
 const sec=ts/1000,cycle=22,phase=(sec+width*.041)%cycle;
 const warmup=phase<4,processing=phase>=4&&phase<14,delivery=phase>=14&&phase<19;
 const count=Math.min(4,Math.max(1,Math.ceil(workers/3)));
 g.save();g.translate(x,y);
 const floor=1.8;
 if(type==='scierie'){
  const bx=-width*.18;
  g.strokeStyle='#664224';g.lineWidth=2;g.fillStyle='#a9783e';
  for(let k=0;k<count;k++){
   const progress=warmup?.08:processing?((phase-4)/10):delivery?.99:0;
   const offset=k*10;
   g.save();g.translate(bx+offset-15+progress*22,-1+k*.8);
   g.fillRect(-13,-6,24,6);g.strokeRect(-13,-6,24,6);
   for(let r=0;r<3;r++){g.strokeStyle='#e8c58d';g.beginPath();g.arc(-8+r*7,-3,1.1,0,6.28);g.stroke()}
   g.restore();
  }
  if(processing){g.strokeStyle='#dbca94';g.lineWidth=1;for(let n=0;n<3;n++){let f=((sec*2+n*3)%12)/12;g.beginPath();g.moveTo(10+f*12,-10+f*9);g.lineTo(17+f*9,-11+f*10);g.stroke()}}
 }else if(type==='carriere'||type==='marbre'){
  const lift=warmup?0:processing?Math.sin((phase-4)/10*Math.PI)*16:delivery?10:0;
  g.strokeStyle='#806034';g.lineWidth=1.8;g.beginPath();g.moveTo(25,-46);g.lineTo(25,-3-lift);g.stroke();
  g.fillStyle='#d8c7a8';g.strokeStyle='#a49579';g.fillRect(16,-11-lift,23,13);g.strokeRect(16,-11-lift,23,13);
  if(processing){g.fillStyle='#efe1c3';g.fillRect(10,-2,5,3)}
 }else if(type==='cave'){
  g.save();g.translate(21,-9);g.fillStyle='#784f31';g.fillRect(-14,-8,28,5);
  g.strokeStyle='#5b3b20';g.lineWidth=3;g.rotate(processing?Math.sin(phase*1.1)*.15:0);g.beginPath();g.moveTo(0,-5);g.lineTo(0,-25);g.stroke();g.restore();
  if(delivery){g.fillStyle='#70472b';for(let k=0;k<3;k++)g.fillRect(10+k*8,-4-k*1,6,9)}
 }else if(type==='entrepot'||type==='marche'||type==='port'){
  const q=warmup?0:processing?(phase-4)/10:delivery?1:0;
  g.fillStyle='#8b612f';g.strokeStyle='#e2c18a';g.lineWidth=.8;
  for(let k=0;k<2;k++){const xx=(k*15-25)+q*18;g.fillRect(xx,0+k*4,13,10);g.strokeRect(xx,0+k*4,13,10)}
 }
 g.restore();
}
function v18JobMotion(g,actor,pose,t){
 if(!pose.doing)return;
 const role=actor.role,task=pose.taskPhase||'travail',u=pose.taskProgress||0;
 const phase=t*1.7+actor.uid*.68;
 const work=task==='travail',load=task==='chargement',prep=task==='installation';
 g.save();
 if(role==='builder'){
  const x=11,y=-11;
  if(prep){g.fillStyle='#a4834e';g.fillRect(x-4,y-5,14,6);g.strokeStyle='#6e4c2f';g.lineWidth=1.5;g.strokeRect(x-4,y-5,14,6)}
  if(work){const swing=Math.sin(phase*3.5)*6;g.strokeStyle='#724d30';g.lineWidth=2;g.beginPath();g.moveTo(5,-19);g.lineTo(14+swing,-33);g.stroke();g.fillStyle='#a7a496';g.fillRect(11+swing,-35,8,5);
   if(Math.sin(phase*3.5)>.88){for(let i=0;i<4;i++){g.fillStyle=`rgba(224,193,128,${.2+(i%2)*.13})`;g.fillRect(11+i*3,-3-i*1.4,2,2)}}}
  if(load){g.fillStyle='#c8bb9f';g.strokeStyle='#85745b';g.fillRect(6,-11,18,7);g.strokeRect(6,-11,18,7)}
 } else if(role==='producer'){
  const state=getState(performance.now());const site=state.sites[actor.targetIndex],type=site?.type;
  if(work&&type==='scierie'){const a=-.75+Math.sin(phase*2.1)*1;g.save();g.translate(6,-24);g.rotate(a);g.strokeStyle='#69472c';g.lineWidth=2;g.beginPath();g.moveTo(0,0);g.lineTo(12,-15);g.stroke();g.fillStyle='#b0a89b';g.fillRect(9,-19,8,5);g.restore()}
  else if(work&&(type==='carriere'||type==='marbre')){const sy=Math.sin(phase*1.7)*8;g.strokeStyle='#6a482c';g.lineWidth=1.8;g.beginPath();g.moveTo(3,-17);g.lineTo(14,-31+sy);g.stroke();g.fillStyle='#9f9b8b';g.fillRect(11,-35+sy,9,4)}
  else if(work&&type==='cave'){g.strokeStyle='#7d5533';g.lineWidth=2;g.beginPath();g.moveTo(7,-20);g.lineTo(14,-28+Math.sin(phase*2)*2);g.stroke();g.fillStyle='#8f4d42';g.beginPath();g.ellipse(14,-5,5,3,0,0,Math.PI*2);g.fill()}
  if(load){g.fillStyle='#9b6c36';g.fillRect(4,-13,12,7);g.fillStyle='#d4b27b';g.fillRect(5,-12,10,1)}
 }else if(role==='carrier'){
  const l=prep?-7:load?-3:0;g.fillStyle='#835025';g.strokeStyle='#d4ac68';g.lineWidth=1;g.fillRect(4,-20+l,15,13);g.strokeRect(4,-20+l,15,13);
  if(load){g.fillStyle='#d8b981';g.fillRect(6,-18+l,11,2)}
 }else if(role==='soldier'){
  g.strokeStyle='#d7c28d';g.lineWidth=1.4;g.beginPath();g.moveTo(11,-12);g.lineTo(11,-42);g.stroke();
  if(work){g.fillStyle='#a32a1a';g.beginPath();g.ellipse(-8,-19,6.5,9,0,0,Math.PI*2);g.fill()}
 }else if(role==='resident'){
  if(work){g.fillStyle='#a47b4e';g.fillRect(7,-9,9,5);g.fillStyle='#e8d7b4';g.fillRect(9,-14,4,5)}
 }
 g.restore();
}

function v18RoadsideLife(g,state,ts,scenic){
 const t=ts/1000;g.save();
 const props=[];
 for(let i=0;i<state.sites.length;i++){
  const b=state.sites[i];if(!b)continue;
  const [x,y]=scenic?v18ScenicSitePoint(i,state):tilePoint(...sites[i]);
  if(b.type==='entrepot')props.push({type:'crates',x:x+43,y:y+9,i});
  if(b.type==='marche')props.push({type:'stalls',x:x+35,y:y+13,i});
  if(b.type==='logement')props.push({type:'planters',x:x-38,y:y+8,i});
  if(b.type==='hotelville'||b.type==='senatbat')props.push({type:'banner',x:x-48,y:y+2,i});
  if(b.type==='port')props.push({type:'rope',x:x+38,y:y+14,i});
 }
 for(const p of props){
  if(p.type==='crates'){
   g.fillStyle='#7d5430';g.fillRect(p.x-8,p.y-12,16,12);g.strokeStyle='#c7a070';g.lineWidth=1;g.strokeRect(p.x-8,p.y-12,16,12);const shift=Math.sin(t*1.3+p.i)*2;g.fillStyle='#a77d43';g.fillRect(p.x+9,p.y-10+shift,10,9);g.strokeRect(p.x+9,p.y-10+shift,10,9)
  }else if(p.type==='stalls'){
   g.fillStyle='#b88c46';for(let k=0;k<4;k++){g.beginPath();g.arc(p.x+k*4,p.y-5+Math.sin(t*2+k)*1.3,2.2,0,Math.PI*2);g.fill()}
  }else if(p.type==='planters'){
   g.fillStyle='#8a6438';g.fillRect(p.x-6,p.y-8,12,7);g.strokeStyle='#c49a63';g.strokeRect(p.x-6,p.y-8,12,7);v18Leaf(g,p.x,p.y-8,t,p.i,.52)
  }else if(p.type==='banner'){
   g.strokeStyle='#8c6a3d';g.lineWidth=1.6;g.beginPath();g.moveTo(p.x,p.y-20);g.lineTo(p.x,p.y+12);g.stroke();g.fillStyle='#8f1815';g.beginPath();g.moveTo(p.x,p.y-18);g.lineTo(p.x+11,p.y-15+Math.sin(t*2+p.i)*2);g.lineTo(p.x,p.y-6);g.closePath();g.fill();
  }else if(p.type==='rope'){
   g.strokeStyle='rgba(212,196,159,.7)';g.lineWidth=1.4;g.beginPath();g.moveTo(p.x-10,p.y-5);g.quadraticCurveTo(p.x,p.y+Math.sin(t*2.2+p.i)*2,p.x+12,p.y-4);g.stroke();
  }
 }
 g.restore();
}

function v18ActivityStatus(state){
 return state.sites.map((b,i)=>{if(!b)return null;
 const building=state.construction?.site===i;
 return {site:i,type:b.type,level:b.level,mode:building?'amélioration':state.workers?.[i]>0?'actif':'repos',workers:Number(state.workers?.[i]||0)}
 }).filter(Boolean)
}


function v23SiteWorkers(state,i){return Math.max(0,Number(state.workers?.[i]||0))}
function v23SceneActive(type,workers){return workers>0||['marche','port','hotelville','senatbat','caserne','entrepot','logement'].includes(type)}
function v23DrawWorker(g,role,x,y,scale,sec,seed){
 g.save();g.translate(x,y);g.scale(scale,scale);
 const sway=Math.sin(sec*3.1+seed)*0.8,j=Math.sin(sec*6.3+seed)*0.6;
 g.fillStyle=role==='soldier'||role==='guard'?'#8f2118':role==='merchant'?'#c88d45':role==='delegate'?'#ede1c4':role==='docker'?'#7d5d3c':'#cfc2a6';
 g.strokeStyle='#5f3d24';g.lineWidth=1;
 g.beginPath();g.ellipse(0,-10+j,3.4,5.7,0,0,v16TAU);g.fill();g.stroke();
 g.fillStyle='#d6b28b';g.beginPath();g.arc(0,-18+sway*.25,2.5,0,v16TAU);g.fill();
 g.strokeStyle='#6d472a';g.lineWidth=1.2;
 g.beginPath();g.moveTo(0,-5);g.lineTo(-2.2,2.6+j);g.moveTo(0,-5);g.lineTo(2.2,2.6-j);g.moveTo(-1.2,-8.5);g.lineTo(-3.8,-2.5+sway);g.moveTo(1.2,-8.5);g.lineTo(3.8,-2.5-sway);g.stroke();
 if(role==='builder'){g.strokeStyle='#735235';g.lineWidth=1.5;g.beginPath();g.moveTo(3.2,-9);g.lineTo(7.2,-14+sway);g.stroke();g.fillStyle='#bcb7aa';g.fillRect(6.5,-15.5+sway,3.1,2.3)}
 else if(role==='carrier'||role==='docker'){g.fillStyle='#8c6336';g.fillRect(4,-12,5,4.5);g.strokeRect(4,-12,5,4.5)}
 else if(role==='merchant'){g.fillStyle='#9c6c34';g.beginPath();g.ellipse(5,-11,3.4,2.3,.2,0,v16TAU);g.fill();g.stroke()}
 else if(role==='guard'||role==='soldier'){g.strokeStyle='#85613a';g.beginPath();g.moveTo(5,-17);g.lineTo(5,2);g.stroke();g.fillStyle='#9f2319';g.beginPath();g.ellipse(-5,-11,3,5,-.1,0,v16TAU);g.fill();g.stroke()}
 else if(role==='delegate'){g.fillStyle='#ece0c2';g.fillRect(4,-13,4.5,5.8);g.strokeRect(4,-13,4.5,5.8)}
 g.restore();
}


function v24Architecture(g,x,y,sz,type,level,ts){
 if(level<2)return;
 // Cohesive painted extensions: re-use a crop of the SAME architectural sprite, never another building type.
 const img=spriteFor(type),sec=ts/1000;
 const ready=img?.complete&&img.naturalWidth>0,sw=ready?img.naturalWidth:0,sh=ready?img.naturalHeight:0;
 const isCivic=['hotelville','senatbat','temple','academie'].includes(type);
 const isTrade=['marche','entrepot','port','scierie'].includes(type);
 const scale=sz/190;
 g.save();
 const shadow=(xx,yy,rx,ry)=>{g.fillStyle='#35291e3d';g.beginPath();g.ellipse(xx,yy,rx,ry,0,0,Math.PI*2);g.fill()};
 if(ready){
  // Cropped colonnades / roofs from the original sprite become lateral wings, keeping roof material and perspective identical.
  const cropX=sw*.04,cropY=sh*.10,cropW=sw*.45,cropH=sh*.60;
  const wingW=sz*(isCivic?.37:isTrade?.34:.30),wingH=wingW*cropH/cropW;
  shadow(x-sz*.34,y+10,wingW*.33,9*scale);
  g.globalAlpha=.96;
  g.drawImage(img,cropX,cropY,cropW,cropH,x-sz*.50,y-wingH+14,wingW,wingH);
  if(level>=3){
   shadow(x+sz*.38,y+12,wingW*.31,10*scale);
   g.drawImage(img,sw*.52,cropY,sw*.40,cropH,x+sz*.15,y-wingH+18,wingW*.91,wingH*.91);
  }
 }
 if(level>=2){
  // Roman stone perimeter (real volume via shadow, cap and front wall)
  const rx=sz*.39,yy=y+15;
  g.fillStyle='rgba(58,40,24,.35)';g.beginPath();g.ellipse(x,yy+6,rx+12,17*scale,0,0,Math.PI*2);g.fill();
  g.strokeStyle='#ead7ad';g.lineWidth=3.2*scale;g.beginPath();g.moveTo(x-rx,yy-2);g.quadraticCurveTo(x,yy+9,x+rx,yy-1);g.stroke();
  g.strokeStyle='#a88a65';g.lineWidth=2.1*scale;g.beginPath();g.moveTo(x-rx,yy+2);g.quadraticCurveTo(x,yy+13,x+rx,yy+3);g.stroke();
 }
 if(level>=3){
  // Materials matching the game art: stone steps and terracotta planted borders.
  for(let k=-2;k<=2;k++){
   const px=x+k*sz*.12,py=y+sz*.10+Math.abs(k)*2.5*scale;
   g.fillStyle=k%2?'#bd9a6b':'#d9bc88';g.fillRect(px-9*scale,py,18*scale,5*scale);
   g.strokeStyle='#8b7551';g.lineWidth=.65;g.strokeRect(px-9*scale,py,18*scale,5*scale);
  }
 }
 if(level>=4){
  const statue=modularProps.statue;
  if(statue?.complete&&statue.naturalWidth){const h=sz*.31,w=h*statue.naturalWidth/statue.naturalHeight;
   g.drawImage(statue,x+sz*.37,y-h+9,w,h);}
  const olive=modularProps.olive;
  if(olive?.complete&&olive.naturalWidth){const h=sz*.35,w=h*olive.naturalWidth/olive.naturalHeight;
   g.drawImage(olive,x-sz*.52,y-h+11,w,h);}
 }
 if(level>=5&&isCivic){
   // Two small torches and warm moving highlights, only after the major civic upgrade.
   for(const xx of [x-sz*.27,x+sz*.28]){
     g.strokeStyle='#77502b';g.lineWidth=2;g.beginPath();g.moveTo(xx,y+5);g.lineTo(xx,y-27*scale);g.stroke();
     const flick=.7+.3*Math.sin(sec*7+xx);g.fillStyle=`rgba(255,187,73,${.65*flick})`;g.beginPath();g.ellipse(xx,y-29*scale,3.2*scale,5.4*scale,0,0,Math.PI*2);g.fill();
   }
 }
 g.restore();
}


function v24LongActivity(g,x,y,sz,type,level,workers,ts){
 const t=ts/1000,w=workers||0,s=sz/195;if(w<=0)return;
 const sequence=(t+level*.9)%29.0,progress=(sequence%7.25)/7.25;
 g.save();g.translate(x,y);g.scale(s,s);
 if(type==='scierie'){
  const dx=-20+progress*53,drop=Math.sin(progress*Math.PI)*3;
  g.strokeStyle='#56391e';g.lineWidth=2;g.fillStyle='#a87639';g.fillRect(dx-15,14-drop,29,7);g.strokeRect(dx-15,14-drop,29,7);
  for(let i=0;i<3;i++){const px=dx-10+i*9;g.strokeStyle='#d1a16c';g.beginPath();g.moveTo(px,14-drop);g.lineTo(px+8,21-drop);g.stroke()}
 }else if(type==='carriere'||type==='marbre'){
  const lift=Math.max(0,Math.sin(progress*Math.PI))*18;g.fillStyle='#c9c0ac';g.strokeStyle='#7a766c';g.lineWidth=1;g.fillRect(19,10-lift,16,9);g.strokeRect(19,10-lift,16,9);
  for(let k=0;k<4;k++){g.fillStyle='#e5dfc6';g.globalAlpha=(1-progress)*.42;g.beginPath();g.arc(12+Math.sin(t*2+k)*7,4-progress*25,1.5+k*.3,0,Math.PI*2);g.fill()}
 }else if(type==='cave'){
  g.save();g.translate(27,5);g.rotate(Math.sin(progress*Math.PI*2)*.23);g.fillStyle='#8f5426';g.beginPath();g.ellipse(0,0,15,8,0,0,Math.PI*2);g.fill();g.strokeStyle='#5a3520';g.lineWidth=2;g.stroke();g.restore();
 }else if(type==='marche'){
  for(let k=0;k<4;k++){g.fillStyle=['#c5813e','#c79b3f','#9e6c2b','#b64f36'][k];g.beginPath();g.arc(-32+k*12,17+Math.sin(progress*Math.PI*2+k)*2,3,0,Math.PI*2);g.fill()}
 }
 g.restore();
}
function v23DrawBuildingScene(g,x,y,sz,type,level,workers,ts,state,i,scenic){
 const sec=ts/1000,active=v23SceneActive(type,workers),s=sz/190;
 // Level halos and ground integration
 if(level>1){
  g.save();g.globalAlpha=.07+.03*Math.min(3,level);g.fillStyle='#f6e3b8';g.beginPath();g.ellipse(x,y+10,44*s+level*8,13*s+level*2,0,0,v16TAU);g.fill();g.restore();
 }
 if(type==='hotelville'){
  const ox=x-sz*.10,oy=y+sz*.02;v23DrawWorker(g,'delegate',ox-24,oy,1.05*s,sec,1.2);v23DrawWorker(g,'delegate',ox+4,oy+8,1.0*s,sec,2.3);if(level>=2)v23DrawWorker(g,'guard',ox+30,oy+11,1.0*s,sec,3.1);
  g.save();g.strokeStyle='rgba(245,230,186,.55)';g.lineWidth=1.5;g.beginPath();g.moveTo(x-28*s,y-sz*.28);g.quadraticCurveTo(x,y-sz*.35+Math.sin(sec*2.1)*3,x+30*s,y-sz*.25);g.stroke();g.restore();
 }
 if(type==='senatbat'){
  v23DrawWorker(g,'delegate',x-18*s,y+8,1.0*s,sec,4.5);v23DrawWorker(g,'guard',x+22*s,y+10,1.0*s,sec,2.9);if(level>=2)v23DrawWorker(g,'delegate',x+2*s,y+18,0.95*s,sec,6.2);
 }
 if(type==='marche'){
  for(let k=0;k<3;k++){const px=x-12*s+k*16*s,py=y+15+s*2*Math.sin(sec*1.9+k);v23DrawWorker(g,k===1?'merchant':'resident',px,py,.95*s,sec,1.8+k)}
  g.save();g.strokeStyle='#e8c88f';g.lineWidth=2;g.beginPath();g.moveTo(x-29*s,y-sz*.18);g.quadraticCurveTo(x-4*s,y-sz*.24+Math.sin(sec*3.2)*2,x+24*s,y-sz*.18);g.stroke();g.restore();
 }
 if(type==='port'){
  const waveAlpha=.16+.06*Math.sin(sec*2.4);g.save();g.strokeStyle=`rgba(244,249,228,${waveAlpha})`;g.lineWidth=1.4;for(let k=0;k<3;k++){g.beginPath();g.ellipse(x+25*s+k*13*s,y+10+k*4,16*s,5*s,0,0.15,Math.PI*1.28);g.stroke()}g.restore();
  const hook=10+Math.sin(sec*1.8)*8;g.strokeStyle='#8a6a40';g.lineWidth=2.2;g.beginPath();g.moveTo(x+sz*.18,y-sz*.18);g.lineTo(x+sz*.26,y-sz*.29);g.lineTo(x+sz*.35,y-sz*.26);g.stroke();g.strokeStyle='#6d6248';g.lineWidth=1.3;g.beginPath();g.moveTo(x+sz*.29,y-sz*.27);g.lineTo(x+sz*.29,y-sz*.10+hook);g.stroke();g.fillStyle='#cdb593';g.fillRect(x+sz*.25,y-sz*.08+hook,11*s,8*s);
  v23DrawWorker(g,'docker',x-10*s,y+14,1.0*s,sec,2.7);v23DrawWorker(g,'carrier',x+12*s,y+18,1.0*s,sec,3.7);
 }
 if(type==='scierie'&&active){v23DrawWorker(g,'builder',x+14*s,y+14,1.0*s,sec,5.5);if(workers>3)v23DrawWorker(g,'carrier',x-12*s,y+22,.95*s,sec,6.5)}
 if((type==='carriere'||type==='marbre')&&active){v23DrawWorker(g,'builder',x+18*s,y+18,1.0*s,sec,2.2);if(workers>2)v23DrawWorker(g,'carrier',x-10*s,y+26,.95*s,sec,4.9)}
 if(type==='cave'&&active){v23DrawWorker(g,'merchant',x+14*s,y+16,.95*s,sec,2.1);if(workers>2)v23DrawWorker(g,'carrier',x-11*s,y+20,.92*s,sec,3.2)}
 if(type==='entrepot'){
  g.fillStyle='#8b6134';g.strokeStyle='#c9a16b';g.lineWidth=1;g.fillRect(x+30*s,y+7,14*s,10*s);g.strokeRect(x+30*s,y+7,14*s,10*s);if(level>=2){g.fillRect(x+20*s,y+13,11*s,8*s);g.strokeRect(x+20*s,y+13,11*s,8*s)};v23DrawWorker(g,'carrier',x+8*s,y+20,.98*s,sec,5.1)
 }
 if(type==='logement'){
  g.save();g.strokeStyle='rgba(236,228,198,.75)';g.lineWidth=1.2;g.beginPath();g.moveTo(x-8*s,y-sz*.10);g.lineTo(x+20*s,y-sz*.05);g.stroke();['#d56d5c','#ece0c2','#bf9a54'].forEach((c,k)=>{g.fillStyle=c;const fx=x+(k*8-2)*s,fy=y-sz*.08+Math.sin(sec*2+k)*1.8;g.fillRect(fx,fy,6*s,6*s)});g.restore();
  v23DrawWorker(g,'resident',x-14*s,y+20,.95*s,sec,7.1)
 }
 if(type==='caserne'){
  v23DrawWorker(g,'guard',x-18*s,y+16,1.02*s,sec,1.7);v23DrawWorker(g,'soldier',x+8*s,y+20,1.02*s,sec,2.7);g.strokeStyle='#77512b';g.lineWidth=1.6;g.beginPath();g.moveTo(x+22*s,y+5);g.lineTo(x+34*s,y-11);g.stroke();
 }
 if(type==='hotelville'||type==='senatbat'||type==='caserne'){
  g.save();g.globalAlpha=.32;g.fillStyle='#fbe3af';for(let k=0;k<3;k++)g.fillRect(x-15*s+k*12*s,y-sz*.22+k,2*s,2*s);g.restore();
 }
}



// CIVITAS XXXIXI — direction artistique unifiée, réellement rendue dans la scène interactive.
// These are material/lighting layers and per-building architectural grounds, not a second map mode.
const v32TWO_PI=Math.PI*2;
const v32ShadowAtlas=new Map();
function v32SpriteShadow(type,img){
 if(!img?.complete||!img.naturalWidth)return null;
 let hit=v32ShadowAtlas.get(type);if(hit&&hit.w===img.naturalWidth&&hit.h===img.naturalHeight)return hit.img;
 const off=document.createElement('canvas');off.width=img.naturalWidth;off.height=img.naturalHeight;
 const ox=off.getContext('2d',{willReadFrequently:false});ox.filter='brightness(0)';ox.drawImage(img,0,0);
 v32ShadowAtlas.set(type,{w:off.width,h:off.height,img:off});return off;
}
function v32StonePath(g,x,y,rx,ry,style='stone',level=1){
 g.save();g.translate(x,y);
 // A flattened, isometric paved court with real wall caps; the texture grows with the building.
 g.beginPath();g.moveTo(-rx*.90,-ry*.11);g.lineTo(-rx*.34,-ry*.96);
 g.quadraticCurveTo(0,-ry*1.16,rx*.47,-ry*.74);g.lineTo(rx*.95,ry*.04);
 g.lineTo(rx*.42,ry*.83);g.quadraticCurveTo(0,ry*1.04,-rx*.48,ry*.70);g.closePath();
 const grad=g.createLinearGradient(-rx,-ry,rx,ry);
 const sand=style==='work';grad.addColorStop(0,sand?'rgba(196,173,117,.49)':'rgba(224,206,159,.57)');
 grad.addColorStop(.6,sand?'rgba(159,133,88,.43)':'rgba(201,172,123,.51)');
 grad.addColorStop(1,'rgba(113,85,53,.24)');g.fillStyle=grad;g.fill();
 g.strokeStyle='rgba(69,47,28,.22)';g.lineWidth=3;g.stroke();
 g.strokeStyle='rgba(248,223,171,.49)';g.lineWidth=1.3;g.stroke();
 g.save();g.clip();
 if(!sand){
  g.lineWidth=.8;for(let j=-6;j<7;j++){
   const yy=j*8;g.strokeStyle=(j%3===0)?'rgba(108,85,52,.28)':'rgba(255,249,226,.34)';
   g.beginPath();g.moveTo(-rx*1.2,yy-ry*.14);g.lineTo(rx*1.2,yy+ry*.14);g.stroke();
   for(let k=-8;k<9;k++){
    const xx=k*20+(j%2)*10;g.strokeStyle='rgba(95,70,39,.24)';g.beginPath();g.moveTo(xx,yy-2);g.lineTo(xx+3,yy+5);g.stroke();
   }
  }
 }else{
  // Small irregularly placed gravel and earth marks; no checkerboard.
  for(let k=0;k<40;k++){
   const ax=Math.sin(k*12.9898+13.7)*rx*.75,ay=Math.cos(k*9.332+5.2)*ry*.77;
   g.fillStyle=k%3===0?'rgba(235,218,163,.49)':'rgba(79,64,42,.23)';
   g.beginPath();g.ellipse(ax,ay,1.0+(k%3),.7+(k%2),-.2,0,v32TWO_PI);g.fill();
  }
 }
 g.restore();
 if(level>=3&&!sand){
  g.strokeStyle='rgba(255,233,185,.8)';g.lineWidth=2.0;
  g.beginPath();g.moveTo(-rx*.54,ry*.72);g.lineTo(rx*.36,ry*.77);g.stroke();
 }
 g.restore();
}
function v32BuildCourtyard(g,state,i,x,y,type,level,ts){
 const civic=['hotelville','senatbat','temple','academie','forum'].includes(type);
 const commerce=['marche','entrepot','caserne'].includes(type);
 const port=type==='port',production=['scierie','carriere','marbre','cave'].includes(type);
 const rx=civic?106:commerce?88:production?78:70;
 const ry=civic?38:commerce?33:29;
 g.save();
 // One textured, polygonal courtyard replaces generic oval building pedestals.
 if(!port)v32StonePath(g,x,y+11,rx,ry,civic||commerce?'stone':'work',level);
 if(type==='hotelville'){
  // Civic axis: a coherent axial stair and gate to the city road.
  g.fillStyle='#b6a078';g.strokeStyle='#f6e5b9';g.lineWidth=1.2;
  for(let j=0;j<3;j++){const yy=y+19+j*5;
   g.beginPath();g.moveTo(x-19-j*2,yy);g.lineTo(x+19+j*2,yy);g.lineTo(x+26+j*2,yy+3);g.lineTo(x-26-j*2,yy+3);g.closePath();g.fill();g.stroke();
  }
 }
 if(['carriere','marbre','scierie','entrepot'].includes(type)){
  // Loaded pallets, lime and timber stockpiles appear only after building completion.
  const sx=x+rx*.58,sy=y+ry*.41;
  for(let q=0;q<2+Math.min(level,2);q++){
   g.fillStyle=type==='carriere'||type==='marbre'?'#d2c9b5':'#8d6037';g.strokeStyle='rgba(76,54,33,.65)';g.lineWidth=.9;
   g.fillRect(sx+(q%2)*8,sy-Math.floor(q/2)*8,12,6);g.strokeRect(sx+(q%2)*8,sy-Math.floor(q/2)*8,12,6);
  }
 }
 if(type==='cave'||type==='logement'){
  // Mediterranean hedges and vineyards with light animated leaf sway.
  for(let q=0;q<6+Math.min(2,level);q++){
   const ax=x-rx*.63+q*15,ay=y+ry*.74+Math.sin(q*2+ts*.001)*1.1;
   g.fillStyle=q%2?'#5d7941':'#708348';g.beginPath();g.ellipse(ax,ay,6,2.3,-.1,0,v32TWO_PI);g.fill();
   if(type==='cave'&&q%2===0){g.fillStyle='#79304e';g.beginPath();g.arc(ax+2,ay+2,1.9,0,v32TWO_PI);g.fill()}
  }
 }
 if(type==='caserne'){
  // Training lanes, not generic work yard.
  g.strokeStyle='rgba(85,69,45,.65)';g.lineWidth=1.8;
  for(let q=-1;q<=2;q++){g.beginPath();g.moveTo(x-38,y+24+q*5);g.lineTo(x+38,y+24+q*5);g.stroke()}
 }
 g.restore();
}
function v32CastShadow(g,img,type,x,y,sz,height,level){
 const shadow=v32SpriteShadow(type,img);if(!shadow)return;
 g.save();g.globalAlpha=.15;
 // Sun comes from the upper-left: roofs cast to the lower-right on the ground plane.
 // Flip the projected vertical axis, preserving the transparent architectural silhouette.
 g.translate(x+7,y+16);g.transform(1,0,-.53,-.19,0,0);
 g.filter='blur(2.1px)';g.drawImage(shadow,-sz/2,-height+18,sz,height);
 g.restore();
}
function v32DetailTrim(g,x,y,type,level,ts){
 if(level<2)return;
 const s=Math.min(1.25,1+(level-2)*.05);
 const civic=type==='hotelville'||type==='senatbat';
 if(civic){
  g.save();g.strokeStyle='rgba(245,217,164,.72)';g.lineWidth=1.25;g.beginPath();
  g.moveTo(x-48*s,y+29);g.quadraticCurveTo(x,y+39,x+47*s,y+28);g.stroke();
  // Solitary miniature urns: intentional details, not random giant statues.
  for(const xx of [-46,46]){g.fillStyle='#9b6b3d';g.fillRect(x+xx*s-3,y+20,6*s,6);g.fillStyle='#d5b883';g.beginPath();g.ellipse(x+xx*s,y+20,4*s,3,0,0,v32TWO_PI);g.fill()}
  g.restore();
 }
 if(level>=3&&['entrepot','marche','cave','scierie'].includes(type)){
  g.save();const px=x+48*s,py=y+19;
  g.fillStyle='#916036';g.fillRect(px-17,py-7,20,9);g.strokeStyle='#ddba83';g.strokeRect(px-17,py-7,20,9);
  g.restore();
 }
}
function v32AtmosphericLayer(g,state,ts){
 const t=ts/1000;
 // Painterly warm top-left sunlight, with a coastal blue bounce. These gradients are animated slightly, not photographic filters.
 g.save();g.globalCompositeOperation='soft-light';
 const sun=g.createRadialGradient(-70,-70,38,190,80,650);
 sun.addColorStop(0,'rgba(250,214,140,.20)');sun.addColorStop(.5,'rgba(232,197,135,.06)');sun.addColorStop(1,'rgba(232,197,135,0)');
 g.fillStyle=sun;g.fillRect(0,0,W,H);
 const blue=g.createRadialGradient(1155,410,20,1040,410,510);
 blue.addColorStop(0,'rgba(51,130,163,.13)');blue.addColorStop(1,'rgba(51,130,163,0)');g.fillStyle=blue;g.fillRect(0,0,W,H);g.restore();
 // Coastal mist and natural sea air; no opaque atmosphere blocking gameplay.
 g.save();
 for(let k=0;k<4;k++){
  const mx=860+Math.sin(t*.07+k*2.1)*98+k*28,my=128+k*72;
  const haze=g.createRadialGradient(mx,my,0,mx,my,65);
  haze.addColorStop(0,'rgba(230,244,224,.055)');haze.addColorStop(1,'rgba(230,244,224,0)');
  g.fillStyle=haze;g.fillRect(mx-65,my-45,130,90);
 }
 g.restore();
}


function v32TierOrnaments(g,x,y,type,level,ts){
 if(level<2)return;
 const civic=['hotelville','senatbat','temple','academie','forum'].includes(type);
 g.save();
 // All added architectural structures are proportional to the site's footprint, never copies of the entire building.
 const side=type==='hotelville'?70:58;
 if(civic){
  // Low marble balustrades / stair lamps sit at the building entrance.
  for(const d of [-1,1]){
   const bx=x+d*side,by=y+24;
   g.fillStyle='#c9b28a';g.strokeStyle='#70563c';g.lineWidth=1;
   g.fillRect(bx-5,by-12,10,13);g.strokeRect(bx-5,by-12,10,13);
   g.fillStyle='#f4e2be';g.fillRect(bx-6,by-13,12,3);
   if(level>=3){g.fillStyle='#537044';g.beginPath();g.ellipse(bx,by-17,6,5,-.18,0,v32TWO_PI);g.fill();}
   if(level>=4){const t=Math.sin(ts*.0015+d)*1.1;g.fillStyle='rgba(255,191,84,.57)';g.beginPath();g.ellipse(bx,by-20+t,2.0,3,0,0,v32TWO_PI);g.fill()}
  }
 }else if(['scierie','carriere','marbre','entrepot'].includes(type)){
  // Raised storage rack with materials that match the building's industry.
  const sx=x+48,sy=y+24;
  g.strokeStyle='#805837';g.lineWidth=1.4;
  for(let k=0;k<3;k++){g.beginPath();g.moveTo(sx+k*7,sy-12);g.lineTo(sx+k*7,sy+1);g.stroke()}
  g.strokeStyle='#c5a16d';g.beginPath();g.moveTo(sx-2,sy-8);g.lineTo(sx+23,sy-8);g.stroke();
  if(level>=3){g.fillStyle=type==='scierie'?'#92622d':'#c5b99f';for(let k=0;k<3;k++)g.fillRect(sx+k*6,sy-15,7,4)}
 }else if(type==='logement'||type==='cave'){
  for(let j=-2;j<=2;j++){
   const bx=x+j*15,by=y+28;
   g.fillStyle=(j%2)?'#5f7c46':'#78905d';g.beginPath();g.ellipse(bx,by,4.4,2.7,0,0,v32TWO_PI);g.fill();
   if(type==='cave'&&level>=3){g.fillStyle='#7d3353';g.beginPath();g.arc(bx+2,by+1,1.4,0,v32TWO_PI);g.fill()}
  }
 }else if(type==='caserne'){
  g.strokeStyle='#9a6c35';g.lineWidth=1.7;for(let i=0;i<3;i++){
   g.beginPath();g.moveTo(x+48+i*6,y+25);g.lineTo(x+51+i*6,y+4);g.stroke();
  }
 }
 g.restore();
}

function paintLandscapeBuildings(g,state,ts,onlySite=null){
 const list=illustratedSites.map((p,i)=>({i,p:v18ScenicSitePoint(i,state),b:state.sites[i],active:state.construction?.site===i,queued:(state.queue||[]).some(q=>q.site===i)})).filter(a=>Math.floor(a.i/8)===(state.district||0)&&(onlySite===null||a.i===onlySite)).sort((a,b)=>a.p[1]-b.p[1]);
 for(const slot of list){
  const {i,p,b,active,queued}=slot,[x,y]=p,selected=state.selected===i;
  if(!b&&!active){if(selected){g.save();g.strokeStyle='#ffe3a9';g.lineWidth=3;g.setLineDash([8,6]);g.beginPath();g.ellipse(x,y+9,66,32,0,0,Math.PI*2);g.stroke();g.restore()}continue}
  const type=b?.type||state.construction?.type,level=b?.level||state.construction?.level||1,img=spriteFor(type);
  const hall=type==='hotelville',senate=type==='senatbat';
  const sz=(hall?244:senate?202:type==='port'?199:type==='carriere'?171:type==='marbre'?175:type==='scierie'?179:174)*(1+Math.min(.13,Math.max(0,level-1)*.035));
  const workers=v23SiteWorkers(state,i);
  g.save();
  // A mottled contact patch and directional shade bind the building into the painted soil.
  v40SoilIntegration(g,x,y,type,sz,level,ts,i);
  if(b&&!active)v32TierOrnaments(g,x,y,type,level,ts);
  if(img?.complete&&img.naturalWidth){
   const ratio=img.naturalWidth/img.naturalHeight,drawH=sz/ratio;if(!active)v32CastShadow(g,img,type,x,y,sz,drawH,level);
   if(active&&!b){const c=state.construction,p=Math.min(1,Math.max(0,(Date.now()-c.start)/(c.end-c.start)));v18DrawStructure(g,img,x,y+3,sz,drawH,p,ts/1000)}
   else {g.save();g.filter='saturate(.96) contrast(1.025) brightness(.995)';g.drawImage(img,x-sz/2,y-drawH+19,sz,drawH);g.restore();}
  }else{g.fillStyle='#b8a280';g.fillRect(x-29,y-76,58,70);g.fillStyle='#b05b3f';g.beginPath();g.moveTo(x-42,y-76);g.lineTo(x,y-100);g.lineTo(x+42,y-76);g.fill()}
  v40ForegroundContact(g,x,y,type,sz,level,i);
  if(!active){if(workers>0&&['scierie','carriere','cave','marbre'].includes(type))paintWorkshopActivity(g,x+sz*.17,y-(sz/1.5),ts,workers,type);v18BuildingMotion(g,x,y,sz,type,level,workers,ts);v19WorkshopShift(g,x,y,sz,type,workers,ts);v24LongActivity(g,x,y,sz,type,level,workers,ts);v23DrawBuildingScene(g,x,y,sz,type,level,workers,ts,state,i,true);v32DetailTrim(g,x,y,type,level,ts)}
  if(active){const started=state.construction.start||Date.now(),ends=state.construction.end||started+12000,f=Math.min(1,Math.max(0,(Date.now()-started)/(ends-started)));
    if(b){g.lineWidth=2.5;g.strokeStyle='#c49a60';g.beginPath();g.moveTo(x-47,y-22);g.lineTo(x-47,y-110);g.lineTo(x+47,y-110);g.lineTo(x+47,y-22);g.moveTo(x-47,y-56);g.lineTo(x+47,y-93);g.stroke();}
    g.fillStyle='#291a10c9';g.fillRect(x-44,y+41,88,8);g.fillStyle='#795129';g.fillRect(x-43,y+42,86,6);g.fillStyle='#f2da9a';g.fillRect(x-43,y+42,86*f,6);
    v23DrawWorker(g,'builder',x-14,y+18,1.05,ts/1000,1.1);v23DrawWorker(g,'carrier',x+12,y+22,1.0,ts/1000,2.1)
  }
  if(selected){const pulse=.67+.33*Math.sin(ts*.0035);g.globalAlpha=pulse;g.strokeStyle='#ffe3a9';g.lineWidth=2.2;g.setLineDash([]);g.beginPath();g.ellipse(x,y+14,hall?98:83,30,0,0,Math.PI*2);g.stroke();g.globalAlpha=1}
  if(queued){g.fillStyle='#26180fcc';g.fillRect(x+52,y-98,24,14);g.fillStyle='#f8dfa1';g.font='bold 11px Georgia';g.fillText('Q',x+60,y-87)}
  g.restore();
 }
}


function v16ActorEquipment(g,role,doing,sec,uid){
 if(role==='soldier'){
  // Tunic shield and helmet crest distinguish the patrol from civilian sprites.
  g.fillStyle='#931e17';g.strokeStyle='#ebc67f';g.lineWidth=1.3;
  g.beginPath();g.ellipse(-14,-26,7,14,.12,0,v16TAU);g.fill();g.stroke();
  v16Ell(g,-14,-26,2.3,3.8,'#edca79');
  g.strokeStyle='#6b3820';g.lineWidth=1.8;g.beginPath();g.moveTo(10,-28);g.lineTo(10,-53);g.stroke();
 }else if(role==='carrier'){
  const swing=doing?0:Math.sin(sec*9+uid)*2;
  g.fillStyle='#925b2d';g.strokeStyle='#e6cc97';g.lineWidth=1;
  g.fillRect(-18,-24+swing,13,12);g.strokeRect(-18,-24+swing,13,12);
  g.beginPath();g.moveTo(-16,-22+swing);g.lineTo(-8,-14+swing);g.moveTo(-8,-22+swing);g.lineTo(-16,-14+swing);g.stroke();
 }else if(role==='builder'){
  g.strokeStyle='#82602d';g.lineWidth=2;g.beginPath();g.moveTo(13,-28);g.lineTo(18,-42);g.stroke();
  if(doing){g.save();g.translate(16,-42);g.rotate(Math.sin(sec*7+uid)*.45);g.fillStyle='#b5ad9a';g.fillRect(-5,-3,11,5);g.restore()}
 }else if(role==='producer'){
  if(doing){g.strokeStyle='#6e4a25';g.lineWidth=2;g.beginPath();g.moveTo(13,-30);g.lineTo(20+Math.sin(sec*4+uid)*3,-45);g.stroke()}
 }
}



function paintTownAtmosphere(g,state,ts){
 const sec=ts/1000;
 // sea shimmer and foam
 g.save();g.beginPath();g.rect(1026,470,144,190);g.clip();
 for(let i=0;i<11;i++){
  const x=1034+((i*31+sec*18)%168),y=500+(i*17)%152+Math.sin(sec*.9+i)*4;
  g.strokeStyle=`rgba(245,250,227,${.18+.14*Math.sin(sec+i)})`;g.lineWidth=1.2+(i%3)*.15;
  g.beginPath();g.moveTo(x-18,y);g.quadraticCurveTo(x,y-5,x+20,y);g.stroke();
 }
 g.restore();
 // cart on road after warehouse exists
 if(state.sites.some(b=>b?.type==='entrepot')){
  const cart=modularProps.cart;
  if(cart?.complete&&cart.naturalWidth){const p=(sec*.019)%1;const x=420+p*365,y=452-p*87+Math.sin(p*6)*5;g.fillStyle='#33271b55';g.beginPath();g.ellipse(x+8,y+4,20,5,0,0,Math.PI*2);g.fill();g.drawImage(cart,x-30,y-35,61,40)}
 }
 // distant birds
 for(let i=0;i<5;i++){const x=972+Math.sin(sec*.17+i*1.4)*120,y=66+i*28+Math.cos(sec*.4+i)*8,w=6+(i%2)*3;g.strokeStyle='rgba(255,250,225,.82)';g.lineWidth=1.6;g.beginPath();g.moveTo(x-w,y);g.quadraticCurveTo(x,y-5,x,y);g.quadraticCurveTo(x+3,y-5,x+w,y);g.stroke()}
 // light clouds
 g.save();g.globalCompositeOperation='screen';
 for(let i=0;i<4;i++){const cx=160+(i*290+sec*5)%1380,cy=70+(i%2)*28;const grad=g.createRadialGradient(cx,cy,12,cx,cy,72);grad.addColorStop(0,'rgba(255,248,229,.16)');grad.addColorStop(1,'rgba(255,248,229,0)');g.fillStyle=grad;g.beginPath();g.ellipse(cx,cy,82,26,0,0,v16TAU);g.fill()}
 g.restore();
 if(state.sites.some(b=>b?.type==='port')){
  const boatX=1094-Math.sin(sec*.12)*48,boatY=575+Math.cos(sec*.8)*2;g.fillStyle='#4a2d1e';g.beginPath();g.moveTo(boatX-20,boatY);g.quadraticCurveTo(boatX,boatY+10,boatX+22,boatY-1);g.lineTo(boatX+16,boatY+8);g.quadraticCurveTo(boatX,boatY+14,boatX-22,boatY+6);g.closePath();g.fill();g.strokeStyle='#8a6233';g.lineWidth=1.2;g.beginPath();g.moveTo(boatX,boatY-30);g.lineTo(boatX,boatY+2);g.stroke();g.fillStyle='#a32019';g.beginPath();g.moveTo(boatX,boatY-28);g.lineTo(boatX+22,boatY-16);g.lineTo(boatX,boatY-4);g.closePath();g.fill();}
}


function v16BuildingsSpecial(g,state,ts,scenic){
 const t=ts/1000;
 for(let i=0;i<state.sites.length;i++){
  const b=state.sites[i];if(!b||state.construction?.site===i)continue;
  const xy=scenic?v18ScenicSitePoint(i,state):tilePoint(...sites[i]);const [x,y]=xy;
  if(b.type==='marche'){
   // Stall fabric breathes with wind, while the market must exist before effects appear.
   g.save();g.globalAlpha=.3;g.strokeStyle='#efc188';g.lineWidth=2;
   const sway=Math.sin(t*2.1+i)*3;g.beginPath();g.moveTo(x-18,y-49);g.quadraticCurveTo(x+4,y-57+sway,x+23,y-45);g.stroke();g.restore();
  }
  if(b.type==='port'){
   const ripple=.17+.08*Math.sin(t*2.4+i);
   g.strokeStyle=`rgba(249,254,228,${ripple})`;g.lineWidth=1.5;
   g.beginPath();g.ellipse(x+30,y+9,28+Math.sin(t*.9)*2,9,0,.1,Math.PI*1.3);g.stroke();
  }
  if(b.type==='senatbat'||b.type==='hotelville'){
   const baseY=y-(b.type==='hotelville'?170:125);const x0=x+46;
   g.save();g.globalAlpha=.32;g.fillStyle='#e6c98e';
   for(let k=0;k<4;k++)v16Ell(g,x0+(Math.sin(t*1.2+k+i))*3,baseY+36+k*7,1.3,1.3,'#fbe6ba',.48);
   g.restore();
  }
 }
}

