  const life=(t*.22+i*.178)%1,px=x+Math.sin(i*3.21+t*.6)*14+life*8,py=y-12-life*(type==='cave'?28:55),rad=2+life*7;
  const base=type==='carriere'||type==='marbre'?'rgba(226,213,177,':'rgba(234,219,185,';
