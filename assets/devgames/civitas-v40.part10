';
let renderMode='scenic';
const illustratedSites=[[371,208],[562,145],[756,210],[966,289],[585,304],[372,376],[825,383],[634,494], [797,208],[606,145],[412,210],[202,289],[583,304],[796,376],[343,383],[534,494]];
function v18ScenicSitePoint(i,state){const b=state?.sites?.[i],job=state?.construction?.site===i?state.construction:null;if(b?.type==='port'||job?.type==='port')return i>=8?[166,583]:[1002,583];return illustratedSites[i];}
const scenicRoutes=[
[[394,459],[460,423],[513,367],[584,323]],
[[394,459],[460,423],[510,351],[526,249],[559,184]],
[[394,459],[460,423],[584,323],[660,277],[744,253]],
[[394,459],[460,423],[584,323],[750,350],[875,365],[951,314]],
[[394,459],[460,423],[546,351],[594,325]],
[[394,459],[410,417],[376,408]],
[[394,459],[460,423],[584,323],[721,390],[820,413]],
[[394,459],[460,423],[548,424],[616,484]]
];

function spriteFor(type){if(!type)return null;if(artCache.has(type))return artCache.get(type);const img=new Image();img.src=api.sprite(type);artCache.set(type,img);return img}
function getState(ts){if(ts-lastStateAt>420||!viewState){viewState=api.snapshot();lastStateAt=ts}return viewState}
function fxy(x,y){const index=sites.findIndex(([tx,ty])=>x===tx&&y===ty);const [px,py]=renderMode==='scenic'&&index>=0?v18ScenicSitePoint(index+(getState(performance.now()).district||0)*8,getState(performance.now())):tilePoint(x,y);return [W/2+(px-W/2)*zoom+panX,H/2+(py-H/2)*zoom+panY]}
function unproject(x,y){const xp=(x-W/2-panX)/zoom+W/2,yp=(y-H/2-panY)/zoom+H/2;const a=(xp-ORIGIN_X)/(TW/2),b=(yp-ORIGIN_Y)/(TH/2);return [(a+b)/2,(b-a)/2]}
function isWalkable(x,y){return x>=0&&y>=0&&x<COLS&&y<ROWS&&!sites.some(([a,b],i)=>a===x&&b===y)}
function adj(tile){const [x,y]=tile;return [[x+1,y],[x-1,y],[x,y+1],[x,y-1]].filter(([nx,ny])=>isWalkable(nx,ny))}
function nearSite(index){const [x,y]=sites[index%8]||sites[4];const choices=[[x,y+1],[x,y-1],[x+1,y],[x-1,y]];return choices.find(([a,b])=>isWalkable(a,b)&&isRoad(a,b))||choices.find(([a,b])=>isWalkable(a,b))||[x,y]}
function route(a,b){
 const start=makeKey(...a),end=makeKey(...b),cost=new Map([[start,0]]),previous=new Map(),open=[a],visited=new Set();
 while(open.length){open.sort((p,q)=>(cost.get(makeKey(...p))??Infinity)-(cost.get(makeKey(...q))??Infinity));const cur=open.shift(),key=makeKey(...cur);
  if(visited.has(key))continue;visited.add(key);if(key===end)break;
  for(const next of adj(cur)){const nk=makeKey(...next),nc=(cost.get(key)||0)+(isRoad(...next)?1:2.8);if(nc<(cost.get(nk)??Infinity)){cost.set(nk,nc);previous.set(nk,key);open.push(next)}}
 }
 if(!cost.has(end))return [a];const result=[b];let cur=end,guard=0;while(cur!==start&&guard++<COLS*ROWS){cur=previous.get(cur);if(!cur)break;result.unshift(cur.split(',').map(Number))}return result;
}

// CIVITAS XXXIX — route graph traced over the real paved streets of the scenic layer.
// Workers carry their destination site explicitly. Nobody traverses empty building parcels.
const v17RoadNodes={
 W:[216,232],NW:[348,152],U:[566,228],NE:[752,143],E:[962,206],
 R:[816,284],L:[406,337],C:[581,386],S:[670,420],Q:[908,510],H:[1004,560],SE:[1028,406]
};
const v17RoadEdges=[
 ['W','NW',[[247,191],[300,165]]],['NW','U',[[414,176],[492,212]]],
 ['U','NE',[[638,196],[706,164]]],['U','L',[[493,272],[449,306]]],
 ['W','L',[[213,247],[290,282],[351,316]]],
 ['U','R',[[658,270],[741,303]]],['L','C',[[472,364],[533,381]]],
 ['C','R',[[653,354],[737,315]]],['R','E',[[877,254],[942,219]]],
 ['R','SE',[[891,318],[968,354],[1023,391]]],['SE','Q',[[1001,459],[960,488]]],
 ['C','S',[[625,399],[654,414]]],['S','Q',[[728,451],[813,485]]],
 ['Q','H',[[957,539],[996,559]]]
];
const v17Access=['NW','U','NE','E','C','L','R','S'];
const v17RoadAdj={};
for(const name of Object.keys(v17RoadNodes))v17RoadAdj[name]=[];
const v17Distance=(p,q)=>Math.hypot(p[0]-q[0],p[1]-q[1]);
const v17RouteLength=p=>p.slice(1).reduce((n,v,i)=>n+v17Distance(p[i],v),0);
for(const [a,b,way] of v17RoadEdges){
 const pts=[v17RoadNodes[a],...way,v17RoadNodes[b]],length=v17RouteLength(pts);
 v17RoadAdj[a].push({to:b,path:pts,weight:length});
 v17RoadAdj[b].push({to:a,path:pts.slice().reverse(),weight:length});
}
const v17RoadCache=new Map();
function v17RoadPath(origin,destination){
 const key=origin+':'+destination;if(v17RoadCache.has(key))return v17RoadCache.get(key);
 if(!v17RoadAdj[origin]||!v17RoadAdj[destination])return[v17RoadNodes.C,v17RoadNodes.Q];
 const frontier=[origin],dist={[origin]:0},parents={};
 while(frontier.length){frontier.sort((a,b)=>dist[a]-dist[b]);const at=frontier.shift();
  if(at===destination)break;
  for(const link of v17RoadAdj[at]){const value=dist[at]+link.weight;
   if(dist[link.to]===undefined||value<dist[link.to]){dist[link.to]=value;parents[link.to]={from:at,path:link.path};if(!frontier.includes(link.to))frontier.push(link.to)}
  }
 }
 const segments=[];let current=destination,safety=0;
 while(current!==origin&&parents[current]&&safety++<24){segments.unshift(parents[current].path);current=parents[current].from}
 const points=segments.flatMap((seg,i)=>i?seg.slice(1):seg);
 const result=points.length>1?points:[v17RoadNodes[origin],v17RoadNodes[destination]];
 v17RoadCache.set(key,result);return result;
}
// Stable actor identifiers keep each citizen's cycle and path even after state refreshes.
function v17ActorId(role,site,instance){return (role.charCodeAt(0)*41+(site+7)*97+instance*193)%997}

function updateActors(state){
 const city=state.activeCity||'player';
 const signature=[city,state.sites.map(b=>b?b.type+'-'+b.level:'.').join(','),Object.entries(state.workers||{}).sort().join(','),state.construction?.type,state.construction?.site,Math.floor(state.pop||0),state.formation,(state.units?JSON.stringify(state.units):''),(state.queue||[]).length].join('|');
 if(signature===lastCity)return;lastCity=signature;
 const center=[8,8],quay=[12,12],trips=[];
 function speedFor(role){return role==='carrier'||role==='docker'?24:role==='soldier'||role==='guard'?31:role==='delegate'?26:role==='merchant'?25:role==='resident'?28:27}
 function addTrip(name,role,start,end,number,workDuration,index,origin,destination){
  const path=route(start,end);if(path.length<2)return;
  for(let n=0;n<number;n++){
   const uid=v17ActorId(role,index??-1,n+trips.length);
   trips.push({name,role,path,uid,phase:(uid*.271)%21,workDuration,site:end,targetIndex:index??null,roadOrigin:origin,roadTarget:destination,speed:speedFor(role)+(uid%5-2)*.45,lane:((uid%3)-1)*.72});
  }
 }
 function addLocalRole(site,role,count,from,to,duration,name){
  const goal=nearSite(site),dest=v17Access[site]||to||'C';
  addTrip(name||role,role,center,goal,count,duration,site,from||'C',dest);
 }
 if(state.construction){const idx=state.construction.site,goal=nearSite(idx),destination=v17Access[idx]||'C';
  addTrip('Artisan au chantier','builder',center,goal,3,6.3,idx,'L',destination);
  addTrip('Livraison des matériaux','carrier',quay,goal,2,4.1,idx,'H',destination);
 }
 for(let i=0;i<state.sites.length;i++){
  const b=state.sites[i],count=Math.max(0,+(state.workers?.[i]||0));
  if(!b)continue;
  const goal=nearSite(i),to=v17Access[i%8]||'C';
  if(['scierie','carriere','marbre','cave'].includes(b.type)&&count>0){
   const names={scierie:'Bûcheron',carriere:'Carrier',marbre:'Marbrier',cave:'Vigneron'};
   addTrip(names[b.type],'producer',center,goal,Math.min(3,Math.max(1,Math.ceil(count/3))),8.0,i,(i%2===0?'C':'L'),to);
   if(count>=4)addTrip('Manutentionnaire','carrier',quay,goal,1+(count>=8?1:0),4.8,i,'H',to);
  }
  if(b.type==='marche'){addTrip('Marchand','merchant',[8,8],goal,2,7.2,i,'C',to);addTrip('Cliente','resident',[4,6],goal,1,5.8,i,'W',to)}
  if(b.type==='port'){addTrip('Docker','docker',[12,12],goal,2,6.4,i,'H',to);addTrip('Porteur','carrier',[11,11],goal,1,4.7,i,'Q',to)}
  if(b.type==='hotelville'){addTrip('Magistrat','delegate',[8,8],goal,2,8.5,i,'C',to);addTrip('Garde civique','guard',[12,7],goal,1,8.8,i,'E',to)}
  if(b.type==='senatbat'){addTrip('Sénateur','delegate',[6,5],goal,2,8.8,i,'U',to);if((b.level||1)>=2)addTrip('Lictor','guard',[10,5],goal,1,8.5,i,'R',to)}
  if(b.type==='caserne'){addTrip('Patrouille','soldier',[4,7],goal,2,7.6,i,'L',to);addTrip('Recrue','guard',[8,7],goal,1,6.9,i,'C',to)}
  if(b.type==='entrepot'){addTrip('Débardeur','carrier',[12,12],goal,1,5.4,i,'H',to)}
  if(b.type==='logement'&&state.pop>=24){addTrip('Habitant','resident',[4,6],goal,1,6.2,i,'W',to)}
 }
 const military=Math.max(state.legions||0, (state.units?.legionnaires||0)+(state.units?.velites||0)+(state.units?.equites||0));
 if(military>0){addTrip('Patrouille romaine','soldier',[4,7],[12,7],2,4.0,-1,'L','E');if(military>=24)addTrip('Escorte','guard',[8,10],[8,3],1,4.6,-2,'H','NW')}
 const idleRoutes=[[[4,6],[12,7],'W','E'],[[8,10],[8,3],'H','NW'],[[12,10],[4,4],'R','W'],[[10,11],[6,4],'Q','U']];
 const idleCount=Math.min(7,Math.max(2,Math.floor((state.pop||0)/14)));
 for(let i=0;i<idleCount;i++){const [a,b,from,to]=idleRoutes[i%idleRoutes.length];addTrip(i%3===0?'Voyageur':'Citoyen','resident',a,b,1,5.5,-10-i,from,to)}
 actors=trips.slice(0,26);
}

function scenicPathForActor(actor){
 if(actor._v39Road)return actor._v39Road;
 const to=actor.roadTarget||v17Access[(actor.targetIndex??0)%8]||'C',from=actor.roadOrigin||'L';
 let path=v17RoadPath(from,to).map(([x,y])=>[x,y]);
 if((actor.targetIndex??-1)>=8)path=path.map(([x,y])=>[W-x,y]);
 const site=actor.targetIndex;
 // Real final walking segment. Stop at the frontage, rather than a remote road node.
 if(Number.isInteger(site)&&site>=0&&site<16){
  const state=getState(performance.now()),occupied=state.sites[site]||state.construction?.site===site;
  if(occupied){
   const [bx,by]=v18ScenicSitePoint(site,state),last=path[path.length-1];
   const type=state.sites[site]?.type||state.construction?.type||'';
   const frontY=by+(type==='port'?18:35),spread=type==='hotelville'?48:32;
   const direct=Math.sign(last[0]-bx)||((actor.uid%2)?1:-1);
   let entry=[bx+direct*Math.min(spread,Math.abs(last[0]-bx)*.60+8),frontY];
   // Rear-side roads must skirt an occupied building, not intersect its walls.
   if(last[1]<by-8){
    const outside=type==='hotelville'?124:type==='senatbat'?104:90;
    path.push([bx+direct*outside,by-4],[bx+direct*outside,by+26]);
   }
   if(v17Distance(path[path.length-1],entry)>6)path.push(entry);
  }
 }
 actor._v39Road=path;
 return path;
}
function scenicInterp(path,distance){
 const total=v17RouteLength(path),target=Math.max(0,Math.min(total,distance)),tiny=0.00001;
 let remaining=target;
 for(let i=1;i<path.length;i++){
  const p=path[i-1],q=path[i],part=v17Distance(p,q);
  if(remaining<=part||i===path.length-1){const t=part>tiny?Math.min(1,remaining/part):0;
   return {x:p[0]+(q[0]-p[0])*t,y:p[1]+(q[1]-p[1])*t,dx:(q[0]-p[0])/(part||1),dy:(q[1]-p[1])/(part||1)};
  }
  remaining-=part;
 }
 const end=path[path.length-1];return{x:end[0],y:end[1],dx:1,dy:0};
}

function v17ActorPose(actor,path,seconds){
 const length=v17RouteLength(path),duration=Math.max(1,length/(actor.speed||28));
 const role=actor.role,rest=role==='guard'?4.5:role==='resident'?2.4:1.6;
 const working=role==='builder'?18:role==='producer'?21:role==='carrier'||role==='docker'?15:role==='soldier'||role==='guard'?14:role==='delegate'?16:role==='merchant'?17:12;
 const pause=1.2+(actor.uid%4)*.38;
 const cycle=rest+duration+working+duration+pause;
 const phase=((seconds+actor.phase*2.17)%cycle+cycle)%cycle;
 let distance=0,walking=false,doing=false,backward=false,taskPhase='repos',taskProgress=0;
 if(phase<rest){distance=0;taskPhase='repos'}
 else if(phase<rest+duration){distance=(phase-rest)/duration*length;walking=true;taskPhase='aller'}
 else if(phase<rest+duration+working){distance=length;doing=true;taskProgress=(phase-rest-duration)/working;taskPhase=taskProgress<.16?'installation':taskProgress<.72?'travail':taskProgress<.86?'pause':'chargement'}
 else if(phase<rest+2*duration+working){distance=length-(phase-rest-duration-working)/duration*length;walking=true;backward=true;taskPhase='retour'}
 else {distance=0;taskPhase='repos'}
 const loc=scenicInterp(path,distance);if(backward){loc.dx*=-1;loc.dy*=-1}
 if(walking){const lane=(actor.lane||0)*.42;loc.x+=-loc.dy*lane;loc.y+=loc.dx*lane*.48}
 if(role==='guard'&&!walking){loc.y+=Math.sin(seconds*1.3+actor.uid)*.35}
 if(role==='delegate'&&doing){loc.x+=Math.sin(seconds*1.1+actor.uid)*.75}
 return {...loc,walking,doing,backward,phase,cycle,duration,distance,length,taskPhase,taskProgress};
}


function v17DrawCitizen(g,a,pose,sec){
 const {x,y,walking,doing,dx}=pose;
 const distanceFactor=Math.max(.72,Math.min(1.02,.69+y*.00034));
 const h=34*distanceFactor,w=18.5*distanceFactor;
 const bob=walking?Math.sin(sec*(9.4+(a.uid%3)) + a.uid)*.62:doing?Math.sin(sec*2.9+a.uid)*.22:0;
 const img=v18ImageForActor(a);
 g.save();g.translate(x,y);
 v16Ell(g,0,1.6,8.4*distanceFactor,3*distanceFactor,'#201a12',.27);
 v40CitizenFootfall(g,a,pose,sec,distanceFactor);
 if(img.complete&&img.naturalWidth){
  const fw=img.naturalWidth/8,fh=img.naturalHeight;
  const frame=walking?(Math.floor(sec*(6.2+(a.uid%3)*.45)+a.uid*.19)%8):doing?((a.uid+(pose.taskPhase==='travail'?2:0))%8):a.uid%8;
  g.save();g.scale(dx<-.08?-1:1,1);g.drawImage(img,frame*fw,0,fw,fh,-w/2,-h+bob,w,h);g.restore();
 }else{v16Ell(g,0,-h*.55,5,10,'#8b4a2e');v16Ell(g,0,-h*.92,3.6,3.8,'#e8c091')}
 const propX=(dx<0?-1:1)*6.8*distanceFactor;
 if(a.role==='carrier'||a.role==='docker'){
  const b=6.2*distanceFactor,swing=walking?Math.sin(sec*8+a.uid)*1.2:0;
  g.fillStyle='#85532b';g.strokeStyle='#e1c38a';g.lineWidth=.75;g.fillRect(propX,-h*.62+swing,b,b*.85);g.strokeRect(propX,-h*.62+swing,b,b*.85);
 }else if(a.role==='soldier'||a.role==='guard'){
  g.fillStyle='#922315';g.strokeStyle='#d9ac51';g.lineWidth=.9;g.beginPath();g.ellipse(-8*distanceFactor,-h*.49,4*distanceFactor,7*distanceFactor,-.1,0,v16TAU);g.fill();g.stroke();
  g.strokeStyle='#7d5b36';g.lineWidth=1.2;g.beginPath();g.moveTo(propX+2,-h*.84);g.lineTo(propX+2,1);g.stroke();
 }else if(a.role==='builder'&&doing){
  const beat=Math.sin(sec*6+a.uid)*2.5*distanceFactor;g.strokeStyle='#6e4124';g.lineWidth=1.4;g.beginPath();g.moveTo(5*distanceFactor,-h*.48);g.lineTo(8*distanceFactor+beat,-h*.70);g.stroke();v16Ell(g,7*distanceFactor+beat,-h*.70,3*distanceFactor,1.7*distanceFactor,'#a9a8a0');
 }else if(a.role==='merchant'){
  g.fillStyle='#ad7b3d';g.strokeStyle='#e3c17d';g.lineWidth=.7;g.beginPath();g.ellipse(propX,-h*.54,4.6*distanceFactor,2.8*distanceFactor,.18,0,v16TAU);g.fill();g.stroke();
 }else if(a.role==='delegate'){
  g.fillStyle='#efe4c9';g.strokeStyle='#8b714d';g.lineWidth=.7;g.fillRect(propX-1.5,-h*.63,5*distanceFactor,8*distanceFactor);g.strokeRect(propX-1.5,-h*.63,5*distanceFactor,8*distanceFactor);
 }
 if(doing&&a.role==='builder'&&Math.sin(sec*8+a.uid)>.80){v16Ell(g,9,-2,2,1.4,'#e1d2a3',.33)}
 if(doing)v18JobMotion(g,a,{...pose,x:0,y:0,doing:true},sec);
 g.restore();
}

function paintLandscapeActors(g,ts,state){
 const sec=ts/1000;
 if(showRoutes){const seen=new Set();g.save();g.lineWidth=2;g.setLineDash([6,6]);
  for(const a of actors){const path=scenicPathForActor(a),key=path.map(p=>p.join(',')).join('/');if(seen.has(key))continue;seen.add(key);
   g.strokeStyle=a.role==='builder'?'rgba(255,215,131,.85)':a.role==='carrier'?'rgba(218,236,175,.78)':'rgba(241,232,178,.62)';
   g.beginPath();path.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.stroke()}
  g.restore();
 }
 const visible=actors.map(a=>({a,pose:v17ActorPose(a,scenicPathForActor(a),sec)}));
 visible.sort((a,b)=>a.pose.y-b.pose.y);
 for(const entry of visible)v17DrawCitizen(g,entry.a,entry.pose,sec);
}
function drawActors(g,ts){
 const sec=ts/1000;
 if(showRoutes){g.save();g.setLineDash([6,5]);g.lineWidth=1.7;for(const a of actors){if(a.role==='resident')continue;
  g.strokeStyle=a.role==='builder'?'#e5bf6b88':'#ffe5b371';g.beginPath();a.path.map(([x,y])=>tilePoint(x,y)).forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.stroke()}
  g.restore()}
 const entries=[];for(const a of actors){const path=a.path.map(([x,y])=>tilePoint(x,y));if(path.length<2)continue;
  entries.push({a,pose:v17ActorPose(a,path,sec)})}
 entries.sort((a,b)=>a.pose.y-b.pose.y);
 for(const entry of entries)v17DrawCitizen(g,entry.a,entry.pose,sec);
}
// Browser-readable diagnostics; do not write to save data.
window.CIVITAS_V24_VISUAL=()=>({revision:24,province:!!document.querySelector('.v24-map-svg'),world:!!document.querySelector('.v24-world-art'),animated:!!document.querySelector('.v24-province-ambience')});
window.CIVITAS_V23_DIAGNOSTIC=()=>({visual:'v23',scene:renderMode,actors:actors.length,buildings:getState(performance.now()).sites.filter(Boolean).length}),
window.CIVITAS_V19_DIAGNOSTIC=()=>({vegetation:v19Vegetation.length,scene:renderMode,activities:v18ActivityStatus(getState(performance.now())),actors:actors.map(a=>({role:a.role,uid:a.uid,targetIndex:a.targetIndex,frameVariant:a.uid%5===0?'azure':a.uid%3===0?'ochre':'classic'})),render:renderMode});
window.CIVITAS_V17_DIAGNOSTIC=()=>({
 actors:actors.map(a=>({role:a.role,targetIndex:a.targetIndex,origin:a.roadOrigin,destination:a.roadTarget,
  roadLength:Math.round(v17RouteLength(scenicPathForActor(a))),pose:v17ActorPose(a,scenicPathForActor(a),performance.now()/1000)})),
 roadNodes:v17RoadNodes,roads:v17RoadEdges.map(e=>({from:e[0],to:e[1]}))
});


function drawLabel(g,x,y,value,selected=false){g.font='bold 13px Georgia';const width=Math.min(146,g.measureText(value).width+20);g.fillStyle=selected?'#682015f2':'#321b12d9';g.beginPath();g.roundRect(x-width/2,y-14,width,23,6);g.fill();g.strokeStyle=selected?'#ffda82':'#cfa165';g.lineWidth=1;g.stroke();g.fillStyle='#fce9bc';g.fillText(value,x-width/2+10,y+2)}


// V16: Canvas animation effects are rendered from the actual in-game scene, never a fake progress simulation.
const v16TAU=Math.PI*2;
function v16Ell(g,x,y,rx,ry,color,opacity=1){g.save();g.globalAlpha=opacity;g.fillStyle=color;g.beginPath();g.ellipse(x,y,rx,ry,0,0,v16TAU);g.fill();g.restore()}
function v16Breeze(g,ts){
 const t=ts/1000;
 // Subtle, moving dappled sunlight; the landscape is not translated or distorted.
 g.save();g.globalCompositeOperation='soft-light';
 for(let k=0;k<7;k++){
  let x=((k*239+t*7)%1480)-150,y=125+(k*81)%330;
  const r=g.createRadialGradient(x,y,4,x,y,92+(k%3)*24);
  r.addColorStop(0,'rgba(255,239,179,.12)');r.addColorStop(1,'rgba(255,239,179,0)');
  g.fillStyle=r;g.beginPath();g.ellipse(x,y,110,42,-.17,0,v16TAU);g.fill();
 }g.restore();
 // Flecks of moving foliage remain in the fixed tree canopy positions.
 for(const [x,y,s] of [[164,142,1],[329,91,.84],[892,158,.95],[1023,279,.9],[760,75,.65]]){
  g.save();g.globalAlpha=.14;g.translate(x,y);g.rotate(Math.sin(t*.65+x)*.025);
  for(let n=0;n<5;n++){
   let dx=Math.cos(n*2.4)*24*s+Math.sin(t*1.1+n)*3,dy=Math.sin(n*2.4)*13*s;
   v16Ell(g,dx,dy,12*s,5.5*s,n%2?'#c3be67':'#435e30',.38);
  }g.restore();
 }
}
function v16Flags(g,ts,state,scenic){
 const t=ts/1000;
 // Flags are physically anchored to built civic structures; no floating fixed-position props.
 const flags=[];
