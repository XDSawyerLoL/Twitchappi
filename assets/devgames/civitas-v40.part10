 g.save();g.lineCap='round';
 for(const [ax,ay,aw,ah] of areas){g.save();g.beginPath();g.rect(ax,ay,aw,ah);g.clip();
 for(let n=0;n<38;n++){
  const phase=(t*(3+n%4)*.55+n*37.73),x=ax+((n*73+phase*7)%(aw+42))-14,y=ay+((n*41+Math.sin(t*.9+n)*3)%(ah+20));
