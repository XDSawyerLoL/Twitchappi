  }g.restore();v16Ell(g,0,0,3,3,'#b6915b');
 }else if(type==='carriere'||type==='marbre'){
  for(let n=0;n<2;n++){
   const s=(t*2.8+n*1.1)%1;
   v16Ell(g,x+13+s*18,y+6-s*5,2+s*2,1.2+s*1.3,'#e6d8b1',.5*(1-s));
  }
 }else if(type==='cave'){
