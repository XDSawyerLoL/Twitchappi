">
 ${v24ProvinceTraffic()}${v25ProvinceMissionMap()}<div class="v15-region-decor" aria-hidden="true">
 ${[
   ['olive',7,25,88],['cypress',12,38,60],['rocks',40,14,118],['olive',33,16,80],
   ['cypress',81,24,70],['olive',64,14,76],['rocks',13,77,95],['cypress',35,73,79],
   ['rocks',58,82,105],['olive',89,12,84],['cypress',44,26,60],['olive',23,89,71]
 ].map(([type,x,y,w],i)=>`<img src="${(window.CIVITAS_V13_ART||{})[type]}" class="region-detail region-detail-${i}" style="left:${x}%;top:${y}%;width:${w}px" alt="">`).join('')}
 <div class="v15-wave-mark v15-wave-one"></div><div class="v15-wave-mark v15-wave-two"></div>
 </div>
 ${Object.entries(COMMON_SITES).map(([key,def])=>`<button class="common-node ${game.localSelected==='site:'+key?'active':''}" data-local-site="${key}" style="left:${def.x}%;top:${def.y}%"><img class="v15-common-art" alt="" loading="lazy" src="${(window.CIVITAS_V13_ART||{})[key==='wood'?'scierie':'carriere']}"><strong>${def.name}</strong><small>Ouvriers : ${commonTotal(key)} / ${COMMON_MAX}</small></button>`).join('')}
 ${NEIGHBORS.map(n=>{const owned=!!game.cities[n.id],vacant=n.id.startsWith('vacant')&&!owned,name=owned?cityName(n.id):n.name;return `<button class="local-node ${owned?'my-city':''} ${vacant?'vacant':''} ${game.localSelected===n.id?'active':''}" data-local-city="${n.id}" style="left:${n.x}%;top:${n.y}%" aria-label="Inspecter ${esc(name)}"><span class="node-building">${vacant?'<span class="vacant-flag">✚</span>':`<img loading="lazy" alt="" src="${(window.CIVITAS_V13_ART||{})[owned?(game.cities[n.id]?.sites?.[4]?.type==='hotelville'?'hotelville':'scaffold'):n.type.includes('militaire')?'caserne':n.type.includes('agricole')?'cave':n.type.includes('forestier')?'scierie':n.type.includes('fluvial')?'port':n.type.includes('marchand')?'marche':n.type.includes('viticole')?'cave':n.type.includes('minier')?'carriere':'logement']||(window.CIVITAS_V13_ART||{}).logement}">`}</span><span class="node-name">${esc(name)}</span><small>${owned?(game.activeCity===n.id?'Cité active':'Votre colonie'):vacant?'Terrain libre':'PNJ · '+n.type}</small></button>`}).join('')}
 <div class="local-legend"><span>⚜ Votre colonie</span><span>⌂ Colonies indépendantes (PNJ)</span><span>✚ Emplacements libres</span></div>
 </div><div class="local-bottom"><div><strong>Province du Latium</strong><span>${7+Object.keys(game.cities).length} positions occupées · ${3-Object.keys(game.cities).length} libres · routes terrestres</span></div><div><button class="btn-parch" data-nav="ville">Voir ma ville</button><button class="btn-red" data-nav="carte">Carte du monde</button></div></div>
 </div></div>`;}
function neighborPanel(){if(String(game.localSelected).startsWith('site:')){const type=game.localSelected.slice(5),site=COMMON_SITES[type];if(site){const used=game.sharedWorkers?.[type]||0,all=commonTotal(type),avail=availableWorkers();panelTitle('Ressource commune');$('rightPanel').innerHTML=`<div class="local-inspector"><div class="local-eyebrow">PROVINCE DU LATIUM · EXPLOITATION</div><div class="common-icon">${site.icon}</div><h2>${site.name}</h2><p>${site.description}</p><div class="local-stat"><span>Mes travailleurs</span><strong>${used} / ${COMMON_MAX}</strong></div><div class="local-stat"><span>Total provincial</span><strong>${all} / ${COMMON_MAX}</strong></div><div class="local-stat"><span>Disponibles chez moi</span><strong>${avail}</strong></div><div class="local-stat"><span>Production de ma cité</span><strong>+${Math.round(used*site.perWorker*(.58+game.happiness*.0042)*(regionBonus()[type]||1))}/h</strong></div><div class="common-controls"><button class="btn-parch" data-common-worker="${type}" data-delta="-1" ${used===0?'disabled':''}>− 1 ouvrier</button><button class="btn-red" data-common-worker="${type}" data-delta="1" ${all>=COMMON_MAX||avail===0||!hasHall()?'disabled':''}>+ 1 ouvrier</button></div><button class="btn-parch" data-local-city="player">Retour aux colonies</button><p class="local-explain">Ces ouvriers ne peuvent pas travailler simultanément dans un atelier. Leur production continue pendant votre absence.</p></div>`;return;}}
 const n=neighbor(game.localSelected)||NEIGHBORS[0],owned=!!game.cities[n.id],free=n.id.startsWith('vacant')&&!owned,st=!owned&&!free?localState(n.id):null,c=owned?cityInfo(n.id):null;
 panelTitle('Province · Voisinage');
 $('rightPanel').innerHTML=`<div class="local-inspector"><div class="local-eyebrow">LATIUM · ${owned?'CITÉ ROMAINE':free?'TERRAIN LIBRE':'CITÉ INDÉPENDANTE'}</div><div class="local-inspect-art">${owned?'⚜':free?'✚':'🏛'}</div><h2>${esc(owned?c.city:n.name)}</h2><p>${owned?'Colonie administrée':free?'Terrain côtier disponible':n.type}</p>
 ${owned?`<div class="local-stat"><span>Population</span><strong>${Math.floor(c.pop)}</strong></div><div class="local-stat"><span>Édifices</span><strong>${c.sites.filter(Boolean).length}</strong></div><div class="local-stat"><span>Stocks</span><strong>🪵 ${Math.floor(c.res.wood)} · 🪨 ${Math.floor(c.res.stone)}</strong></div><button class="btn-red" data-switch-city="${n.id}" ${game.activeCity===n.id?'disabled':''}>${game.activeCity===n.id?'Vous administrez cette cité':'Administrer cette cité'}</button><button class="btn-parch" data-nav="empire">Voir mes colonies</button>`:''}
 ${free?`<p>Une deuxième ville avec ses propres habitants, bâtiments, stocks, ouvriers et chantiers. Dix colons partent de la ville active.</p><div class="local-stat"><span>Hôtel de ville</span><strong>Niveau 2 requis</strong></div><div class="local-stat"><span>Port</span><strong>Requis</strong></div><div class="local-stat"><span>Population</span><strong>55 habitants</strong></div><div class="local-stat"><span>Coût</span><strong>🪵260 🪨190 🍇25 🪙180</strong></div>${game.colonizing?.target===n.id?`<div class="mission-ticket"><strong>Navire des colons en voyage</strong><span>${Math.ceil((game.colonizing.end-now())/1000)} s restants</span></div>`:''}<button class="btn-red" data-colonize="${n.id}" ${!canColonize(n.id)?'disabled':''}>Fonder ici une colonie</button>`:''}
 ${!free&&!owned?`<div class="local-stat"><span>Relations</span><strong>${st.relation}</strong></div><div class="local-stat"><span>Garnison</span><strong>${st.intelUntil>now()?st.guards+' légionnaires':'Estimation '+n.garrison}</strong></div><div class="local-stat"><span>Spécialité</span><strong>${META[n.resource].name}</strong></div><div class="local-stat"><span>Population</span><strong>${Math.floor(st.population)}</strong></div><div class="local-stat"><span>Réserves ${st.intelUntil>now()?'observées':'estimées'}</span><strong>${st.intelUntil>now()?Math.floor(st.stock)+' unités':st.stock>180?'Abondantes':st.stock>65?'Moyennes':'Faibles'}</strong></div><div class="local-stat"><span>Trésor</span><strong>${st.intelUntil>now()?Math.floor(st.treasury)+' deniers':'Non renseigné'}</strong></div><div class="local-stat"><span>Traité commercial</span><strong>${st.pactUntil>now()?'En vigueur':'Aucun'}</strong></div><div class="v22-enemy-forecast"><h3>Rapport de force avant attaque</h3><div>Garnison : <strong>${st.intelUntil>now()?Math.floor(st.guards):"≈ "+n.garrison}</strong> · Mes troupes mobilisables : <strong>${armyCount(takeMarchingArmy(st))}</strong></div><div>Chances estimées : <strong>${Math.round(previewBattle(n.id).chance*100)} %</strong> · Formation : ${FORMATIONS[game.formation]?.name||"Acies"}</div><small>Estimation, pas une garantie : le terrain, les pertes et le hasard interviennent pendant le combat.</small></div><button class="btn-parch" data-nav="caserne">Préparer les troupes et les formations</button><div class="local-controls"><button class="btn-parch" data-local-action="trade" ${!hasBuilding('marche')||!!game.localMission?'disabled':''}>Commercer</button><button class="btn-parch" data-local-action="spy" ${!hasBuilding('academie')||!!game.localMission?'disabled':''}>Espionner</button><button class="btn-parch" data-pact="${n.id}" ${!hasBuilding('marche')||st.relation<12||st.pactUntil>now()?'disabled':''}>Traité (50 or)</button><button class="btn-red" data-local-action="attack" ${!hasBuilding('caserne')||armyCount(takeMarchingArmy(st))<5||!!game.localMission?'disabled':''}>Attaquer</button></div><p class="local-explain">Ces voisins restent des PNJ simulés, pas des joueurs en ligne.</p>`:''}
 ${game.localMission?`<div class="mission-ticket"><strong>Mission en cours</strong><span>${neighbor(game.localMission.target)?.name||''} · ${Math.max(0,Math.ceil((game.localMission.end-now())/1000))} s</span></div>`:''}</div>`;
}
function sidePanel(){if(game.nav==='locale'){neighborPanel();return;}if(game.nav==='ville'){
 const b=game.sites[game.selected],c=game.construction,queueJob=game.queue.find(j=>j.site===game.selected);
 if(!b&&game.panelMode==='details'&&!c&&!queueJob)game.panelMode='catalog';
 if(c&&c.site===game.selected){const progress=100*Math.min(1,Math.max(0,(now()-c.start)/(c.end-c.start)));
  panelTitle('Chantier en activité');$('rightPanel').innerHTML=`<div class="v4-inspector"><div class="v4-eyebrow">PARCELLE ${game.selected+1} · CONSTRUCTION</div><div class="v4-building"><img src="${sprite(c.type)}" alt=""><div><h3>${BUILD[c.type].name}</h3><p>Niveau ${c.level} · artisans au travail</p></div></div><div class="v4-progress"><i style="width:${progress}%"></i></div><div class="v4-row"><span>Avancement</span><strong>${Math.floor(progress)} %</strong></div><div class="v4-row"><span>Temps restant</span><strong class="buildremain">${formatSec((c.end-now())/1000)}</strong></div><p class="v4-explainer">Le bâtiment ne produira qu'une fois le chantier terminé. Les ouvriers traversent la ville jusqu'à cette parcelle.</p><div class="v4-actions"><button class="btn-parch" data-nav="chantiers">Voir la file (${game.queue.length})</button><button class="btn-parch v4-danger" data-cancel-job="-1">Annuler</button></div></div>`;return;}
 if(queueJob){panelTitle('Chantier programmé');$('rightPanel').innerHTML=`<div class="v4-inspector"><div class="v4-eyebrow">PARCELLE ${game.selected+1} · FILE D'ATTENTE</div><div class="v4-building"><img src="${sprite(queueJob.type)}" alt=""><div><h3>${BUILD[queueJob.type].name}</h3><p>Niveau ${queueJob.level}</p></div></div><p class="v4-explainer">Les matériaux ont été réservés. Les travaux débuteront après les chantiers précédents.</p><div class="v4-row"><span>Position dans la file</span><strong>${game.queue.indexOf(queueJob)+2} / ${game.queue.length+1}</strong></div><div class="v4-row"><span>Durée prévue</span><strong>${formatSec(queueJob.seconds)}</strong></div><div class="v4-actions"><button class="btn-parch" data-nav="chantiers">Gérer les chantiers</button><button class="btn-parch v4-danger" data-cancel-job="${game.queue.indexOf(queueJob)}">Annuler</button></div></div>`;return}
 if(b&&game.panelMode!=='catalog'){const def=BUILD[b.type],next=b.level+1,cost=costFor(b.type,next),n=game.workers[game.selected]||0,work=WORK_TYPES[b.type],queued=game.construction?game.queue.length+1:0;
  const effective=work?Math.round(n*work[1]*(1+.15*(b.level-1))*(.58+game.happiness*.0042)*(game.researches?.economy?1.14:1)):0;
  panelTitle(def.name+' · niveau '+b.level);
  $('rightPanel').innerHTML=`<div class="v4-inspector"><div class="v4-eyebrow">BÂTIMENT ACTIF · PARCELLE ${game.selected+1}</div><div class="v4-building"><img src="${sprite(b.type)}" alt="${def.name}"><div><h3>${def.name}</h3><p>${def.desc}</p></div></div><div class="v4-stats"><div><small>Niveau</small><strong>${b.level}</strong></div>${work?`<div><small>Production réelle</small><strong>+${effective}/h</strong></div>`:def.housing?`<div><small>Capacité d'accueil</small><strong>+${b.level*def.housing}</strong></div>`:def.storage?`<div><small>Capacité de stockage</small><strong>+${b.level*def.storage}</strong></div>`:`<div><small>Statut</small><strong>Actif</strong></div>`}</div>
 ${work?`<div class="v4-workshop"><div class="v4-section-title">Main-d'œuvre <span>${n} / ${jobsCapacity(game.selected)} · ${availableWorkers()} libres</span></div><div class="v4-labor-track"><i style="width:${n/jobsCapacity(game.selected)*100}%"></i></div><div class="v4-labor-buttons"><button data-worker="-5">−5</button><button data-worker="-1">−1</button><button data-worker="1">+1</button><button data-worker="5">+5</button></div><small>Sans ouvriers, pas de production. Les citoyens libres fournissent les revenus fiscaux.</small></div>`:''}
 ${work&&n===0?`<div class="v5-labor-warning"><strong>⚠ Atelier à l'arrêt</strong><span>Tu as ${availableWorkers()} travailleurs libres. Il faut les affecter pour démarrer la production.</span><button class="v5-assign" data-worker="5" ${availableWorkers()<=0?'disabled':''}>Affecter jusqu'à 5 ouvriers</button></div>`:''}
 <div class="v4-section-title">Amélioration <span>niveau ${next}</span></div>${requirementsHtml(cost)}<div class="v4-duration">⌛ ${formatSec(timeFor(b.type,next))} ${queued?' · position '+(queued+1):''}</div><button class="btn-red v4-cta" data-build="${b.type}" ${game.queue.length>=2&&game.construction||!affordable(cost)?'disabled':''}>${!affordable(cost)?'Ressources insuffisantes':game.construction?'Programmer l’amélioration':'Améliorer au niveau '+next}</button><div class="v4-actions"><button class="btn-parch" data-panel-catalog="1">Catalogue des bâtiments</button>${b.type==='hotelville'?'<button class="btn-parch" data-nav="locale">Voir les voisins</button>':b.type==='senatbat'?'<button class="btn-parch" data-nav="senat">Délibérer au Sénat</button>':`<button class="btn-parch v4-danger" data-demolish="${game.selected}">Démolir</button>`}</div></div>`;return;
 }
 panelTitle(!hasHall()?'Fonder la colonie':'Construire et développer');const filter=game.panelFilter||'tous';const canBuild=!b;
 $('rightPanel').innerHTML=`<div class="v4-catalog"><div class="v4-eyebrow">PARCELLE ${game.selected+1} · ${canBuild?'TERRAIN LIBRE':'BÂTIMENT EXISTANT'}</div>${b?`<div class="v4-switch-banner">Tu inspectes ${BUILD[b.type].name}. <button data-panel-details="1">Voir le bâtiment ❯</button><button data-site-next="1">Terrain libre ❯</button></div>`:`<div class="v4-mini-stat">${game.sites.filter(x=>!x).length} terrains libres · ${3-(game.construction?1:0)-game.queue.length} emplacements de chantier</div>`}<div class="v4-tabs">${Object.entries(GROUPS).map(([id,name])=>`<button class="${filter===id?'active':''}" data-panel-filter="${id}">${name}</button>`).join('')}</div><div class="v30-catalog-controls"><label class="v30-search-label" for="v30CatalogSearch">Rechercher un bâtiment</label><div class="v30-catalog-fields"><input id="v30CatalogSearch" type="search" placeholder="Scierie, logement, caserne…" autocomplete="off"><button id="v30Affordable" type="button" aria-pressed="false">Constructibles</button></div><div id="v30CatalogCount" aria-live="polite"></div></div><div class="v4-catalog-list">${Object.entries(BUILD).filter(([k])=>(k!=='hotelville'||game.selected===HALL_SITE)&&(filter==='tous'||GROUP_OF[k]===filter)).map(([type,def])=>{const cost=costFor(type,1),miss=missingCost(cost),blocked=game.selected===HALL_SITE?type!=='hotelville':type==='hotelville'||!hasHall(),senateLocked=type==='senatbat'&&(hallLevel()<2||hasSenate()),disabled=!canBuild||blocked||senateLocked||miss.length||game.construction&&game.queue.length>=2;return `<div class="v4-card ${disabled?'is-locked':''}" data-v30-name="${esc(def.name.toLowerCase())}" data-v30-type="${type}"><img src="${sprite(type)}" alt=""><div class="v4-card-info"><strong>${def.name}</strong><small>${def.desc}</small><div class="v4-card-cost">${resHTML(cost)}</div></div><button data-build="${type}" ${disabled?'disabled':''} title="${disabled?(miss.length?'Manque '+miss.join(', '):!canBuild?'Sélectionner un terrain libre':'File de chantiers pleine'):'Construire '+def.name}">${disabled?'·':'❯'}</button></div>`}).join('')}</div><p class="v4-catalog-help">${!hasHall()?'Commence par l’Hôtel de ville au centre : c’est le tout premier bâtiment de ta colonie.':canBuild?'Choisis un bâtiment : les matériaux sont prélevés au lancement du chantier.':'Sélectionne une parcelle vide pour bâtir.'}${needsFoundingAid()?`<br><button class="v5-catalog-relief" data-relief="1">✉ Demander un ravitaillement de fondation</button>`:''}</p></div>`;return;
 }
const status={locale:'Vue de province',carte:'Province sélectionnée',empire:'Votre empire',senat:'Le Sénat',alliance:'Diplomatie',messages:'Journal',classement:'Classement',options:'Préférences',caserne:'Vos légions',marche:'Comptoir'};panelTitle(status[game.nav]||'Votre cité');let right='';if(game.nav==='carte'){
 const p=PLACES.find(p=>p.id===provinceSelected)||PLACES[1],owned=game.provinces.includes(p.id),mode=game.provinceMode||'province',resource=Object.keys(p.bonus)[0]||'stone';
 const cost=expeditionCost(p),tradeCost=voyageCost(p);
 right=`<div class="v4-province"><div class="v4-prov-head"><span class="v4-prov-seal">${owned?'⚜':'⚑'}</span><div><small>${p.kind.toUpperCase()}</small><h3>${p.name}</h3></div></div><p class="v4-prov-desc">${p.desc}</p><div class="v4-prov-tabs"><button data-province-mode="province" class="${mode==='province'?'active':''}">Province</button><button data-province-mode="campagne" class="${mode==='campagne'?'active':''}">Campagne</button><button data-province-mode="commerce" class="${mode==='commerce'?'active':''}">Commerce</button></div>
 ${mode==='province'?`<div class="v4-prov-row"><span>Souveraineté</span><strong>${owned?'Romaine':'Indépendante'}</strong></div><div class="v4-prov-row"><span>Garnison</span><strong>${p.power} légionnaires</strong></div><div class="v4-prov-row"><span>Traversée</span><strong>${formatSec(travelTime(p))}</strong></div><div class="v4-section-title">Richesses naturelles</div><div class="chips">${Object.entries(p.bonus).map(([k,v])=>`<span class="chip">${META[k].icon} +${v}/h</span>`).join('')||'<span class="chip">Cité fondatrice</span>'}</div><p class="v4-p-tip">Pour conquérir ou commercer avec cette province, ouvre l’onglet correspondant.</p>`:''}
 ${mode==='campagne'?`<div class="v4-prov-row"><span>Cohortes mobilisables</span><strong>${armyCount(takeMarchingArmy())} · Force ${Math.round(armyPower(takeMarchingArmy()))}</strong></div><div class="v4-prov-row"><span>Défense locale</span><strong>${p.power}</strong></div><div class="v4-odds">Chances de victoire : <strong>${expeditionOdds(p)} %</strong><div class="v4-labor-track"><i style="width:${expeditionOdds(p)}%"></i></div></div><div class="v4-section-title">Coût de la campagne</div>${requirementsHtml(cost)}<button class="btn-red v4-prov-action" data-expedition="${p.id}" ${owned||!hasBuilding('caserne')||!hasBuilding('port')||armyPower(takeMarchingArmy())*(FORMATIONS[game.formation]?.attack||1)<p.power*.85||game.expedition||!affordable(cost)?'disabled':''}>⚔ ${owned?'Province déjà conquise':'Envoyer les cohortes'}</button><p class="v4-p-tip">${!hasBuilding('port')?'Port nécessaire. ':''}${!hasBuilding('caserne')?'Caserne nécessaire. ':''}Une campagne peut échouer. Les soldats partent réellement de la garnison.</p>`:''}
 ${mode==='commerce'?`<div class="v4-prov-row"><span>Cargaison recherchée</span><strong>${META[resource].icon} ${META[resource].name}</strong></div><div class="v4-prov-row"><span>Quantité attendue</span><strong>+${Math.round(55+p.power*2.5)}</strong></div><div class="v4-prov-row"><span>Durée aller-retour</span><strong>${formatSec(Math.max(20,Math.round(travelTime(p)*.8)))}</strong></div><div class="v4-section-title">Frais du navire</div>${requirementsHtml(tradeCost)}<button class="btn-red v4-prov-action" data-voyage="${p.id}" ${p.id==='latium'||!hasBuilding('port')||game.voyage||!affordable(tradeCost)?'disabled':''}>⛵ ${p.id==='latium'?'Colonie principale':game.voyage?'Navire déjà en mer':'Lancer le commerce'}</button><p class="v4-p-tip">Le navire ramènera les marchandises à l’arrivée. Le port est indispensable.</p>`:''}
 </div>`;
}
else if(game.nav==='empire')right=`<h3>Colonia Julia</h3><p>Rome ne s'est pas bâtie en un jour.</p><div class="statrow">Provinces <strong>${game.provinces.length} / ${PLACES.length}</strong></div><div class="statrow">Influence <strong>${game.influence}</strong></div><div class="statrow">Légionnaires <strong>${game.legions}</strong></div><div class="statrow">Citoyens <strong>${Math.floor(game.pop)}</strong></div><div class="statrow">Satisfaction <strong>${Math.round(game.happiness)}%</strong></div><button class="btn-red" data-nav="carte">Voir les provinces</button>`;
else if(game.nav==='senat')right=`<h3>Décrets impériaux</h3><p>La loyauté du peuple détermine la prospérité de la cité.</p><div class="statrow">Satisfaction <strong>${Math.round(game.happiness)} %</strong></div><div class="statrow">Prestige <strong>${game.influence}</strong></div><button class="btn-parch" data-edict="wine">Organiser une fête</button>`;
else if(game.nav==='caserne'||game.nav==='guerre')right=`<h3>État des forces</h3><div class="statrow">Légionnaires <strong>${game.legions}</strong></div><div class="statrow">Vélites <strong>${game.units?.velites||0}</strong></div><div class="statrow">Équites <strong>${game.units?.equites||0}</strong></div><div class="statrow">Doctrine <strong>${FORMATIONS[game.formation||'acies']?.name||'Acies'}</strong></div><p>Puissance combinée : <strong>${Math.round(armyPower(cityArmy(game)))}</strong></p>${game.incomingRaid?`<p class="v22-raid-alert">⚠ Raid sur ${esc(cityName(game.incomingRaid.city))} dans ${formatSec((game.incomingRaid.end-now())/1000)}</p>`:''}<button class="btn-parch" data-nav="guerre">Rapports de bataille (${game.battleReports?.length||0})</button><button class="btn-parch" data-nav="locale">Voisins du Latium</button>`;
else if(game.nav==='marche')right=`<h3>Comptoir marchand</h3><p>Échangez vos ressources contre celles qui vous manquent.</p><button class="btn-parch" data-trade="wood">100 bois → 75 pierre</button>`;
else if(game.nav==='alliance'||game.nav==='classement')right=`<h3>Multijoueur</h3><p>Cette alpha se joue hors ligne, contre des provinces neutres. Les alliances et classements de joueurs nécessitent un serveur partagé.</p><button class="btn-parch" data-nav="carte">Explorer les provinces</button>`;
else if(game.nav==='options')right=`<h3>Configuration</h3><p>La progression est enregistrée automatiquement sur ce navigateur.</p><button class="btn-parch" data-export="1">Exporter ma partie</button>`;
else if(game.nav==='messages')right=`<h3>Événements</h3>${game.log.slice(0,5).map(e=>`<p style="font-size:15px;border-bottom:1px solid #bd9863">${esc(e.txt)}</p>`).join('')}`;
else if(game.nav==='economie')right=`<h3>Ouvriers & production</h3><div class="statrow">Main-d’œuvre <strong>${occupied()} / ${workforce()}</strong></div><div class="statrow">Sans emploi <strong>${availableWorkers()}</strong></div><p>Les citoyens doivent être affectés aux ateliers. Sélectionne un bâtiment de production pour les répartir.</p><button class="btn-parch" data-nav="ville">Retour à la cité</button>`;
else if(game.nav==='recherche')right=`<h3>Académie</h3><div class="statrow">Savoir <strong>${Math.floor(game.science)} points</strong></div><p>L'académie produit du savoir permettant d'améliorer l'économie, la construction et la navigation.</p><button class="btn-parch" data-nav="ville">Construire une académie</button>`;
else if(game.nav==='evenements'){const ev=EVENTS.find(e=>e.id===game.pendingEvent);right=ev?`<h3>${ev.title}</h3><p>${ev.text}</p>`:'<h3>Chroniques</h3><p>Aucun événement en attente.</p>'}
$('rightPanel').innerHTML=`<div class="panel-section">${right}</div>`}
function renderSelectedRoute(){
 const p=PLACES.find(x=>x.id===provinceSelected);if(!p||p.id==='latium')return '';
 const origin=PLACES[0],x1=origin.x*10,y1=origin.y*4.7,x2=p.x*10,y2=p.y*4.7;
 const cx=(x1+x2)/2,cy=(y1+y2)/2+Math.min(85,30+Math.hypot(x2-x1,y2-y1)*.10);
 const path=`M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
 return `<svg class="v4-route-overlay" viewBox="0 0 1000 470" preserveAspectRatio="none" aria-hidden="true"><path class="v4-route-glow" d="${path}"/><path class="v4-route-path" d="${path}"/><text font-size="20" text-anchor="middle">⛵<animateMotion dur="11s" repeatCount="indefinite" path="${path}"/></text></svg>`;
}
function overlayContents(nav){if(nav==='locale')return localOverlay();const h={chantiers:'Atelier des bâtisseurs',economie:'Économie et main-d’œuvre',recherche:'Recherche et progrès',evenements:'Chroniques du gouverneur',carte:'Mare Nostrum — Carte des provinces',empire:'L’Empire de Rome',senat:'Le Sénat de la cité',alliance:'Ambassades et alliances',messages:'Chroniques de la colonie',classement:'Gloire de Rome',options:'Options et sauvegarde',caserne:'Les légions de Rome',guerre:'Chroniques militaires',marche:'Le marché'}[nav]||'CIVITAS';let b='';
if(nav==='carte'){b=`<div class="map-kicker"><span>◈ La Méditerranée · Provinces romaines et territoires indépendants</span><span>${game.provinces.length} / ${PLACES.length} provinces sous influence</span></div><div class="roman-map" role="group" aria-label="Carte géographique interactive de la Méditerranée"><div class="roman-map-art">${GEOMAP}</div>${v24WorldArt()}${v25WorldMissionMap()}
<div class="v15-world-features" aria-hidden="true">
 ${[
 ['port',53,43,72],['cypress',27,22,31],['olive',70,21,40],['rocks',25,71,61],
 ['carriere',43,60,62],['cave',34,39,55],['rocks',78,69,75],['olive',59,22,43]
 ].map(([kind,x,y,w])=>`<img src="${(window.CIVITAS_V13_ART||{})[kind]}" alt="" style="left:${x}%;top:${y}%;width:${w}px">`).join('')}
 </div>${renderSelectedRoute()}${PLACES.map(p=>`<button class="geo-pin ${game.provinces.includes(p.id)?'owned':''} ${provinceSelected===p.id?'active':''}" data-province="${p.id}" style="left:${p.x}%;top:${p.y}%" aria-label="Sélectionner ${p.name}"><span class="pin-icon"><img alt="" src="${(window.CIVITAS_V13_ART||{})[p.id==='latium'?'hotelville':p.bonus?.wine?'cave':p.bonus?.marble?'marbre':p.bonus?.stone?'carriere':p.bonus?.gold?'marche':'logement']}"></span><span class="pin-name">${p.name}</span></button>`).join('')}<div class="map-legend"><span><i class="legend-owned"></i> Rome</span><span><i class="legend-free"></i> Provinces indépendantes</span><span>⛵ Routes commerciales</span></div></div><div class="map-bottom"><div><strong>Conseil impérial</strong> — Sélectionne un territoire sur la carte. Les coûts, les délais, ses ressources et sa garnison apparaîtront à droite.</div><button class="btn-parch" data-nav="empire">Voir mon empire</button></div>`}
else if(nav==='chantiers'){const jobs=[...(game.construction?[{...game.construction,active:true}]:[]),...game.queue.map((j,i)=>({...j,queueIndex:i}))];b=`<p>Les travaux sont réalisés dans l'ordre, avec <strong>un chantier actif</strong> et <strong>deux travaux programmables</strong>. Les matériaux des travaux programmés sont réservés immédiatement.</p><div class="v4-job-grid">${jobs.length?jobs.map((j,i)=>`<div class="v4-job-card"><div class="v4-job-icon"><img src="${sprite(j.type)}" alt=""></div><div><strong>${BUILD[j.type].name} · niv. ${j.level}</strong><small>Parcelle ${j.site+1} · ${j.active?'En construction':'En attente'}</small>${j.active?`<div class="v4-progress"><i style="width:${Math.max(0,Math.min(100,100*(now()-j.start)/(j.end-j.start)))}%"></i></div><small>${formatSec((j.end-now())/1000)} restantes</small>`:`<small>Durée : ${formatSec(j.seconds)}</small>`}</div><button class="btn-parch v4-danger" data-cancel-job="${j.active?-1:j.queueIndex}">Annuler</button></div>`).join(''):'<div class="v4-empty-jobs">Aucun chantier actif. Sélectionne un terrain pour commencer.</div>'}</div><div class="v4-footer-actions"><button class="btn-red" data-nav="ville">Retour à la cité</button></div>`}
else if(nav==='empire'){const built=game.sites.filter(Boolean).length;b=`<div class="card-grid"><div class="card"><h3>🏛️ La colonie</h3><p>${esc(game.city)} · Population ${Math.floor(game.pop)} / ${popCap()}</p><small>${built} bâtiments, ${game.sites.filter(x=>!x).length} parcelles libres</small></div><div class="card"><h3>⚔️ Les légions</h3><p>${game.legions} soldats, ${game.provinces.length} provinces sous le contrôle de Rome.</p><button class="btn-parch" data-nav="caserne">Gérer l'armée</button></div><div class="card"><h3>🏆 Prestige</h3><p>Influence impériale : ${game.influence}</p><small>Satisfaction : ${Math.round(game.happiness)} %</small></div></div><h2>Provinces administrées</h2><div class="chips">${PLACES.filter(p=>game.provinces.includes(p.id)).map(p=>`<span class="chip">⚜ ${p.name}</span>`).join('')}</div><div class="empire-actions"><button class="btn-red" data-nav="carte">Explorer la Méditerranée</button><button class="btn-parch" data-nav="economie">Gérer les ouvriers</button><button class="btn-parch" data-nav="recherche">Développer les recherches</button></div>`}
else if(nav==='economie'){const rates=production();b=`<p>Les ateliers produisent uniquement lorsque des citoyens y travaillent. Les habitants sans emploi soutiennent l'économie et génèrent des deniers.</p><div class="economy-summary"><div><span>Population</span><b>${Math.floor(game.pop)} / ${popCap()}</b></div><div><span>Ouvriers</span><b>${occupied()} / ${workforce()}</b></div><div><span>Disponibles</span><b>${availableWorkers()}</b></div><div><span>Bonheur</span><b>${Math.floor(game.happiness)} %</b></div></div><div class="card-grid">${game.sites.map((building,i)=>{if(!building||!WORK_TYPES[building.type])return '';const [res,prod]=WORK_TYPES[building.type];return `<div class="card"><h3>${BUILD[building.type].icon} ${BUILD[building.type].name} · niv. ${building.level}</h3><p>${game.workers[i]||0} ouvriers sur ${jobsCapacity(i)} places</p><small>+${Math.floor((game.workers[i]||0)*prod)} ${META[res].name}/h avant bonus</small><div class="worker-controls"><button class="btn-parch" data-worker-site="${i}" data-worker="-1">−</button><button class="btn-parch" data-worker-site="${i}" data-worker="1">+ 1</button><button class="btn-parch" data-worker-site="${i}" data-worker="5">+ 5</button></div></div>`}).join('')}</div>`}
else if(nav==='recherche'){b=`<p>La connaissance accroît la puissance de Rome. Construis une <strong>Académie</strong> pour générer du savoir, puis débloque des progrès permanents.</p><div class="economy-summary"><div><span>Savoir disponible</span><b>${Math.floor(game.science)}</b></div><div><span>Académies</span><b>${buildings('academie').length}</b></div><div><span>Recherches</span><b>${Object.keys(game.researches).filter(k=>game.researches[k]).length} / ${TECHS.length}</b></div></div><div class="card-grid">${TECHS.map(t=>`<div class="card research-card"><h3>${t.icon} ${t.name}</h3><p>${t.desc}</p><small>✦ ${t.cost} points de savoir</small><button class="btn-red" data-research="${t.id}" ${!hasBuilding('academie')||game.science<t.cost||game.researches[t.id]?'disabled':''}>${game.researches[t.id]?'✓ Débloquée':'Étudier'}</button></div>`).join('')}</div>`}
else if(nav==='evenements'){const e=EVENTS.find(e=>e.id===game.pendingEvent);b=e?`<div class="event-stage"><div class="event-illust">⚜</div><h2>${e.title}</h2><p>${e.text}</p><div class="event-choices">${e.choices.map((c,i)=>`<button class="btn-red" data-event-choice="${i}" ${Object.entries(c[1]).some(([k,v])=>RES.includes(k)&&v<0&&game.res[k]<-v)?'disabled':''}>${c[0]}</button>`).join('')}</div></div>`:'<p>Aucun événement politique ou commercial ne réclame ton intervention pour l’instant.</p>'}
else if(nav==='senat'&&!hasSenate()){b=`<div class="senate-locked"><div class="senate-icon">⚖</div><h2>La Curie n’est pas encore érigée</h2><p>Le Sénat n’existe pas dans cette colonie tant que son bâtiment n’a pas été construit. Développe l’Hôtel de ville jusqu’au niveau 2, puis érige la Curie sur un emplacement libre.</p><div class="chips"><span class="chip">Hôtel de ville : niv. ${hallLevel()} / 2</span><span class="chip">Curie : à construire</span></div><button class="btn-red" data-nav="ville">Retour aux chantiers</button></div>`}
else if(nav==='senat'){const rows=[['tax','Lever un impôt','Le trésor reçoit 200 or, mais le mécontentement augmente.','Gain : +200 or / −12 satisfaction',{}],['wine','Organiser des jeux','Offrir vin et spectacles pour rassurer la plèbe.','Gain : +14 satisfaction / +3 prestige',{wine:80,gold:35}],['grain','Distribuer des vivres','Attirer de nouveaux habitants et renforcer la loyauté.','Gain : +4 habitants / +10 satisfaction',{gold:80}],['trade','Mandater des négociants','Échanger des blocs de pierre contre une cargaison de bois.','Gain : +165 bois',{stone:100}]];b=`<p>Les décisions du Sénat ont des conséquences sur la satisfaction, la population et la richesse. Chaque décret nécessite un délai avant d'être adopté de nouveau.</p><div class="card-grid">${rows.map(([id,title,desc,effect,cost])=>`<div class="card"><h3>${title}</h3><p>${desc}</p><small>${effect}</small><div class="costgrid">${resHTML(cost)}</div><button class="btn-red" data-edict="${id}" ${game.cooldown[id]>now()||!affordable(cost)?'disabled':''}>${game.cooldown[id]>now()?`Patientez ${formatSec((game.cooldown[id]-now())/1000)}`:'Promulguer'}</button></div>`).join('')}</div>`}
else if(nav==='caserne'){b=warOfficeHTML()}
else if(nav==='guerre'){b=`<div class="v22-war-history"><h2>Chroniques des campagnes</h2><p>Rapports de bataille, pertes et conséquences diplomatiques des guerres menées depuis tes colonies.</p>${battleReportsHTML()}<button class="btn-parch" data-nav="caserne">Revenir au castrum</button></div>`}
else if(nav==='marche'){const offers=[['wood','100 Bois','75 Pierre'],['stone','100 Pierre','80 Bois'],['marble','70 Marbre','110 Or'],['wine','100 Vin','90 Or'],['gold','150 Or','80 Marbre']];b=`<p>Les négociants importent et exportent des marchandises. Pour accéder aux échanges, construisez un <strong>Marché</strong>.</p><div class="card-grid">${offers.map(([id,from,to])=>`<div class="card"><h3>${from}</h3><p>À échanger contre <strong>${to}</strong></p><button class="btn-red" data-trade="${id}" ${!hasBuilding('marche')?'disabled':''}>Effectuer l'échange</button></div>`).join('')}</div>${!hasBuilding('marche')?'<p class="muted">Marché non construit : échanges verrouillés.</p>':''}`}
else if(nav==='messages')b=`<p>Le journal garde la trace des actes de votre colonie. Il ne s'agit pas de messages provenant de vrais joueurs.</p>${game.log.map(e=>`<div class="event-row"><time>${new Date(e.t).toLocaleString('fr-FR')}</time>${esc(e.txt)}</div>`).join('')}`;
else if(nav==='alliance')b=`<div class="plaque"><h2>⚜ Diplomatie romaine</h2><p>Le système d'alliances entre joueurs sera disponible dans l'édition multijoueur avec comptes, serveur et synchronisation des colonies.</p><p>Dans cette version solo, vos relations extérieures sont représentées par les provinces indépendantes de la carte stratégique.</p><button class="btn-red" data-nav="carte">Visiter les territoires indépendants</button></div>`;
else if(nav==='classement')b=`<div class="plaque"><h2>🏆 Votre progression</h2><table class="table-like"><tr><th>Indicateur</th><th>Votre cité</th></tr><tr><td>Prestige</td><td>${game.influence}</td></tr><tr><td>Provinces</td><td>${game.provinces.length}</td></tr><tr><td>Population</td><td>${Math.floor(game.pop)}</td></tr><tr><td>Légionnaires</td><td>${game.legions}</td></tr><tr><td>Bâtiments</td><td>${game.sites.filter(Boolean).length}</td></tr></table><p>Un classement réel apparaîtra lorsque plusieurs joueurs pourront rejoindre le même serveur.</p></div>`;
else if(nav==='options')b=`<div class="two-col"><div class="plaque"><h2>⚙️ Paramètres</h2><label for="speedPicker"><strong>Vitesse de progression (alpha)</strong></label><p><select class="speed-select" id="speedPicker"><option value="1" ${game.speed===1?'selected':''}>×1 — temps réel</option><option value="10" ${game.speed===10?'selected':''}>×10 — rapide</option><option value="30" ${game.speed===30?'selected':''}>×30 — démonstration</option><option value="60" ${game.speed===60?'selected':''}>×60 — accéléré</option></select></p><p>Le taux de production affiché est exprimé en heures de jeu, le facteur choisi accélère le temps de production.</p><label for="renameCity"><strong>Nom de la colonie</strong></label><p><input id="renameCity" maxlength="24" value="${esc(game.city)}" style="padding:9px;background:#fff3d7;border:1px solid #bd9760"><button class="btn-parch" data-rename="1">Renommer</button></p></div><div class="plaque"><h2>💾 Sauvegarde</h2><p>Progression enregistrée automatiquement dans ce navigateur. Le fonctionnement est hors ligne.</p><div class="export-box"><button class="btn-parch" data-export="1">Exporter une partie (.json)</button><label class="btn-parch" for="importGame" style="cursor:pointer">Importer une partie</label><input type="file" id="importGame" accept=".json,application/json" style="display:none"></div><p><button class="btn-parch" data-story="menu">Retourner à l'écran titre</button> <button class="btn-parch" data-tutorial-replay="1">Revoir le tutoriel</button></p><p><button class="btn-red" data-reset="1">Recommencer à zéro</button></p><small>Aucun compte ni synchronisation multi-appareils pour cette alpha.</small></div></div>`;
if(nav==='empire'){
 const cards=Object.entries(game.cities).map(([id,stored])=>{const c=cityInfo(id);return `<div class="city-card"><h3>⚜ ${esc(c.city)}</h3><p>${Math.floor(c.pop)} habitants · ${c.sites.filter(Boolean).length} bâtiments</p><div class="city-stock">🪵 ${Math.floor(c.res.wood)} &nbsp; 🪨 ${Math.floor(c.res.stone)} &nbsp; 🪙 ${Math.floor(c.res.gold)}</div><button class="btn-parch" data-switch-city="${id}" ${game.activeCity===id?'disabled':''}>${game.activeCity===id?'Cité active':'Administrer'}</button>${game.activeCity!==id?`<div class="city-convoy">Envoyer depuis ${esc(game.city)} (Port nécessaire, 12 or) :<div><button class="btn-parch" data-convoy="${id}" data-cargo="wood" data-amount="50" ${!hasBuilding('port')||!!game.convoy||game.res.wood<50||game.res.gold<12?'disabled':''}>50 bois</button><button class="btn-parch" data-convoy="${id}" data-cargo="stone" data-amount="50" ${!hasBuilding('port')||!!game.convoy||game.res.stone<50||game.res.gold<12?'disabled':''}>50 pierre</button><button class="btn-parch" data-convoy="${id}" data-cargo="gold" data-amount="50" ${!hasBuilding('port')||!!game.convoy||game.res.gold<62?'disabled':''}>50 or</button></div></div>`:''}</div>`}).join('');
 b=`<div class="city-manager"><div class="manager-heading"><h2>Gouverner mes cités · ${Object.keys(game.cities).length}</h2><button class="btn-parch" data-nav="locale">Vue Province</button></div><p>Chaque ville produit, bâtit et recrute indépendamment. Les convois transportent réellement les marchandises.</p>${game.convoy?`<div class="mission-ticket"><strong>Convoi vers ${esc(cityName(game.convoy.to))}</strong><span>${game.convoy.amount} ${META[game.convoy.resource].name} · ${Math.max(0,Math.ceil((game.convoy.end-now())/1000))} s</span></div>`:''}<div class="city-grid">${cards}</div></div>`+b;
}
if(nav==='empire')b='<div class="v28-nav-actions"><button class="btn-parch" data-nav="economie">⚒ Économie et ouvriers</button><button class="btn-parch" data-nav="recherche">📜 Recherches</button></div>'+b; if(nav==='senat')b='<div class="v28-nav-actions"><button class="btn-parch" data-nav="recherche">📜 Recherche et progrès</button><button class="btn-parch" data-nav="economie">⚒ Administration économique</button></div>'+b; return `<div class="viewbox"><div class="view-header">${h}<button class="view-close" data-nav="ville" aria-label="Fermer">×</button></div><section class="view-body">${b}</section></div>`}
function showOverlay(nav){$('viewOverlay').innerHTML=nav==='ville'?'':overlayContents(nav)}

function refreshRegionDecor(){const stage=$('stage'),note=$('regionNote'),decor=$('regionDecor');if(!stage||!note||!decor)return;const region=game.activeCity||'player';stage.dataset.region=region;
 const bonus=regionBonus();note.textContent=bonus.description;
 if(decor.dataset.region===region)return;decor.dataset.region=region;
 if(region==='vacant1')decor.innerHTML=`<svg width="1672" height="941" viewBox="0 0 1672 941" aria-hidden="true"><defs><radialGradient id="forestGlow"><stop stop-color="#29573d" stop-opacity=".15"/><stop offset="1" stop-color="#29573d" stop-opacity="0"/></radialGradient></defs><ellipse cx="220" cy="350" rx="240" ry="190" fill="url(#forestGlow)"/><ellipse cx="1070" cy="300" rx="190" ry="150" fill="url(#forestGlow)"/><g fill="none" stroke="#7caa71" stroke-opacity=".2" stroke-width="2"><path d="M154 392q34-15 69-3m11-49q44-16 82-6m703-73q53-21 102 1"/><path d="M162 400q26-9 62-3m33-57q36-12 65-4"/></g></svg>`;
 else if(region==='vacant2')decor.innerHTML=`<svg width="1672" height="941" viewBox="0 0 1672 941" aria-hidden="true"><g opacity=".4" fill="#c8a774" stroke="#805c37" stroke-width="2"><path d="M1055 798l130 18 21-12-131-18z"/><path d="M1096 802v-21m34 27v-19m35 22v-20"/></g><g stroke="#d7ece4" stroke-width="2.5" opacity=".35" fill="none"><path d="M997 806q41-14 82 0m-96 21q63-18 118-2m80-31q34-9 71-2"/></g></svg>`;
 else decor.innerHTML='';
}
function render(){update();c33CampaignTick();bar();createNav();plots();quests();sidePanel();showOverlay(game.nav);coloniesMenu();refreshRegionDecor();$('fleetBadge').textContent=game.expedition?'⛵ Flotte en mission':'';$('fleetBadge').classList.toggle('visible',!!game.expedition);const alerts=$('worldAlerts');if(alerts){alerts.innerHTML=(game.incomingRaid?'<button class="v3-event-badge v22-incoming-alert" data-nav="caserne">⚠ Raid ennemi vers '+esc(cityName(game.incomingRaid.city))+' · '+formatSec((game.incomingRaid.end-now())/1000)+'</button>':'')+(game.pendingEvent?'<button class="v3-event-badge" data-nav="evenements">✦ Un événement attend ta décision</button>':'')}}
function switchDistrict(ward){if(ward!==0&&ward!==1)return; if(ward===1&&!hasHall())return notify('Construis d’abord l’Hôtel de ville.');game.district=ward;game.selected=ward===0?4:8;game.panelMode=game.sites[game.selected]?'details':'catalog';game.nav='ville';save();render();}
function navigate(id){if(id==='options'||NAV.some(n=>n[0]===id)||id==='caserne'||id==='marche'||id==='recherche'||id==='economie'||id==='evenements'||id==='chantiers'||id==='guerre'||id==='locale'){game.nav=id;if(id==='locale')game.tutorialVisitedLocale=true;if(id==='carte')game.tutorialVisitedWorld=true;save();render()}}
function selectSite(i){if(i===HALL_SITE)localStorage.setItem('civitas-v18-core-clicked','1');game.selected=i;game.nav='ville';game.panelMode=game.sites[i]?'details':'catalog';game.selectedBuild=null;render()}

// CIVITAS XXXIX — Real six-chapter SOLO CAMPAIGN, integrated into the saved game.
// A chapter is validated only by actual, persisted economic, civic or military state.
const C33_CHAPTERS=[
 {id:'foundations',title:'I · Les premières pierres',subtitle:'De la côte sauvage à une colonie organisée',
  reward:{wood:80,stone:70,gold:45},steps:[
   {text:'Fonder l’Hôtel de ville',check:g=>g.sites.some(b=>b?.type==='hotelville'),target:'hotelville'},
   {text:'Construire une scierie',check:g=>g.sites.some(b=>b?.type==='scierie'),target:'scierie'},
   {text:'Employer au moins trois ouvriers',check:g=>Object.values(g.workers||{}).reduce((n,v)=>n+(+v||0),0)>=3,target:'economie'}]},
 {id:'settlement',title:'II · La vie de la cité',subtitle:'Offrir du travail et un foyer aux familles',
  reward:{wood:115,stone:100,gold:65},steps:[
   {text:'Bâtir un logement',check:g=>g.sites.some(b=>b?.type==='logement'),target:'logement'},
   {text:'Ouvrir un entrepôt',check:g=>g.sites.some(b=>b?.type==='entrepot'),target:'entrepot'},
   {text:'Atteindre 65 habitants',check:g=>(g.pop||0)>=65,target:'ville'}]},
 {id:'routes',title:'III · Routes et richesses',subtitle:'Échanger au-delà des murailles',
  reward:{marble:75,wine:95,gold:110},steps:[
   {text:'Construire un marché',check:g=>g.sites.some(b=>b?.type==='marche'),target:'marche'},
   {text:'Réaliser au moins un échange',check:g=>(g.stats?.trades||0)>=1,target:'marche'},
   {text:'Découvrir les colonies du Latium',check:g=>!!g.tutorialVisitedLocale,target:'locale'}]},
 {id:'republic',title:'IV · La voix de Rome',subtitle:'Donner des institutions à la colonie',
  reward:{marble:100,gold:140,wood:120},steps:[
   {text:'Élever l’Hôtel de ville au niveau 2',check:g=>g.sites.some(b=>b?.type==='hotelville'&&b.level>=2),target:'hotelville'},
   {text:'Construire la Curie du Sénat',check:g=>g.sites.some(b=>b?.type==='senatbat'),target:'senatbat'},
   {text:'Achever une recherche à l’Académie',check:g=>Object.values(g.researches||{}).some(Boolean),target:'recherche'}]},
 {id:'legions',title:'V · Les aigles de Rome',subtitle:'Protéger les routes et lever une légion',
  reward:{gold:220,wine:120,marble:80},steps:[
   {text:'Construire une caserne',check:g=>g.sites.some(b=>b?.type==='caserne'),target:'caserne'},
   {text:'Former au moins cinq soldats',check:g=>(g.stats?.recruited||0)>=5,target:'caserne'},
   {text:'Terminer une bataille et recevoir son rapport',check:g=>(g.battleReports||[]).length>=1,target:'guerre'}]},
 {id:'imperium',title:'VI · Imperium',subtitle:'Un peuple, des colonies, une autorité reconnue',
  reward:{gold:350,marble:140,wine:140},steps:[
   {text:'Fonder une deuxième colonie',check:g=>Object.keys(g.cities||{}).filter(k=>k!=='player').length>=1,target:'empire'},
   {text:'Étendre le territoire à une autre province',check:g=>(g.provinces||[]).some(p=>p!=='latium'),target:'carte'},
   {text:'Atteindre une influence de 15',check:g=>(g.influence||0)>=15,target:'senat'},
   {text:'Maintenir au moins 60 % de satisfaction',check:g=>(g.happiness||0)>=60,target:'economie'}]}
];
function c33CampaignStatus(){
 const stored=game.c33Campaign?.done||[];
 const chapters=C33_CHAPTERS.map((c,index)=>({id:c.id,title:c.title,subtitle:c.subtitle,index,
  steps:c.steps.map(s=>({text:s.text,done:!!s.check(game),target:s.target})),completed:stored.includes(c.id),
  reward:{...c.reward}}));
 const complete=chapters.filter(c=>c.completed).length;
 return {chapters,complete,total:chapters.length,victory:!!game.c33Campaign?.victory,
  city:game.city,progress:Math.round(100*complete/chapters.length),last:game.c33Campaign?.last||null};
}
function c33CampaignTick(){
 if(!game.c33Campaign||!Array.isArray(game.c33Campaign.done))game.c33Campaign={done:[],victory:false,last:null};
 let changed=false;
 for(const chapter of C33_CHAPTERS){
  if(game.c33Campaign.done.includes(chapter.id))continue;
  // Progress through the story in order, preventing out-of-order reward exploitation.
  const earlier=C33_CHAPTERS.indexOf(chapter);
  if(earlier>0&&!game.c33Campaign.done.includes(C33_CHAPTERS[earlier-1].id))break;
  if(chapter.steps.every(step=>step.check(game))){
   game.c33Campaign.done.push(chapter.id);
   game.c33Campaign.last={title:chapter.title,at:Date.now()};
   grant(chapter.reward);game.influence=(game.influence||0)+1;
   log(`Campagne : ${chapter.title} achevé. Récompense attribuée.`);
   notify(`Chapitre achevé : ${chapter.title}`);changed=true;
  }
 }
 if(game.c33Campaign.done.length===C33_CHAPTERS.length&&!game.c33Campaign.victory){
  game.c33Campaign.victory=true;game.c33Campaign.victoryAt=Date.now();
  log('VICTOIRE : Le Sénat reconnaît ton Imperium. La campagne solo est terminée.');
  notify('VICTOIRE — Le Sénat reconnaît ton Imperium !');changed=true;
 }
 if(changed)save();return changed;
}

function exportSave(){const json=JSON.stringify({...game,last:now()},null,2);const blob=new Blob([json],{type:'application/json'});const u=URL.createObjectURL(blob);const a=document.createElement('a');a.href=u;a.download='civitas-sauvegarde-'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),3000);notify('Sauvegarde exportée')}
function importSave(file){if(!file)return;const reader=new FileReader;reader.onload=()=>{try{const d=JSON.parse(String(reader.result));if(![4,5,7,8,9,10,11,12].includes(d.v)||!Array.isArray(d.sites)||![8,16].includes(d.sites.length)||!d.res||!d.stats)throw Error('Format incompatible');game=migrateV7(d);game.workers=game.workers||{};game.units=game.units||{velites:0,equites:0};game.formation=game.formation||'acies';game.battleReports=game.battleReports||[];game.incomingRaid=game.incomingRaid||null;game.sharedWorkers=game.sharedWorkers||{wood:0,stone:0};game.localStates=game.localStates||{};initCities();game.science=game.science||0;game.researches=game.researches||{};game.pendingEvent=game.pendingEvent||null;game.eventAt=game.eventAt||now()+240000;game.queue=Array.isArray(game.queue)?game.queue:[];game.voyage=game.voyage||null;game.panelMode=game.sites[game.selected]?'details':'catalog';game.panelFilter='tous';game.last=now();game.nav='ville';save();render();notify('Partie importée avec succès')}catch(e){notify('Fichier de sauvegarde invalide ou incompatible.')}};reader.readAsText(file)}
document.addEventListener('click',e=>{const target=e.target.closest('button');if(!target)return;const d=target.dataset;if(d.nav){navigate(d.nav);return}if(d.panelFilter){game.panelFilter=d.panelFilter;save();sidePanel();return}if(d.provinceMode){game.provinceMode=d.provinceMode;save();sidePanel();return}if(d.panelCatalog){game.panelMode='catalog';save();sidePanel();return}if(d.panelDetails){game.panelMode='details';save();sidePanel();return}if(d.cancelJob!==undefined){cancelJob(+d.cancelJob);return}if(d.demolish!==undefined){demolishBuilding(+d.demolish);return}if(d.voyage){startVoyage(d.voyage);return}if(d.relief){claimFoundingAid();return}if(d.hintSite){const i=game.sites.findIndex((b,j)=>!b&&game.construction?.site!==j&&!game.queue.some(q=>q.site===j));if(i>=0)selectSite(i);else notify('Aucun terrain libre : visite l’atelier des bâtisseurs.');return}if(d.worker){setWorkers(d.workerSite!==undefined?+d.workerSite:game.selected,+d.worker);return}if(d.research){research(d.research);return}if(d.eventChoice!==undefined){decideEvent(+d.eventChoice);return}if(d.colonize){colonize(d.colonize);return}if(d.switchCity){switchCity(d.switchCity);return}if(d.convoy){sendConvoy(d.convoy,d.cargo,+d.amount);return}if(d.localSite){game.localSelected='site:'+d.localSite;save();render();return}if(d.commonWorker){setCommonWorkers(d.commonWorker,+d.delta);return}if(d.pact){negotiatePact(d.pact);return}if(d.localCity){localSelect(d.localCity);return}if(d.localAction){localAction(d.localAction,game.localSelected);return}if(d.site!==undefined){selectSite(+d.site);return}if(d.build){startBuild(d.build);return}if(d.quest){claimQuest(d.quest);return}if(d.province){provinceSelected=d.province;render();return}if(d.edict){edict(d.edict);return}if(d.trainType){recruit(d.trainType);return}if(d.formation){setFormation(d.formation);return}if(d.recruit){recruit();return}if(d.expedition){sendExpedition(d.expedition);return}if(d.trade){trade(d.trade);return}if(d.siteNext){const idx=game.sites.findIndex((x,i)=>!x&&!game.queue.some(j=>j.site===i)&&game.construction?.site!==i);selectSite(idx>=0?idx:0);return}if(d.tutorialReplay){localStorage.setItem('civitas-v5-step','0');localStorage.removeItem('civitas-v18-core-clicked');sessionStorage.removeItem('civitas-hide-advisor');game.nav='ville';save();render();notify('Le conseiller reprend les instructions depuis le début.');return}if(d.export){exportSave();return}if(d.rename){const v=$('renameCity')?.value.trim().replace(/[<>]/g,'');if(v){game.city=v.slice(0,24);save();render();notify('Colonie renommée.')}return}if(d.reset&&confirm('Effacer définitivement la partie enregistrée sur ce navigateur ?')){game=fresh();initCities();save();localStorage.setItem('civitas-v5-step','0');localStorage.setItem('civitas-v19-mode','intro');localStorage.setItem('civitas-v19-intro','intro1');location.reload();return}});
document.addEventListener('change',e=>{if(e.target.id==='speedPicker'){update();game.speed=+e.target.value;save();render();notify('Vitesse de jeu modifiée.')}if(e.target.id==='importGame')importSave(e.target.files?.[0])});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&game.nav!=='ville')navigate('ville')});
function resize(){const fit=Math.min(window.innerWidth/1672,window.innerHeight/941);$('stage').style.transform=`scale(${fit})`;$('stage-holder').style.width=`${1672*fit}px`;$('stage-holder').style.height=`${941*fit}px`}


function v31Workforce(mode='balanced'){
 update();
 const sites=game.sites.map((b,i)=>b&&WORK_TYPES[b.type]?{index:i,type:b.type,capacity:jobsCapacity(i)}:null).filter(Boolean);
 if(!sites.length){notify('Construis une scierie ou une carrière avant de répartir les ouvriers.');return {ok:false,reason:'Aucun atelier de production'};}
 const shared=Object.values(game.sharedWorkers||{}).reduce((a,b)=>a+Math.max(0,+b||0),0);
 let budget=Math.max(0,workforce()-shared);
 const limits=Object.fromEntries(sites.map(b=>[b.index,0]));
 if(mode!=='clear'){
  const weights={balanced:{wood:1.12,stone:1,marble:.75,wine:.78},wood:{wood:3,stone:1.2,marble:.6,wine:.6},stone:{wood:1.3,stone:3,marble:.8,wine:.7}}[mode]||{wood:1.12,stone:1,marble:.75,wine:.78};
  while(budget>0){
   const available=sites.filter(b=>limits[b.index]<b.capacity);
   if(!available.length)break;
   available.sort((a,b)=>{
    const pa=(limits[a.index]+.5)/(a.capacity*(weights[WORK_TYPES[a.type][0]]||.8));
    const pb=(limits[b.index]+.5)/(b.capacity*(weights[WORK_TYPES[b.type][0]]||.8));
    return pa-pb||a.index-b.index;
   });
   limits[available[0].index]++;budget--;
  }
 }
 for(const old of Object.keys(game.workers||{})){if(!sites.some(s=>s.index===+old))delete game.workers[old]}
 for(const item of sites)game.workers[item.index]=limits[item.index];
 const assigned=Object.values(limits).reduce((a,b)=>a+b,0);
 const quest=QUESTS.find(q=>q.id==='workers');
 if(quest&&!game.quests.includes('workers')&&quest.check(game)>=quest.goal){game.quests.push('workers');grant(quest.reward);log('Le Sénat récompense la mobilisation des premiers ouvriers.');}
 const title={balanced:'équilibrée',wood:'priorité au bois',stone:'priorité à la pierre',clear:'ouvriers libérés'}[mode]||mode;
 log(`Répartition ${title} : ${assigned} travailleurs dans ${sites.length} ateliers.`);save();render();notify(`Main-d’œuvre : ${title} · ${assigned} ouvriers affectés.`);
 return {ok:true,assigned,siteCount:sites.length,mode};
}
function v31CouncilData(){
 const result=production(),max=capacity(),popLimit=popCap();
 const stats={wood:game.res.wood||0,stone:game.res.stone||0,marble:game.res.marble||0,wine:game.res.wine||0,gold:game.res.gold||0};
 const assigned=occupied(),workers=workforce(),outstanding=[];
 for(const [key,label] of [['wood','Bois'],['stone','Pierre'],['marble','Marbre'],['wine','Vin']]){
  if(result[key]<=0)outstanding.push({key,label,level:0,message:`Aucune production de ${label.toLowerCase()}`});
  else if(stats[key]>=max*.95)outstanding.push({key,label,level:1,message:`Réserve de ${label.toLowerCase()} proche de la saturation`});
 }
 let suggestedType='scierie';
 if(!hasHall())suggestedType='hotelville';
 else if(!hasBuilding('scierie'))suggestedType='scierie';
 else if(!hasBuilding('carriere'))suggestedType='carriere';
 else if(popCap()-game.pop<10)suggestedType='logement';
 else if(!hasBuilding('entrepot')&&stats.wood>=max*.7)suggestedType='entrepot';
 else if(!hasBuilding('cave'))suggestedType='cave';
 else if(!hasBuilding('marbre'))suggestedType='marbre';
 else if(!hasBuilding('marche'))suggestedType='marche';
 else if(!hasBuilding('senatbat')&&hallLevel()>=2)suggestedType='senatbat';
 else if(!hasBuilding('academie'))suggestedType='academie';
 else suggestedType='logement';
 const cost=costFor(suggestedType,1),missing=Object.fromEntries(Object.entries(cost).filter(([k,value])=>stats[k]<value).map(([k,value])=>[k,value-stats[k]]));
 const timeKeys=Object.keys(missing).map(k=>(result[k]||0)>0?missing[k]/result[k]:Infinity);
 const wait=timeKeys.length?Math.max(...timeKeys):0;
 return {city:game.city,stocks:stats,rates:result,workers,assigned,free:availableWorkers(),maxStock:max,pop:game.pop,popLimit,happiness:game.happiness,
  buildings:game.sites.filter(Boolean).length,sites:game.sites.length,construction:game.construction?{type:game.construction.type,site:game.construction.site,end:game.construction.end}:null,
  suggested:{type:suggestedType,name:BUILD[suggestedType].name,cost,missing,waitHours:Number.isFinite(wait)?wait:null},outstanding:outstanding.slice(0,3)};
}
function v31FocusBuilding(type){
 if(!BUILD[type])return false;
 if(type==='hotelville'&&hasHall())return false;
 let site=-1;
 if(type==='hotelville')site=HALL_SITE;
 else {
  site=game.sites.findIndex((b,i)=>b?.type===type&&game.construction?.site!==i);
  if(site<0)site=game.sites.findIndex((b,i)=>i!==HALL_SITE&&!b&&game.construction?.site!==i&&!(game.queue||[]).some(q=>q.site===i));
 }
 if(site<0){notify('Aucune parcelle disponible. Libère une parcelle pour construire.');return false;}
 if(game.district!==Math.floor(site/8))switchDistrict(Math.floor(site/8));
 game.selected=site;game.panelMode=game.sites[site]?'details':'catalog';game.selectedBuild=type;
 save();render();window.CIVITAS_V30_PREVIEW=game.sites[site]?null:type;
 return true;
}

window.CIVITAS_BRIDGE={
 campaign:()=>c33CampaignStatus(),
 cityReport:()=>v31CouncilData(),
 distributeWorkers:(mode)=>v31Workforce(mode),
 focusBuilding:(type)=>v31FocusBuilding(type),
 snapshot:()=>({v30:true,resources:{...game.res},income:production(),citizens:game.pop,capacity:popCap(),freeWorkers:availableWorkers(),happiness:game.happiness,constructionCount:(game.construction?1:0)+game.queue.length,district:game.district||0,totalBuildings:game.sites.filter(Boolean).length,city:game.city,activeCity:game.activeCity||'player',nav:game.nav,sites:game.sites.map((b,i)=>Math.floor(i/8)===(game.district||0)&&b?{type:b.type,level:b.level}:null),workers:Object.fromEntries(Object.entries(game.workers||{}).filter(([i])=>Math.floor(+i/8)===(game.district||0))),pop:game.pop,legions:game.legions,formation:game.formation,units:{...game.units},selected:game.selected,construction:game.construction&&Math.floor(game.construction.site/8)===(game.district||0)?{...game.construction}:null,queue:(game.queue||[]).map(b=>({...b}))}),
 selectSite:(i)=>selectSite(i),switchDistrict:(ward)=>switchDistrict(ward),
 sprite:(type)=>sprite(type),
 label:(type)=>BUILD[type]?.name||type,
 catalog:()=>Object.entries(BUILD).map(([type,def])=>{
  const current=game.sites[game.selected],upgrading=current?.type===type;
  const cost=costFor(type,upgrading?current.level+1:1);
  const beforeHall=!hasHall(),locked=game.selected===HALL_SITE?type!=='hotelville':type==='hotelville'||beforeHall;
  const senateLocked=type==='senatbat'&&(hallLevel()<2||hasSenate());
  const queueLocked=!!game.construction&&game.queue.length>=2;
  const allowed=upgrading||!current&&!locked&&!senateLocked;
  const possible=allowed&&affordable(cost)&&!queueLocked;
  return {type,name:def.name,description:def.desc,cost,possible,allowed,upgrading,level:current?.type===type?current.level:0,
   workers:current?.type===type?Number(game.workers[game.selected]||0):0,
   missing:missingCost(cost)};
 }),
 navigate:(id)=>navigate(id)
};
window.CIVITAS_DEBUG_READONLY=()=>({battleReports:JSON.parse(JSON.stringify(game.battleReports||[])),incomingRaid:game.incomingRaid,units:{...game.units},formation:game.formation,localMission:game.localMission,localStates:JSON.parse(JSON.stringify(game.localStates)),commonWorkers:{...game.sharedWorkers},activeCity:game.activeCity,cities:Object.keys(game.cities||{}),colonizing:game.colonizing,convoy:game.convoy,city:game.city,buildings:game.sites.filter(Boolean).length,resources:{...game.res},workers:occupied(),queue:game.queue.map(j=>({site:j.site,type:j.type})),construction:game.construction?{site:game.construction.site,type:game.construction.type}:null,voyage:game.voyage?{target:game.voyage.target}:null,population:game.pop,satisfaction:game.happiness,production:production(),reliefCount:game.reliefCount,siteSelected:game.selected});window.addEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(!document.hidden){render();save()}});window.addEventListener('beforeunload',save);resize();render();setInterval(()=>{
 update();tickCount++;if(tickCount%5===0)c33CampaignTick();bar();
 const c=game.construction;
 if(c){
  document.querySelectorAll('.buildremain').forEach(el=>el.textContent=formatSec((c.end-now())/1000));
  const pc=100*Math.min(1,Math.max(0,(now()-c.start)/(c.end-c.start)));
  document.querySelectorAll('.v4-hud-progress i,.v4-inspector .v4-progress i').forEach(el=>el.style.width=pc+'%');
  const hudSmall=document.querySelector('#v4BuildHud .v4-hud-main small');
  if(hudSmall)hudSmall.textContent=formatSec((c.end-now())/1000)+' restant · '+game.queue.length+' en attente';
 }
 if(tickCount%3===0)quests();
 if(needsRedraw){needsRedraw=false;render();save();}
 else if(tickCount%15===0)save();
},1000);
})();
</script>
<script>
(()=>{
'use strict';
const SPRITES={walk:'data:image/png;base64,',mentor:'data:image/png;base64,'};
const SAVE_KEY='civitas-roman-v32';
const MODE_KEY='civitas-v20-mode';
const STEP_KEY='civitas-v20-step';
const INTRO_KEY='civitas-v19-intro';
const state=()=>{try{return JSON.parse(localStorage.getItem(SAVE_KEY)||localStorage.getItem('civitas-roman-v28')||localStorage.getItem('civitas-roman-v14')||localStorage.getItem('civitas-roman-v13')||localStorage.getItem('civitas-roman-v12')||localStorage.getItem('civitas-roman-v11')||localStorage.getItem('civitas-roman-v10')||'null')}catch{return null}};
const setState=s=>localStorage.setItem(SAVE_KEY,JSON.stringify(s));
const now=()=>Date.now();
const $=s=>document.querySelector(s);
const $$=s=>Array.from(document.querySelectorAll(s));
const overlay=$('#storyOverlay'), storyCard=$('#storyCard'), advisor=$('#advisorBox');
const mainMenu = ()=>`<div class="hero"><h1>CIVITAS</h1><p>Imperium · Aux origines de ta cité romaine</p></div><div class="story-body"><span class="start-blazon">⚜ Senatus Populusque Romanus</span><h2>Une terre. Un peuple. Un destin.</h2><p>La République romaine regarde vers les mers. De l'autre côté des collines, des familles attendent des terres, des marchands attendent des routes et des légions attendent des ordres. Le Sénat vient de te confier une colonie sur les rives du Latium.</p><div class="intro-columns"><div class="intro-box"><span class="tutorial-badge">DÉCRET DU SÉNAT</span><p><strong>« Gouverneur, fais naître une cité digne de Rome. »</strong></p><p>Trace d’abord le cœur de ta ville : le premier édifice sera l’Hôtel de ville. Tu pourras ensuite ouvrir les ateliers, accueillir les habitants et découvrir les cités voisines.</p></div><div class="intro-box"><strong>Les premiers jours</strong><p>Une terre presque vierge, un petit campement, quelques ressources et la voix de ton conseiller, Marcus Atilius.</p><p>L’Hôtel de ville n’existe pas encore : c’est ta première construction. Le Sénat viendra bien plus tard, une fois la ville développée.</p></div></div><div class="story-actions"><button class="btn-red" data-story="new">Fonder ma colonie</button><button class="btn-parch" data-story="continue" ${state()?'':'disabled'}>Poursuivre ma partie</button><button class="btn-parch" data-story="credits">À propos du jeu</button></div><p class="story-small">Nouvelle partie : la sauvegarde locale actuelle sera remplacée.</p></div>`;
const credits = ()=>`<div class="hero"><h1>CIVITAS</h1><p>Notes de version V14</p></div><div class="story-body"><h2>Ce qui change dans cette itération</h2><div class="credits-list"><div class="intro-box"><strong>Ouverture de partie</strong><p>Un écran titre, une introduction et un démarrage plus pauvre remplacent l'entrée brutale dans la ville.</p></div><div class="intro-box"><strong>Tutoriel</strong><p>Un conseiller guide les premières actions : scierie, logements, entrepôt, Sénat et carte.</p></div><div class="intro-box"><strong>Ville plus vivante</strong><p>Des passants circulent, les ouvriers traversent la colonie et un navire anime le port.</p></div><div class="intro-box"><strong>Mare Nostrum</strong><p>La carte gagne des routes maritimes, un meilleur habillage et un sentiment plus stratégique.</p></div></div><div class="story-actions"><button class="btn-red" data-story="back">Retour</button></div></div>`;
const intro1 = ()=>`<div class="hero"><h1>CIVITAS</h1><p>Chapitre I — L'arrivée du gouverneur</p></div><div class="story-body"><h2>Une colonie encore fragile</h2><p>Au matin, ton navire jette l'ancre devant une crique paisible du Latium. Quelques familles t'attendent près d'un quai rudimentaire. Les terres sont encore à peine tracées, mais Rome exige déjà des résultats.</p><p>Le Sénat t'accorde un faible stock de départ et te charge de transformer ce rivage en une cité capable d'exporter, de lever des hommes et d'étendre l'influence romaine.</p><div class="story-actions"><button class="btn-red" data-story="intro2">Poursuivre</button></div></div>`;
const intro2 = ()=>`<div class="hero"><h1>CIVITAS</h1><p>Chapitre II — Les premières instructions</p></div><div class="story-body"><h2>Le conseiller impérial t'accompagne</h2><p><strong>Marcus Atilius</strong>, envoyé du Sénat, te guidera au cours des premiers jours. Commence par l’Hôtel de ville au cœur de la cité, puis une scierie et des habitations. Tu découvriras les villes voisines depuis la vue de la province avant d’accéder au monde.</p><div class="intro-columns"><div class="intro-box"><p><strong>Ressources de départ</strong> : 160 bois, 110 pierre, 35 deniers. Aucun vin ni marbre.</p><p><strong>Population</strong> : 36 habitants.</p></div><div class="intro-box"><p><strong>Objectif du tutoriel</strong> : poser les fondations d'une ville viable, puis ouvrir l'horizon stratégique.</p></div></div><div class="story-actions"><button class="btn-red" data-story="begin">Entrer dans la colonie</button></div></div>`;
function starterState(){return {v:11,city:'Colonia Julia',coords:'425:317',res:{wood:160,stone:110,marble:0,wine:0,gold:35},pop:36,happiness:62,influence:2,legions:0,nav:'ville',selected:4,sites:Array(16).fill(null),construction:null,recruit:null,expedition:null,provinces:['latium'],cooldown:{},log:[{t:now(),txt:'Débarquement sur les côtes du Latium. Premier chantier : Hôtel de ville.'}],quests:[],stats:{woodMade:0,trades:0,recruited:0},speed:10,last:now(),start:now(),tech:0,workers:{},science:0,researches:{},pendingEvent:null,eventAt:now()+240000,queue:[],voyage:null,panelMode:'catalog',panelFilter:'tous',localSelected:'player',localStates:{},localMission:null,tutorialVisitedLocale:false,tutorialInspectedNeighbor:false,tutorialVisitedWorld:false}};
function showOverlay(kind){document.body.classList.add('story-mode');overlay.classList.add('visible');storyCard.innerHTML=(kind==='menu'?mainMenu():kind==='credits'?credits():kind==='intro1'?intro1():kind==='intro2'?intro2():mainMenu())}
function hideOverlay(){overlay.classList.remove('visible');document.body.classList.remove('story-mode')}
function loadMenuIfNeeded(){const mode=localStorage.getItem(MODE_KEY)||'';if(mode==='intro'){showOverlay(localStorage.getItem(INTRO_KEY)||'intro1');return}if(!sessionStorage.getItem('civitas-v18-playing'))showOverlay('menu')}
function storyAction(act){if(act==='new'){sessionStorage.removeItem('civitas-hide-advisor');setState(starterState());localStorage.setItem(MODE_KEY,'intro');localStorage.setItem(INTRO_KEY,'intro1');localStorage.setItem(STEP_KEY,'0');localStorage.removeItem('civitas-v18-clicked-plot');sessionStorage.removeItem('civitas-v18-playing');location.reload();return}if(act==='continue'){sessionStorage.setItem('civitas-v18-playing','1');hideOverlay();return}if(act==='credits'){showOverlay('credits');return}if(act==='menu'){showOverlay('menu');return}if(act==='back'){showOverlay('menu');return}if(act==='intro2'){localStorage.setItem(MODE_KEY,'intro');localStorage.setItem(INTRO_KEY,'intro2');showOverlay('intro2');return}if(act==='begin'){localStorage.removeItem(MODE_KEY);localStorage.removeItem(INTRO_KEY);sessionStorage.setItem('civitas-v18-playing','1');hideOverlay();renderAdvisor(true);return}}

document.addEventListener('click',e=>{const btn=e.target.closest('[data-story]');if(btn)storyAction(btn.dataset.story)});

const tutorial=[
{title:'Choisir le cœur de la cité',text:'Clique sur la parcelle centrale éclairée. L’Hôtel de ville sera le premier bâtiment construit, et non un décor déjà posé.',check:s=>localStorage.getItem('civitas-v18-core-clicked')==='1'||s?.construction?.type==='hotelville'||s?.sites?.[4]?.type==='hotelville',selector:'.hit-plot.central-plot'},
{title:'Construire l’Hôtel de ville',text:'Sur la parcelle centrale, lance le chantier de l’<strong>Hôtel de ville</strong>. Sans lui, aucune autre construction n’est autorisée.',check:s=>s?.construction?.type==='hotelville'||s?.queue?.some(j=>j.type==='hotelville')||s?.sites?.[4]?.type==='hotelville',selector:'[data-build="hotelville"]'},
{title:'Inaugurer le centre civique',text:'Observe les ouvriers achever l’Hôtel de ville. Il débloquera les parcelles et le premier ravitaillement.',check:s=>s?.sites?.[4]?.type==='hotelville',selector:'.hit-plot.central-plot'},
{title:'Installer une scierie',text:'Choisis un terrain libre et construis une <strong>Scierie</strong> pour produire du bois.',check:s=>s?.construction?.type==='scierie'||s?.sites?.some(b=>b?.type==='scierie'),selector:'[data-build="scierie"]'},
{title:'Faire travailler les habitants',text:'Une fois la scierie achevée, sélectionne-la et affecte <strong>trois ouvriers</strong>. Un atelier vide ne produit rien.',check:s=>Object.entries(s?.workers||{}).reduce((n,[i,v])=>s.sites?.[+i]?.type==='scierie'?n+v:n,0)>=3,selector:'.worker-controls [data-worker="1"]'},
{title:'Loger les nouvelles familles',text:'Construis un <strong>Logement</strong> sur un terrain libre pour accroître la population.',check:s=>s?.sites?.some(b=>b?.type==='logement'),selector:'[data-build="logement"]'},
{title:'Protéger les réserves',text:'Construis un <strong>Entrepôt</strong> pour augmenter la capacité de stockage.',check:s=>s?.sites?.some(b=>b?.type==='entrepot'),selector:'[data-build="entrepot"]'},
{title:'Voir les colonies voisines',text:'Clique sur <strong>Province</strong> pour découvrir la région et les voisins de ta colonie.',check:s=>!!s?.tutorialVisitedLocale,selector:'[data-nav="locale"]'},
{title:'Inspecter un voisin',text:'Sélectionne une cité voisine pour consulter son profil et les actions possibles : commerce, espionnage, attaque.',check:s=>!!s?.tutorialInspectedNeighbor,selector:'.local-node'},
{title:'Ouvrir Mare Nostrum',text:'Passe à la <strong>vue Monde</strong> pour observer les territoires lointains et les routes d’expansion.',check:s=>!!s?.tutorialVisitedWorld,selector:'[data-nav="carte"]'}
];
function currentStep(){return Math.max(0,Math.min(tutorial.length,+(localStorage.getItem(STEP_KEY)||0)))}
function setStep(n){localStorage.setItem(STEP_KEY,String(n))}
function highlight(selector){$$('.pulse-target').forEach(el=>el.classList.remove('pulse-target')); if(!selector) return; $$(selector).forEach(el=>el.classList.add('pulse-target'))}
function maybeAdvanceTutorial(){
 const st=state();if(!st)return;let step=currentStep();if(step>=tutorial.length)return;
 if(step===0&&(st.sites?.[4]?.type==='hotelville'||st.construction?.type==='hotelville'||localStorage.getItem('civitas-v18-core-clicked')==='1'))step=1;
 let loops=0;
 while(step<tutorial.length&&loops++<tutorial.length){
  let met=false;try{met=!!tutorial[step].check(st)}catch(e){met=false}
  if(!met)break;step++;
 }
 if(step!==currentStep()){setStep(step);advisor.dataset.lastStep='';renderAdvisor(true)}
}
document.addEventListener('click',e=>{if(e.target.closest('[data-site]'))localStorage.setItem('civitas-v18-clicked-plot','1')});
function renderAdvisor(force){if(overlay.classList.contains('visible') && !force) return; if(sessionStorage.getItem('civitas-hide-advisor')==='1'&&!force)return; const stNow=state();if(stNow?.activeCity&&stNow.activeCity!=='player'){advisor.classList.remove('visible');highlight(null);return;} const hallMissing=stNow&&!stNow.sites?.[4]?.type?.includes('hotelville')&&!stNow.construction?.type?.includes('hotelville')&&(stNow.res?.wood<80||stNow.res?.stone<45||stNow.res?.gold<15);const scierieMissing=stNow&&!stNow.sites?.some(b=>b?.type==='scierie')&&!stNow.construction?.type?.includes('scierie')&&!stNow.queue?.some(j=>j.type==='scierie')&&(stNow.res?.wood<110||stNow.res?.stone<60||stNow.res?.gold<20);const aidNeeded=hallMissing||scierieMissing; const nextStep=String(currentStep())+'-'+(aidNeeded?'s':'o'); if(!force && advisor.dataset.lastStep===nextStep && advisor.classList.contains('visible')) return; advisor.dataset.lastStep=nextStep; const st=state(); if(!st){advisor.classList.remove('visible'); return;} let step=currentStep(); if(step>=tutorial.length){advisor.classList.add('visible'); advisor.innerHTML=`<div class="ad-head"><div class="ad-portrait" aria-label="Marcus Atilius animé"><div class="portraitAnim" style="background-image:url(${SPRITES.mentor})"></div></div><div><div class="ad-title">Marcus Atilius</div><div class="ad-sub">Conseiller impérial</div></div></div><div class="ad-body"><div class="advisor-done">Tutoriel terminé</div><h3>La colonie peut respirer</h3><p>Tu as posé les premières pierres d'une véritable ville romaine. Continue de bâtir, commerce, recrute des légions et étends l'influence de Rome.</p><div class="ad-actions"><span class="step">Prochaine ambition : port, marché, caserne et conquêtes.</span><button class="skip" id="hideAdvisor">Masquer</button></div></div>`; highlight(null); return; } const item=tutorial[step];const aidText=(step===1&&hallMissing||step===3&&scierieMissing)?`<div class="v5-advisor-aid">Tes réserves sont insuffisantes pour ${hallMissing?'l’Hôtel de ville':'la scierie'}. <button class="v5-assign" data-relief="1">✉ Ravitaillement du Sénat</button></div>`:''; const freePlotText=step===3&&st.sites?.[st.selected]?'<button class="btn-parch v5-choose-free" data-hint-site="1">Choisir une parcelle libre</button>':'';advisor.classList.add('visible'); advisor.innerHTML=`<div class="ad-head"><div class="ad-portrait" aria-label="Marcus Atilius animé"><div class="portraitAnim" style="background-image:url(${SPRITES.mentor})"></div></div><div><div class="ad-title">Marcus Atilius</div><div class="ad-sub">Conseiller impérial</div></div></div><div class="ad-body"><div class="tutorial-badge">TUTORIEL</div><h3>${item.title}</h3><p>${item.text}</p>${aidText}${freePlotText}<p class="tip">${step===0?'Commence modestement : une seule bonne décision vaut mieux qu’un grand plan prématuré.':'Suis l’ordre proposé pour retrouver un début de partie à la Ikariam : base, croissance, administration, carte.'}</p><div class="ad-actions"><span class="step">Étape ${step+1} / ${tutorial.length}</span>${step===7?'<button class="btn-parch" data-nav="locale">Ouvrir la province</button>':step===9?'<button class="btn-parch" data-nav="carte">Voir le monde</button>':''}<button class="skip" id="skipTutorial">Ignorer le tutoriel</button></div></div>`; highlight(item.selector)}

document.addEventListener('click',e=>{if(e.target.id==='skipTutorial'){setStep(tutorial.length);renderAdvisor(true)} if(e.target.id==='hideAdvisor'){sessionStorage.setItem('civitas-hide-advisor','1');advisor.classList.remove('visible')}});

const npcLayer=$('#npcLayer');
const npcPaths=[
 {cls:'citizen', robe:'#a34a24', speed:0.022, path:[[310,418],[380,452],[480,488],[580,526],[670,565],[770,604],[860,637],[950,675],[1040,710]]},
 {cls:'citizen alt', robe:'#2f704d', speed:0.018, path:[[304,367],[380,322],[455,304],[535,319],[645,370],[746,411],[835,448],[942,501],[1045,546]]},
 {cls:'citizen', robe:'#7d2934', speed:0.02, path:[[498,490],[588,451],[676,400],[773,354],[845,313],[911,276]]},
 {cls:'citizen soldier', robe:'#7b1b14', speed:0.017, path:[[598,590],[680,550],[756,500],[835,453],[945,385],[1014,351],[1079,323]]},
 {cls:'citizen alt', robe:'#86561f', crate:true, speed:0.023, path:[[593,594],[677,563],[771,599],[864,638],[950,677]]},
 {cls:'citizen', robe:'#555f8b', speed:0.019, path:[[738,409],[835,447],[925,494],[1051,541],[1121,591]]}
 ];
 const boats=[{speed:0.012, path:[[1040,760],[990,744],[937,732],[884,724],[829,718],[774,713],[724,709],[674,709],[628,710],[587,713],[552,717]]}];
 function interp(path,t){const segCount=path.length-1;const pos=(t%1)*segCount;const i=Math.floor(pos);const f=pos-i;const [x1,y1]=path[i];const [x2,y2]=path[Math.min(i+1,segCount)];return [x1+(x2-x1)*f,y1+(y2-y1)*f]}
 window.CIVITAS_WALK_SPRITE=SPRITES.walk;
 function initNPCs(){if(!npcLayer || npcLayer.dataset.ready) return; npcLayer.dataset.ready='1'; npcPaths.forEach((d,i)=>{const el=document.createElement('div'); el.className=d.cls+' sprite-npc'; el.style.setProperty('--robe',d.robe); el.innerHTML=`<div class="spritewalk" aria-hidden="true" style="background-image:url(${SPRITES.walk})"></div>`; if(d.crate){const c=document.createElement('div'); c.className='crate'; el.appendChild(c)} el.dataset.index=i; const fw=d.cls.includes('soldier')?40:34, fh=d.cls.includes('soldier')?82:70; el.firstElementChild.style.backgroundSize=`${fw*8}px ${fh}px`; npcLayer.appendChild(el); d.el=el;d.frameWidth=fw;}); boats.forEach((d,i)=>{const el=document.createElement('div'); el.className='boat-mini'; el.innerHTML='<div class="mast"></div><div class="sail"></div><div class="hull"></div><div class="prow"></div>'; const wake=document.createElement('div'); wake.className='wake'; npcLayer.appendChild(wake); npcLayer.appendChild(el); d.el=el; d.wake=wake; d.t=i*0.17})}
 const BUILD_SPOTS=[[453,372],[644,304],[837,374],[1045,452],[665,466],[453,539],[902,548],[714,656]];
let npcStateCache={time:0,state:null};
function npcGameState(ts){if(ts-npcStateCache.time>1200){npcStateCache={time:ts,state:state()}}return npcStateCache.state||{sites:[],workers:{},legions:0,pop:36}}
function jobPath(site){const q=BUILD_SPOTS[site]||[650,480];const goal=[q[0]+(q[0]>750?-27:24),q[1]+40];return [[470,690],[515,631],[580,568],[630,512],goal];}
function activeJobSite(g,type){return g?.sites?.findIndex((b,i)=>b?.type===type && (+g.workers?.[i]||0)>0)??-1}
function animateNPCs(ts){if(!npcLayer)return;initNPCs();const seconds=ts/1000;const g=npcGameState(ts);
 const roles=[
 {active:true,path:g?.construction?jobPath(g.construction.site):npcPaths[0].path,worker:!!g?.construction},
 {active:activeJobSite(g,'scierie')>=0,path:jobPath(activeJobSite(g,'scierie')),worker:true},
 {active:activeJobSite(g,'carriere')>=0,path:jobPath(activeJobSite(g,'carriere')),worker:true},
 {active:(g?.legions||0)>0||!!g?.expedition,path:npcPaths[3].path,worker:false},
 {active:activeJobSite(g,'cave')>=0||activeJobSite(g,'marbre')>=0,path:jobPath(Math.max(activeJobSite(g,'cave'),activeJobSite(g,'marbre'))),worker:true},
 {active:(g?.pop||0)>=36,path:npcPaths[5].path,worker:false}
 ];
 npcPaths.forEach((d,idx)=>{const role=roles[idx];if(!role.active){d.el.style.opacity='0';return}
 const path=role.path;const raw=(seconds*d.speed+idx*.17)%2;const t=raw<=1?raw:2-raw;const [x,y]=interp(path,t);const ahead=raw<=1?Math.min(.999,t+.014):Math.max(.001,t-.014);const [nx]=interp(path,ahead);const flip=nx-x<0?-1:1;
 d.el.style.left=x+'px';d.el.style.top=(y+Math.sin(seconds*4+idx)*.9)+'px';d.el.style.transform=`translate(-50%,-90%) scaleX(${flip})`;d.el.style.opacity=document.body.classList.contains('story-mode')?'0':'1';
 const frame=Math.floor((seconds*6.6+idx*1.6)%8);if(d.spriteFrame!==frame){d.el.querySelector('.spritewalk').style.backgroundPosition=`-${frame*d.frameWidth}px 0`;d.spriteFrame=frame}
 });
 boats.forEach((d,idx)=>{const raw=(seconds*d.speed+d.t)%2;const t=raw<=1?raw:2-raw;const [x,y]=interp(d.path,t);const [nx]=interp(d.path,Math.min(.999,t+.01));d.el.style.left=x+'px';d.el.style.top=(y+Math.sin(seconds*2+idx)*2)+'px';d.el.style.transform=`translate(-50%,-50%) scaleX(${nx-x<0?-1:1})`;d.wake.style.left=(x-18)+'px';d.wake.style.top=(y+4)+'px';d.el.style.opacity=document.body.classList.contains('story-mode')?'0':((g?.voyage||g?.expedition||g?.sites?.some(b=>b?.type==='port'))?'1':'.3');d.wake.style.opacity=document.body.classList.contains('story-mode')?'0':'.65'});
 const portrait=advisor?.querySelector('.portraitAnim');if(portrait){const portraitFrame=Math.min(7,Math.floor((seconds*3.2)%12));portrait.style.backgroundPosition=`-${96*portraitFrame}px 0`;}
 requestAnimationFrame(animateNPCs)}

function enhanceMap(){const map=$('.worldmap'); if(!map || map.dataset.enhanced) return; map.dataset.enhanced='1'; const routes=document.createElement('div'); routes.className='map-routes'; routes.innerHTML=`<svg viewBox="0 0 1000 600" preserveAspectRatio="none"><path class="route-path" d="M225,305 C330,180 410,165 455,145 S605,145 645,290 S760,370 842,290"/><path class="route-path alt" d="M455,145 C420,230 400,300 410,405 S520,500 640,485 S760,470 790,366"/><path class="route-path" d="M640,485 C690,420 760,370 842,290"/><g><circle class="port-dot" cx="225" cy="305" r="7"/><circle class="port-dot" cx="455" cy="145" r="7"/><circle class="port-dot" cx="410" cy="405" r="7"/><circle class="port-dot" cx="645" cy="290" r="7"/><circle class="port-dot" cx="842" cy="290" r="7"/><circle class="port-dot" cx="790" cy="485" r="7"/></g><text class="route-text" x="490" y="124">Route commerciale tyrrhénienne</text><text class="route-text" x="597" y="514">Voie méridionale</text></svg><div class="compassRose">✶</div><div class="sea-note">Mare Nostrum — routes et provinces</div>`; map.appendChild(routes); const panel=document.createElement('div'); panel.className='map-panel'; panel.innerHTML='<strong>Conseil stratégique</strong><p>Les provinces les plus lointaines offrent de meilleures ressources, mais exigent davantage de flotte et de légions.</p>'; const body=$('#viewOverlay .view-body'); if(body && !body.querySelector('.map-panel')) body.insertBefore(panel, body.children[1]||null)}

function sync(){maybeAdvanceTutorial();renderAdvisor();enhanceMap();const quests=document.querySelector('#questList');if(quests)quests.classList.toggle('tutorial-active',currentStep()<tutorial.length);const ad=document.querySelector('#advisorBox');if(ad)ad.classList.toggle('hidden-in-modal',state()?.nav!=='ville');const content=document.querySelector('#viewOverlay .viewbox');if(content)content.classList.toggle('map-expanded',!!document.querySelector('#viewOverlay .roman-map'));}

loadMenuIfNeeded(); requestAnimationFrame(animateNPCs); setInterval(sync,500); setTimeout(sync,900);
})();
</script>
<script>
/* CIVITAS XII — Ville animée à deux rendus et habitants affectés et indépendante du fond d'écran.
   Le canvas lit uniquement l'état du jeu via CIVITAS_BRIDGE. Aucun gain fictif. */
(()=>{'use strict';
const api=window.CIVITAS_BRIDGE;
if(!api)return;
const STAGE=document.getElementById('stage');
const holder=document.createElement('section');holder.id='isoDistrict';holder.setAttribute('aria-label','Quartier isométrique interactif');holder.innerHTML=`
  <div class="iso-heading"><div><strong>CIVITAS XL · LA CITÉ IMPÉRIALE</strong><small id="isoCityName">Colonie côtière</small></div><div class="v28-wards" role="group" aria-label="Quartiers de la ville"><button data-district="0" class="selected">Forum</button><button data-district="1">Collines · +8 terrains</button></div><div class="v29-scene-tabs" role="group" aria-label="Naviguer entre les vues"><button data-nav="ville">Ville</button><button data-nav="locale">Province</button><button data-nav="carte">Monde</button></div><div class="iso-tools"><button id="isoTimeMode" title="Éclairage de la cité : jour, crépuscule, nuit et cycle" aria-label="Mode d’éclairage">☀ Jour</button><button id="v30Weather" type="button" title="Changer l’ambiance météo (sans effet sur les ressources)" aria-label="Ambiance météo">☀ Clair</button><button id="v30Immersion" type="button" aria-pressed="false" title="Agrandi la vue de la ville sans changer de moteur" aria-label="Agrandir la vue de la ville">◈</button><button id="isoZoomOut" title="Dézoomer">−</button><button id="isoZoomReset" title="Recentrer">⌖</button><button id="isoZoomIn" title="Zoomer">+</button><button id="v30Fullscreen" type="button" title="Affichage plein écran" aria-label="Passer en plein écran">⛶</button></div></div>
  <canvas id="isoCanvas" width="1168" height="662" role="img" aria-label="Ville isométrique interactive avec routes, bâtiments, chantiers et habitants au travail"></canvas><div id="isoHover" role="status"></div><aside id="v30QuickPanel" aria-label="Gérer la parcelle sélectionnée"></aside><button type="button" id="v30QuickToggle" aria-label="Afficher ou masquer les outils de construction" title="Afficher les commandes de construction">⚒ Gérer la cité</button>
  <div class="iso-info"><span id="v30CityCompass">◈ COLONIE ROMAINE · CLIQUER SUR UNE PARCELLE POUR CONSTRUIRE</span><span id="isoDetails">Chargement de la cité</span></div>
  <button class="iso-city-menu" id="isoRoads" title="Afficher les itinéraires des ouvriers">Afficher les trajets</button>`;
STAGE.appendChild(holder);
const toggle=document.createElement('button');toggle.id='isoToggle';toggle.textContent='◈ VILLE MODULAIRE';toggle.setAttribute('aria-label','Basculer entre la vue illustrée et le plan isométrique interactif');STAGE.appendChild(toggle);
const canvas=holder.querySelector('canvas'),ctx=canvas.getContext('2d');
const W=1168,H=662,COLS=17,ROWS=14,TW=84,TH=40,ORIGIN_X=546,ORIGIN_Y=45;
// Native resolution is raised independently of CSS dimensions for sharper images on high-DPI desktops.
const V30_PIXEL_SCALE=Math.min(1.75,Math.max(1.25,(window.devicePixelRatio||1)*1.45));
canvas.width=Math.round(W*V30_PIXEL_SCALE);canvas.height=Math.round(H*V30_PIXEL_SCALE);
let v30PreviewType=null;let v30HoveredIndex=-1;

const tiles=[],roads=new Set(),sites=[[4,4],[8,2],[12,4],[14,7],[8,7],[4,10],[12,10],[8,12]];
const makeKey=(x,y)=>`${x},${y}`;
const isRoad=(x,y)=>roads.has(makeKey(x,y));
for(let x=2;x<=14;x++){roads.add(makeKey(x,7));roads.add(makeKey(x,4));roads.add(makeKey(x,10))}
for(let y=2;y<=12;y++){roads.add(makeKey(4,y));roads.add(makeKey(8,y));roads.add(makeKey(12,y))}
for(let x=0;x<COLS;x++)for(let y=0;y<ROWS;y++)tiles.push({x,y,r:(Math.sin(x*23.7+y*47.2)*45758.4)%1});
const tilePoint=(x,y)=>[ORIGIN_X+(x-y)*TW/2,ORIGIN_Y+(x+y)*TH/2];
const siteAt=(x,y)=>sites.findIndex(([a,b])=>a===x&&b===y);
const tileDraw=(g,x,y,palette)=>{const [sx,sy]=tilePoint(x,y);g.beginPath();g.moveTo(sx,sy-TH/2);g.lineTo(sx+TW/2,sy);g.lineTo(sx,sy+TH/2);g.lineTo(sx-TW/2,sy);g.closePath();g.fillStyle=palette;g.fill();return [sx,sy]};
const terrain=document.createElement('canvas');terrain.width=W;terrain.height=H;const tctx=terrain.getContext('2d');
const terrainMaterial=new Image();terrainMaterial.src='data:image/jpeg;base64,';terrainMaterial.onload=()=>drawTerrain();

const modularProps={};for(const key of ['cypress','olive','rocks','road','grass','cart','statue','scaffold']){let im=new Image();im.src=window.CIVITAS_V13_ART?.[key]||'';im.onload=()=>{if(typeof drawTerrain==='function')drawTerrain()};modularProps[key]=im;}

function seeded(x,y,z=0){let n=Math.sin(x*127.1+y*311.7+z*83.91)*43758.5453;return n-Math.floor(n)}
function poly(g,coords,fill,stroke=null,width=1){g.beginPath();coords.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.closePath();if(fill){g.fillStyle=fill;g.fill()}if(stroke){g.strokeStyle=stroke;g.lineWidth=width;g.stroke()}}
function drawCypress(g,x,y,scale=1){const art=modularProps.cypress;if(art.complete&&art.naturalWidth){g.drawImage(art,x-24*scale,y-104*scale,48*scale,105*scale);return;}g.save();g.translate(x,y);g.scale(scale,scale);g.fillStyle='#14271844';g.beginPath();g.ellipse(7,2,17,5,0,0,Math.PI*2);g.fill();g.fillStyle='#503c24';g.fillRect(-2,-26,4,30);
 for(let i=0;i<6;i++){g.fillStyle=['#294c32','#3a5a39','#527044'][i%3];g.beginPath();g.ellipse(0,-10-i*8,5+i%2*1.5,14-i*.4,-.05,0,Math.PI*2);g.fill()}g.restore()}
function drawOlive(g,x,y,scale=1){const art=modularProps.olive;if(art.complete&&art.naturalWidth){g.drawImage(art,x-37*scale,y-67*scale,74*scale,70*scale);return;}g.save();g.translate(x,y);g.scale(scale,scale);g.fillStyle='#172d2144';g.beginPath();g.ellipse(9,1,18,5,0,0,Math.PI*2);g.fill();g.strokeStyle='#6e5034';g.lineWidth=4;g.beginPath();g.moveTo(0,0);g.lineTo(0,-20);g.lineTo(-9,-32);g.moveTo(0,-20);g.lineTo(9,-28);g.stroke();for(let k=0;k<6;k++){g.fillStyle=['#658254','#7e9364','#4d7551'][k%3];g.beginPath();g.ellipse((k%3-1)*9,-29-Math.floor(k/3)*7,12,10,-.15,0,Math.PI*2);g.fill()}g.restore()}
function drawRock(g,x,y,size=1){const art=modularProps.rocks;if(art.complete&&art.naturalWidth){g.drawImage(art,x-34*size,y-27*size,68*size,31*size);return;}g.save();g.translate(x,y);g.scale(size,size);poly(g,[[-10,0],[-16,-8],[-6,-21],[10,-22],[18,-5],[10,1]],'#89877b','#666c66',1.3);poly(g,[[-10,0],[-16,-8],[-6,-21],[0,-16],[4,0]],'#b6ab95');poly(g,[[0,-16],[10,-22],[18,-5],[10,1],[4,0]],'#706f66');g.restore()}
const v19Vegetation=[];
function drawTerrain(){
 const g=tctx;g.clearRect(0,0,W,H);
 const sea=g.createLinearGradient(0,0,W,H);sea.addColorStop(0,'#0b5876');sea.addColorStop(.36,'#177e91');sea.addColorStop(.72,'#18758c');sea.addColorStop(1,'#093e62');g.fillStyle=sea;g.fillRect(0,0,W,H);
 // Distant archipelago: a landscape layer drawn independently from the playable terrain.
 g.save();g.globalAlpha=.7;
 const horizon=g.createLinearGradient(0,0,0,190);horizon.addColorStop(0,'#b2d3cf');horizon.addColorStop(1,'#2b878e');g.fillStyle=horizon;g.beginPath();g.moveTo(730,0);g.quadraticCurveTo(890,44,978,20);g.quadraticCurveTo(1040,8,1168,58);g.lineTo(1168,0);g.closePath();g.fill();
 g.fillStyle='#54886a';g.beginPath();g.moveTo(830,0);g.quadraticCurveTo(926,38,1034,14);g.quadraticCurveTo(1100,4,1168,28);g.lineTo(1168,0);g.closePath();g.fill();g.restore();
 // Sea currents, foam and flashes of sunlight are small strokes rather than one flat blue field.
 for(let i=0;i<480;i++){const x=seeded(i,1,28)*W,y=seeded(i,2,29)*H,r=3+seeded(i,4,27)*15;g.strokeStyle=`rgba(225,248,225,${.035+seeded(i,3,11)*.15})`;g.lineWidth=.7+seeded(i,4,9)*.8;g.beginPath();g.moveTo(x-r,y);g.quadraticCurveTo(x,y-3,x+r,y);g.stroke()}
 const west=tilePoint(0,0),north=tilePoint(16,0),east=tilePoint(16,13),south=tilePoint(0,13);
 const perimeter=[[-135,-120],[970,-110],[1195,630],[-110,740]];
 const landPath=()=>{g.beginPath();perimeter.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.closePath()};
 // The rock is a continuous coastal shelf, not a set of disconnected isometric cubes.
 const depth=31;
 poly(g,perimeter.map(([x,y])=>[x+11,y+depth+10]),'#073f53');
 poly(g,[[...perimeter[3]],[...perimeter[2]],[perimeter[2][0]+3,perimeter[2][1]+depth],[perimeter[3][0],perimeter[3][1]+depth]],'#806c52','#c6af81',2);
 poly(g,[[...perimeter[0]],[...perimeter[3]],[perimeter[3][0],perimeter[3][1]+depth],[perimeter[0][0],perimeter[0][1]+depth-3]],'#9e8965','#d8c298',1.6);
 // Stone layers along the front cliff, with real water touching its edge.
 for(let i=0;i<45;i++){const t=i/45,[lx,ly]=perimeter[3],[rx,ry]=perimeter[2],x=lx+(rx-lx)*t,y=ly+(ry-ly)*t;g.strokeStyle=i%2?'#ccb89066':'#564d3566';g.lineWidth=1+seeded(i,5,8);g.beginPath();g.moveTo(x,y+5);g.lineTo(x-2+seeded(i,4,7)*7,y+16+seeded(i,4,9)*8);g.stroke()}
 // Ground material uses a separate reproducible texture, clipped only to the terrain polygon.
 g.save();landPath();g.clip();
 if(terrainMaterial.complete&&terrainMaterial.naturalWidth){g.drawImage(terrainMaterial,0,0,W,H)}else{g.fillStyle='#9da16c';g.fillRect(0,0,W,H)}
 // Broad painted ochre meadows and dark groves, with no hard tile outlines.
 for(let k=0;k<250;k++){const x=seeded(k,8,1)*W,y=seeded(k,9,2)*H,rx=14+seeded(k,10,1)*60,ry=4+seeded(k,11,2)*22;g.fillStyle=k%3===0?'rgba(225,207,121,.08)':k%3===1?'rgba(63,99,48,.08)':'rgba(172,115,63,.035)';g.beginPath();g.ellipse(x,y,rx,ry,seeded(k,7)*.7,0,Math.PI*2);g.fill()}
 // Roads are connected paved paths with dusty shoulders, not checkerboard squares.
 const paths=[];
 for(const yy of [4,7,10])paths.push(Array.from({length:13},(_,i)=>tilePoint(i+2,yy)));
 for(const xx of [4,8,12])paths.push(Array.from({length:11},(_,i)=>tilePoint(xx,i+2)));
 const line=(pts,color,width)=>{g.beginPath();pts.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.strokeStyle=color;g.lineWidth=width;g.lineJoin='round';g.lineCap='round';g.stroke()};
 for(const path of paths){line(path,'#655b4270',26);line(path,'#a49570',23);line(path,'#d7c29b',19);line(path,'#beaa83',15);line(path,'#dbc8a2',11)}
 // Hand-laid paving joins in perspective, aligned to each road direction.
 for(let p=0;p<paths.length;p++){const pts=paths[p];for(let j=0;j<pts.length-1;j++){const [x1,y1]=pts[j],[x2,y2]=pts[j+1],angle=Math.atan2(y2-y1,x2-x1),len=Math.hypot(x2-x1,y2-y1);for(let d=7;d<len;d+=9.5){const u=d/len,x=x1+(x2-x1)*u,y=y1+(y2-y1)*u,dx=-Math.sin(angle),dy=Math.cos(angle);g.strokeStyle=(j+Math.floor(d))%3===0?'#a29276ad':'#f2e3bf99';g.lineWidth=.85;g.beginPath();g.moveTo(x-dx*4.6,y-dy*4.6);g.lineTo(x+dx*4.6,y+dy*4.6);g.stroke()}}}
 // Inner stone alleys meet the streets without making a uniform repeated grid.
 for(const [x,y] of [[4,4],[4,10],[8,4],[8,7],[8,10],[12,4],[12,10]]){const [px,py]=tilePoint(x,y);g.fillStyle='#d4bf98a6';g.beginPath();g.ellipse(px,py,17,11,0,0,Math.PI*2);g.fill()}
 // Tiny vegetation in the material, filtered around architectural plots and carriageways.
 for(let i=0;i<660;i++){const tx=Math.floor(seeded(i,41)*17),ty=Math.floor(seeded(i,42)*14),[x,y]=tilePoint(tx,ty);const nearPlot=sites.some(([sx,sy])=>Math.abs(tx-sx)<2&&Math.abs(ty-sy)<2);if(isRoad(tx,ty)||nearPlot)continue;const px=x+(seeded(i,13)-.5)*44,py=y+(seeded(i,14)-.5)*17;g.strokeStyle=i%3?'#477d3c72':'#d0c48c8c';g.lineWidth=1;g.beginPath();g.moveTo(px,py);g.lineTo(px-2,py-2-seeded(i,12)*4);g.stroke();if(i%14===0){g.fillStyle=i%2?'#f4e8bb':'#e9b6a0';g.fillRect(px+2,py-3,2,2)}}
 g.restore();
 // Coast highlights and separate clusters of art assets stay independently drawable.
 line([perimeter[3],perimeter[2]],'#dfcfad9c',2);
 for(let i=0;i<44;i++){const t=seeded(i,12),x=perimeter[3][0]+(perimeter[2][0]-perimeter[3][0])*t,y=perimeter[3][1]+(perimeter[2][1]-perimeter[3][1])*t+depth+8;g.strokeStyle=`rgba(232,250,230,${.16+seeded(i,29)*.3})`;g.lineWidth=1.5;g.beginPath();g.moveTo(x-10,y);g.quadraticCurveTo(x,y-3,x+12,y);g.stroke()}
 // Less vegetation, but individual trees large enough to be seen and painted in depth order.
 const deco=[];
 for(let x=0;x<COLS;x++)for(let y=0;y<ROWS;y++){
  const near=sites.some(([sx,sy])=>Math.abs(sx-x)<=1&&Math.abs(sy-y)<=1);
  if(near||isRoad(x,y))continue;
  const r=seeded(x,y,6);if(r<.66)continue;
  const [px,py]=tilePoint(x,y);deco.push({px:px+(seeded(x,y,22)-.5)*12,py:py+6,type:r>.93?'rock':r>.78?'olive':'cypress',scale:.6+seeded(x,y,25)*.36});
 }
 deco.sort((a,b)=>a.py-b.py);
 v19Vegetation.length=0;
 for(const p of deco){if(p.type==='rock')drawRock(g,p.px,p.py,p.scale);else v19Vegetation.push({...p,scale:p.scale*(p.type==='olive'?.95:.93)});}
 // Scattered individual stone boulders and sea-side vegetation, never covering the buildable lots.
 for(let i=0;i<24;i++){const t=(i+.4)/25, x=perimeter[3][0]+(perimeter[2][0]-perimeter[3][0])*t, y=perimeter[3][1]+(perimeter[2][1]-perimeter[3][1])*t;
  if(i%4===0)drawRock(g,x,y+2,.63+seeded(i,7,8)*.25);
  if(i%6===1)v19Vegetation.push({px:x,py:y-4,type:'olive',scale:.47});
 }
 // A terraced grove behind the colony introduces variation without occupying a building lot.
 for(const [xx,yy,k] of [[1,2,1],[2,1,.85],[3,1,.7],[14,1,.75],[15,2,.8],[0,9,.9],[15,10,.85]]){
  const [px,py]=tilePoint(xx,yy);v19Vegetation.push({px,py,type:'olive',scale:k*.73});
 }
 // Distinct port assembly along the southern coastal edge, not part of a pasted scene.
 const [hx,hy]=tilePoint(12,12);
 g.fillStyle='#1f344254';g.beginPath();g.ellipse(hx+54,hy+28,103,25,-.1,0,Math.PI*2);g.fill();
 g.lineCap='round';g.strokeStyle='#654322';g.lineWidth=19;g.beginPath();g.moveTo(hx-3,hy);g.lineTo(hx+115,hy+34);g.stroke();g.strokeStyle='#cfb288';g.lineWidth=13;g.beginPath();g.moveTo(hx-3,hy-5);g.lineTo(hx+115,hy+29);g.stroke();
 for(let i=0;i<6;i++){const x=hx+i*22,y=hy-6+i*6.4;g.fillStyle='#6d4927';g.fillRect(x,y,6,21);g.strokeStyle='#eddbaf';g.lineWidth=1;g.beginPath();g.moveTo(x+1,y);g.lineTo(x+4,y);g.stroke()}
 if(modularProps.cart?.complete&&modularProps.cart.naturalWidth)g.drawImage(modularProps.cart,hx-45,hy-62,62,72);
 // Simple stone watch-post near the port and raised quay.
 g.fillStyle='#a18d6b';g.fillRect(hx+120,hy+2,17,34);poly(g,[[hx+116,hy+5],[hx+128,hy-9],[hx+141,hy+5]],'#dfceb0','#806b4c',1);
}
drawTerrain();

// CIVITAS XXXIX — Moteur pictural modulaire : aucun plan de ville pré-rendu.
const v20ExtraSrc={north:'data:image/png;base64,'};

// Les matériaux, reliefs, arbres, routes, bâtiments et effets sont peints indépendamment.
const v20AccentSrc={northwest:'data:image/png;base64,',horizon:'data:image/png;base64,