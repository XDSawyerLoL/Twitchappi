<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#3f2114"><title>CIVITAS XXXIX — Jeu de stratégie romain</title>
<style>
:root{--gold:#d6a449;--bronze:#80502a;--red:#690d09;--ink:#382113;--parch:#f4dfb4;--line:#b88b49}*{box-sizing:border-box}body{background:#17110d;color:var(--ink);font-family:Georgia,'Times New Roman',serif;margin:0;overflow:hidden}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.47;cursor:not-allowed}button:focus-visible,input:focus-visible{outline:3px solid #fff3a5;outline-offset:3px}#viewport{width:100vw;height:100dvh;overflow:auto;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#6d4b29,#0c0a09)}#stage-holder{position:relative;margin:auto}#stage{width:1672px;height:941px;position:absolute;top:0;left:0;transform-origin:0 0;overflow:hidden;background:#5e8ca5}#art{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;user-select:none}.hot{position:absolute;border:0;background:transparent;z-index:6}#nav-hotspots .hot:hover{background:#ffdb7640;box-shadow:inset 0 0 0 2px #ffe08d;border-radius:7px}#nav-hotspots .hot.active{background:#ffe09d22;box-shadow:inset 0 -4px 0 #ffe19a}.resourceNumber{position:absolute;z-index:5;width:89px;text-align:center;font:700 22px/1 Georgia,serif;color:#2c2215;background:linear-gradient(90deg,#f0d5a6 0,#f2dcb4 40%,#efd5a6 100%);text-shadow:0 1px #fff6d3}.resourceRate{position:absolute;z-index:5;width:87px;text-align:center;font:700 16px/1 Georgia,serif;color:#15793d;background:linear-gradient(90deg,#f0d5a6 0,#f2dcb4 40%,#efd5a6 100%)}#population{font-size:18px;top:115px;left:1214px;width:86px}#poprate{top:134px;left:1211px;font-size:14px;width:92px}.popdot{color:#257b43}.timerbox{position:absolute;right:35px;bottom:20px;z-index:5;color:#fff2cd;background:#25160f;padding:5px 14px;border-radius:20px;font:700 17px Georgia;width:145px;height:37px;text-align:center;display:grid;place-items:center}.hit-plot{position:absolute;z-index:8;width:160px;height:128px;transform:translate(-50%,-51%);border:2px solid transparent;border-radius:50%;background:transparent;color:#fff0be;cursor:pointer;filter:drop-shadow(0 1px 1px #28190e);transition:background .16s,border .16s}.hit-plot:hover{background:#ffdb512e;border:2px dashed #ffe3a5}.hit-plot.selected{border:2px solid #ffe4a4;background:#ffdc4b21;box-shadow:0 0 25px #ffe4a466}.hit-plot .sprite{position:absolute;width:148px;height:132px;object-fit:contain;left:4px;top:-29px;filter:drop-shadow(0px 11px 7px #3029168a)}.hit-plot .constructing{position:absolute;top:-13px;left:13px;width:127px;height:93px;border:3px dashed #ffdd80;border-radius:25px;background:#75532488;display:grid;place-content:center;font-size:41px;text-shadow:0 3px 6px black}.hit-plot .bname{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);background:#391b10d6;border:1px solid #dcb46e;border-radius:20px;white-space:nowrap;padding:4px 9px;color:#fff0bd;font:700 14px Georgia}.hit-plot .lvl{font-size:12px;color:#efcc83}.hit-plot.empty:focus-visible{background:#ffdf6b44}.plotHint{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);opacity:0;color:#fff4a7;background:#502b1cca;border:1px solid #edc179;border-radius:7px;padding:7px;white-space:nowrap;font-size:13px;pointer-events:none}.hit-plot.empty:hover .plotHint{opacity:1}.card-zone{position:absolute;z-index:9;left:1277px;top:235px;width:357px;height:502px;overflow:auto;scrollbar-color:#ad7945 #e8cfa1;padding:7px 30px 14px 10px;background:linear-gradient(90deg,#d9b987 0%,#f6e4c1 5%,#f4e0b7 50%,#f4ddb0 96%,#d3ad77 100%);border-left:2px solid #b5884f;border-right:2px solid #ab773f}.panel-top{position:absolute;z-index:8;top:188px;left:1295px;width:315px;height:39px;padding-top:5px;color:#fff0c5;font:700 22px Georgia;text-shadow:0 2px 3px #300400;text-align:center;background:linear-gradient(90deg,#8c180c,#941e0e,#751007);border-radius:3px}.build-row{position:relative;min-height:92px;display:flex;gap:7px;align-items:center;padding:6px 3px;border-bottom:1px solid #ae865a}.build-row img{width:86px;height:69px;object-fit:contain;flex-shrink:0;filter:drop-shadow(1px 3px 3px #745b3199)}.build-row .build-text{flex:1;min-width:0}.build-row b{display:block;font-size:19px;color:#321e10}.build-row small{font:14px/1.15 Georgia;display:block;margin:2px 0 7px}.build-row .costline{display:flex;flex-wrap:wrap;gap:7px;color:#684528;font:700 12px Georgia}.build-row button{width:35px;min-width:35px;height:35px;border-radius:6px;background:linear-gradient(#f7dea4,#cfa66b);border:2px solid #ac7a44;color:#7a4b21;font-size:28px;display:grid;place-items:center;line-height:1}.build-row button:not(:disabled):hover{filter:brightness(1.13)}.build-row.selected-item{background:#ffeca47a}.card-zone:after{content:"";position:fixed;left:1608px;top:237px;height:496px;width:22px;background:#f1dbb2;pointer-events:none;z-index:2}.panel-note{font:14px/1.3 Georgia;color:#725432;padding:12px 5px;text-align:center}.panel-section{padding:13px;color:#3d2210;font-size:16px}.panel-section h3{font-size:23px;margin:5px 0 9px}.panel-section p{margin:10px 0}.panel-section .statrow{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #aa865b;padding:8px 0;gap:6px}.panel-section .statrow strong{font-size:18px}.btn-red{border:2px solid #d5a363;background:linear-gradient(#a72d1a,#641007);box-shadow:inset 0 1px 0 #f9cf9c,0 3px 0 #7d502c;border-radius:5px;color:#fff0c1;text-shadow:0 2px #481307;padding:10px 14px;font-weight:700;line-height:1.2;cursor:pointer}.btn-red:hover:not(:disabled){filter:brightness(1.15)}.btn-red:disabled{filter:grayscale(.2);opacity:.5}.btn-parch{background:linear-gradient(#fff1ca,#dcc098);border:1px solid #9c6e3e;box-shadow:0 2px 1px #ab825a;border-radius:5px;color:#45220c;padding:7px 11px;font-weight:700;cursor:pointer}.btn-parch:not(:disabled):hover{filter:brightness(1.1)}.tiny{font-size:13px;color:#855b32}.progress{height:10px;background:#9f7f55;box-shadow:inset 0 2px 3px #603a24;border-radius:10px;overflow:hidden;margin:10px 0}.progress i{display:block;height:100%;background:linear-gradient(90deg,#2b9357,#d9bd5a);transition:width 1s;width:0}.costgrid{display:flex;flex-wrap:wrap;gap:9px;margin:12px 0;color:#563821;font-weight:bold}.costgrid .missing{color:#b32714}.quest-content{position:absolute;z-index:7;left:19px;top:796px;width:341px;height:109px;background:linear-gradient(105deg,#efd6a6,#f5e2bd,#e9cb94);padding:5px 5px 3px;overflow:auto;scrollbar-width:thin}.quest-content button{width:100%;text-align:left;border:0;background:transparent;font:700 15px/1.23 Georgia;color:#442a16;margin:0;padding:4px 0}.quest-content button:hover{background:#ffeac5}.quest-content .tick{border:1px solid #b99458;border-radius:4px;padding:1px 4px;margin-right:5px;background:#eed7a8}.quest-content .completed .tick{background:#98a96a}.toast{position:absolute;z-index:80;left:50%;bottom:42px;transform:translate(-50%,18px);max-width:650px;min-width:280px;text-align:center;padding:15px 22px;border:2px solid #ddbb70;border-radius:8px;background:linear-gradient(#752819,#42110c);color:#ffe7b5;box-shadow:0 10px 25px #29150ac9;font:700 19px Georgia;opacity:0;pointer-events:none;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}.viewbox{position:absolute;z-index:18;left:150px;top:184px;width:1066px;height:577px;border:12px ridge #a3743d;border-radius:14px;box-shadow:0 15px 50px #000b;background:linear-gradient(160deg,#f7e6c2,#dfbb8c);overflow:hidden}.view-header{background:linear-gradient(90deg,#681106,#9b2412,#5e0b06);color:#fff2cc;min-height:58px;padding:13px 22px;font:700 28px Georgia;text-align:center;border-bottom:4px ridge #cba565}.view-close{position:absolute;z-index:4;right:13px;top:11px;border:2px solid #dcb16e;border-radius:50%;width:37px;height:37px;background:#6b160b;color:#f7deaa;font:700 24px Arial}.view-body{height:490px;overflow:auto;padding:22px;color:#352111;scrollbar-color:#b77d43 #edcea0}.view-body h2{margin:8px 0 13px;font:700 28px Georgia}.view-body h3{margin:9px 0;font-size:21px}.view-body p{margin:8px 0 14px;line-height:1.35}.card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{border:2px solid #c09a67;background:#f4dfb4b5;box-shadow:0 2px 5px #9b713c55;border-radius:8px;padding:13px}.card h3{margin:4px 0 8px}.card p{min-height:43px;font-size:15px}.card small{font-size:13px;color:#7b5532}.card .btn-red,.card .btn-parch{margin-top:11px}.chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.chip{background:#e8cc9b;border:1px solid #a67e45;border-radius:50px;padding:6px 12px;font-weight:bold}.worldmap{position:relative;width:100%;height:400px;background:radial-gradient(ellipse,#5aabc0 0,#327995 60%,#21607b 100%);border:8px ridge #b48a4a;overflow:hidden;border-radius:9px}.worldmap:before{position:absolute;inset:0;content:'';opacity:.3;background:repeating-radial-gradient(ellipse at 40% 50%,transparent 0,transparent 21px,#b9f2e744 24px,transparent 28px)}.island{position:absolute;transform:translate(-50%,-50%);width:145px;height:84px;background:linear-gradient(145deg,#c4b57b,#688b4c 37%,#486b35);border:5px solid #ddcc9b;border-radius:56% 39% 45% 45% / 47% 60% 37% 43%;box-shadow:0 10px 2px #134e68;color:#fffad7;font-size:15px;font-weight:bold;text-shadow:0 2px 3px #1e2b15;z-index:2}.island small{display:block;font-weight:normal}.island.owned{box-shadow:0 10px 2px #134e68,0 0 0 7px #d0b45f8f}.island:hover{filter:brightness(1.25)}.island.active{outline:4px solid #ffe3a0}.maplabel{position:absolute;top:14px;left:18px;font:italic 33px Georgia;color:#edebc6;text-shadow:0 2px 4px #205771}.two-col{display:grid;grid-template-columns:1.2fr 1fr;gap:16px}.big-stat{background:#eed7ab;border:1px solid #c4a06c;padding:10px;margin:7px 0;border-radius:4px;font-size:18px}.event-row{border-bottom:1px solid #caab77;padding:11px 7px}.event-row time{color:#815528;font-size:13px;margin-right:7px}.plaque{background:linear-gradient(#fbebc8,#e9c999);border:3px ridge #c09a64;border-radius:7px;padding:16px}.intro-inline{font-size:14px;color:#6a4428}.muted{color:#865d35}.header-caption{position:absolute;left:133px;top:146px;z-index:7;color:#42280e;font:700 17px Georgia;white-space:nowrap;background:#eed3a3}.header-city{position:absolute;left:132px;top:124px;z-index:7;font:700 19px Georgia;color:#352016;background:#f1d8ac;white-space:nowrap}.city-backdrop{position:absolute;left:119px;top:119px;z-index:6;width:173px;height:49px;background:linear-gradient(90deg,#f0d7a9,#efd9ae,#e9cea0)}.resourceGroup{position:absolute;z-index:6;height:53px;width:91px;background:linear-gradient(90deg,#f1d9b1 0%,#f2dbb3 80%,#edd4a8 100%);text-align:center;padding-top:6px}.resourceGroup .number{font:700 22px/24px Georgia;color:#322719}.resourceGroup .rate{font:700 15px/17px Georgia;color:#177a40}.resourceGroup.population{width:101px}.resourceGroup.population .number{font-size:19px}.resourceGroup.population .rate{font-size:14px}.header-speed{position:absolute;z-index:8;top:152px;left:408px;background:#301a0c9c;color:#fff0ba;padding:4px 9px;border-radius:4px;font:700 13px Georgia}.debug-banner{position:absolute;z-index:10;left:410px;top:908px;background:#3a1c11db;color:#f6d7a0;padding:4px 10px;border-radius:6px;font:700 12px Georgia}.dock-count{position:absolute;z-index:7;left:1105px;top:790px;background:#53250eda;color:#ffe5ad;font:700 15px Georgia;padding:6px 10px;border-radius:7px;opacity:0}.dock-count.visible{opacity:1}.panel-queue{background:#f2dbad;border:2px dashed #ae8753;border-radius:8px;padding:12px;margin:8px 0}.speed-select{font-weight:bold;background:#f7e5be;padding:8px;border:1px solid #ad8355}.export-box{display:flex;gap:10px;flex-wrap:wrap}.detail-title{display:flex;align-items:center;gap:12px}.detail-title img{width:92px;height:82px;object-fit:contain}.focus-inactive{opacity:.55}.modal-counter{font-size:19px;font-weight:700}.table-like{width:100%;border-collapse:collapse}.table-like td,.table-like th{border-bottom:1px solid #c5a16d;padding:10px;text-align:left}.table-like th{background:#e5c58f}#globalInfo{position:absolute;right:368px;top:169px;z-index:7;border:1px solid #ebd6a6;background:#431c0ddc;color:#ffe9bf;border-radius:6px;padding:4px 8px;font-size:14px;display:none}
@media (prefers-reduced-motion:reduce){.toast,.progress i,.hit-plot{transition:none}}@media print{body{overflow:visible}#viewport{overflow:visible}}

#npcLayer,#fxLayer{position:absolute;inset:0;pointer-events:none}.citizen{position:absolute;z-index:4;width:14px;height:28px;transform:translate(-50%,-50%);filter:drop-shadow(0 2px 2px #0008)}.citizen:before{content:'';position:absolute;left:3px;top:0;width:8px;height:8px;border-radius:50%;background:#f0c89d}.citizen:after{content:'';position:absolute;left:1px;top:8px;width:12px;height:16px;border-radius:8px 8px 4px 4px;background:var(--robe,#b43322);box-shadow:0 10px 0 -7px #5b3218}.citizen.alt:after{background:var(--robe,#28704c)}.citizen.soldier:after{background:var(--robe,#7e1f17)}.citizen .crate{position:absolute;left:-4px;top:12px;width:10px;height:10px;background:#9d6b38;border:1px solid #5d3815;border-radius:2px}.wake{position:absolute;width:22px;height:6px;border-radius:99px;background:#ffffff4a;filter:blur(1px);transform:translate(-50%,-50%)}.boat-mini{position:absolute;z-index:4;width:56px;height:24px;transform:translate(-50%,-50%);filter:drop-shadow(0 4px 3px #0007)}.boat-mini .sail{position:absolute;left:23px;top:1px;width:0;height:0;border-left:0 solid transparent;border-right:18px solid transparent;border-bottom:19px solid #8d1710}.boat-mini .mast{position:absolute;left:21px;top:1px;width:2px;height:18px;background:#5b3217}.boat-mini .hull{position:absolute;left:4px;top:16px;width:46px;height:8px;background:#5d3416;border-radius:0 0 18px 18px}.boat-mini .prow{position:absolute;right:2px;top:14px;width:10px;height:10px;border:2px solid #bb8b42;border-left:0;border-bottom:0;border-radius:0 10px 0 0}.pulse-target{animation:pulseTarget 1.2s infinite !important;position:relative;z-index:120 !important;box-shadow:0 0 0 0 #ffe89d}@keyframes pulseTarget{0%{box-shadow:0 0 0 0 #ffe89daa}70%{box-shadow:0 0 0 14px #ffe89d00}100%{box-shadow:0 0 0 0 #ffe89d00}}#advisorBox{position:absolute;left:18px;bottom:18px;z-index:130;width:390px;display:none;background:linear-gradient(180deg,#f3e0bc,#e4c58f 65%,#cca166);border:3px solid #8a5c2c;border-radius:14px;box-shadow:0 18px 40px #0008;color:#351f10;overflow:hidden}#advisorBox.visible{display:block}#advisorBox .ad-head{display:flex;align-items:center;gap:12px;padding:10px 12px;background:linear-gradient(90deg,#6f110b,#9e2414,#651009);color:#fff1cf}#advisorBox .ad-portrait{width:56px;height:56px;border-radius:50%;background:radial-gradient(circle at 45% 28%,#f6d0ab 0 18%,#8d5d34 19% 20%,transparent 20%),radial-gradient(circle at 55% 36%,#fff 0 2px,#2a170d 3px,transparent 4px),radial-gradient(circle at 41% 36%,#fff 0 2px,#2a170d 3px,transparent 4px),radial-gradient(circle at 50% 58%,#b35a43 0 4px,transparent 5px),linear-gradient(#cbcccf,#8b919b);border:2px solid #e9c88f;box-shadow:inset 0 10px 18px #ffffff30}#advisorBox .ad-title{font-size:22px;font-weight:700}#advisorBox .ad-sub{font-size:13px;color:#ffddae}#advisorBox .ad-body{padding:12px 14px 14px}#advisorBox h3{margin:0 0 6px;font-size:23px}#advisorBox p{margin:6px 0 8px;line-height:1.35}#advisorBox .tip{font-size:14px;color:#6f4724}#advisorBox .ad-actions{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-top:10px}#advisorBox .step{font-size:13px;color:#684225;font-weight:bold}#advisorBox .skip{background:transparent;border:0;color:#7a4a21;text-decoration:underline;cursor:pointer}#storyOverlay{position:absolute;inset:0;z-index:200;display:none}#storyOverlay.visible{display:block}#storyOverlay .story-bg{position:absolute;inset:0;background:linear-gradient(180deg,#100b08de,#100b08f0 50%,#181109ea),url("data:image/png;base64,