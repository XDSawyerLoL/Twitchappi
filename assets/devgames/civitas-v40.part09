'};
const v20Accents={};for(const [id,src] of Object.entries(v20AccentSrc)){
 const img=new Image();img.onload=()=>drawTerrainV20();img.src=src;v20Accents[id]=img;
}
function v20LandOutline(g){
 // Coastline irregularly bounds the PLAYABLE coast; no straight rectangular platform.
 g.beginPath();g.moveTo(-55,-40);g.lineTo(1112,-40);
 g.bezierCurveTo(1110,35,1094,63,1112,105);g.bezierCurveTo(1136,140,1112,161,1082,195);
 g.bezierCurveTo(1054,224,1064,247,1092,276);g.bezierCurveTo(1099,302,1047,310,1034,340);
 g.bezierCurveTo(1015,368,1039,387,1013,420);g.bezierCurveTo(1000,451,968,452,944,480);
 g.bezierCurveTo(929,511,954,525,920,555);g.bezierCurveTo(895,580,871,588,847,616);
 g.bezierCurveTo(815,646,774,650,737,694);g.lineTo(-55,694);g.closePath();
}
function v20Coast(g){
 const line=[[1112,-40],[1110,105],[1082,195],[1092,276],[1034,340],[1013,420],[944,480],[920,555],[847,616],[737,694]];
 g.save();g.lineCap='round';g.lineJoin='round';
 const coast=()=>{g.beginPath();line.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));};
 coast();g.strokeStyle='#073b4c77';g.lineWidth=32;g.stroke();
 coast();g.strokeStyle='#5a6f5559';g.lineWidth=22;g.stroke();
 coast();g.strokeStyle='#bca98a';g.lineWidth=11;g.stroke();
 coast();g.strokeStyle='#d8c6a7';g.lineWidth=4;g.stroke();
 // Multiple independently placed rock clusters along the edge.
 for(let i=0;i<31;i++){
  const j=3+Math.floor(seeded(i,23)*6),[a,b]=line[j],[c,d]=line[Math.min(j+1,line.length-1)];
  const u=seeded(i,44),x=a+(c-a)*u-7,y=b+(d-b)*u;
  const scale=.44+seeded(i,11)*.65;
  if(modularProps.rocks?.complete&&modularProps.rocks.naturalWidth) g.drawImage(modularProps.rocks,x-37*scale,y-27*scale,74*scale,35*scale);
 }
 g.restore();
}
function v20PaintRoad(g,path,width=25){
 const smooth=[];
 for(let i=0;i<path.length-1;i++){
  const [ax,ay]=path[i],[bx,by]=path[i+1];const count=Math.ceil(Math.hypot(bx-ax,by-ay)/12);
  for(let t=0;t<count;t++){const u=t/count;const jitter=Math.sin((i+u)*3.2)*2;
   smooth.push([ax+(bx-ax)*u+jitter,ay+(by-ay)*u+jitter*.45]);}
 }smooth.push(path[path.length-1]);
 const stroke=(color,w)=>{g.beginPath();smooth.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.strokeStyle=color;g.lineWidth=w;g.stroke()};
 g.lineCap='round';g.lineJoin='round';
 stroke('#544b3466',width+15);stroke('#a48b5cc0',width+11);stroke('#d4b786',width+6);stroke('#f0dfb8',width+1);stroke('#cfb38c',width-7);
 // Mortar and individual cobbles, following the bent road axis.
 for(let i=1;i<smooth.length-1;i++){
  if(i%1!==0)continue;const [x,y]=smooth[i],[xa,ya]=smooth[i-1],[xb,yb]=smooth[i+1];
  const dx=xb-xa,dy=yb-ya, length=Math.max(1,Math.hypot(dx,dy)),vx=-dy/length,vy=dx/length;
  const r=(width-6)*.45;
  g.strokeStyle=i%3===0?'#ad987e99':'#f9e8c7aa';g.lineWidth=.95;
  g.beginPath();g.moveTo(x-vx*r,y-vy*r);g.lineTo(x+vx*r,y+vy*r);g.stroke();
  if(i%3===0){g.strokeStyle='#aa9477a1';g.beginPath();g.moveTo(x+vx*(r*.13),y+vy*(r*.13));g.lineTo(x+vx*(r*.13)+dx/length*7,y+vy*(r*.13)+dy/length*7);g.stroke();}
 }
}

/* CIVITAS XXX : rendu modulaire vivant. Chaque élément est peint à part de l'arrière-plan.
   Rien ici n'ajoute d'or, d'ouvriers, de soldats ou de bâtiments fictifs. */
const V21_TAU=Math.PI*2;
const V21_CLUSTERS=[
 [180,177,.63,'olive'],[246,199,.5,'cypress'],[337,208,.49,'olive'],[443,184,.57,'cypress'],
 [104,370,.59,'olive'],[178,446,.6,'cypress'],[230,538,.43,'olive'],[320,580,.52,'cypress'],
 [922,170,.66,'olive'],[979,245,.58,'cypress'],[1006,418,.62,'olive'],[860,598,.63,'olive']
];
function v21Atmosphere(g,ts,phase){
 const t=ts/1000;
 g.save();
 if(phase==='under'){
  // Sunlight grazing the Roman hills, subtle haze over open water.
  const sun=g.createRadialGradient(175,20,20,305,145,750);
  sun.addColorStop(0,'rgba(255,238,168,.14)');sun.addColorStop(.65,'rgba(243,215,141,.025)');sun.addColorStop(1,'rgba(255,242,174,0)');
  g.fillStyle=sun;g.fillRect(0,0,W,H);
  // Moving cloud-shadows: a material effect, not a screenshot.
  g.beginPath();v20LandOutline(g);g.clip();
  for(let i=0;i<4;i++){
    const x=((i*395+t*7)%1780)-330,y=88+i*112+Math.sin(t*.04+i)*16;
    const shade=g.createRadialGradient(x,y,22,x,y,205);
    shade.addColorStop(0,'rgba(25,49,35,.12)');shade.addColorStop(1,'rgba(25,49,35,0)');
    g.fillStyle=shade;g.save();g.translate(x,y);g.scale(1.5,.44);g.translate(-x,-y);g.fillRect(x-240,y-240,480,480);g.restore();
  }
 }else if(phase==='top'){
  // The coast and the landscape belong to one atmosphere, without obscuring the city.
  const vign=g.createRadialGradient(550,293,270,550,293,850);
  vign.addColorStop(0,'rgba(19,39,29,0)');vign.addColorStop(1,'rgba(14,28,24,.11)');
  g.fillStyle=vign;g.fillRect(0,0,W,H);
  // Small, independently animated seabirds along the coastal horizon.
  for(let i=0;i<3;i++){
   const x=1000+Math.sin(t*.16+i*2.13)*73,y=55+i*34+Math.cos(t*.42+i)*4;
   g.strokeStyle='rgba(245,242,207,.75)';g.lineWidth=1.35;g.beginPath();
   g.moveTo(x-8,y);g.quadraticCurveTo(x-3,y-5,x,y-1);g.quadraticCurveTo(x+4,y-6,x+9,y);g.stroke();
  }
 }
 g.restore();
}

// --- CIVITAS XXX: genuinely built urban districts, not fixed buildings on a painted scene. ---
let v25TimePreset='day';
const V25_TAU=Math.PI*2;
function v25TileStone(g,x,y,rx,ry,level,type){
 g.save();g.translate(x,y);
 // Layered border and weathering on the paved ground plane.
 g.fillStyle='rgba(54,42,29,.27)';g.beginPath();g.ellipse(7,13,rx+7,ry+4,0,0,V25_TAU);g.fill();
 g.fillStyle=type==='marche'?'#d3b88d':type==='hotelville'||type==='senatbat'?'#e4d0a9':'#bfa784';
 g.strokeStyle='#8b7250';g.lineWidth=2;g.beginPath();g.ellipse(0,7,rx,ry,0,0,V25_TAU);g.fill();g.stroke();
 g.save();g.beginPath();g.ellipse(0,7,rx-3,ry-3,0,0,V25_TAU);g.clip();
 for(let k=-7;k<=7;k++){
  const ty=7+k*7, span=Math.sqrt(Math.max(0,1-((ty-7)/(ry+1))**2))*rx;
  const parity=Math.abs(k)%2;
  g.strokeStyle=parity?'rgba(102,81,56,.23)':'rgba(255,241,214,.38)';g.lineWidth=1.2;
  g.beginPath();g.moveTo(-span,ty);g.lineTo(span,ty);g.stroke();
  for(let col=-8;col<=8;col++){
   const tx=col*15+(parity?7.5:0);
   if(Math.abs(tx)>span)continue;
   g.strokeStyle='rgba(111,89,60,.22)';g.beginPath();g.moveTo(tx,ty-6.5);g.lineTo(tx,ty);g.stroke();
  }
 }
 if(level>=3){
  g.strokeStyle='rgba(163,103,55,.58)';g.lineWidth=2;g.beginPath();g.ellipse(0,7,rx*.62,ry*.58,0,0,V25_TAU);g.stroke();
  if(type==='hotelville'||type==='senatbat'){
   for(let j=0;j<8;j++){const a=j*V25_TAU/8;g.fillStyle=j%2?'#ad8150':'#e8d6b4';g.beginPath();g.arc(Math.cos(a)*rx*.39,7+Math.sin(a)*ry*.39,2.8,0,V25_TAU);g.fill()}
  }
 }
 g.restore();g.restore();
}
function v25DrawFarmrows(g,x,y,level,kind){
 g.save();g.translate(x,y);
 for(let r=0;r<3+Math.min(3,level);r++){
  const yy=22+r*7;g.strokeStyle='#6c5538';g.lineWidth=2.8;g.beginPath();g.moveTo(-58,yy);g.quadraticCurveTo(-7,yy-5,46,yy+1);g.stroke();
  for(let q=0;q<8;q++){
   const px=-53+q*13,py=yy-3+(q%2)*1.5;
   g.fillStyle=kind==='cave'?'#477342':'#6b8d47';g.beginPath();g.ellipse(px,py,3.6,2.4,-.4,0,V25_TAU);g.fill();
   if(kind==='cave'&&q%2===0){g.fillStyle='#702c55';g.beginPath();g.arc(px+2,py+3,1.6,0,V25_TAU);g.fill()}
  }
 }
 g.restore();
}
function v25DistrictGround(g,state,ts){
 const built=(state.sites||[]).map((b,i)=>({b,i})).filter(o=>o.b||state.construction?.site===o.i);
 for(const {b,i} of built){
  const [x,y]=tilePoint(...sites[i]);const type=b?.type||state.construction.type,level=b?.level||1;
  const p=state.construction?.site===i&&!b?Math.max(.12,Math.min(1,(Date.now()-state.construction.start)/(state.construction.end-state.construction.start))):1;
  // Conditional connection to the pre-existing road geometry; unbuilt plots remain natural.
  const [tx,ty]=sites[i];
  const access=[[tx,ty+1],[tx,ty-1],[tx+1,ty],[tx-1,ty]].filter(([ax,ay])=>isRoad(ax,ay));
  if(access.length){const end=tilePoint(...access[0]);g.save();g.globalAlpha=.87;
   const dx=end[0]-x,dy=end[1]-y;
   g.strokeStyle='#725d4080';g.lineWidth=18;g.lineCap='round';g.beginPath();g.moveTo(x+dx*.27,y+dy*.27+17);g.quadraticCurveTo(x+dx*.75,y+dy*.75,end[0],end[1]);g.stroke();
   g.strokeStyle='#e3cd9f';g.lineWidth=12;g.stroke();g.strokeStyle='#bc9970';g.lineWidth=8;g.stroke();g.restore();}
  g.save();g.globalAlpha=p;
  const rx=type==='hotelville'||type==='senatbat'?94+level*6:type==='marche'?88:70+Math.min(5,level)*5;
  const ry=type==='hotelville'||type==='senatbat'?40+level*2:type==='marche'?31:26;
  if(type==='hotelville'||type==='senatbat'||type==='marche'||type==='temple'||type==='academie')v25TileStone(g,x,y,rx,ry,level,type);
  else{
   const grd=g.createRadialGradient(x,y+8,3,x,y+10,rx);
   grd.addColorStop(0,type==='cave'?'rgba(123,98,51,.66)':'rgba(165,139,91,.54)');grd.addColorStop(.67,'rgba(171,145,90,.25)');grd.addColorStop(1,'rgba(171,145,90,0)');g.fillStyle=grd;g.beginPath();g.ellipse(x,y+13,rx,ry,0,0,V25_TAU);g.fill();
  }
  if(type==='cave'&&b)v25DrawFarmrows(g,x-20,y+22,level,'cave');
  if(type==='logement'&&b){
   for(let k=0;k<5+Math.min(level,4);k++){const px=x-60+k*17,py=y+24+Math.sin(k*1.8)*5;g.fillStyle=k%2?'#6d8741':'#487749';g.beginPath();g.arc(px,py,3.1,0,V25_TAU);g.fill();g.fillStyle='#d7ab6a';g.fillRect(px-1,py-1,1.4,1.4)}
  }
  if(type==='caserne'&&b){
   g.save();g.translate(x,y);g.strokeStyle='rgba(110,82,49,.68)';g.lineWidth=1.7;for(let q=-2;q<=2;q++){g.beginPath();g.moveTo(-41,q*7+28);g.lineTo(41,q*7+28);g.stroke()}g.restore();
  }
  if(type==='port'&&b){
   const yy=y+19;g.fillStyle='#a7804b';g.strokeStyle='#5c422c';g.lineWidth=2;g.fillRect(x+32,yy-13,47,17);g.strokeRect(x+32,yy-13,47,17);
   for(let k=0;k<5;k++){g.strokeStyle='#e9cb90';g.beginPath();g.moveTo(x+36+k*9,yy-11);g.lineTo(x+36+k*9,yy+2);g.stroke()}
  }
  if(level>=2&&b){
   const olive=modularProps.olive;
   if(olive?.complete&&olive.naturalWidth){g.globalAlpha=.90;g.drawImage(olive,x-rx-12,y-61,49,70);if(level>=4)g.drawImage(olive,x+rx-25,y-58,42,62)}
  }
  g.restore();
 }
}
function v25LocalSparks(g,state,ts){
 const t=ts/1000;
 for(let i=0;i<state.sites.length;i++){
  const b=state.sites[i];if(!b)continue;
  const workers=Number(state.workers?.[i]||0),[x,y]=tilePoint(...sites[i]);
  if(['scierie','carriere','marbre','cave'].includes(b.type)&&workers>0){
   g.save();g.globalAlpha=.19;
   for(let k=0;k<Math.min(6,workers+2);k++){const f=(t*.31+k*.16)%1;g.fillStyle=b.type==='scierie'?'#d8bf82':'#f1e8d0';g.beginPath();g.ellipse(x+Math.sin(k*2.7+t*.8)*13,y-11-f*27,2+f*4,1.5+f*2,0,0,V25_TAU);g.fill()}
   g.restore();
  }
 }
}
function v25DrawLight(g,x,y,r,alpha){
 const grad=g.createRadialGradient(x,y,3,x,y,r);
 grad.addColorStop(0,`rgba(255,192,83,${alpha})`);grad.addColorStop(.35,`rgba(255,173,75,${alpha*.44})`);grad.addColorStop(1,'rgba(255,153,68,0)');
 g.fillStyle=grad;g.beginPath();g.arc(x,y,r,0,V25_TAU);g.fill();
}
function v25Lighting(g,state,ts,scenic){
 const sec=ts/1000;
 const tone=v25TimePreset==='auto'?(sec%600)/600:v25TimePreset==='day'?0:v25TimePreset==='dusk'?.58:.8;
 const darkness=v25TimePreset==='auto'?Math.pow(Math.max(0,Math.sin(tone*V25_TAU-Math.PI*.65)),2)*.48:v25TimePreset==='day'?0:v25TimePreset==='dusk'?.27:.49;
 if(darkness<.01)return;
 g.save();g.fillStyle=`rgba(13,29,57,${darkness.toFixed(3)})`;g.fillRect(0,0,W,H);
 const t=ts/1000;
 for(let i=0;i<state.sites.length;i++){
  const b=state.sites[i];if(!b)continue;
  const [x,y]=scenic?v18ScenicSitePoint(i,state):tilePoint(...sites[i]);
  const n=b.level||1;
  const lights=b.type==='hotelville'||b.type==='senatbat'?[[ -39,-29],[39,-29],[0,-12]]:b.type==='port'?[[ 25,-10],[-29,-9]]:b.type==='marche'?[[ -33,-25],[15,-20]]:b.type==='caserne'?[[ -25,-20],[28,-21]]:[[0,-25]];
  for(let k=0;k<lights.length;k++){
   const [dx,dy]=lights[k];const flicker=.84+Math.sin(t*4.8+i*2.1+k)*.12;
   v25DrawLight(g,x+dx,y+dy,35+n*3,(.28+darkness*.28)*flicker);
   g.fillStyle='#ffe6a8';g.beginPath();g.arc(x+dx,y+dy,1.6,0,V25_TAU);g.fill();
  }
 }
 g.restore();
}


function v26EnrichedQuarter(g,state,ts){
 const sec=ts/1000;
 for(let i=0;i<state.sites.length;i++){
  const b=state.sites[i];if(!b)continue;
  const type=b.type,level=Math.max(1,b.level||1),workers=Number(state.workers?.[i]||0),[x,y]=tilePoint(...sites[i]);
  const scale=1+Math.min(level-1,4)*.08;
  g.save();
  // Two-tier low stone boundary gives the quarters a shared physical scale.
  if(['hotelville','senatbat','marche','academie','temple','caserne','entrepot'].includes(type)){
   const rx=(type==='hotelville'||type==='senatbat'?100:78)*scale,ry=(type==='hotelville'?42:32)*scale;
   g.strokeStyle='#5a46335b';g.lineWidth=8;g.beginPath();g.ellipse(x+2,y+25,rx,ry,0,Math.PI*.18,Math.PI*.94);g.stroke();
   g.strokeStyle='#e0c89e';g.lineWidth=5;g.beginPath();g.ellipse(x,y+21,rx,ry,0,Math.PI*.17,Math.PI*.95);g.stroke();
   for(let q=-2;q<=2;q++){
    const theta=(q+2)/4*Math.PI*.79+Math.PI*.16;
    const px=x+Math.cos(theta)*rx,py=y+21+Math.sin(theta)*ry;
    g.fillStyle='#e1cba5';g.fillRect(px-3,py-9,6,11);g.fillStyle='#b9a079';g.fillRect(px-4,py-10,8,3);
   }
  }
  // Animated props and identifiable exterior workplaces, driven by building type and actual workers.
  if(type==='scierie'){
   for(let k=0;k<4+Math.min(level,3);k++){
    const px=x-62+k*12,py=y+31+(k%2)*5;
    g.fillStyle='#74512d';g.beginPath();g.ellipse(px,py,10,4.3,.06,0,Math.PI*2);g.fill();
    g.strokeStyle='#c69a61';g.lineWidth=1.4;g.stroke();g.fillStyle='#e6bb7f';g.beginPath();g.arc(px-8,py,2.4,0,Math.PI*2);g.fill();
   }
   if(workers>0){const t=(sec*.19)%1;g.fillStyle='#9d7040';g.fillRect(x+18+t*24,y+27,27,8);g.strokeStyle='#4d3b21';g.strokeRect(x+18+t*24,y+27,27,8);}
  }
  if(type==='carriere'||type==='marbre'){
   for(let k=0;k<3+Math.min(level,3);k++){
    const xx=x-54+(k%3)*27,yy=y+31+Math.floor(k/3)*12;
    g.fillStyle=k%2?'#d0c4ad':'#b6ab9a';g.beginPath();g.moveTo(xx-12,yy+8);g.lineTo(xx-6,yy-3);g.lineTo(xx+10,yy-5);g.lineTo(xx+14,yy+6);g.closePath();g.fill();g.strokeStyle='#8b857a';g.lineWidth=.7;g.stroke();
   }
   if(workers>0){g.fillStyle='rgba(236,223,198,.32)';g.beginPath();g.ellipse(x+34,y+19+Math.sin(sec*3)*1,7,4,0,0,Math.PI*2);g.fill();}
  }
  if(type==='marche'){
   for(let k=0;k<3+Math.min(level,3);k++){
    const xx=x-54+k*19,yy=y+31+(k%2)*4;
    g.fillStyle='#ad7442';g.fillRect(xx-8,yy-3,17,7);g.fillStyle=k%2?'#c85239':'#e9d0a6';g.beginPath();g.moveTo(xx-11,yy-5);g.lineTo(xx,yy-15+Math.sin(sec*1.8+k)*1.1);g.lineTo(xx+11,yy-5);g.closePath();g.fill();
   }
  }
  if(type==='logement'){
   for(let k=0;k<3+Math.min(level,4);k++){
    const xx=x-42+k*17,yy=y+30+Math.sin(k*4)*3;
    g.fillStyle='#946e45';g.fillRect(xx-8,yy,15,7);for(let f=0;f<4;f++){
     g.fillStyle=(f+k)%2?'#648c51':'#b36748';g.beginPath();g.arc(xx-5+f*3,yy-3,2.6,0,Math.PI*2);g.fill();}
   }
  }
  if(type==='cave'){
   for(let k=0;k<4+Math.min(level,5);k++){
    const xx=x-48+k*14,yy=y+35+(k%2)*3;
    g.strokeStyle='#6e5e32';g.lineWidth=2;g.beginPath();g.moveTo(xx,yy-14);g.lineTo(xx,yy+5);g.stroke();
    g.fillStyle='#678747';g.beginPath();g.ellipse(xx-3,yy-10,6,3,.25,0,Math.PI*2);g.fill();
    g.fillStyle='#5b3975';for(let b=0;b<3;b++){g.beginPath();g.arc(xx-2+b*2,yy-6+(b%2)*3,1.4,0,Math.PI*2);g.fill()}
   }
  }
  if(type==='caserne'){
   for(let k=0;k<3+Math.min(level,4);k++){
    const xx=x-45+k*23,yy=y+35;
    g.strokeStyle='#79532b';g.lineWidth=2;g.beginPath();g.moveTo(xx,yy-26);g.lineTo(xx,yy+2);g.stroke();
    g.fillStyle='#8c1d16';g.beginPath();g.moveTo(xx,yy-25);g.lineTo(xx+10+Math.sin(sec*1.4+k)*2,yy-21);g.lineTo(xx,yy-16);g.fill();
   }
  }
  if(type==='port'){
   // Real pier extension and animated tide, no detached water squares.
   for(let k=0;k<4;k++){
    g.fillStyle='#8f673e';g.fillRect(x+36+k*13,y+24+k*3,13,5);
    g.strokeStyle='#4c3624';g.beginPath();g.moveTo(x+40+k*13,y+26+k*3);g.lineTo(x+40+k*13,y+36+k*3);g.stroke();
   }
  }
  if(type==='hotelville'&&level>=2){
   // Second-level fountain and hedges are part of the actual built civic quarter.
   const fx=x-92,fy=y+25;g.fillStyle='#ac9670';g.beginPath();g.ellipse(fx,fy,17,10,0,0,Math.PI*2);g.fill();
   g.fillStyle='#518e9a';g.beginPath();g.ellipse(fx,fy-2,12,6,0,0,Math.PI*2);g.fill();
   g.strokeStyle='#b8e8d7';g.lineWidth=1;g.beginPath();g.moveTo(fx,fy-2);g.quadraticCurveTo(fx+Math.sin(sec*2)*6,fy-14,fx+5,fy-3);g.stroke();
  }
  if(type==='senatbat'&&level>=2){
   for(const xx of [x-57,x+55]){g.fillStyle='#c9b18c';g.fillRect(xx-4,y+4,8,23);g.fillStyle='#e6cda1';g.fillRect(xx-6,y+1,12,5)}
  }
  if(type==='entrepot'){
   for(let k=0;k<4+Math.min(level,4);k++){
    const xx=x-44+(k%4)*20,yy=y+25+Math.floor(k/4)*10;
    g.fillStyle='#986835';g.fillRect(xx,yy,16,10);g.strokeStyle='#6b472b';g.lineWidth=1;g.strokeRect(xx,yy,16,10);
    g.strokeStyle='#cbaa78';g.beginPath();g.moveTo(xx+8,yy);g.lineTo(xx+8,yy+10);g.stroke();
   }
  }
  g.restore();
 }
}

function v21GroundDetail(g,state,ts){
 const t=ts/1000;
 g.save();
 v25DistrictGround(g,state,ts);v26EnrichedQuarter(g,state,ts);
 // Public amenities only appear if the built civic center exists.
 const hall=state.sites?.[4];
 if(hall?.type==='hotelville'){
  const [x,y]=tilePoint(...sites[4]);
  g.save();g.translate(x,y+21);
  // A restrained elliptical forum pavement, embedded under the architecture.
  g.fillStyle='rgba(227,201,148,.3)';g.strokeStyle='rgba(99,71,40,.48)';g.lineWidth=2;
  g.beginPath();g.ellipse(0,4,116,48,0,0,V21_TAU);g.fill();g.stroke();
  for(let r=30;r<108;r+=22){g.strokeStyle='rgba(128,91,56,.20)';g.beginPath();g.ellipse(0,4,r,r*.41,0,0,V21_TAU);g.stroke();}
  // Fountain only from hall level two; water and shade actually move.
  if(hall.level>=2){
   g.fillStyle='#988260';g.beginPath();g.ellipse(-75,1,19,11,0,0,V21_TAU);g.fill();
   g.fillStyle='#488f9c';g.beginPath();g.ellipse(-75,-1,14,7,0,0,V21_TAU);g.fill();
   for(let k=0;k<5;k++){let tt=t*1.6+k*1.27;g.strokeStyle='rgba(213,244,235,.75)';g.lineWidth=1;g.beginPath();
    g.moveTo(-75,-2);g.quadraticCurveTo(-75+Math.sin(tt)*12,-9,-75+Math.cos(tt)*7,-1);g.stroke();}
  }
  g.restore();
 }
 // Orchards and gardens are consequences of populated housing, not pre-built villas.
 state.sites?.forEach((b,i)=>{
   if(!b)return;const [x,y]=tilePoint(...sites[i]);
   if(b.type==='logement'){
     g.save();g.translate(x,y+17);
     for(let j=0;j<3;j++){let ox=(j-1)*24,oy=21+(j%2)*3;
      g.fillStyle='#81754599';g.fillRect(ox-10,oy-4,20,10);
      for(let k=0;k<4;k++){g.fillStyle=k%2?'#46783c':'#5c8740';g.beginPath();g.arc(ox-7+k*5,oy-2,2.9,0,V21_TAU);g.fill()}
     }g.restore();
   }
   if(b.type==='cave'){
      g.save();g.strokeStyle='rgba(78,77,38,.69)';g.lineWidth=2;
      for(let k=0;k<4;k++){let xx=x-54+k*21, yy=y+30+k*1.5;
       g.beginPath();g.moveTo(xx,yy-14);g.lineTo(xx,yy+11);g.stroke();
       for(let j=0;j<3;j++){g.fillStyle=(j+k)%2?'#567f35':'#6e833e';g.beginPath();g.arc(xx+Math.sin(t*.28+k)*.4,yy-10+j*7,5.2,0,V21_TAU);g.fill();}
      }g.restore();
   }
   if(b.type==='entrepot'){
      g.save();g.translate(x+48,y+12);g.fillStyle='#61422266';g.beginPath();g.ellipse(0,3,24,7,0,0,V21_TAU);g.fill();
      for(let j=0;j<3;j++){const bx=(j-1)*15,by=(j%2)*-7-7;g.fillStyle='#ac8852';g.fillRect(bx,by,13,12);g.strokeStyle='#74542e';g.strokeRect(bx,by,13,12)}g.restore();
   }
 });
 g.restore();
}
function v21RoadTraffic(g,state,ts){
 const t=ts/1000;
 // Carts travel on precisely the same road lines as the city: never across empty lots.
 if(!state.sites?.some(b=>b?.type==='entrepot'||b?.type==='marche'))return;
 const line=Array.from({length:13},(_,i)=>tilePoint(i+2,7));
 const length=line.length-1, u=(t*.052)%1, i=Math.floor(u*length),frac=u*length-i;
 const a=line[i],b=line[Math.min(length,i+1)];const x=a[0]+(b[0]-a[0])*frac,y=a[1]+(b[1]-a[1])*frac;
 g.save();g.translate(x,y-4);g.rotate(Math.atan2(b[1]-a[1],b[0]-a[0])*.3);
 const cart=modularProps.cart;
 g.fillStyle='rgba(22,26,18,.34)';g.beginPath();g.ellipse(3,7,20,5,0,0,V21_TAU);g.fill();
 if(cart?.complete&&cart.naturalWidth)g.drawImage(cart,-27,-30,54,33);
 else{g.fillStyle='#8d643a';g.fillRect(-12,-13,25,14);g.fillStyle='#34291d';g.beginPath();g.arc(-8,2,4,0,V21_TAU);g.arc(10,2,4,0,V21_TAU);g.fill();}
 g.restore();
}
function v21CoastLife(g,state,ts){
 const t=ts/1000;
 if(!state.sites?.some(b=>b?.type==='port'))return;
 const x=893+Math.cos(t*.11)*38,y=579+Math.sin(t*.11)*15;
 g.save();g.translate(x,y);g.rotate(.08+Math.sin(t*.3)*.06);
 g.fillStyle='rgba(6,31,42,.38)';g.beginPath();g.ellipse(0,6,39,10,0,0,V21_TAU);g.fill();
 g.strokeStyle='#f4e8c68a';g.lineWidth=1.4;for(let r=29;r<51;r+=11){g.beginPath();g.ellipse(0,5,r,11,0,.1,Math.PI);g.stroke()}
 g.fillStyle='#71451f';g.beginPath();g.ellipse(0,2,26,6,0,0,V21_TAU);g.fill();
 g.strokeStyle='#542b17';g.lineWidth=2;g.beginPath();g.moveTo(0,1);g.lineTo(0,-27);g.stroke();
 g.fillStyle='#a72517';g.beginPath();g.moveTo(0,-26);g.lineTo(19+Math.sin(t*2)*2,-13);g.lineTo(0,-13);g.fill();
 g.restore();
}

function drawTerrainV20(){
 const g=tctx;g.clearRect(0,0,W,H);
 // Marine layer independent from a modular, paintable coastline.
 let sea=g.createLinearGradient(725,20,1180,675);sea.addColorStop(0,'#8ab8b8');sea.addColorStop(.2,'#317c92');sea.addColorStop(.54,'#136f91');sea.addColorStop(1,'#073b60');
 g.fillStyle=sea;g.fillRect(0,0,W,H);
 const mist=g.createLinearGradient(0,0,0,185);mist.addColorStop(0,'#d6e8d1c7');mist.addColorStop(.55,'#7fb5b997');mist.addColorStop(1,'#1f799000');g.fillStyle=mist;g.fillRect(0,0,W,185);
 if(v20Accents.horizon?.complete&&v20Accents.horizon.naturalWidth)g.drawImage(v20Accents.horizon,750,-9,418,165);
 // Water remains modular; dynamic highlights added every frame below.
 for(let k=0;k<200;k++){
  const x=780+seeded(k,113)*390,y=85+seeded(k,114)*565;
  const len=3+seeded(k,115)*21;g.strokeStyle=k%3===0?'#e4f4d552':'#89d0c82d';g.lineWidth=.7;
  g.beginPath();g.moveTo(x-len*.5,y);g.quadraticCurveTo(x,y-2,x+len*.5,y);g.stroke();
 }
 // Whole ground texture is one REUSABLE MATERIAL, not a fixed city image.
 g.save();v20LandOutline(g);g.clip();
 if(terrainMaterial.complete&&terrainMaterial.naturalWidth)g.drawImage(terrainMaterial,-10,-20,W+80,H+80);
 else{g.fillStyle='#9ea66b';g.fillRect(-10,-10,W+20,H+20)}
 const sun=g.createLinearGradient(90,0,900,650);sun.addColorStop(0,'#f4dea52b');sun.addColorStop(.3,'#f1e4b000');sun.addColorStop(1,'#31503924');g.fillStyle=sun;g.fillRect(0,0,W,H);
 // Meadow pigments: density and hue are deterministic, with no checkerboard.
 for(let i=0;i<145;i++){
  let x=seeded(i,81)*1080,y=seeded(i,82)*680,rx=15+seeded(i,83)*65,ry=5+seeded(i,84)*20;
  g.fillStyle=i%4===0?'#eddb8b12':i%4===1?'#42753a12':i%4===2?'#f0ca9314':'#44582a14';
  g.beginPath();g.ellipse(x,y,rx,ry,seeded(i,85)*.4,0,6.283);g.fill();
 }
 // Painted back hills are a SEPARATE module; building slots are never part of it.
 if(v20Accents.northwest?.complete&&v20Accents.northwest.naturalWidth)g.drawImage(v20Accents.northwest,-10,-24,470,214);
 // Dense northern relief: independently layered local art, not a whole-scene screenshot.
 if(v20Accents.north?.complete&&v20Accents.north.naturalWidth)g.drawImage(v20Accents.north,385,-11,390,148);
 // The roads use geometric state, and can later be independently extended by new roads.
 const trace=[];
 for(const ty of [4,7,10])trace.push(Array.from({length:13},(_,i)=>tilePoint(i+2,ty)));
 for(const tx of [4,8,12])trace.push(Array.from({length:11},(_,i)=>tilePoint(tx,i+2)));
 for(let i=0;i<trace.length;i++)v20PaintRoad(g,trace[i],i<3?22:19);
 // Circular paved nodes at crossroads, built from individually drawn stones.
 for(const xx of [4,8,12])for(const yy of [4,7,10]){
  const [px,py]=tilePoint(xx,yy);g.fillStyle='#dac5a5';g.beginPath();g.ellipse(px,py,18,11,0,0,6.283);g.fill();
  g.strokeStyle='#b49b75';g.lineWidth=1.1;g.beginPath();g.ellipse(px,py,16,9,0,0,6.283);g.stroke();
  for(let k=0;k<9;k++){const a=k*.7;g.strokeStyle='#c9b08e';g.beginPath();g.moveTo(px+Math.cos(a)*4,py+Math.sin(a)*2);g.lineTo(px+Math.cos(a)*14,py+Math.sin(a)*7);g.stroke()}
 }
 // Microdetail surrounding plots; keep architectural plots visually clear.
 for(let k=0;k<410;k++){
  const gx=seeded(k,121)*COLS,gy=seeded(k,122)*ROWS,[px,py]=tilePoint(gx,gy);
  if(sites.some(([sx,sy])=>Math.abs(sx-gx)<1.4&&Math.abs(sy-gy)<1.2))continue;
  if(Math.abs(gy-4)<.45||Math.abs(gy-7)<.45||Math.abs(gy-10)<.45||Math.abs(gx-4)<.43||Math.abs(gx-8)<.43||Math.abs(gx-12)<.43)continue;
  g.strokeStyle=k%4===0?'#e9e0a077':'#3b773a77';g.lineWidth=.6+seeded(k,123);
  g.beginPath();g.moveTo(px,py);g.lineTo(px+seeded(k,124)*3-1.5,py-2-seeded(k,125)*5);g.stroke();
  if(k%13===0){g.fillStyle=k%2?'#f1d5aa':'#e6cbd6';g.beginPath();g.arc(px+2,py-3,1.5,0,6.283);g.fill()}
 }
 g.restore();
 v20Coast(g);
 // Foreground scenic modules are static TERRAIN accents, not buildings or units.
 
 
 
 // Separately arranged trees, gardens and stone props; never embedded into a flattened city scene.
 v19Vegetation.length=0;
 for(let i=0;i<250;i++){
  const tx=seeded(i,140)*16,ty=seeded(i,141)*13,[px,py]=tilePoint(tx,ty);
  if(px>955&&py>270)continue;
  const slotNear=sites.some(([sx,sy])=>Math.abs(sx-tx)<1.4&&Math.abs(sy-ty)<1.5);
  const roadNear=[4,7,10].some(v=>Math.abs(ty-v)<.74)||[4,8,12].some(v=>Math.abs(tx-v)<.74);
  if(slotNear||roadNear)continue;
  const edge=tx<2.7||tx>13.6||ty<2.8||ty>11;
  if(!edge&&seeded(i,143)<.62)continue;
  const r=seeded(i,145);const type=r<.78?'olive':'cypress';
  v19Vegetation.push({px,py,type,scale:(type==='olive'?.57:.69)+seeded(i,146)*.25});
 }
 // Rock props and vineyard terraces are independent and avoid interactable lots.
 for(let i=0;i<34;i++){
   const gx=seeded(i,180)*16,gy=seeded(i,181)*13,[px,py]=tilePoint(gx,gy);
   if(sites.some(([sx,sy])=>Math.abs(sx-gx)<1.9&&Math.abs(sy-gy)<1.9)||isRoad(Math.floor(gx),Math.floor(gy)))continue;
   if(modularProps.rocks?.complete&&modularProps.rocks.naturalWidth){const sc=.28+seeded(i,183)*.32;g.drawImage(modularProps.rocks,px-36*sc,py-28*sc,72*sc,35*sc)}
 }
 
 // Rocky promontories and cypress groves from independent, reusable transparent sprites.
 const boulderGroups=[[18,591,1.15],[73,620,.94],[122,593,.91],[178,651,.85],[251,646,1.1],
 [384,656,1.12],[486,641,.89],[705,648,1.15],[807,615,.92],[922,528,.9],
 [1058,278,.94],[1031,345,.72],[1000,424,.86],[942,491,.7]];
 for(let i=0;i<boulderGroups.length;i++){
  const [x,y,scale]=boulderGroups[i];if(modularProps.rocks?.complete&&modularProps.rocks.naturalWidth)
   g.drawImage(modularProps.rocks,x-48*scale,y-43*scale,96*scale,50*scale);
 }
 for(const [px,py,kind,scale] of [[31,562,'olive',.89],[102,580,'olive',.83],
 [180,620,'cypress',.85],[300,623,'olive',.69],[650,649,'olive',.67],
 [947,320,'olive',.68],[1008,342,'cypress',.81],[1039,409,'olive',.9],
 [900,560,'cypress',.68],[53,193,'cypress',.92]]){
    v19Vegetation.push({px,py,type:kind,scale});
 }
 // Rudimentary coast access, separate from the buildable port structure.
 const hx=852,hy=579;g.save();g.strokeStyle='#553923';g.lineCap='round';g.lineWidth=16;
 g.beginPath();g.moveTo(hx-20,hy-20);g.lineTo(hx+55,hy+16);g.stroke();g.strokeStyle='#d7b78a';g.lineWidth=11;g.stroke();
 for(let k=0;k<4;k++){const x=hx-16+k*22,y=hy-17+k*10;g.strokeStyle='#513b27';g.lineWidth=4;g.beginPath();g.moveTo(x,y-2);g.lineTo(x,y+13);g.stroke()};g.restore();
}
for(const [id,src] of Object.entries(v20ExtraSrc)){const img=new Image();img.onload=()=>drawTerrainV20();img.src=src;v20Accents[id]=img;}
// Replace the old rectangular plateau; asset onload callbacks now use the replacement.
drawTerrain=drawTerrainV20;
drawTerrainV20();

function v20DrawVegetation(g,ts,part,state){
 const t=ts/1000;
 // Living trees are independently culled when city development encroaches on their plot.
 const occupied=(state?.sites||[]).map((b,i)=>b||state?.construction?.site===i?{x:tilePoint(...sites[i])[0],y:tilePoint(...sites[i])[1],type:b?.type||state?.construction?.type}:null).filter(Boolean);
 const sorted=v19Vegetation.slice().sort((a,b)=>a.py-b.py);
 for(let i=0;i<sorted.length;i++){
  const p=sorted[i];if(part==='back'&&p.py>=370)continue;if(part==='front'&&p.py<370)continue;
  if(occupied.some(o=>Math.abs(p.px-o.x)<(o.type==='hotelville'?92:76)&&Math.abs(p.py-o.y)<(o.type==='hotelville'?76:61)))continue;
  const bob=Math.sin(t*.64+i*.73)*.012+Math.cos(t*.27+i*.19)*.009;
  g.save();g.translate(p.px,p.py);g.fillStyle='#172e1a46';g.beginPath();g.ellipse(5,2,17*p.scale,5*p.scale,0,0,6.283);g.fill();g.rotate(bob);
  if(p.type==='olive')drawOlive(g,0,0,p.scale);else drawCypress(g,0,0,p.scale);
  g.restore();
 }
}

function v20Water(g,ts){
 const t=ts/1000;g.save();v20LandOutline(g);g.clip('evenodd');
 // Use an explicit marine clip: no ripples on grass or road.
 g.restore();g.save();g.beginPath();g.rect(0,0,W,H);v20LandOutline(g);g.clip('evenodd');
 for(let i=0;i<135;i++){
  let x=(i*131.9+t*(5+i%4)*3)%W, y=(i*61.17+Math.sin(t*.6+i)*3)%H;
  const alpha=.12+.19*(.5+.5*Math.sin(t*.9+i*.8));g.strokeStyle=`rgba(230,250,224,${alpha})`;g.lineWidth=i%5===0?1.6:.9;
  g.beginPath();g.moveTo(x-9,y);g.quadraticCurveTo(x,y-2.5,x+11,y);g.stroke();
 }
 g.restore();
}

function v19DrawVegetation(g,ts){
 const t=ts/1000;
 const sorted=v19Vegetation.slice().sort((a,b)=>a.py-b.py);
 for(let i=0;i<sorted.length;i++){
  const o=sorted[i],seed=i*1.47+o.px*.013;
  const sway=Math.sin(t*.67+seed)*.022+Math.sin(t*.32+seed*1.7)*.012;
  g.save();g.translate(o.px,o.py);g.fillStyle='#1e2d1640';g.beginPath();g.ellipse(4,2,16*o.scale,4.8*o.scale,0,0,Math.PI*2);g.fill();
  g.rotate(sway);
  if(o.type==='olive')drawOlive(g,0,0,o.scale);
  else drawCypress(g,0,0,o.scale);
  g.restore();
 }
}
