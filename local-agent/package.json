{
  "name": "swapp-local-app",
  "version": "1.0.6",
  "private": true,
  "description": "SWAPP Live — OBS vers swapp.tv en HTTPS, HLS 720p 2s optimisé sans tunnel",
  "main": "main.js",
  "dependencies": {
    "express": "^4.21.2",
    "node-media-server": "^2.7.0",
    "ffmpeg-static": "^5.2.0",
    "hls.js": "^1.6.15"
  },
  "author": "Swapp",
  "productName": "Swapp Local",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tv.swapp.live",
    "productName": "SWAPP Live",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SWAPP-Live-Setup-${version}-${arch}.${ext}"
    },
    "extraMetadata": {
      "main": "main.js"
    },
    "portable": {
      "artifactName": "SWAPP-Live-Portable-${version}-${arch}.${ext}",
      "unpackDirName": false
    },
    "extraResources": [
      {
        "from": "bin/cloudflared.exe",
        "to": "bin/cloudflared.exe"
      }
    ],
    "afterPack": "./scripts/ensure-electron-runtime.cjs"
  }
}
