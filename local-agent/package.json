{
  "name": "swapp-local-app",
  "version": "1.0.0",
  "private": true,
  "description": "SWAPP Live — encodeur local OBS, lecteur HLS et tunnel public, sans console Windows",
  "main": "main.js",
  "dependencies": {
    "express": "^4.21.2",
    "node-media-server": "^2.7.0",
    "ffmpeg-static": "^5.2.0"
  },
  "author": "Swapp",
  "productName": "Swapp Local",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tv.swapp.live",
    "productName": "SWAPP Live",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SWAPP-Live-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
