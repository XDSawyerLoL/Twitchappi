# Oryon — exemple local uniquement.
# Sur Render, ne mets rien en dur dans le code : configure ces variables dans Environment.
NODE_ENV=production
PORT=10000
SESSION_SECRET=change_me_long_random_secret
PUBLIC_BASE_URL=https://ton-domaine.fr
CORS_ORIGINS=https://ton-domaine.fr

# Twitch API / OAuth — utilise les valeurs déjà présentes sur Render
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://ton-domaine.fr/twitch_auth_callback

# Emails de confirmation Oryon : désactivés pour le MVP.
# À réactiver plus tard avec un fournisseur SMTP transactionnel.

# WebRTC natif
# P2P simple par défaut. Ajoute TURN pour fiabiliser les connexions derrière box/NAT.
WEBRTC_MODE=p2p
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
ICE_TRANSPORT_POLICY=all
MAX_NATIVE_VIEWERS=300

# Préparation évolution SFU / P2P hybride
SFU_ENABLED=false
SFU_URL=
P2P_HYBRID_ENABLED=false
P2P_SUPER_PEER_TARGET=8

# GIFs chat
GIPHY_API_KEY=

# Comptes SWAPP sur Hostinger MySQL (pas d'import automatique des comptes tests)
# Activer uniquement une fois la table vérifiée et l'application déployée.
SWAPP_ACCOUNT_STORE=mysql
# Utiliser la même URL MySQL que les autres fonctions SOCIAL, via un secret Hostinger.
# SWAPP_MYSQL_URL=mysql://USER:PASSWORD@MYSQL_HOST:3306/DATABASE

# Fair Discovery v2 (facultatif, DÉSACTIVÉ par défaut).
# Nécessite SWAPP_SOCIAL_FEATURES=1, SWAPP_MYSQL_URL et SESSION_SECRET stable (>=32 caractères).
# Collecte uniquement après consentement volontaire sur une fiche de jeu.
# SWAPP_FAIR_METRICS_ENABLED=1
SWAPP_FAIR_METRICS_ENABLED=0

# SOCIAL back-end migration — keep Render until a FULL verified Pulse snapshot exists.
# Default: render, so existing posts and private messages remain untouched.
SWAPP_SOCIAL_BACKEND=render
# '1' only AFTER full source/destination backup, integrity checks and controlled cutover.
SWAPP_SOCIAL_MYSQL_MIGRATION_VERIFIED=0
# Alternative for a brand-new SOCIAL with no old posts/DMs carried forward.
# Use ONLY after running the no-overwrite bootstrap and confirming it is fresh.
SWAPP_SOCIAL_FRESH_START_VERIFIED=0
# One-time CLI authorization. Keep 0 outside the bootstrap command.
SWAPP_SOCIAL_FRESH_START_APPROVED=0
# One-shot initialization on Node startup; requires explicit fresh approvals above.
# Disable after the first successful boot.
SWAPP_SOCIAL_FRESH_AUTO_INIT=0

# Optional final cutover maintenance: block SOCIAL writes (including posts / DMs).
SWAPP_SOCIAL_MIGRATION_FREEZE=0
# Optional dedicated MySQL URI. If omitted SWAPP_MYSQL_URL is used.
# SWAPP_SOCIAL_MYSQL_URL=mysql://USER:PASSWORD@MYSQL_HOST:3306/DATABASE
# CLI import requires separate explicit approval. Never leave enabled afterward.
SWAPP_SOCIAL_IMPORT_APPROVED=0

# SWAPP Creator Spotlight : 0 tant que MySQL + OAuth Twitch ne sont pas validés sur Hostinger.
# Requiert SWAPP_ACCOUNT_STORE=mysql, SWAPP_MYSQL_URL, TWITCH_CLIENT_ID/SECRET.
SWAPP_SPOTLIGHT_ENABLED=0

# Firebase optionnel pour analytics historiques
FIREBASE_SERVICE_KEY=

# Paiement optionnel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_1250=
STRIPE_PRICE_PREMIUM_MONTHLY=

# Oryon Foundation
# Admin global : mets ton pseudo Oryon, ou plusieurs séparés par virgule.
ORYON_ADMIN_LOGINS=sansa

# Base persistante future : Supabase/PostgreSQL.
# Si absent, le MVP utilise les fichiers JSON locaux du serveur.
DATABASE_URL=

# Limites anti-abus complémentaires
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_HEAVY_PER_MIN=60

# OBS / ingest vidéo natif futur
# Render peut stocker ces variables, mais il faut un vrai serveur RTMP/SRT/WebRTC ingest derrière.
OBS_RTMP_URL=
RTMP_INGEST_URL=
ORYON_RTMP_URL=

# === Moteur vidéo Oryon (PeerTube masqué derrière Oryon) ===
# Côté utilisateur, on affiche "Oryon Live". PeerTube reste l'infra vidéo interne.
ORYON_VIDEO_MODE=oryon-engine
ORYON_PUBLIC_RTMP_URL=rtmp://live.oryon.fr/live
ORYON_RTMP_URL=rtmp://live.oryon.fr/live
ORYON_PLAYER_EMBED_TEMPLATE=https://video.oryon.fr/videos/embed/{uuid}?autoplay=1&warningTitle=0&peertubeLink=0
ORYON_VIDEO_ENGINE_API_URL=https://video.oryon.fr
ORYON_VIDEO_ENGINE_TOKEN=
PEERTUBE_BASE_URL=https://video.oryon.fr
PEERTUBE_ADMIN_USER=
PEERTUBE_ADMIN_PASSWORD=
# Domaine/serveur externe où sera installé PeerTube. Render héberge Oryon, pas l'ingest RTMP.
# Le port RTMP 1935 doit être ouvert sur le serveur vidéo.

# Oryon Local Agent (optionnel, côté streamer)
ORYON_LOCAL_AGENT_PORT=8081
ORYON_LOCAL_RTMP_PORT=1935

# Discord : annonces Snaps uniquement dans le salon 1563559744612999239
# Créer un webhook distinct dans CE salon ; ne jamais commiter son URL réelle.
# SWAPP_SNAPS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
SWAPP_SNAPS_DISCORD_ENABLED=true
